extends ../extends/doctype
block content
    .navigator
        .cont.content.left
            a(href=url_base+"promociones")
                img.concebir-logo(src=url_base+"images/concebir.png", alt="Concebir logo")
        .cont.content-right
            a.nodisplay(href=url_base+"cerrarsesion")
                img.nav-icon-alt.icon__.logout.float-right(src=url_base+"images/iconos/POWER.png", style="width: 60px;")
            a.nodisplay(href=url_base+"configuracion")
                img.nav-icon-alt.icon__.float-right(src=url_base+"images/iconos/AJUSTES-03.png", style="width: 60px;")
            a.nodisplay(href=url_base+"miscitas")
                img.nav-icon-alt.icon__.float-right(src=url_base+"images/iconos/MIS-CITAS-03.png", style="width: 60px;")
            a.nodisplay(href=url_base+"doctores/all")
                img.nav-icon-alt.icon__.float-right(src=url_base+"images/iconos/MEDICOS-03.png", style="width: 60px;")
            a.bar-menu
                i.fas.fa-bars.icon__.float-right(style="margin-right: 18px;margin-bottom:5px;")
            a.bar-close(style="display:none;")
                i.fas.fa-bars.icon__.float-right(style="margin-right: 18px;margin-bottom:5px;")
    script
        include script.js
    
    .contDesplegable(style="display:none;") 
        .nav-header(style="width:100%;height:100vh;z-index:1000;")
            .container(style="background:#fff;")
                .row(style="margin:10px 0 0;")
                    .col-xs-3 
                        a(href=url_base+"cerrarsesion",style="color:#fff;")
                            img(src=url_base+"images/iconos/POWER.png", style="width: 100%;padding:10px;")
                    .col-xs-3 
                        a(href=url_base+"configuracion",style="color:#fff;")
                            img(src=url_base+"images/iconos/AJUSTES-03.png", style="width: 100%;padding:10px;")
                    .col-xs-3 
                        a(href=url_base+"miscitas",style="color:#fff;")
                            img(src=url_base+"images/iconos/MIS-CITAS-03.png", style="width: 100%;padding:10px;")
                    .col-xs-3 
                        a(href=url_base+"doctores/all",style="color:#fff;")
                            img(src=url_base+"images/iconos/MEDICOS-03.png", style="width: 100%;padding:10px;")
            .menuList        
                ul
                    li#promociones
                        a(href=url_base+"promociones") 
                            .row
                                .col-md-12
                                    img#promociones-img.nav-icon(src=url_base+"images/iconos/PROMOCIONES-02.png" alt="") 
                                    span Promociones
                    li#medicos
                        a(href=url_base+"doctores/all")
                            .row
                                .col-md-12
                                    img#medicos-img.nav-icon( src=url_base+"images/iconos/MEDICOS.png" alt="")
                                    span Staff Médico
                    li#sedes
                        a(href=url_base+"sedes")
                            .row
                                .col-md-12
                                    img#sedes-img.nav-icon( src=url_base+"images/iconos/SEDES.png" alt="")
                                    span Sedes Concebir
                    li#productos
                        a(href=url_base+"catalogo")
                            .row
                                .col-md-12
                                    img#sedes-img.nav-icon( src=url_base+"images/iconos/SEDES.png" alt="")
                                    span Catalogo
                    li#productos
                        a(href=url_base+"servicios")
                            .row
                                .col-md-12
                                    img#sedes-img.nav-icon( src=url_base+"images/iconos/MIS-CITAS.png" alt="")
                                    span Servicios
                    li#citas
                        a(href=url_base+"miscitas")
                            .row
                                .col-md-12
                                    img#citas-img.nav-icon(src=url_base+"images/iconos/MIS-CITAS.png" alt="")
                                    span Mis citas
                    li#ajustes
                        a(href=url_base+"configuracion")
                            .row
                                .col-md-12
                                    img#ajustes-img.nav-icon(src=url_base+"images/iconos/AJUSTES.png" alt="")
                                    span Configuraciones
                ul.ul-bottom
                    li
                        a#logout(href=url_base+"cerrarSesion")
                            i.nav-icon.fas.fa-sign-out-alt
                            span Salir
                    .icon-bottom-responsive
                        a(href="https://facebook.com/concebirperu" target="_blank")
                            img.social-buttons(src=url_base+"images/iconos/facebook.png" alt="")
                        a(href="https://www.instagram.com/concebir_peru/" target="_blank")
                            img.social-buttons(src=url_base+"images/iconos/instagram.png" alt="")

    .flex-section
        include ../includes/menu-lateral
        div.container-body
            block contenido