-var url_base="/"
doctype html
html
    head
        meta(charset="utf-8")
        title Inkalandia
        meta(name="viewport" content="initial-scale=1, maximum-scale=1")
        <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap" rel="stylesheet">
 
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/css/bootstrap.min.css">
        link(rel="stylesheet" href=url_base+"css/stylesMenu.css")
        link(rel="stylesheet" href=url_base+"css/stylesRegister.css")
        link(rel='stylesheet' href=url_base+"css/bootstrap-iconpicker.css")
        //- link(rel="stylesheet" href=url_base+"css/dropzone.css")
        link(rel='stylesheet' href=url_base+"css/intlTelInput.css")
 
        <script crossorigin="anonymous"  src="https://code.jquery.com/jquery-3.5.0.js"></script>
        <script crossorigin="anonymous"  src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/js/bootstrap.bundle.min.js"></script>
        <script crossorigin="anonymous"  src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>
        <script crossorigin="anonymous"  src="/js/scriptMenu.js"></script>
        <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.3/css/all.css" integrity="sha384-UHRtZLI+pbxtHCWp1t77Bi1L4ZtiqrqD80Kn4Z8NTSRyMA2Fd33n5dQ8lWUE00s/" crossorigin="anonymous">
         
        script(src=url_base+"js/intlTelInput.js")
        

        header
            div.header-top
              div.container
                div.row
                    div.col-md-5.col-sm-12.right_info
                        p
                            i.fa.fa-map-marker
                            |  Dirección / Perú
                    div.col-md-7.col-sm-12.left_info
                        ul
                            li
                            i.fa.fa-mobile-alt
                            a(href='tel:555555') +52 4454 5644
                            li
                            i.fa.fa-envelope(aria-hidden='true')
                            a(href='mailto:contacto@inkalandia.com') contacto@inkalandia.com
            div.header-main
              div.container
                nav#cssmenu
                    div.logo
                        a(href='/')
                            img(src=url_base+'images/logo-inkalandia.jpg')
                    div#head-mobile
                    div.button
                    ul
                       
                        li
                            a(href='#') Nosotros
                            ul
                                li
                                    a(href='#') Servicios

                        li
                            a(href='/') Iniciar Sesión
                        li.active
                            a(href='#') Comprar
        body
            block content
