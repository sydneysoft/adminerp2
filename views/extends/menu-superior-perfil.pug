extends ../extends/doctype
block content
    .navigator
        .cont.content.left
            a(href=url_base+"admin-reservas")
                img.concebir-logo(src=url_base+"images/concebir.png", alt="Concebir logo")
        .cont.content-right
            
            div.nodisplay.btnAbrir(style="cursor:pointer;position:relative;")
                div.text-center
                    img.nav-icon-alt.icon__.logout(src="http://ssl.gstatic.com/s2/oz/images/sge/grey_silhouette.png", style="width: 60px;border-radius:50%;")
                div.campoAdmin(style="position:absolute;background:#fff;width:300px;top:60px;right:1px;border-radius:10px;box-shadow:0 2px 5px rgb(0 0 0 / 50%);z-index:999;display:none;")
                    div(style="padding:10px 0;")
                        .row(style="margin:0;")
                            .col-md-12 
                                .text-center(style="padding-bottom:20px;")
                                    img(src="http://ssl.gstatic.com/s2/oz/images/sge/grey_silhouette.png", style="width: 80px;border-radius:50%;margin:10px 0;")
                                    h4(style="color:#202124;margin-bottom:5px;")=aqui
                                    h5(style="margin:0;margin-bottom:20px;") usuario
                                    a(href=url_base+"usuario/"+token, class="btnAdministrar", style="color:#3c4043;text-decoration: none;") Administrar Cuenta
                            .col-md-12(style="border-top:1px solid #e8eaed;")
                                .text-center(style="padding:20px 0 10px;")
                                    a(href=url_base+"cerrarsesion", class="btnSalir", style="color:#3c4043;text-decoration: none;") Salir
                    
            a.bar-menu
                i.fas.fa-bars.icon__.float-right(style="margin-right: 18px;margin-bottom:5px;")
            a.bar-close(style="display:none;")
                i.fas.fa-bars.icon__.float-right(style="margin-right: 18px;margin-bottom:5px;")
    
    script
        include script.js

    .contDesplegable(style="display:none;")
        .nav-header(style="width:100%;height:100vh;z-index:1000;")
            
            .menuList(style="height:100vh;overflow-y:scroll;")     
                ul
                    li(style="padding: 10px 0;")
                        a(href=url_base+"admin-perfil")
                            .row
                                .col-md-12
                                    i.nav-icon.fas.fa-user-md
                                    span Home
                    li(style="padding: 10px 0;")
                        a(href=url_base+"admin-perfil-informacion") 
                            .row
                                .col-md-12
                                    i.nav-icon.fas.fa-user-md
                                    span Información Personal
                    li(style="padding: 10px 0;")
                        a(href=url_base+"admin-perfil-seguridad") 
                            .row
                                .col-md-12
                                    i.nav-icon.fas.fa-user-md
                                    span Seguridad
                    li(style="padding: 10px 0;")
                        a(href=url_base+"admin-perfil-estadisticas") 
                            .row
                                .col-md-12
                                    i.nav-icon.fas.fa-user-md
                                    span Estadisticas 
                    li(style="padding: 10px 0;")
                        a(href=url_base+"pagos-perfil-pagos") 
                            .row
                                .col-md-12
                                    i.nav-icon.fas.fa-user-md
                                    span Pagos y suscripciones
                    li(style="padding: 10px 0;")
                        a#logout(href=url_base)
                            .row
                                .col-md-12
                                    i.nav-icon.fas.fa-sign-out-alt
                                    span Salir

    .flex-section
        include ../includes/menu-lateral-perfil
        div.container-body
            block contenido