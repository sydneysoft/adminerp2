    .modal#galeriaEditProducto(tabindex="-1" role="dialog")
        .modal-dialog.modal-lg(role="document")
            .modal-content
                .modal-body
                    input#data-id-product(type="hidden")
                    div.mb-3(style="display:flex;justify-content:center;align-items:center")
                        button.btn.btn-info(onClick="multimediaModalEdit()")="Agregar Más Fotos"
                    .row#imagesAll(style="padding:15px;")
                .modal-footer 
                    button.btn.btn-success(onClick="updateDataGalery()")="Actualizar Galería"
                    button.btn.btn-danger(data-dismiss="modal")="Cancelar"
    .modal#SelectImageFrameEdit(tabindex="-1" role="dialog")
        .modal-dialog.modal-lg(role="document")
            .modal-content
                .modal-body
                    div(class='row',style='padding:8px;')
                        div(class='col-md-12')
                            div#dataRowListMultimediaEditar(class='row m-0 mt-4')
                            div#loadingDataAjaxEditar(class='row m-0 mt-4 ajaxLoading')
                                img(class="image-loader" src="https://ceisantagema.com/wp-content/plugins/gallery-by-supsystic/src/GridGallery/Galleries/assets/img/loading.gif")
                            div(style="width:100%;display:flex;justify-content:center;align-items:center")
