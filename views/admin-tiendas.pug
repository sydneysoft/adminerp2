                            div#dataRowListMultimedia(class='row m-0 mt-4')
                            div#loadingDataAjax(class='row m-0 mt-4 ajaxLoading')
                                img(class="image-loader" src="https://ceisantagema.com/wp-content/plugins/gallery-by-supsystic/src/GridGallery/Galleries/assets/img/loading.gif")
                            div(style="width:100%;display:flex;justify-content:center;align-items:center")
                                div(id="data-paginate-images" data-take='16')
                .modal-footer 
                    button.btn.btn-success(disabled id="choice-image-banner",data-dismiss="modal")="Seleccionar Imágenes"
                    button.btn.btn-danger(data-dismiss="modal")="Cancelar"
