        var typeUpdate=1;
        var arrayImagesNew=[];
        var typeAction=1;
        CKEDITOR.replace('ckeditorarea');
        CKEDITOR.replace('ckeditorareaEditar');
        getMultimediaInitialMultiple();
        $(document).ready( function () {
            $('#tabla-tiendas').DataTable({
                "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"}
            });
        });
        var typeOperation="1";
        getQuantityImagesProduct();
