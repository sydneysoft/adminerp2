extends extends/menu-superior-admin
block contenido
    .row
        .col-12.text-grey(style="margin-bottom:10px;")
            h1.display-1
                strong #{translation.FORM.STORE_LIST}
        .col-12
                button.btn.btn-success(type="button", onClick="openNewHandleModalTienda()")
                    i.fas-fa-plus
                    span #{translation.ADD_STORE}
        .col-12(style="margin-top: 20px;")
            div.table-responsive
                table#tabla-tiendas.table.table-bordered
                    thead.thead-dark
                        tr.table-head
                            th.text-center #{translation.FORM.NAME}
                            th.text-center #{translation.FORM.SCHEDULE}
                            th.text-center #{translation.FORM.IMAGE}
                            th.text-center #{translation.FORM.USER}
                            th.text-center
                    tbody
                        each book in bookStore
                            tr
                                td.text-centera=book.nombre
                                td.text-center=book.horario
                                td.text-center
                                    img(src=book.imagen,style="width:50px;height:50px;object-fit:cover")
                                td.text-center=book.nombre_usuario
                                td.text-center
                                    button.btn.btn-warning(onclick="handleTiendaAdmin('"+book.id+"')")
                                        i.fa.fa-edit
                                    button.btn.btn-danger(type="button" onclick="deleteTiendasAdminPanel('"+book.id+"')",style="margin-left:8px")
                                        i.fa.fa-trash
                                          
    .modal#nuevoTiendaAdmin(tabindex="-1" role="dialog")
        .modal-dialog.modal-lg(role="document")
            .modal-content
                .modal-body
                    .row(style="padding:15px;")
                        .col-md-12.col-12
                            .form-group(style="display:flex;justify-content:center;align-items:center;")
                                img(id="imagen-data-banner" src="https://www.cuba.travel/images/noimage.png" class="imagen-data-producto" onClick="handleModalMultimediaSingle()")
                        .col-md-4.col-12
                            .form-group
                                label #{translation.FORM.NAME}
                                .controls
                                    input#nombreNuevo-tienda-admin.form-control(type="text")
                        .col-md-4.col-12
                            .form-group
                                label #{translation.FORM.USER}
                                .controls
                                    input#usuarioNuevo-tienda-admin.form-control(type="text")
                        .col-md-4.col-12
                            .form-group
                                label #{translation.FORM.PASSWORD}
                                .controls
                                    input#passwordNuevo-tienda-admin.form-control(type="password")
                        .col-md-4.col-12
                            .form-group
                                label #{translation.FORM.SITE_WEB}
                                .controls
                                    input#websiteNuevo-tienda-admin.form-control(type="text")
                        .col-md-4.col-12
                            .form-group
                                label Facebook
                                .controls
                                    input#facebookNuevo-tienda-admin.form-control(type="text")
                        .col-md-4.col-12
                            .form-group
                                label Instagram
                                .controls
                                    input#instagramNuevo-tienda-admin.form-control(type="text")
                        .col-md-4.col-12
                            .form-group
                                label Twitter
                                .controls
                                    input#twitterNuevo-tienda-admin.form-control(type="text")
                        .col-md-4.col-12
                            .form-group
                                label TikTok
                                .controls
                                    input#tiktokNuevo-tienda-admin.form-control(type="text")
                        .col-md-4.col-12
                            .form-group
                                label Whatsapp
                                .controls
                                    input#whatsappNuevo-tienda-admin.form-control(type="number")
                        .col-md-4.col-12
                            .form-group
                                label #{translation.FORM.PHONE}
                                .controls
                                    input#telefonoNuevo-tienda-admin.form-control(type="number")
                        .col-md-4.col-12
                            .form-group
                                label #{translation.FORM.MOBILE}
                                .controls
                                    input#telefonoNuevo-tienda-admin.form-control(type="number")
                        .col-md-4.col-12
                            .form-group
                                label #{translation.FORM.BUSINESS_PHONE}
                                .controls
                                    input#telefonoEmpresaNuevo-tienda-admin.form-control(type="number")
                        .col-md-4.col-12
                            .form-group
                                label #{translation.FORM.EMAIL}
                                .controls
                                    input#correoNuevo-tienda-admin.form-control(type="text")
                        .col-md-4.col-12
                            .form-group
                                label #{translation.FORM.STATE}
                                .controls
                                    select#statusNuevo-tienda-admin.form-control
                                        option(value="1") #{translation.FORM.ACTIVE}
                                        option(value="0") #{translation.FORM.DEACTIVATED}
                        .col-md-4.col-12
                            .form-group
                                label #{translation.FORM.ACTIVE}
                                .controls
                                    select#activadoNuevo-tienda-admin.form-control
                                        option(value="1") #{translation.FORM.YES}
                                        option(value="0") #{translation.FORM.NO}
                        .col-md-4.col-12
                            .form-group
                                label #{translation.FORM.SCHEDULE}
                                .controls
                                    input#horarioNuevo-tienda-admin.form-control(type="text")
                        .col-md-4.col-12
                            .form-group
                                label #{translation.FORM.ADDRESS}
                                .controls
                                    input#direccionNuevo-tienda-admin.form-control(type="text")
                        .col-md-4.col-12
                            .form-group
                                label #{translation.FORM.COORDENATES}
                                .controls
                                    input#coordenadasNuevo-tienda-admin.form-control(type="text")                  
                        .col-12 
                            .form-group
                                label #{translation.FORM.DESCRIPTION}
                                textarea#ckeditorarea(name="ckeditorarea")
                .modal-footer      
                    button.btn.btn-success.nuevo(type="button", style="margin-left:7px;margin-right:7px;",onClick="addTiendaAdmin()") #{translation.ADD}
                    button.btn.btn-danger(type="buton", data-dismiss="modal") #{translation.CLOSE}
    .modal#SelectImageFrame(tabindex="-1" role="dialog")
        .modal-dialog.modal-lg(role="document")
            .modal-content
                .modal-body
                    div(class='row',style='padding:8px;')
                        div(class='col-md-12')
                            input#selected-img-data-editar(type="hidden")
