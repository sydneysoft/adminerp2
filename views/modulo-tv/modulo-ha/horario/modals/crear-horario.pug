//- Modal para crear una nuevo faq
.modal.fade(role="dialog" id="saveModalHorario")
  .modal-dialog
    .modal-content.modalContent(style="height: 100%;")
      .modal-header 
        .row(style="margin:0;")
          .col-md-12
            h3(style="margin:0px 0;") #{translation.ADD}

      .modal-body.borderBottom
        .row 
          .col-12
            .form-group
              label.text-label(for='nombre') #{translation.FORM.NAME}
              input#nombre.form-control(value="" placeholder=translation.FORM.NAME name='nombre')
            .form-group.mt-3
              label.text-label(for='descripcion') #{translation.FORM.DESCRIPTION}
              textarea#descripcion.form-control(placeholder=translation.FORM.DESCRIPTION name='descripcion')
          .col-6
            .form-group.mt-3
              label.text-label(for="diaDe") De
              select#diaDe.form-control(name="diaDe")
                option(value="1") #{translation.DAYS.MONDAY}
                option(value="2") #{translation.DAYS.TUESDAY}
                option(value="3") #{translation.DAYS.WEDNESDAY}
                option(value="4") #{translation.DAYS.THURSDAY}
                option(value="5") #{translation.DAYS.FRIDAY}
                option(value="6") #{translation.DAYS.SATURDAY}
                option(value="0") #{translation.DAYS.SUNDAY}
          .col-6
            .form-group.mt-3
              label.text-label(for="diaA") A
              select#diaA.form-control(name="diaA")
                option(value="1") #{translation.DAYS.MONDAY}
                option(value="2") #{translation.DAYS.TUESDAY}
                option(value="3") #{translation.DAYS.WEDNESDAY}
                option(value="4") #{translation.DAYS.THURSDAY}
                option(value="5") #{translation.DAYS.FRIDAY}
                option(value="6") #{translation.DAYS.SATURDAY}
                option(value="0") #{translation.DAYS.SUNDAY}
          .col-6
            .form-group
              label.text-label(for='horaDe') #{translation.FROM}
              input#horaDe.form-control(value='' type='time')
          .col-6
            .form-group
              label.text-label(for='horaA') #{translation.TO}
              input#horaA.form-control(value='' type='time')

      .modal-footer(style="padding:8px;")
        .row(style="margin:0;")
          .col-md-12.text-right
            button#saveItem.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.ADD}
              i.fas.fa-plus.ml-3
            button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
