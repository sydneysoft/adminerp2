script.
  let tablaServicio = null;
  addEventListener('DOMContentLoaded', () => {
    let urlAjax = '/admin-ceservicios/datatable';
    if(empresa_id.value != '') {
      urlAjax = `/admin-ceservicios/datatable/${empresa_id.value}`;
    }
    tablaServicio = $('#dataTable').DataTable({
      fnCreatedRow: function (nRow, aData, iDataIndex) {
        $(nRow).attr('id', `delete${aData.ID}`);
      },
      ajax: urlAjax,
      type: 'POST',
      processing: true,
      serverSide: true,
      searchDelay: 100,
      columns: [
        { 
          data: "id",
          name: 'id',
          title: 'ID',
          orderable: false,
          searchable: false,
          visible: false
        },
        { 
          data: "nombre",
          name: 'nombre',
          title: "#{translation.NAME}",
          orderable: true,
          searchable: true
        },
        {
          data: "icono", 
          name: "icono",
          title: "#{translation.ICON}",
          render: function (data, type, row) {
            return `<i class="${data}"></i>`;
          },
          orderable: false,
          searchable: false
        },
        {
          data: "icono_imagen", 
          name: "icono_imagen",
          title: "#{translation.ICON_IMAGE}",
          render: function (data, type, row) {
            return `<i class="${data}"></i>`
          },
          orderable: false,
          searchable: false
        },
        {
          data: "imagen",
          name: "imagen",
          title: "#{translation.IMAGE}",
          render: function (data, type, row) {
            try {
              new URL(data);
              return `<img src="${data}" width="50" height="50" />`;
            } catch (error) {
              return `<img src="/images/image-default.jpg" width="50" height="50" />`
            }
          },
          orderable: false,
          searchable: false
        },
        {
          data: "acciones",
          name: "acciones",
          title: "#{translation.ACTIONS}",
          render: function (data, type, row) {
            return `
              <div class="btn-group" role="group" aria-label="Actions buttons">
                <a class="btn btn-primary btn-sm" href="/admin-ceservicios/servicio/editar/${row.id}"><i class="fas fa-pen"></i></a>
                <a class="btn btn-info btn-sm" href="/admin-ceservicios/servicio/${row.id}"><i class="fas fa-eye"></i></a>
                <a class="btn btn-danger btn-sm" onClick="beforeDeleteItem('/admin-ceservicios/servicios/${row.id}', borrarRowDataTable)"><i class="fas fa-trash"></i></a>
              </div>
            `;
          },
          orderable: false,
          searchable: false
        }
      ],
    });
  });
  function borrarRowDataTable(data) {
    tablaServicio.row($(`#${data.target}`)).remove().draw();
  }