.modal.fade(tabindex="-1" role="dialog" id="nuevaCita")
  .modal-dialog.modal-lg
    .modal-content.modalContent
      .modal-header 
        .row(style="margin:0;")
          .col-md-12
            h3(style="margin:0px 0;") #{translation.ADD}

      .modal-body.borderBottom
        .row 
          .col-12.col-md-6 
            .form-group
              label(for="nombre") #{translation.FULLNAME}
              input#nombre.form-control(type="text" name="nombre" placeholder=`${translation.FULLNAME}`) 
          .col-12.col-md-6 
            .form-group 
              label(for="email") #{translation.EMAIL}
              input#email.form-control(type="email" name="email" placeholder=`${translation.EMAIL}`)
          .col-12.col-md-6 
            .form-group 
              label(for="telefono") #{translation.CELULAR}
              input#telefono.form-control(type="text" name="telefono" placeholder=`${translation.CELULAR}`)
          .col-12.col-md-6
            .form-group 
              //- Crear checkbox para escoger color
              label(for="color") #{translation.COLOR}
              input#color.form-control(type="color" name="color" placeholder=`${translation.COLOR}` value="#007bff")
        .row 
          .col-12.col-md-6
            .form-group 
              label(form="start") #{translation.STARTDATE} 
              input#start.form-control(type="datetime-local" name="start")
          .col-12.col-md-6
            .form-group 
              label(form="end") #{translation.ENDDATE}
              input#end.form-control(type="datetime-local" name="end")

      .modal-footer(style="padding:8px;")
        .row(style="margin:0;")
          .col-md-12.text-right
            button#addNewCita.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.ADD}
              i.fas.fa-plus
            button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CANCEL}
              i.fas.fa-times
