extends ../layout.pug

append contenido 
  .border-bottom.border-left.border-right.rounded-bottom.p-3
    .my-3.row.justify-content-between 
      .col 
        button.btn.btn-info(type='button' onclick="window.history.back()") #{translation.BACK}
      .col.text-right
        button#guardarItem.btn.btn-primary(type='submit') #{translation.SAVE}
    .my-3 
        .row 
          input#empresa_id(type="text" value=empresa_id hidden)
          .col-12.col-md-8 
            .form-group
              label(for='nombre') #{translation.NAME} *
              input#nombre.form-control(type='text' placeholder="Nombre" name="nombre" required)
          .col-12.col-md-4 
            .form-group 
              label(for='identificador') #{translation.IDENTIFIER}
              select#identificador.form-control(name="identificador")
                option(value="post" selected) #{translation.POST}
                option(value="contacto") #{translation.CONTACT}
                option(value="nosotros") #{translation.ABOUT}
                option(value="faqs") #{translation.FAQS}
                option(value="politica") #{translation.PRIVACY}
                option(value="cookie") #{translation.COOKIES}
                option(value="mision") #{translation.MISSION}
        .row 
          .col-12.col-md-8 
            .form-group 
              label(for='estracto') #{translation.EXCERPT}
              textarea#estracto.form-control(name="estracto" placeholder=`${translation.EXCERPT}` )
            
        .row 
          .col-12.col-md-8
            .form-group 
              label(for='body') #{translation.BODY}
              textarea#body(name="body" placeholder=`${translation.BODY}`)
          .col-12.col-md-4 
            .row
              .col-12
                include ../../modulo-general/galeria-fotos/modal-galeria.pug
            .row
              .col-12 
                .p-3.border.rounded-lg
                  h4.text-center #{translation.ADD} #{translation.SECTIONS}
                  .row 
                    .col-12 
                      button#nuevaSeccion.btn.btn-primary.btn-block(type='button')
                        i.fa.fa-plus
                  #showSections.mt-3 
                    

    include ../../modulo-general/galeria-fotos/partial-modal-galeria.pug      
  script.
    const editor = CKEDITOR.replace('body', {
      height: 800
    })   

  .modal.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="nuevaSeccionModal")
    .modal-dialog.modal-lg
        .modal-content.modalContent(style="height: 100%;")
            .modal-header 
                .row(style="margin:0;")
                    .col-md-12.text-center
                        h3(style="margin:0px 0;") #{translation.ADD} #{translation.SECTION}

            .modal-body.borderBottom
              .row 
                .col-12.col-md-4
                  .row 
                    .col-12 
                      label(for='identificadorSection') #{translation.IDENTIFIER}
                      select#identificadorSection.form-control(name="identificadorSection")
                        option(value="vacio") #{translation.SELECT_SOMETHING}
                        option(value="formulario_contactos") #{translation.CONTACT_FORM}
              .row.mt 
                .col-12 
                  #showSelected.p-3
             
            .modal-footer(style="padding:8px;")
                .row(style="margin:0;")
                    .col-md-12.text-right
                        button#guardarSeccion.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.ADD}
                        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
  script.
    const nombre = document.getElementById('nombre');
    const imagen = document.getElementById('imagen');
    const estracto = document.getElementById('estracto');
    const identificador = document.getElementById('identificador');

    const clearForm = () => {
      nombre.value = '';
      imagen.value = '';
      estracto.value = '';
      identificador.value = 'post';
      editor.setData('', '')// <-- CKEDITOR
    };

    function clearImage() {
      // imagen.value = document.getElementById('urlImagen').value;
      $(".imagen_").empty();
      clearForm();
    };
  script
    include ../../../js/modulo-tv/save.js
    include ../../modulo-general/galeria-fotos/modal-galeria.js

  script.
    let formulario_contactos = [];
  if Array.isArray(formulario_contactos) && formulario_contactos.length > 0
    script.
      formulario_contactos = !{JSON.stringify(formulario_contactos[0])};
      formulario_contactos.campos = JSON.parse(formulario_contactos.campos);
  script.
    const nuevaSeccion = document.getElementById('nuevaSeccion');

    console.log(formulario_contactos);

    const guardarSeccion = document.getElementById('guardarSeccion');
    const showSections = document.getElementById('showSections');
    const identificadorSection = document.getElementById('identificadorSection');
    const showSelected = document.getElementById('showSelected');

    identificadorSection.addEventListener('change', (event) => {
      switch (event.target.value) {
        case 'formulario_contactos':
          //- #{translation.ERROR_CONTACT_FORM}
          showSelected.innerHTML = '';
          contactFormRender();
          break;
      }
    });

    function contactFormRender() {
      //- let html = '';
      if (Array.isArray(formulario_contactos.campos) && formulario_contactos.campos.length > 0) {
        let cardDiv = document.createElement('div');
        cardDiv.setAttribute('class', 'card');
        let cardBody = document.createElement('div');
        cardBody.setAttribute('class', 'card-body');
        let h3 = document.createElement('h3');
        h3.setAttribute('class', 'card-title');
        h3.innerHTML = formulario_contactos.nombre;
        let paragraph = document.createElement('p');
        paragraph.setAttribute('class', 'card-text');
        paragraph.innerHTML = formulario_contactos.descripcion;
        cardBody.appendChild(h3);
        cardBody.appendChild(paragraph);
        formulario_contactos.campos.forEach((valor, index) => {
          if (valor.type == 'checkbox') {
            let div = document.createElement('div');
            div.setAttribute('class', 'form-group form-check');
            let el = document.createElement(valor.el);
            el.setAttribute('type', valor.type);
            el.setAttribute('placeholder', valor.placeholder);
            el.setAttribute('name', valor.name);
            el.setAttribute('class', 'form-check-input');
            el.setAttribute('id', valor.name);
            el.setAttribute('disabled', true);
            let label = document.createElement('label');
            label.setAttribute('for', valor.name);
            label.setAttribute('class', 'form-check-label');
            label.innerHTML = valor.placeholder;
            div.appendChild(el);
            div.appendChild(label);
            cardBody.appendChild(div);
            return;
          }
          let div = document.createElement('div');
          div.setAttribute('class', 'form-group');
          let label = document.createElement('label');
          label.setAttribute('for', valor.name);
          label.innerHTML = valor.placeholder;
          let el = document.createElement(valor.el);
          el.setAttribute('type', valor.type);
          el.setAttribute('placeholder', valor.placeholder);
          el.setAttribute('name', valor.name);
          el.setAttribute('class', 'form-control');
          el.setAttribute('id', valor.name);
          el.setAttribute('readonly', 'readonly');
          div.appendChild(label);
          div.appendChild(el);
          cardBody.appendChild(div);
        });
        cardDiv.appendChild(cardBody);
        showSelected.appendChild(cardDiv);
      } else {
        html = `
          <div class="alert alert-danger" role="alert">
            #{translation.ERROR_CONTACT_FORM}
          </div>
        `
        showSelected.innerHTML = html;
      }
    }

    guardarSeccion.addEventListener('click', (event) => {
      let position = sectionsPayload.length + 1;
      let identificador = identificadorSection.options[identificadorSection.selectedIndex].text;
      let identificadorValue = identificadorSection.options[identificadorSection.selectedIndex].value;
      if (identificadorValue == 'vacio') {
        sectionEmpty();
        return;
      }
      //no insertar si ya existe
      let existe = false;
      sectionsPayload.forEach((section) => {
        if (section.identificadorValue == identificadorValue) {
          existe = true;
        }
      });
      if (existe) {
        sectionExistAlert();
        return;
      }
      sectionsPayload.push({
        position,
        identificador,
        identificadorValue
      });
      renderSections();
      $('#nuevaSeccionModal').modal('hide');
    });

    function renderSections () {
      showSections.innerHTML = '';
      sectionsPayload.forEach((section, index) => {
        const div = document.createElement('div');
        div.classList.add('alert', 'alert-success', 'alert-dismissible', 'fade', 'show');
        div.setAttribute('role', 'alert');
        div.setAttribute('data-index', index);
        div.innerHTML = `
          <strong>${section.position}</strong> - ${section.identificador}
          <button type="button" class="close" data-dismiss="alert" aria-label="Close" onclick="deleteSectionPayload(this)">
            <span aria-hidden="true">
              <i class="fa fa-times"></i>
            </span>
          </button>
        `;
        showSections.appendChild(div);
      });
    }

    nuevaSeccion.addEventListener('click', () =>{ 
      $('#nuevaSeccionModal').modal('show');
    });
    let sectionsPayload = [];

    document.getElementById('guardarItem').addEventListener('click', (event) => {
      if (nombre.value !== '') {
        const empresa_id = document.getElementById('empresa_id');
        save('/admin-paginas/paginas', {
          nombre: nombre.value,
          imagen: imagen.value,
          estracto: estracto.value,
          identificador: identificador.value,
          body: editor.getData(),
          campos: JSON.stringify(sectionsPayload),
          empresa_id: empresa_id.value
        }, clearImage);
        sectionsPayload = [];
        renderSections();
      } else {
        Swal.fire({
          icon: 'error',
          title: 'Oops...',
          text: 'El nombre es requerido',
        });
      }
    });

    function deleteSectionPayload (e) {
      const index = e.parentNode.getAttribute('data-index');
      sectionsPayload.splice(index, 1);
      renderSections();
    }

    function sectionExistAlert () {
      Swal.fire({
        toast: true,
        position: 'top-end',
        icon: 'error',
        title: #{translation.SECTION_EXISTS},
        showConfirmButton: false,
        timer: 2000
      })
    }

    function sectionEmpty () {
      Swal.fire({
        toast: true,
        position: 'top-end',
        icon: 'error',
        title: #{translation.ERROR_SELECT_SECTION},
        showConfirmButton: false,
        timer: 2000
      })
    }