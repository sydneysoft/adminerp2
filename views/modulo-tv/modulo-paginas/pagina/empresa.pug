extends ../layout.pug

append contenido 
  .border-bottom.border-left.border-right.rounded-bottom.p-3
    .row 
      .col-12.text-left 
        button.btn.btn-info(type="button" onclick="window.history.back()") #{translation.BACK}
    .my-3 
      a.btn.btn-primary.btn-lg.btn-block(type='button' href=`/admin-paginas/empresa/${empresa_id}/crear`) #{translation.BACK}
      .my-3.table-responsive   
        table#dataTable.table.rounded-lg.overflow-hidden
          thead.thead-dark
            tr
              th(scope='col') ID
              th(scope='col') #{translation.NAME}
              th(scope='col') #{translation.EXCERPT}
              th(scope='col') #{translation.ACTIONS}
          tbody
            if Array.isArray(data) && data.length > 0
              each item in data 
                tr
                  th(scope='row') #{item.id}
                  td #{item.nombre}
                  td #{item.estracto}
                  td 
                    .btn-group(role='group' aria-label='Basic example')
                      a.btn.btn-primary(type='button' href=`/admin-paginas/pagina/editar/${item.id}`)
                        i.fas.fa-pen(aria-hidden='true')
                      a.btn.btn-info(type='button' href=`/admin-paginas/pagina/${item.id}`)
                        i.fas.fa-eye(aria-hidden='true')
                      a.btn.btn-danger(type='button' onClick=`beforeDeleteItem('/admin-paginas/paginas/${item.id}', eliminarRowTable)`)
                        i.fas.fa-trash(aria-hidden='true')
  script 
    include ../../../js/modulo-tv/delete.js
  script.
    let tablaPagina;
    $(document).ready( function () {
      tablaPagina = $('#dataTable').DataTable({
        fnCreatedRow: function (nRow, aData, iDataIndex) {
          $(nRow).attr('id', `delete${aData.ID}`);
        },
        columns: [
          { data: 'ID' },
          { data: 'nombre', name: 'nombre', title: '#{translation.NAME}' },
          { data: 'estracto', name: 'estracto', title: '#{translation.EXCERPT}' },
          { 
            data: 'acciones', name: 'acciones', title: '#{translation.ACTIONS}
          }
        ]
      });
    });
    function eliminarRowTable(data) {
      tablaPagina.row($(`#${data.target}`)).remove().draw();
    }