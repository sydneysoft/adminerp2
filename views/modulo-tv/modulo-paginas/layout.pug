extends ../../extends/menu-superior-admin

block contenido
  h1 #{translation.PAGES}
  ul.nav.nav-tabs
    li.nav-item
      a.nav-link(href='/admin-paginas') #{translation.PAGES}
    li.nav-item
      a.nav-link(href='/admin-paginas/pasos') #{translation.STEPS}
    li.nav-item
      a.nav-link(href='/admin-paginas/nosotros') #{translation.ABOUT}
    li.nav-item
      a.nav-link(href='/admin-paginas/politica') #{translation.PRIVACY}
    li.nav-item
      a.nav-link(href='/admin-paginas/cookie') #{translation.COOKIES}
    li.nav-item
      a.nav-link(href='/admin-paginas/mision') #{translation.MISSION}
    li.nat-item
      a.nav-link(href='/admin-paginas/contacto') #{translation.CONTACT}

  script.
      const currentPath = window.location.pathname
      const navLinks = $(".nav .nav-link");
      $.each(navLinks, function (index, value) {
        if(currentPath.startsWith(value.getAttribute('href'))) {
          value.classList.toggle('active')
        }
      });
