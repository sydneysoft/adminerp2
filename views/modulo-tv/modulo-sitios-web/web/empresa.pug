extends ../layout.pug

append contenido 
  .border-bottom.border-left.border-right.p-3 
    .my-3.row
      .col.text-left 
        button.btn.btn-info(type="button" onclick="window.history.back();") #{translation.BACK}
      .col.text-right
        button#createWeb.btn.btn-primary(type='button' data-empresa=empresa_id) #{translation.SAVE}
    script.
      let faviconExist = null;
    if data && data.length === 1
      script.
        faviconExist = '#{data[0].favicon}';
      .row.mt-5.align-items-end
        .col-12.col-md-8 
          .form-group 
            input#idItem(type="text" value=data[0].id hidden)
            label.label-text(for="nombre") #{translation.FORM.NAME} *
            input#nombre.form-control(type="text" name="" placeholder #{translation.FORM.NAME} value=data[0].nombre)
        .col-12.col-md-4 
          include ../../modulo-general/galeria-fotos/favicon.pug
        .col-12.col-md-8 
          .form-group 
            label.label-text(for="nombre") #{translation.FORM.CELULAR_DESCRIPTION}
            input#descripcion_telefono.form-control(type="text" name="" placeholder=#{translation.FORM.CELULAR_DESCRIPTION} value=data[0].descripcion_telefono)
        .col-12.col-md-4
        .col-12.col-md-4 
          .form-group 
            label.label-text(for="telefono") #{translation.FORM.CELULAR}
            input#telefono.form-control(type="text" name="" placeholder #{translation.FORM.CELULAR} value=data[0].telefono)
        .col-12.col-md-4 
          .form-group 
            label.label-text(for="link_telefono") #{translation.FORM.CELULAR_LINK}
            input#link_telefono.form-control(type="text" name="" placeholder #{translation.FORM.CELULAR_LINK} value=data[0].link_telefono)
        .col-12.col-md-4 
          .form-group 
            label.label-text(for="tipo") #{translation.TYPE}
            select#tipo.form-control(name="tipo")
              if data[0].tipo_telefono == 'local'
                option(value="local" selected="true") #{translation.FORM.CELULAR}
              else 
                option(value="local") #{translation.FORM.PHONE}
              if data[0].tipo_telefono == 'whatsapp'
                option(value="whatsapp" selected="true") Whatsapp 
              else
                option(value="whatsapp") Whatsapp 
              if data[0].tipo_telefono == 'telegram'
                option(value="telegram" selected="true") Telegram
              else
                option(value="telegram") Telegram
        .col-12.col-md-6 
          .form-group 
            label.label-text(for="eslogan") #{translation.FORM.SLOGAN} *
            textarea#eslogan.form-control(name="", cols="30", rows="10" placeholder=translation.FORM.SLOGAN) #{data[0].eslogan}
        .col-12.col-md-6 
          label(for="logo") #{translation.FORM.LOGO}
          input#urlImagen(type="text" value=data[0].logo hidden)
          include ../../modulo-general/galeria-fotos/modal-galeria.pug
          include ../../modulo-general/galeria-fotos/partial-modal-galeria.pug

        script.
          const idItem = document.getElementById('idItem');
          document.getElementById('createWeb').addEventListener('click', (event) => {
              const empresa_id = event.target.getAttribute('data-empresa')
              beforeUpdate(idItem.value, empresa_id)
          });
          addEventListener('DOMContentLoaded', () => {
            imagen.value = document.getElementById('urlImagen').value;
            $(".imagen_").empty();
            if (imagen.value !== '') {
              $(".imagen_").append(`<img src="${imagen.value}" class="img-fluid" alt="Responsive image">`);
            }
          });
    else 
      .row 
        .col-12.col-md-8 
          .form-group 
            label.label-text(for="nombre") #{translation.FORM.NAME} *
            input#nombre.form-control(type="text" name="" placeholder=translation.FORM.NAME value="")
        .col-12.col-md-4 
        .col-12.col-md-8 
          .form-group 
            label.label-text(for="nombre") #{translation.FORM.CELULAR_DESCRIPTION}
            input#descripcion_telefono.form-control(type="text" name="" placeholder=translation.FORM.CELULAR_DESCRIPTION value="")
        .col-12.col-md-4
        .col-12.col-md-8 
          .form-group 
            label.label-text(for="telefono") #{translation.FORM.CELULAR}
            input#telefono.form-control(type="text" name="" placeholder=translation.FORM.CELULAR value="")
        .col-12.col-md-4 
          .form-group 
            label.label-text(for="tipo") #{translation.TYPE}
            select#tipo.form-control(name="tipo")
              option(value="local") #{translation.FORM.PHONE}
              option(value="whatsapp") Whatsapp 
              option(value="telegram") Telegram
        .col-12.col-md-6 
          .form-group 
            label.label-text(for="eslogan") #{translation.FORM.SLOGAN} *
            textarea#eslogan.form-control(name="", cols="30", rows="10" placeholder=translation.FORM.SLOGAN)
        .col-12.col-md-6 
          label(for="logo") #{translation.FORM.LOGO}
          include ../../modulo-general/galeria-fotos/modal-galeria.pug
          include ../../modulo-general/galeria-fotos/partial-modal-galeria.pug
        script.
          document.getElementById('createWeb').addEventListener('click', (event) => {
              const empresa_id = event.target.getAttribute('data-empresa')
              beforeSave(empresa_id)
          });
  script 
    include ../../../js/modulo-tv/template.js
    include ../../../js/modulo-tv/save.js
    include ../../../js/modulo-tv/update.js
    include ./web.js
    include ../../modulo-general/galeria-fotos/modal-galeria.js
  script.
    if (faviconExist) {
      favicon.value = faviconExist;
      showFavicon.innerHTML = `<img src="${faviconExist}" class="img-fluid" alt="Responsive image">`;
    }
    const nombre = document.getElementById('nombre');
    // const logo = document.getElementById('logo');
    const imagen = document.getElementById('imagen');
    const eslogan = document.getElementById('eslogan');
    const telefono = document.getElementById('telefono');
    const link_telefono = document.getElementById('link_telefono');
    const tipo_telefono = document.getElementById('tipo');
    const descripcion_telefono = document.getElementById('descripcion_telefono');

    const beforeUpdate = (id, empresa_id = 0) => {
    let data  = {
      nombre: nombre.value,
      logo: imagen.value,
      eslogan: eslogan.value,
      telefono: telefono.value,
      link_telefono: link_telefono.value,
      tipo_telefono: tipo_telefono.value,
      descripcion_telefono: descripcion_telefono.value,
      empresa_id
    }
    if (favicon) {
      data.favicon = favicon.value;
    }
    updateItem(`/admin-sitios-web/web/${id}`, data);
  };