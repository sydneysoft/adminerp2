extends ../layout.pug


append contenido 
  .my-3
    .d-grid
      a#aCrear.btn.btn-primary.btn-block(type='button' href="/admin-tv/pages/crear") #{translation.CREATE_NEW}
        span#span #{translation.CREATE_PAGES} 
  if data && data.length > 0
    .table-responsive
      table.table
        thead#headTable 
          tr 
            th ID 
            th #{translation.FORM.NAME}  
            th #{translation.FORM.TYPE}  
            th #{translation.FORM.ACTIONS}  
        tbody#programasTable 
          each item, key in data 
            tr 
              td #{item.id}
              td #{item.nombre}
              td #{item.tipo}
              td 
                .btn-group
                  a.btn.btn-primary(href=`/admin-tv/pages/edite/${item.id}`)
                    i.fas.fa-pen
                  a.btn.btn-info(href=`/admin-tv/pages/show/${item.id}`)
                    i.fas.fa-eye
                  button.btn.btn-danger(onclick=`beforeEliminarPagina(${item.id})`)
                    i.fas.fa-trash
 
  else 
    .alert.alert-primary(role='alert')
      | #{translation.ALERTS.NO_PAGES} 

  nav(aria-label='...')
    ul.pagination
      li.page-item
        a#prevPage.page-link #{translation.FORM.PREVIOUS} 
      li.page-item
        a#nextPage.page-link(href='#') #{translation.FORM.PREVIOUS}

  script 
    include ./delete.js
