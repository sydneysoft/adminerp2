extends ../layout.pug


append contenido 
  .my-3
    .d-grid
      a#aCrear.btn.btn-primary.btn-block(type='button' href="/admin-tv/services/crear") #{translation.CREATE_NEW} 
        span#spanCrear #{translation.SERVICE}
  if data && data.length > 0
    .table-responsive
      table.table
        thead#headTable 
          tr 
            th ID 
            th #{translation.NAME} 
            th #{translation.ICON} 
            th #{translation.ACTIONS} 
        tbody#programasTable 
          each item, key in data 
            tr 
              td #{item.id}
              td #{item.nombre}
              td #{item.icono}
              td 
                .btn-group
                  a.btn.btn-primary(href=`/admin-tv/services/edite/${item.id}`)
                    i.fas.fa-pen
                  a.btn.btn-info(href=`/admin-tv/services/show/${item.id}`)
                    i.fas.fa-eye
                  button.btn.btn-danger(onclick=`beforeEliminarService(${item.id})`)
                    i.fas.fa-trash
 
  else 
    .alert.alert-primary(role='alert')
      | #{translation.NO_SERVICES_YET}

  nav(aria-label='...')
    ul.pagination
      li.page-item
        a#prevPage.page-link #{translation.PREVIOUS}
      li.page-item
        a#nextPage.page-link(href='#') #{translation.NEXT}

  script 
    include ./delete.js
