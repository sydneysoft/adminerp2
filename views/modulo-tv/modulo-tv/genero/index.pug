extends ../layout.pug


append contenido 
  include ../../../mixins/btn/back.pug
  //- .my-3
  //-   .d-grid
  //-     a#aCrear.btn.btn-primary.btn-block(type='button' href="/admin-tv/generos/crear") Crear nueva 
  //-       span#spanCrear Genero
  .border-left.border-right.border-bottom.rounded-bottom.p-3
    .row
      .col-6.text-left
        +btn-back()
      .col-6.text-right
        button#nuevoItem.btn.btn-primary(type="text" data-toggle="modal" data-target="#crearItem") #{translation.CREATE}
          i.fas.fa-plus.ml-2
    .row.mt-3
      .col-12
        if empresa_id
          input#empresa_id(type="text" value=empresa_id hidden)
        else
          input#empresa_id(type="text" value="" hidden)     
        .table-responsive
          table#tabla.table
            thead.thead-dark
  //- Modal para agregar un nuevo genero
  .modal.fade.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="crearItem")
    .modal-dialog
        .modal-content.modalContent(style="height: 100%;")
            .modal-header 
                .row(style="margin:0;")
                    .col-md-12
                        h3(style="margin:0px 0;") #{translation.ADD}

            .modal-body.borderBottom
              .row
                .col-12
                  .row
                    .col-12 
                      .form-group
                        label(for="nombre")  #{translation.FORM.GENRE_NAME}
                        input#nombre.form-control(type="text" placeholder=translation.FORM.GENRE_NAME required)
                  .row.mt-3
                    .col-12
                      .form-group
                        label(for="estracto") #{translation.FORM.EXCERPT}
                        textarea#estracto.form-control(type="text" placeholder=translation.FORM.EXCERPT required)

            .modal-footer(style="padding:8px;")
                .row(style="margin:0;")
                    .col-md-12.text-right
                        button#agregarItem.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.ADD}
                          i.fas.fa-plus.ml-3
                        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
  
  //- Modal para editar un nuevo genero
  .modal.fade.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="editarItem")
    .modal-dialog
        .modal-content.modalContent(style="height: 100%;")
            .modal-header 
                .row(style="margin:0;")
                    .col-md-12
                        h3(style="margin:0px 0;") #{translation.ADD}

            .modal-body.borderBottom
              .row
                .col-12
                  .row
                    .col-12 
                      .form-group
                        label(for="nombre_editar")  #{translation.FORM.GENRE_NAME}
                        input#nombre_editar.form-control(type="text" placeholder=translation.FORM.GENRE_NAME required)
                  .row.mt-3
                    .col-12
                      .form-group
                        label(for="estracto_editar") #{translation.FORM.EXCERPT}
                        textarea#estracto_editar.form-control(type="text" placeholder #{translation.FORM.EXCERPT} required)
                  input#itemId(type="text" value="" hidden)
            .modal-footer(style="padding:8px;")
                .row(style="margin:0;")
                    .col-md-12.text-right
                        button#actualizarItem.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.ADD}
                          i.fas.fa-plus.ml-3
                        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
  
  //- Modal para mostrar un nuevo genero
  .modal.fade.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="mostrarItem")
    .modal-dialog
        .modal-content.modalContent(style="height: 100%;")
            .modal-header 
                .row(style="margin:0;")
                    .col-md-12
                        h3(style="margin:0px 0;") #{translation.ADD}

            .modal-body.borderBottom
              .row
                .col-12
                  .row
                    .col-12 
                      .form-group
                        label(for="nombre_mostrar")  #{translation.FORM.GENRE_NAME}
                        input#nombre_mostrar.form-control(type="text" placeholder=translation.FORM.GENRE_NAME required)
                  .row.mt-3
                    .col-12
                      .form-group
                        label(for="estracto_mostrar") #{translation.FORM.EXCERPT}
                        textarea#estracto_mostrar.form-control(type="text" placeholder=translation.FORM.EXCERPT required)

            .modal-footer(style="padding:8px;")
                .row(style="margin:0;")
                    .col-md-12.text-right
                        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
  
  script 
    include ../../../js/modulo-tv/save.js
    include ../../../js/modulo-tv/delete.js
    include ../../../js/modulo-tv/update.js
  script.
    const nombre = document.getElementById('nombre');
    const estracto = document.getElementById('estracto');

    const nombre_editar = document.getElementById('nombre_editar');
    const estracto_editar = document.getElementById('estracto_editar');

    const nombre_mostrar = document.getElementById('nombre_mostrar');
    const estracto_mostrar = document.getElementById('estracto_mostrar');

    const agregarItem = document.getElementById('agregarItem');
    const actualizarItem = document.getElementById('actualizarItem');
    const itemId = document.getElementById('itemId');

    let tabla;
    addEventListener('DOMContentLoaded', () => {
      let urlAjaxTabla = '/admin-tv/generos/datatable'
      if (empresa_id.value != '') {
        urlAjaxTabla = `/admin-tv/generos/datatable/${empresa_id.value}`
      }
      tabla = $('#tabla').DataTable({
        fnCreatedRow: function (nRow, aData, iDataIndex) {
          $(nRow).attr('data-id', `delete${aData.id}`);
        },
        searchDelay: 500,
        processing: true,
        serverSide: true,
        ajax: urlAjaxTabla,
        columns: [
          { data: 'id', name: 'id', title: "ID", orderable: false, searchable: false, visible: false },
          { 
            data: 'nombre', 
            name: 'nombre',
            title: '#{translation.FORM.NAME}'
          },
          { 
            data: 'estracto', 
            name: 'estracto',
            title: #{translation.FORM.EXCERPT}
          },
          { 
            data: 'acciones',
            name: 'acciones',
            title: '#{translation.FORM.ACTIONS}',
            render: function (data, type, row) {
              let strRow = JSON.stringify(row);
              return `
                <div class="btn-group">
                  <button class="btn btn-info btn-sm" data-id="${row.id}" onclick='editarModal(${strRow})' data-toggle="modal" data-target="#editarItem">
                    <i class="fas fa-edit"></i>
                  </button>
                  <button class="btn btn-primary btn-sm" data-id="${row.id}" onclick='mostrarModal(${strRow})' data-toggle="modal" data-target="#mostrarItem">
                    <i class="fas fa-eye"></i>
                  </button>
                  <button class="btn btn-danger btn-sm" data-id="${row.id}" onclick="beforeDeleteItem('/admin-tv/generos/items/${row.id}', itemSuccess)">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              `
              return `
              `;
            },
            orderable: false,
            searchable: false,
            width: '125px'
          }
        ]
      });
    });

    agregarItem.addEventListener('click', (event) => {
      if (nombre.value != '') {
        const auxData = {
          nombre: nombre.value,
          estracto: estracto.value
        }
        if (empresa_id.value != "") {
          auxData.empresa_id = empresa_id.value
        }
        save('/admin-tv/generos/items', auxData, itemSuccess)
      } else {
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'error',
          title: 'Error',
          text: #{translation.FORM.REQUIRED_FIELDS},
          showConfirmButton: false,
          timer: 3000
        })
      }
    });

    actualizarItem.addEventListener('click', (event) => {
      if (nombre_editar.value != '') {
        const auxData = {
          nombre: nombre_editar.value,
          estracto: estracto_editar.value
        }
        updateItem(`/admin-tv/generos/items/${itemId.value}`, auxData, itemSuccess)
      } else {
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'error',
          title: 'Error',
          text: #{translation.FORM.REQUIRED_FIELDS},
          showConfirmButton: false,
          timer: 3000
        })
      }
    });


    function mostrarModal(data) {
      nombre_mostrar.value = data.nombre;
      estracto_mostrar.value = data.estracto;
      nombre_mostrar.setAttribute('disabled', 'disabled');
      estracto_mostrar.setAttribute('disabled', 'disabled');
    }

    function editarModal(data) {
      nombre_editar.value = data.nombre;
      estracto_editar.value = data.estracto;
      itemId.value = data.id;
    }

    function itemSuccess(data) {
      tabla.ajax.reload();
    }
