mixin paginate(next, prev)
  nav(aria-label='pagination')
        ul.pagination
          if prev 
            li.page-item.disabled
              a#prevPage.page-link(href='#') #{translation.PREVIOUS}
          else 
            li.page-item
              a#prevPage.page-link(href=prev) #{translation.PREVIOUS}
          if next
            li.page-item.disabled
              a#nextPage.page-link(href='#') #{translation.NEXT}
          else
            li.page-item
              a#nextPage.page-link(href=next) #{translation.NEXT} 