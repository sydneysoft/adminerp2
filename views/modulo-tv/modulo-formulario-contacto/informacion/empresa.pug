extends ../layout.pug

append contenido 
  .border-bottom.border-left.border-right.rounded-bottom.p-3
    .my-3 
    input#empresa_id(type="text" value=empresa_id hidden)
      //- a.btn.btn-primary.btn-lg.btn-block(type='button' href="/admin-faqs/crear") Crear FAQ
    table#dataTable.table.rounded-lg.overflow-hidden
      thead.thead-dark
        tr
          th(scope='col') ID
          th(scope='col') #{translation.NAME}
          th(scope='col') #{translation.COMPANY}
          th(scope='col') #{translation.EMAIL}
          th(scope='col') #{translation.PHONE}
          th(scope='col') #{translation.ACTIONS}
      tbody
    
    .modal.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="nuevoPacienteModal")
      .modal-dialog.modal-lg
          .modal-content.modalContent(style="height: 100%;")
              .modal-header 
                  .row(style="margin:0;")
                      .col-md-12.text-center
                          h3(style="margin:0px 0;") #{translation.SHOW_INFORMATION}

              .modal-body.borderBottom
                //- nombre compani email telefono mensaje
                .row
                  .col-12 
                    .form-group 
                      label(for="nombre") #{translation.NAME}
                      input#nombre.form-control(type="text" disabled)
                  .col-12
                    .form-group 
                      label(for="compania") #{translation.COMPANY}
                      input#compania.form-control(type="text" disabled)
                  .col-12.col-md-8 
                    .form-group 
                      label(for="email") #{translation.EMAIL}
                      input#email.form-control(type="text" disabled)
                  .col-12.col-md-4 
                    .form-group 
                      label(for="telefono") #{translation.PHONE}
                      input#telefono.form-control(type="text" disabled)
                  .col-12 
                    .form-group 
                      label(for="mensaje") #{translation.MESSAGE}
                      textarea#mensaje.form-control(type="text" disabled)

              .modal-footer(style="padding:8px;")
                  .row(style="margin:0;")
                      .col-md-12.text-right
                          //- button#guardarPaciente.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") Agregar
                          button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}


    script.
      let tablaInfoContact;
      const empresa_id = document.getElementById('empresa_id');
      $(document).ready( function () {
        let urlAjax = '/admin-informacion-contactos/datatable';
        if(empresa_id.value != '') {
          urlAjax = `/admin-informacion-contactos/datatable/${empresa_id.value}`;
        }
        tablaInfoContact = $('#dataTable').DataTable({
          dom: 'lBfrtip',
          buttons: [
            'copy', 'excel', 'pdf', 'print'
          ],
          fnCreatedRow: function (nRow, aData, iDataIndex) {
            $(nRow).attr('id', `delete${aData.ID}`);
          },
          processing: true,
          serverSide: true,
          ajax: urlAjax,
          searchDelay: 1000,
          columns: [
            { data: 'id', name: 'id', title: 'ID' },
            { 
              data: 'nombre', 
              name: 'nombre',
              render: function (data, type, row) {
                if(data == null || data == 'undefined') {
                  return 'No especificado';
                }
                return data;
              }
            },
            { 
              data: 'compania', 
              name: 'compania',
              render: function (data, type, row) {
                if(data == null || data == 'undefined') {
                  return 'No especificado';
                }
                return data;
              }
            },
            { 
              data: 'email', 
              name: 'email',
              render: function (data, type, row) {
                if(data == null || data == 'undefined') {
                  return 'No especificado';
                }
                return data;
              }
            },
            { 
              data: 'telefono', 
              name: 'telefono',
              render: function (data, type, row) {
                if(data == null || data == 'undefined') {
                  return 'No especificado';
                }
                return data;
              }
            },
            { 
              data: 'Actions',
              render: function (data, type, row) {
                //- console.log(data, row);
                return `<button class="btn btn-info" onclick='showContactInfo(${JSON.stringify(row)})'><i class="fas fa-eye"></i></button>`
                //- return `<a class="btn btn-primary" href="/admin-formulario-contacto/editar/${row.id}"><i class="fas fa-pen"></i></a>
                //-         <a class="btn btn-info" href="/admin-formulario-contacto/mostrar/${row.id}"><i class="fas fa-eye"></i></a>
                //-         <a class="btn btn-danger" href="/admin-formulario-contacto/eliminar/${row.id}"><i class="fas fa-trash"></i></a>`;
              },
              searchable: false,
            }
          ]
        });
      });

      function showContactInfo (data) {
        if (data.nombre == null || data.nombre == 'undefined') {
          data.nombre = 'No especificado';
        }
        if (data.compania == null || data.compania == 'undefined') {
          data.compania = 'No especificado';
        }
        if (data.email == null || data.email == 'undefined') {
          data.email = 'No especificado';
        }
        if (data.telefono == null || data.telefono == 'undefined') {
          data.telefono = 'No especificado';
        }
        if (data.mensaje == null || data.mensaje == 'undefined') {
          data.mensaje = 'No especificado';
        }
        
        $('#nombre').val(data.nombre);
        $('#compania').val(data.compania);
        $('#email').val(data.email);
        $('#telefono').val(data.telefono);
        $('#mensaje').val(data.mensaje);
        $('#nuevoPacienteModal').modal('show');
      }