extends ../layout.pug

append contenido
  .container.mt-3
    .tab-content
      h2 #{translation.TREATMENT}
    .row
      .col-12
        .text-right 
          button#nuevoTratamiento.btn.btn-primary(role="button") #{translation.NEW} 
            i.fas.fa-plus.ml-3
    .row.mt-3
      .col-12 
        div.table-responsive 
          table#dataTable.w-100.table
            thead 
              tr 
                th ID
                th #{translation.FORM.NAME}  
                th #{translation.FORM.PRICE}
                th #{translation.FORM.DURATION}
                th #{translation.FORM.FREQUENCY}
                th #{translation.FORM.MODE_OF_APPLICATION}
                th #{translation.FORM.DOSIFICATION}
                th #{translation.FORM.ACTIONS} 
            tbody
              if Array.isArray(data) && data.length > 0
                each tratamiento, index in data
                  tr 
                    td= tratamiento.id
                    td= tratamiento.nombre
                    td= tratamiento.costo
                    td= tratamiento.duracion
                    td= tratamiento.frecuencia
                    td= tratamiento.modo_aplicacion
                    td= tratamiento.dosificacion
                    td= JSON.stringify(tratamiento)
  .modal.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="nuevoTratamientoModal" style="min-height: 80vh;")
    .modal-dialog.modal-lg
      .modal-content.modalContent(style="height: 100%;")
        .modal-header 
          .row(style="margin:0;")
            .col-md-12.text-center
              h3(style="margin:0px 0;") Agregar Tratamiento
        .modal-body.borderBottom(style="height: 80vh;overflow-y: scroll")
          .row
            .col-md-8
              .form-group
                label(for="nombre") #{translation.FORM.NAME} *
                input#nombre.form-control(type="text" placeholder="Nombre")
            .col-md-4
              .form-group
                label(for="costo") #{translation.FORM.PRICE} *
                input#costo.form-control(type="number" placeholder="Costo")
            .col-md-4
              .form-group
                label(for="duracion") #{translation.FORM.DURATION}
                input#duracion.form-control(type="number" placeholder="Duración")
            .col-md-4
              .form-group
                label(for="frecuencia") #{translation.FORM.FREQUENCY}
                input#frecuencia.form-control(type="number" placeholder="Frecuencia")
            .col-md-4
              .form-group
                label(for="modo_aplicacion") #{translation.FORM.MODE_OF_APPLICATION}
                select#modo_aplicacion.form-control
                  option(value="oral") #{translation.FORM.ORAL}
                  option(value="intravenosa") #{translation.FORM.INTRAVENOUS}
                  option(value="intramuscular") #{translation.FORM.INTRAMUSCULAR}
                  option(value="subcutanea")  #{translation.FORM.SUBCATENEUS}
                  option(value="inhalatoria") #{translation.FORM.INHALATORY}
                  option(value="rectal") #{translation.FORM.RECTAL}
                  option(value="vaginal") #{translation.FORM.VAGINAL}
                  option(value="topica") #{translation.FORM.TOPIC}
                  option(value="otro") #{translation.FORM.OTHER}
            .col-md-6
              .form-group
                label(for="dosificacion")  #{translation.FORM.DOSIFICATION} *
                input#dosificacion.form-control(type="number" placeholder="Dosificación")
            .col-md-6
              .form-group
                label(for="descripcion")  #{translation.FORM.DESCRIPTION}
                textarea#descripcion.form-control(placeholder="Descripción") 
            .col-md-6
              .form-group
                label(for="precauciones") #{translation.FORM.PRECAUTIONS}
                textarea#precauciones.form-control(placeholder="Precauciones") 
            .col-md-6
              .form-group
                label(for="efectos_secundarios") #{translation.FORM.SECONDARY_EFFECTS}
                textarea#efectos_secundarios.form-control(placeholder="Efectos secundarios")
            .col-md-6
              .form-group
                label(for="recomendaciones") #{translation.FORM.RECOMMENDATIONS}
                textarea#recomendaciones.form-control(placeholder="Recomendaciones")
            
        .modal-footer(style="padding:8px;")
          .row(style="margin:0;")
            .col-md-12.text-right
              button#guardarTratamiento.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;" onclick="guardarTratamiento()") #{translation.ADD}
              button.btn.btn-danger(type="buton" data-dismiss="modal") Cerrar

  .modal.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="editarTratamientoModal" style="min-height: 80vh;")
    .modal-dialog.modal-lg
      .modal-content.modalContent(style="height: 100%;")
        .modal-header 
          .row(style="margin:0;")
            .col-md-12.text-center
              h3(style="margin:0px 0;") #{translation.EDIT_TREATMENT}


        .modal-body.borderBottom(style="height: 80vh;overflow-y: scroll")
          .row 
            input#empresa_id(type="text" value=empresa_id hidden)
            input#tratamiento_id(type="text" hidden)
            .col-md-8
              .form-group 
                label(for="nombre") #{translation.FORM.NAME} *
                input#nombre_editar.form-control(type="text" placeholder="Nombre")
            .col-md-4
              .form-group
                label(for="costo") #{translation.FORM.PRICE} *
                input#costo_editar.form-control(type="number" placeholder="Costo")
            .col-md-4
              .form-group
                label(for="duracion") #{translation.FORM.ADDRESS}
                input#duracion_editar.form-control(type="number" placeholder="Duración")
            .col-md-4
              .form-group
                label(for="frecuencia") #{translation.FORM.FREQUENCY}
                input#frecuencia_editar.form-control(type="number" placeholder="Frecuencia")
            .col-md-4
              .form-group
                label(for="modo_aplicacion") #{translation.FORM.APPLICATION_MODE}
                select#modo_aplicacion_editar.form-control
                  option(value="oral") #{translation.FORM.ORAL}
                  option(value="intravenosa") #{translation.FORM.INTRAVENOUS}
                  option(value="intramuscular") #{translation.FORM.INTRAMUSCULAR}
                  option(value="subcutanea") #{translation.FORM.SUBCATENEUS}
                  option(value="inhalatoria") #{translation.FORM.INHALATORY}
                  option(value="rectal") #{translation.FORM.RECTAL}
                  option(value="vaginal") #{translation.FORM.VAGINAL}
                  option(value="topica") #{translation.FORM.TOPIC}
                  option(value="otro") #{translation.FORM.OTHER}
            .col-md-6
              .form-group
                label(for="dosificacion") #{translation.FORM.DOSIFICATION} *
                input#dosificacion_editar.form-control(type="number" placeholder="Dosificación")
            .col-md-6
              .form-group
                label(for="descripcion") #{translation.FORM.DESCRIPTION}
                textarea#descripcion_editar.form-control(placeholder="Descripción")
            .col-md-6
              .form-group
                label(for="precauciones") #{translation.FORM.DESCRIPTION}
                textarea#precauciones_editar.form-control(placeholder="Precauciones")
            .col-md-6
              .form-group
                label(for="efectos_secundarios") #{translation.FORM.SECONDARY_EFFECTS}
                textarea#efectos_secundarios_editar.form-control(placeholder="Efectos secundarios")
            .col-md-6
              .form-group
                label(for="recomendaciones") #{translation.FORM.RECOMMENDATIONS}
                textarea#recomendaciones_editar.form-control(placeholder="Recomendaciones")
        .modal-footer(style="padding:8px;")
          .row(style="margin:0;")
            .col-md-12.text-right
              button#actualizarTratamiento.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.SAVE}
              button.btn.btn-danger(type="buton" data-dismiss="modal") Cerrar
  
  .modal.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="mostrarTratamientoModal" style="min-height: 80vh;")
    .modal-dialog.modal-lg
      .modal-content.modalContent(style="height: 100%;")
        .modal-header 
          .row(style="margin:0;")
            .col-md-12.text-center
              h3(style="margin:0px 0;") #{translation.TREATMENT}


        .modal-body.borderBottom(style="height: 80vh;overflow-y: scroll")
          .row 
            .col-md-8
              .form-group 
                label(for="nombre_mostrar") #{translation.FORM.NAME} *
                input#nombre_mostrar.form-control(type="text" placeholder="Nombre" readonly)
            .col-md-4
              .form-group
                label(for="costo_mostrar") #{translation.FORM.PRICE} *
                input#costo_mostrar.form-control(type="number" placeholder="Costo" readonly)
            .col-md-4
              .form-group
                label(for="duracion_mostrar") #{translation.FORM.DURATION}
                input#duracion_mostrar.form-control(type="number" placeholder="Duración" readonly)
            .col-md-4
              .form-group
                label(for="frecuencia_mostrar") #{translation.FORM.FREQUENCY}
                input#frecuencia_mostrar.form-control(type="number" placeholder="Frecuencia" readonly)
            .col-md-4
              .form-group
                label(for="modo_aplicacion_mostrar") #{translation.FORM.APPLICATION_MODE}
                select#modo_aplicacion_mostrar.form-control(disabled)
                  option(value="oral") #{translation.FORM.ORAL}
                  option(value="intravenosa") #{translation.FORM.INTRAVENOUS}
                  option(value="intramuscular") #{translation.FORM.INSTRAMUSCULAR}
                  option(value="subcutanea") #{translation.FORM.SUBCATENEUS}
                  option(value="inhalatoria") #{translation.FORM.INHALATORY}
                  option(value="rectal") #{translation.FORM.RECTAL}
                  option(value="vaginal") #{translation.FORM.VAGINAL}
                  option(value="topica") #{translation.FORM.TOPIC}
                  option(value="otro") #{translation.FORM.OTHER}
            .col-md-6
              .form-group
                label(for="dosificacion_mostrar") #{translation.FORM.DOSIFICATION} *
                input#dosificacion_mostrar.form-control(type="number" placeholder="Dosificación" readonly)
            .col-md-6
              .form-group
                label(for="descripcion_mostrar") #{translation.FORM.DESCRIPTION}
                textarea#descripcion_mostrar.form-control(placeholder="Descripción" readonly)
            .col-md-6
              .form-group
                label(for="precauciones_mostrar") #{translation.FORM.PRECAUTIONS}
                textarea#precauciones_mostrar.form-control(placeholder="Precauciones" readonly)
            .col-md-6
              .form-group
                label(for="efectos_secundarios_mostrar") #{translation.FORM.SECONDARY_EFFECTS}
                textarea#efectos_secundarios_mostrar.form-control(placeholder="Efectos secundarios" readonly)
            .col-md-6
              .form-group
                label(for="recomendaciones_mostrar") #{translation.FORM.RECOMMENDATIONS}
                textarea#recomendaciones_mostrar.form-control(placeholder="Recomendaciones" readonly)
        .modal-footer(style="padding:8px;")
          .row(style="margin:0;")
            .col-md-12.text-right
              button#actualizarTratamiento.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.ADD}
              button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
  

  script.
    document.getElementById('nuevoTratamiento').addEventListener('click', function () {
      $('#nuevoTratamientoModal').modal('show');
    });
    document.getElementById('actualizarTratamiento').addEventListener('click', function () {
      updateTratamiento()
    });
    let tablaTratamientos;
    $(document).ready(function() {
      tablaTratamientos = $('#dataTable').DataTable({
        fnCreatedRow: function (nRow, aData, iDataIndex) {
          $(nRow).attr('id', `delete${aData.ID}`);
        },
        columns: [
          { data: 'ID' },
          { data: 'Nombre' },
          { data: 'Costo' },
          { data: 'Duración' },
          { data: 'Frecuencia' },
          { data: 'Modo de aplicación' },
          { data: 'Dosificación' },
          { 
            data: 'Acciones',
            render: function (data, type, row) {
              return `<button class="btn btn-primary btn-sm" onclick='editarTratamiento(${data})'><i class="fas fa-edit"></i></button>
                      <button class="btn btn-info btn-sm" onclick='verTratamiento(${data})'><i class="fas fa-eye"></i></button>
                      <button class="btn btn-danger btn-sm" onclick="beforeDeleteItem('/admin-clinica/tratamientos/items/${row.ID}', deleteItemSuccess)"><i class="fas fa-trash"></i></button>`;
            }
          }
        ]
      });
    });
    function deleteItemSuccess (data) {
      tablaTratamientos.row(`#${data.target}`).remove().draw();
    }
  script
    include ../../../js/modulo-tv/delete.js
    include ../../../js/modulo-tv/save.js
    include ../../../js/modulo-tv/update.js
    include ./tratamiento.js