        function mostrarCita (data) {
            console.log(data);
            sede_editar.setAttribute('disabled', 'disabled');
            paciente_editar.setAttribute('disabled', 'disabled');
            doctor_editar.setAttribute('disabled', 'disabled');
            tipoCita_editar.setAttribute('disabled', 'disabled');
            estado_editar.setAttribute('disabled', 'disabled');
            fecha_editar.setAttribute('disabled', 'disabled');
            hora_editar.setAttribute('disabled', 'disabled');
            precio_editar.setAttribute('disabled', 'disabled');
            colorpicker_editar.setAttribute('disabled', 'disabled');
            especialidad_editar.setAttribute('disabled', 'disabled');
            nota_editar.setAttribute('disabled', 'disabled');
            hora_fin_editar.setAttribute('disabled', 'disabled');

            sede_editar.value = data.sede.id;
            paciente_editar.value = data.paciente.id;
            doctor_editar.value = data.doctor.id;
            tipoCita_editar.value = data.tipoCita;
            estado_editar.value = data.estado;
            fecha_editar.value = moment(data.fechaCita).format('YYYY-MM-DD');
            hora_editar.value = moment(data.hora, 'HH:mm:ss').format('HH:mm');
            hora_fin_editar.value = moment(data.horaFin, 'HH:mm:ss').format('HH:mm');
            precio_editar.value = data.precio;
            colorpicker_editar.value = data.color;
            especialidad_editar.value = data.especialidad.id;
            nota_editar.value = data.nota;
            itemId.value = data.id;

            $("#editarCita").modal("show");
        }