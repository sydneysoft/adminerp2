extends ../layout.pug

append contenido
  include ../../../mixins/select-pais.pug
  .container.mt-3
    .tab-content
      h2 Pacientes
    .row
      .col-12
        .text-right 
          button#nuevoPaciente.btn.btn-primary(role="button") #{translation.CREATE}
            i.fas.fa-plus.ml-2
    .row.mt-3
      input#empresa_id(type='text' value=empresa_id hidden)
      .col-12 
        div.table-responsive 
          table#dataTable.w-100.table
            thead 
              tr 
                th ID
                th #{translation.FORM.NAME}
                th #{translation.FORM.FATHER_LASTNAME}
                th #{translation.FORM.CELULAR} 
                th #{translation.FORM.EMAIL} 
                th #{translation.FORM.ACTIONS} 
            tbody
              if Array.isArray(pacientes) && pacientes.length > 0
                each paciente in pacientes
                  tr
                    td= paciente.id
                    td= paciente.nombre
                    td= paciente.apellido_paterno
                    td= paciente.celular
                    td= paciente.correo
                    td= JSON.stringify(paciente)

  //- Modal para crear un nuevo paciente
  .modal.fade.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="nuevoPacienteModal")
    .modal-dialog.modal-lg
        .modal-content.modalContent(style="height: 100%;")
            .modal-header 
                .row(style="margin:0;")
                    .col-md-12.text-center
                        h3(style="margin:0px 0;") #{translation.CREATE} #{translation.FORM.PATIENT}

            .modal-body.borderBottom
              
              .row
                .col-12.col-md-4 
                  .form-group 
                    label(for="nombre") #{translation.FORM.NAME} *
                    input#nombre.form-control(type="text" placeholder=translation.FORM.NAME)
                .col-12.col-md-4
                  .form-group 
                    label(for="apellido_paterno") #{translation.FORM.FATHER_LASTNAME} *
                    input#apellido_paterno.form-control(type="text" placeholder=translation.FORM.FATHER_LASTNAME)
                .col-12.col-md-4
                  .form-group 
                    label(for="apellido_materno") #{translation.FORM.MOTHER_LASTNAME}
                    input#apellido_materno.form-control(type="text" placeholder=translation.FORM.MOTHER_LASTNAME)
              
              .row.mt-3
                .col-12.col-md-6
                  .form-group
                    label(for="tipo_documento") #{translation.FORM.DOCUMENT_TYPE}
                    select#tipo_documento.form-control
                      option(value="pasaporte") #{translation.FORM.PASSPORT}
                      option(value="cedula") #{translation.FORM.CEDULA}
                      option(value="carnet_extranjeria") #{translation.FORM.CARNET_EXTRANJERIA}
                      option(value="dni") #{translation.FORM.DNI}
                      option(value="otro") #{translation.FORM.OTHER}
                .col-12.col-md-6
                  .form-group
                    label(for="numero_documento") #{translation.FORM.DOCUMENT_NUMBER}
                    input#numero_documento.form-control(type="text" placeholder=translation.FORM.DOCUMENT_NUMBER)
              
              .row.mt-3 
                .col-12.col-md-4 
                  .form-group
                    label(for="sexo") #{translation.FORM.GENRE}
                    select#sexo.form-control
                      option(value="masculino") #{translation.FORM.MALE}
                      option(value="femenino") #{translation.FORM.FEMALE}
                      
                .col-12.col-md-4 
                  .form-group
                    label(for="fecha_nacimiento") #{translation.FORM.BIRTH_DATE}
                    input#fecha_nacimiento.form-control(type="date" placeholder=translation.FORM.BIRTH_DATE)    
                .col-12.col-md-4 
                  .form-group
                    label(for="estado_civil") #{translation.FORM.CIVIL_STATUS}
                    select#estado_civil.form-control
                      option(value="soltero") #{translation.FORM.SINGLE}
                      option(value="casado") #{translation.FORM.MARRIED}
                      option(value="divorciado") #{translation.FORM.DIVORCED}
                      option(value="viudo") #{translation.FORM.WIDOWED}
                      option(value="otro") #{translation.FORM.OTHER}

              .row.mt-3 
                .col-12.col-md-4
                  .form-group
                    label(for="tipo_seguro") #{translation.FORM.INSURANCE_TYPE}
                    select#tipo_seguro.form-control
                      if Array.isArray(tipo_seguro) && tipo_seguro.length > 0
                        each tipo in tipo_seguro[0].valor
                          option(value=tipo)
                            span.text-capitalize #{tipo}
                .col-12.col-md-4
                  .form-group
                    label(for="nombre_seguro") #{translation.FORM.INSURANCE_NAME}
                    //- input#nombre_seguro.form-control(type="text" placeholder=translation.FORM.INSURANCE_NAME)
                    select#nombre_seguro.form-control
                      if Array.isArray(aseguradoras) && aseguradoras.length > 0
                        each item in aseguradoras
                          option(value=item.id)
                            span.text-capitalize #{item.nombre}
                .col-12.col-md-4
                  .form-group
                    label(for="numero_seguro") #{translation.FORM.INSURANCE_NUMBER}
                    input#numero_seguro.form-control(type="text" placeholder=translation.FORM.INSURANCE_NUMBER)

              .row.mt-3 
                .col-12.col-md-4
                  .form-group
                    label(for="celular") #{translation.FORM.CELULAR}
                    input#celular.form-control(type="text" placeholder=translation.FORM.CELULAR)
                .col-12.col-md-4 
                  .form-group
                    label(for="correo") #{translation.FORM.EMAIL}
                    input#correo.form-control(type="email" placeholder=translation.FORM.EMAIL)
                .col-12.col-md-4 
                  //- lista de todos los paises ejemplo: option(value="sv") ${translation.COUNTRY.SV}
                  +pais('pais')
              .row.mt-3 
                .col-12.col-md-6
                  .form-group
                    label(for="direccion") #{translation.FORM.ADDRESS}
                    input#direccion.form-control(type="text" placeholder=translation.FORM.ADDRESS)
                .col-12.col-md-6
                  .form-group
                    label(for="nota") #{translation.FORM.OBSERVATION}
                    textarea#nota.form-control.h-100(placeholder=translation.FORM.OBSERVATION)
            
            .modal-footer(style="padding:8px;")
                .row(style="margin:0;")
                    .col-md-12.text-right
                        button#guardarPaciente.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.SAVE}
                          i.fas.fa-save.ml-2
                        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
                          i.fas.fa-times-circle.ml-2

  .modal.fade.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="editarPacienteModal")
    .modal-dialog.modal-lg
        .modal-content.modalContent(style="height: 100%;")
            .modal-header 
                .row(style="margin:0;")
                    .col-md-12
                        h3(style="margin:0px 0;") #{translation.EDIT}

            .modal-body.borderBottom
              .row
                .col-12.col-md-4 
                  .form-group 
                    label(for="nombreEditar") #{translation.FORM.NAME} *
                    input#nombreEditar.form-control(type="text" placeholder=translation.FORM.NAME)
                .col-12.col-md-4
                  .form-group 
                    label(for="apellido_paternoEditar") #{translation.FORM.FATHER_LASTNAME}*
                    input#apellido_paternoEditar.form-control(type="text" placeholder=translation.FORM.FATHER_LASTNAME)
                .col-12.col-md-4
                  .form-group 
                    label(for="apellido_maternoEditar") #{translation.FORM.MOTHER_LASTNAME}
                    input#apellido_maternoEditar.form-control(type="text" placeholder=translation.FORM.MOTHER_LASTNAME)
              .row.mt-3
                .col-12.col-md-6
                  .form-group
                    label(for="tipo_documentoEditar") #{translation.FORM.DOCUMENT_TYPE}
                    select#tipo_documentoEditar.form-control
                      option(value="pasaporte") #{translation.FORM.PASSPORT}
                      option(value="cedula") #{translation.FORM.CEDULA}
                      option(value="carnet_extranjeria") #{translation.FORM.CARNET_EXTRANJERIA}
                      option(value="dni") #{translation.FORM.DNI}
                      option(value="otro") #{translation.FORM.OTHER}
                .col-12.col-md-6
                  .form-group
                    label(for="numero_documentoEditar") #{translation.FORM.DOCUMENT_NUMBER}
                    input#numero_documentoEditar.form-control(type="text" placeholder=translation.FORM.DOCUMENT_NUMBER)
              
              .row.mt-3 
                .col-12.col-md-4 
                  .form-group
                    label(for="sexoEditar") #{translation.FORM.GENRE}
                    select#sexoEditar.form-control
                      option(value="masculino") #{translation.FORM.MALE}
                      option(value="femenino") #{translation.FORM.FEMALE}

                .col-12.col-md-4 
                  .form-group
                    label(for="fecha_nacimientoEditar") #{translation.FORM.BIRTH_DATE}
                    input#fecha_nacimientoEditar.form-control(type="date" placeholder=translation.FORM.BIRTH_DATE)    
                .col-12.col-md-4 
                  .form-group
                    label(for="estado_civilEditar") #{translation.FORM.CIVIL_STATUS}
                    select#estado_civilEditar.form-control
                      if Array.isArray(estado_civil) && estado_civil.length > 0
                        each tipo in sexo[0].valor
                          option(value=tipo)
                            span.text-capitalize #{tipo}
                      else
                        option(value="0") No hay tipos de sexo   
              .row.mt-3 
                .col-12.col-md-4
                  .form-group
                    label(for="tipo_seguroEditar") #{translation.FORM.INSURANCE_TYPE}
                    select#tipo_seguroEditar.form-control
                      if Array.isArray(tipo_seguro) && tipo_seguro.length > 0
                        each tipo in tipo_seguro[0].valor
                          option(value=tipo)
                            span.text-capitalize #{tipo}
                      else
                        option(value="0") No hay tipos de seguro
                .col-12.col-md-4
                  .form-group
                    label(for="nombre_seguroEditar") #{translation.FORM.INSURANCE_NAME}
                    select#nombre_seguroEditar.form-control
                      if Array.isArray(aseguradoras) && aseguradoras.length > 0
                        each item in aseguradoras
                          option(value=item.id)
                            span.text-capitalize #{item.nombre}
                      else
                        option(value="0") No hay aseguradoras
                .col-12.col-md-4
                  .form-group
                    label(for="numero_seguroEditar") #{translation.FORM.INSURANCE_NUMBER}
                    input#numero_seguroEditar.form-control(type="text" placeholder=translation.FORM.INSURANCE_NUMBER)

              .row.mt-3 
                .col-12.col-md-4 
                  .form-group 
                    label(for="celularEditar") #{translation.FORM.CELULAR}
                    input#celularEditar.form-control(type="text" placeholder=translation.FORM.CELULAR)
                .col-12.col-md-4 
                  .form-group 
                    label(for="correoEditar") #{translation.FORM.EMAIL}
                    input#correoEditar.form-control(type="email" placeholder=translation.FORM.EMAIL)
                .col-12.col-md-4
                  +pais('paisEditar')
              .row.mt-3 
                .col-12.col-md-6 
                  .form-group
                    label(for="direccionEditar") #{translation.FORM.ADDRESS}
                    input#direccionEditar.form-control(type="text" placeholder=translation.FORM.ADDRESS)
                .col-12.col-md-6
                  .form-group
                    label(for="notaEditar") #{translation.FORM.OBSERVATION}
                    textarea#notaEditar.form-control.h-100(placeholder=translation.FORM.OBSERVATION)

              input#idEditar(type="text" hidden)
            .modal-footer(style="padding:8px;")
                .row(style="margin:0;")
                    .col-md-12.text-right
                        button#updatePaciente.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.SAVE}
                          i.fas.fa-save.ml-2
                        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
                          i.fas.fa-times.ml-2
  script
    include ../../../js/modulo-tv/delete.js
  
  script.
    const nombre = document.getElementById('nombre');
    const apellido_paterno = document.getElementById('apellido_paterno');
    const apellido_materno = document.getElementById('apellido_materno');
    const numero_documento = document.getElementById('numero_documento');
    const tipo_documento = document.getElementById('tipo_documento');
    const sexo = document.getElementById('sexo');
    const fecha_nacimiento = document.getElementById('fecha_nacimiento');
    const estado_civil = document.getElementById('estado_civil');
    const numero_seguro = document.getElementById('numero_seguro');
    const tipo_seguro = document.getElementById('tipo_seguro');
    const celular = document.getElementById('celular');
    const correo = document.getElementById('correo');
    const direccion = document.getElementById('direccion');
    const nota = document.getElementById('nota');
    const pais = document.getElementById('pais');
    const nombre_seguro = document.getElementById('nombre_seguro');

    const nombreEditar = document.getElementById('nombreEditar');
    const apellido_paternoEditar = document.getElementById('apellido_paternoEditar');
    const apellido_maternoEditar = document.getElementById('apellido_maternoEditar');
    const numero_documentoEditar = document.getElementById('numero_documentoEditar');
    const tipo_documentoEditar = document.getElementById('tipo_documentoEditar');
    const sexoEditar = document.getElementById('sexoEditar');
    const fecha_nacimientoEditar = document.getElementById('fecha_nacimientoEditar');
    const estado_civilEditar = document.getElementById('estado_civilEditar');
    const numero_seguroEditar = document.getElementById('numero_seguroEditar');
    const tipo_seguroEditar = document.getElementById('tipo_seguroEditar');
    const celularEditar = document.getElementById('celularEditar');
    const correoEditar = document.getElementById('correoEditar');
    const direccionEditar = document.getElementById('direccionEditar');
    const notaEditar = document.getElementById('notaEditar');
    const idEditar = document.getElementById('idEditar');
    const paisEditar = document.getElementById('paisEditar');
    const nombre_seguroEditar = document.getElementById('nombre_seguroEditar');

    const empresa_id = document.getElementById('empresa_id');

    function clearForm() {
      nombre.value = ''
      apellido_paterno.value = ''
      apellido_materno.value = ''
      numero_documento.value = ''
      tipo_documento.value = ''
      sexo.value = ''
      fecha_nacimiento.value = ''
      estado_civil.value = ''
      numero_seguro.value = ''
      tipo_seguro.value = ''
      celular.value = ''
      correo.value = ''
      direccion.value = ''
      nota.value = ''
    }

    let tablaPacientes;
    document.addEventListener('DOMContentLoaded', function () {
      tablaPacientes = $('#dataTable').DataTable({
        fnCreatedRow: function (nRow, aData, iDataIndex) {
          $(nRow).attr('id', `delete${aData.ID}`);
        },
        buttons: [
          {
            extend: 'print',
            text: 'Print current page',
            autoPrint: true
          }
        ],
        columns: [
          { data: 'ID' },
          { data: 'Nombre' },
          { data: 'Apellido Paterno' },
          { data: 'Celular' },
          { data: 'Correo' },
          {
            data: 'Acciones',
            render: function (data, type, row) {
              return `
                <button class="btn btn-primary btn-sm" onclick='editarPacienteModal(${data})'>#{translation.EDIT}</button>
                <a class="btn btn-warning btn-sm" href="/admin-clinica/pacientes/historial/${row.ID}">#{translation.HISTORY}</a>
                <button class="btn btn-danger btn-sm" onclick="beforeDeleteItem('/admin-citas-medicas/pacientes/pacientes/${(JSON.parse(data)).id}', ${(JSON.parse(data)).id})">#{translation.DELETE}</button>
                `
            }
          },
        ],
      });
    });

    document.getElementById('nuevoPaciente').addEventListener('click', (e) => {
      $('#nuevoPacienteModal').modal('show');
    });

    document.getElementById('guardarPaciente').addEventListener('click', (e) => {
      if (nombre.value !== '' && apellido_paterno.value !== '') {
        e.preventDefault();
        const data = {
          nombre: nombre.value,
          apellido_paterno: apellido_paterno.value,
          apellido_materno: apellido_materno.value,
          numero_documento: numero_documento.value,
          tipo_documento: tipo_documento.value,
          sexo: sexo.value,
          fecha_nacimiento: fecha_nacimiento.value,
          estado_civil: estado_civil.value,
          numero_seguro: numero_seguro.value,
          tipo_seguro: tipo_seguro.value,
          celular: celular.value,
          correo: correo.value,
          direccion: direccion.value,
          nota: nota.value,
          empresa_id: empresa_id.value,
          pais: pais.value,
          nombre_seguro: nombre_seguro.value
        }
        fetch('/admin-clinica/pacientes/pacientes', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        })
          .then(res => res.json())
          .then(response => {
            if (response.ok) {
              console.log(response);
              $('#nuevoPacienteModal').modal('hide');
              Swal.fire({
                position: 'center',
                icon: 'success',
                title: '#{translation.ALERTS.PATIENT_CREATED}',
                showConfirmButton: false,
                timer: 1500
              })
              tablaPacientes.rows.add([{
                "ID": response.id,
                "Nombre": nombre.value,
                "Apellido Paterno": apellido_paterno.value,
                "Celular": celular.value,
                "Correo": correo.value,
                "Acciones": JSON.stringify({ id: response.id, ...data })
              }]).draw();
              clearForm();
            }
          })
          .catch(err => console.log(err));
      } else {
        Swal.fire({
          icon: 'error',
          title: 'Oops...',
          text: '#{translation.FORM.REQUIRED_FIELDS}',
        });
      }
    });

    function editarPacienteModal(str) {
      const data = JSON.parse(JSON.stringify(str));
      nombreEditar.value = data.nombre;
      apellido_paternoEditar.value = data.apellido_paterno;
      apellido_maternoEditar.value = data.apellido_materno;
      numero_documentoEditar.value = data.numero_documento;
      tipo_documentoEditar.value = data.tipo_documento;
      sexoEditar.value = data.sexo;
      fecha_nacimientoEditar.value = moment(data.fecha_nacimiento).format('YYYY-MM-DD');
      estado_civilEditar.value = data.estado_civil;
      numero_seguroEditar.value = data.numero_seguro;
      tipo_seguroEditar.value = data.tipo_seguro;
      celularEditar.value = data.celular;
      correoEditar.value = data.correo;
      direccionEditar.value = data.direccion;
      notaEditar.value = data.nota;
      idEditar.value = data.id;
      paisEditar.value = data.pais;
      nombre_seguroEditar.value = data.nombre_seguro;
      
      $('#editarPacienteModal').modal('show');

      console.log(data);
    }

    document.getElementById('updatePaciente').addEventListener('click', (e) => {
      if (nombreEditar.value !== '' && apellido_paternoEditar.value !== '') {
        const data = {
          nombre: nombreEditar.value,
          apellido_paterno: apellido_paternoEditar.value,
          apellido_materno: apellido_maternoEditar.value,
          numero_documento: numero_documentoEditar.value,
          tipo_documento: tipo_documentoEditar.value,
          sexo: sexoEditar.value,
          fecha_nacimiento: fecha_nacimientoEditar.value,
          estado_civil: estado_civilEditar.value,
          numero_seguro: numero_seguroEditar.value,
          tipo_seguro: tipo_seguroEditar.value,
          celular: celularEditar.value,
          correo: correoEditar.value,
          direccion: direccionEditar.value,
          nota: notaEditar.value,
          pais: paisEditar.value,
          nombre_seguro: nombre_seguroEditar.value
        }
        fetch(`/admin-clinica/pacientes/pacientes/${idEditar.value}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        })
          .then(res => res.json())
          .then(response => {
            if (response.ok) {
              $('#editarPacienteModal').modal('hide');
              Swal.fire({
                position: 'center',
                icon: 'success',
                title: '#{translation.ALERTS.PATIENT_UPDATED}',
                showConfirmButton: false,
                timer: 1500
              })
              tablaPacientes.row(`#delete${idEditar.value}`).remove().draw();
              tablaPacientes.rows.add([{
                "ID": idEditar.value,
                "Nombre": nombreEditar.value,
                "Apellido Paterno": apellido_paternoEditar.value,
                "Celular": celularEditar.value,
                "Correo": correoEditar.value,
                "Acciones": JSON.stringify({ id: idEditar.value, ...data })
              }]).draw();
            }
          })
          .catch(err => console.log(err));
      } else {
        Swal.fire({
          icon: 'error',
          title: 'Oops...',
          text: '#{translation.FORM.REQUIRED_FIELDS}',
        });
      }
    });

    $("#pais").select2();
    $("#paisEditar").select2();
    $("#tipo_documento").select2();
    $("#tipo_documentoEditar").select2();
    $("#sexo").select2();
    $("#sexoEditar").select2();
    $("#estado_civil").select2();
    $("#estado_civilEditar").select2();
    $("#tipo_seguro").select2();
    $("#tipo_seguroEditar").select2();
    $("#nombre_seguro").select2();
    $("#nombre_seguroEditar").select2();