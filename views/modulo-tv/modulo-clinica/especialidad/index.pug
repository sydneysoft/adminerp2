  script.
    addEspecialidad.addEventListener ('click', (e) => {
      if (nombre.value != '') {
        const data = {
          nombre: nombre.value,
          codigoexterno: codigoexterno.value,
          imagen: imagen.value,
          activado: activado.checked ? 1 : 0,
          estado: estado.value,
          sede: sede.value,
          categoria: categoria.value,
          descripcioncorta: descripcioncorta.value,
          descriptionlarga: descriptionlarga.value,
          icono: icono.value
        }
        if (empresa_id && empresa_id.value != '') {
          data.empresa_id = empresa_id.value
        }
        save('/admin-clinica/especialidades/items',data, addItemSuccess)
      } else {
        Swal.fire({
          icon: 'error',
          title: 'Oops...',
          text: 'El nombre de la especialidad es requerido',
          timer: 2000
        })
      }
    });

    editEspecialidad.addEventListener('click', (e) => {
      if(nombre_editar.value != '') {
        const data = {
          nombre: nombre_editar.value,
          codigoexterno: codigoexterno_editar.value,
          imagen: imagen_editar.value,
          activado: activado_editar.checked ? 1 : 0,
          estado: estado_editar.value,
          sede: sede_editar.value,
          categoria: categoria_editar.value,
          descripcioncorta: descripcioncorta_editar.value,
          descriptionlarga: descriptionlarga_editar.value,
          icono: icono_editar.value
        }
        updateItem(`/admin-clinica/especialidades/items/${itemId.value}`, data, editItemSuccess)
      } else {
        Swal.fire({
          icon: 'error',
          title: 'Oops...',
          text: 'El nombre de la especialidad es requerido',
          timer: 2000
        })
      }
    })

    function addItemSuccess (data) {
      tabla.ajax.reload();
      nombre.value = '';
      codigoexterno.value = '';
      imagen.value = '';
      activado.checked = false;
      estado.value = '';
      sede.value = '';
      categoria.value = '';
      descripcioncorta.value = '';
      descriptionlarga.value = '';
      icono.value = '';
      showIcono.innerHTML = '';
      $('#mostrarImagen').html('');
      $('#nuevoEspecialidadModal').modal('hide');
    }

    function editItemSuccess (data) {
      tabla.ajax.reload();
      nombre_editar.value = '';
      codigoexterno_editar.value = '';
      imagen_editar.value = '';
      activado_editar.value = '';
      estado_editar.checked = false;
      sede_editar.value = '';
      categoria_editar.value = '';
      descripcioncorta_editar.value = '';
      descriptionlarga_editar.value = '';
      icono_editar.value = '';
      showIcono_editar.innerHTML = '';
      $('#mostrarImagen_editar').html('');
      $('#editarEspecialidadModal').modal('hide');
    }
    
    function itemDeleteSuccess (data) {
      tabla.row($(`#${data.target}`)).remove().draw();
    }

    function formatState (state) {
      if (!state.id) { return state.text; }
          let $state = $(
            '<span><i class="' +  state.element.value.toLowerCase() + '"> </i> ' + 
        state.text +     '</span>'
      );
      return $state;
    };

    $("#icono").select2({
      templateResult: formatState
    });
    $("#icono_editar").select2({
      templateResult: formatState
    });

