  script.
    const nombre = document.getElementById('nombre');
    const codigoexterno = document.getElementById('codigoexterno');
    const imagen = document.getElementById('imagen');
    const activado = document.getElementById('activado');
    const estado = document.getElementById('estado');
    const sede = document.getElementById('sede');
    const categoria = document.getElementById('categoria');
    const descripcioncorta = document.getElementById('descripcioncorta');
    const descriptionlarga = document.getElementById('descriptionlarga');
    const icono = document.getElementById('icono');

    const nombre_editar = document.getElementById('nombre_editar');
    const codigoexterno_editar = document.getElementById('codigoexterno_editar');
    const imagen_editar = document.getElementById('imagen_editar');
    const activado_editar = document.getElementById('activado_editar');
    const estado_editar = document.getElementById('estado_editar');
    const sede_editar = document.getElementById('sede_editar');
    const categoria_editar = document.getElementById('categoria_editar');
    const descripcioncorta_editar = document.getElementById('descripcioncorta_editar');
    const descriptionlarga_editar = document.getElementById('descriptionlarga_editar');
    const icono_editar = document.getElementById('icono_editar');

    const nombre_mostrar = document.getElementById('nombre_mostrar');
    const codigoexterno_mostrar = document.getElementById('codigoexterno_mostrar');
    const imagen_mostrar = document.getElementById('imagen_mostrar');
    const activado_mostrar = document.getElementById('activado_mostrar');
    const estado_mostrar = document.getElementById('estado_mostrar');
    const sede_mostrar = document.getElementById('sede_mostrar');
    const categoria_mostrar = document.getElementById('categoria_mostrar');
    const descripcioncorta_mostrar = document.getElementById('descripcioncorta_mostrar');
    const descriptionlarga_mostrar = document.getElementById('descriptionlarga_mostrar');
    const icono_mostrar = document.getElementById('icono_mostrar');

    
    const addEspecialidad =  document.getElementById('addEspecialidad');
    const editEspecialidad =  document.getElementById('editEspecialidad');
    const itemId = document.getElementById('itemId');

    const showIcono = document.getElementById('showIcono');
    const showIcono_editar = document.getElementById('showIcono_editar');
    const showIcono_mostrar = document.getElementById('showIcono_mostrar');

  script.
    let tabla;
    addEventListener('DOMContentLoaded', () => {
      const empresa_id = document.querySelector('#empresa_id');
      let auxAjaxUrl = '/admin-clinica/especialidades/datatable'
      if (empresa_id && empresa_id.value != '') {
        auxAjaxUrl = `/admin-clinica/especialidades/datatable/${empresa_id.value}`
      }
      tabla = $('#especialidad').DataTable({
        fnCreatedRow: function (nRow, aData, iDataIndex) {
          $(nRow).attr('id', `delete${aData.id}`);
        },
        processing: true,
        serverSide: true,
        ajax: auxAjaxUrl,
        columns: [
          { 
            data: 'id', name: 'id', title: 'ID',
            searchable: false,
            orderable: false,
            visible: false
          },
          { 
            data: 'nombre', name: 'nombre', title: '#{translation.FORM.NAME}',
            searchable: true,
            orderable: true,
          },
          { 
            data: 'codigoexterno', name: 'codigoexterno', title: '#{translation.FORM.EXTERNAL_CODE}',
            searchable: true,
            orderable: true,
          },
          { 
            data: 'imagen', name: 'imagen', title: '#{translation.FORM.IMAGE}',
            searchable: false,
            orderable: false,
            render: function (data, type, row) {
              try {
                new URL(row.imagen);
                return `<img src="${row.imagen}" alt="imagen" style="width: 50px; height: 50px;">`
              } catch(e) {
                return `<img src="/images/image-default.jpg" alt="imagen" style="width: 50px; height: 50px;">`
              }
            }
          },
          { 
            data: 'activado', name: 'activado', title: '#{translation.FORM.ENABLED}',
            searchable: false,
            orderable: false,
            render: function (data, type, row) {
              if (row.activado == 1) {
                return '<span class="badge badge-success">#{translation.FORM.ACTIVE}</span>'
              } else {
                return '<span class="badge badge-danger">#{translation.FORM.INACTIVE}</span>'
              }
            }
          },
          { 
            data: 'estado', name: 'estado', title: '#{translation.FORM.STATE}',
            searchable: false,
            orderable: false,
            render: function (data, type, row) {
              if (row.estado == 1) {
                return '<span class="badge badge-success">#{translation.FORM.ACTIVE}</span>'
              } else {
                return '<span class="badge badge-danger">#{translation.FORM.INACTIVE}</span>'
              }
            }
          },
          { 
            data: 'sede', name: 'sede', title: '#{translation.FORM.BRANCH}',
            searchable: true,
            orderable: true,
            render: function (data, type, row) {
              if (Array.isArray(sedes) && sedes.length > 0) {
                const sede = sedes.find(sede => sede.id == row.sede)
                if (sede)
                  return sede.nombre;
                else
                  return '#{translation.FORM.NO_BRANCH}'
              } else {
                return '#{translation.FORM.NO_BRANCH}'
              }
            }
          },
          { 
            data: 'categoria', name: 'categoria', title: '#{translation.FORM.CATEGORY}',
            searchable: true,
            orderable: true,
          },
          { 
            data: 'icono', name: 'icono', title: '#{translation.FORM.ICON}',
            searchable: false,
            orderable: false,   
            render: function (data, type, row) {
              return `<i class="${row.icono}"></i>`
            }
          },
          { 
            data: 'actions',
            name: 'actions',
            title: '#{translation.FORM.ACTIONS}',
            searchable: false,
            orderable: false,
            render: function (data, type, row) {
              return `
                <button class="btn btn-primary btn-sm" onclick='editarEspecialidad(${JSON.stringify(row)})' data-toggle="modal" data-target="#editarEspecialidadModal"><i class="fas fa-edit"></i></button>
                <button class="btn btn-success btn-sm" onclick='mostrarEspecialidad(${JSON.stringify(row)})' data-toggle="modal" data-target="#mostrarEspecialidadModal"><i class="fas fa-eye"></i></button>
                <button class="btn btn-danger btn-sm" onclick="beforeDeleteItem('/admin-clinica/especialidades/items/${row.id}', itemDeleteSuccess)"><i class="fas fa-trash"></i></button>
              `
            }
          }
        ]
      })
    });
    function nuevaEspecialidad() {
      createImageGroup('imagen', 'imagenFile', 'mostrarImagen', 'galeriaImagen');
