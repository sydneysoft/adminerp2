    function editarEspecialidad(data) {

      nombre_editar.value = data.nombre;
      codigoexterno_editar.value = data.codigoexterno;
      imagen_editar.value = data.imagen;
      activado_editar.checked = data.activado;
      estado_editar.value = data.estado;
      sede_editar.value = data.sede;
      categoria_editar.value = data.categoria;
      descripcioncorta_editar.value = data.descripcioncorta;
      descriptionlarga_editar.value = data.descriptionlarga;
      icono_editar.value = data.icono;
      $('#showIcono_editar').html(`<i class="${data.icono}"></i>`)
      try {
        new URL(data.imagen);
        $('#mostrarImagen_editar').html(`<img src="${data.imagen}" alt="imagen" style="width: 50px; height: 50px;">`)
      }catch (e) {
        $('#mostrarImagen_editar').html(`<img src="/images/image-default.jpg" alt="imagen" style="width: 50px; height: 50px;">`)
      }
      itemId.value = data.id;
      createImageGroup('imagen_editar', 'imagenFile_editar', 'mostrarImagen_editar', 'galeriaImagen_editar');
    }

    function mostrarEspecialidad(data) {
      nombre_mostrar.value = data.nombre;
      codigoexterno_mostrar.value = data.codigoexterno;
      activado_mostrar.checked = data.activado;
      estado_mostrar.value = data.estado;
      sede_mostrar.value = data.sede;
      categoria_mostrar.value = data.categoria;
      descripcioncorta_mostrar.value = data.descripcioncorta;
      descriptionlarga_mostrar.value = data.descriptionlarga;
      icono_mostrar.value = data.icono;
      $('#showIcono_mostrar').html(`<i class="${data.icono}"></i>`)
      try {
        new URL(data.imagen);
        $('#mostrarImagen_mostrar').html(`<img src="${data.imagen}" alt="imagen" style="width: 50px; height: 50px;">`)
      }catch (e) {
        $('#mostrarImagen_mostrar').html(`<img src="/images/image-default.jpg" alt="imagen" style="width: 50px; height: 50px;">`)
      }
    }

