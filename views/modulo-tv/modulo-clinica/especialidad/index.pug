extends ../layout.pug

append contenido
  .border-left.border-right.border-bottom.p-3
    if empresa_id
      input#empresa_id(type="text" value=empresa_id hidden)
    else 
      input#empresa_id(type="text" value="" hidden)
    .container-fluid 
      .row
        .col-12.text-right 
          button.btn.btn-primary(type="button" data-toggle="modal" onclick="nuevaEspecialidad()" data-target="#nuevoEspecialidadModal") #{translation.ADD}
            i.fas.fa-plus.ml-2
    .container-fluid.mt-3
      .table-responsive
        table#especialidad.table.table-striped
          thead.thead-dark
            tr
              th(scope='col') ID
              th(scope='col') #{translation.FORM.NAME}
              th(scope='col') #{translation.FORM.EXTERNAL_CODE}
              th(scope='col') #{translation.FORM.IMAGE}
              th(scope='col') #{translation.FORM.ENABLED}
              th(scope='col') #{translation.FORM.STATE}
              th(scope='col') #{translation.FORM.BRANCH}
              th(scope='col') #{translation.FORM.CATEGORY}
              th(scope='col') #{translation.FORM.ICON}
              th(scope='col') #{translation.FORM.ACTIONS}
          tbody

  //- Modal para agregar especialidad
  .modal.fade.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="nuevoEspecialidadModal")
    .modal-dialog.modal-lg
        .modal-content.modalContent(style="height: 100%;")
            .modal-header 
                .row(style="margin:0;")
                    .col-md-12
                        h3(style="margin:0px 0;") #{translation.ADD}

            .modal-body.borderBottom
              .row 
                .col-12.col-md-9
                  .form-group 
                    label(for="nombre") #{translation.FORM.NAME}
                    input#nombre.form-control(type="text" placeholder=translation.FORM.NAME)
                .col-12.col-md-3
                  .form-group
                    label(for="codigoexterno") #{translation.FORM.EXTERNAL_CODE}
                    input#codigoexterno.form-control(type="text" placeholder=translation.FORM.EXTERNAL_CODE)
              .row.mt-3
                .col-12.col-md-6
                  .form-group 
                    label(for="estado") #{translation.FORM.STATE}
                    //- input#estado.form-control(type="text" placeholder=translation.FORM.STATE)
                    select#estado.form-control(name="estado")
                      option(value="1") #{translation.FORM.ACTIVE}
                      option(value="2") #{translation.FORM.INACTIVE}
                .col-12.col-md-6 
                  .form-group
                    label(for="sede") #{translation.FORM.BRANCH}
                    select#sede.form-control
                      option(value="0") #{translation.FORM.NO_BRANCH}
                      each sede in sedes
                        option(value=sede.id) #{sede.nombre}
              .row.mt-3
                .col-12.col-md-6
                  .form-group 
                    label(for="categoria") #{translation.FORM.CATEGORY}
