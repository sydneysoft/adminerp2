extends ../layout.pug

append contenido
  .border-left.border-right.border-bottom.p-3
    if empresa_id
      input#empresa_id(type="text" value=empresa_id hidden)
    else 
      input#empresa_id(type="text" value="" hidden)
    .container-fluid 
      .row
        .col-12.text-right 
          button.btn.btn-primary(type="button" data-toggle="modal" data-target="#nuevoModal") #{translation.ADD}
            i.fas.fa-plus.ml-2
    .container-fluid.mt-3
      .table-responsive
        table#tablaSeguros.table.table-striped
          thead.thead-dark


  //- Modal para agregar sede
  .modal.fade.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="nuevoModal")
    .modal-dialog.modal-lg
        .modal-content.modalContent(style="height: 100%;")
            .modal-header 
                .row(style="margin:0;")
                    .col-md-12
                        h3(style="margin:0px 0;") #{translation.ADD}

            .modal-body.borderBottom
              //- nombre	numero_identificacion	direccion	tipo_seguro	cobertura	correo	celular	
              .row
                .col-12.col-md-8
                  .form-group
                    label(for="nombre") #{translation.FORM.NAME}
                    input#nombre.form-control(type="text" placeholder=translation.FORM.NAME)
                .col-12.col-md-4
                  .form-group
                    label(for="numero_identificacion") #{translation.FORM.IDENTIFICATION_NUMBER}
                    input#numero_identificacion.form-control(type="text" placeholder=translation.FORM.IDENTIFICATION_NUMBER)
              .row
                .col-12.col-md-8
                  .form-group
                    label(for="direccion") #{translation.FORM.ADDRESS}
                    input#direccion.form-control(type="text" placeholder=translation.FORM.ADDRESS)
                .col-12.col-md-4
                  .form-group
                    label(for="tipo_seguro") #{translation.FORM.INSURANCE_TYPE}
                    select#tipo_seguro.form-control(name="tipo_seguro")
                      option(value='seguro_de_vida') #{translation.FORM.LIFE_INSURANCE}
                      option(value='seguro_de_salud') #{translation.FORM.HEALTH_INSURANCE}
                      option(value='seguro_de_accidentes') #{translation.FORM.ACCIDENT_INSURANCE}
                      option(value='seguro_de_responsabilidad_civil') #{translation.FORM.CIVIL_RESPONSIBILITY_INSURANCE}
                      option(value='seguro_de_decesos') #{translation.FORM.DEATH_INSURANCE}
                      option(value='seguro_medico') #{translation.FORM.MEDICAL_INSURANCE}
                      option(value='no_life_insurance') #{translation.FORM.NO_LIFE_INSURANCE}
              .row
                .col-12.col-md-8
                  .form-group 
                    label(for="correo") #{translation.FORM.EMAIL}
                    input#correo.form-control(type="text" placeholder=translation.FORM.EMAIL)
                .col-12.col-md-4 
                  .form-group 
                    label(for="celular") #{translation.FORM.CELULAR}
                    input#celular.form-control(type="number" placeholder=translation.FORM.CELULAR)
              .row
                .col-12
                  .form-group
                    label(for="cobertura") #{translation.FORM.COVERAGE}
                    textarea#cobertura.form-control(type="text" placeholder=translation.FORM.COVERAGE)
                
            .modal-footer(style="padding:8px;")
                .row(style="margin:0;")
                    .col-md-12.text-right
                        button#nuevoItem.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.ADD}
                        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}

  //- Modal para editar sede
  .modal.fade.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="editarModal")
    .modal-dialog.modal-lg
        .modal-content.modalContent(style="height: 100%;")
            .modal-header 
                .row(style="margin:0;")
                    .col-md-12
                        h3(style="margin:0px 0;") #{translation.EDIT}

            .modal-body.borderBottom
              .row
                .col-12.col-md-8
                  .form-group
                    label(for="nombre_editar") #{translation.FORM.NAME}
                    input#nombre_editar.form-control(type="text" placeholder=translation.FORM.NAME)
                .col-12.col-md-4
                  .form-group
                    label(for="numero_identificacion_editar") #{translation.FORM.IDENTIFICATION_NUMBER}
                    input#numero_identificacion_editar.form-control(type="text" placeholder=translation.FORM.IDENTIFICATION_NUMBER)
                .col-12.col-md-8
                  .form-group
                    label(for="direccion_editar") #{translation.FORM.ADDRESS}
                    input#direccion_editar.form-control(type="text" placeholder=translation.FORM.ADDRESS)
                .col-12.col-md-4
                  .form-group
                    label(for="tipo_seguro_editar") #{translation.FORM.INSURANCE_TYPE}
                    select#tipo_seguro_editar.form-control(name="tipo_seguro")
                      option(value='seguro_de_vida') #{translation.FORM.LIFE_INSURANCE}
                      option(value='seguro_de_salud') #{translation.FORM.HEALTH_INSURANCE}
                      option(value='seguro_de_accidentes') #{translation.FORM.ACCIDENT_INSURANCE}
                      option(value='seguro_de_responsabilidad_civil') #{translation.FORM.CIVIL_RESPONSIBILITY_INSURANCE}
                      option(value='seguro_de_decesos') #{translation.FORM.DEATH_INSURANCE}
                      option(value='seguro_medico') #{translation.FORM.MEDICAL_INSURANCE}
                      option(value='no_life_insurance') #{translation.FORM.NO_LIFE_INSURANCE}
                .col-12.col-md-8
                  .form-group 
                    label(for="correo_editar") #{translation.FORM.EMAIL}
                    input#correo_editar.form-control(type="text" placeholder=translation.FORM.EMAIL)
                .col-12.col-md-4 
                  .form-group 
                    label(for="celular_editar") #{translation.FORM.CELULAR}
                    input#celular_editar.form-control(type="number" placeholder=translation.FORM.CELULAR)
                .col-12
                  .form-group
                    label(for="cobertura_editar") #{translation.FORM.COVERAGE}
                    textarea#cobertura_editar.form-control(type="text" placeholder=translation.FORM.COVERAGE)
                input#itemId(type="text" value="" hidden)
            .modal-footer(style="padding:8px;")
                .row(style="margin:0;")
                    .col-md-12.text-right
                        button#editarItem.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.EDIT}
                        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
  
  //- Modal para mostrar sede
  .modal.fade.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="mostrarModal")
    .modal-dialog.modal-lg
        .modal-content.modalContent(style="height: 100%;")
            .modal-header 
                .row(style="margin:0;")
                    .col-md-12
                        h3(style="margin:0px 0;") #{translation.SHOW}

            .modal-body.borderBottom
              .row
                .col-12.col-md-8
                  .form-group
                    label(for="nombre_mostrar") #{translation.FORM.NAME}
                    input#nombre_mostrar.form-control(type="text" placeholder="Nombre")
                .col-12.col-md-4
                  .form-group
                    label(for="numero_identificacion_mostrar") #{translation.FORM.IDENTIFICATION_NUMBER}
                    input#numero_identificacion_mostrar.form-control(type="text" placeholder="Número de identificación")
                .col-12.col-md-8
                  .form-group
                    label(for="direccion_mostrar") #{translation.FORM.ADDRESS}
                    input#direccion_mostrar.form-control(type="text" placeholder="Dirección")
                .col-12.col-md-4
                  .form-group
                    label(for="tipo_seguro_mostrar") #{translation.FORM.INSURANCE_TYPE}
                    select#tipo_seguro_mostrar.form-control(name="tipo_seguro")
                      option(value='seguro_de_vida') #{translation.FORM.LIFE_INSURANCE}
                      option(value='seguro_de_salud') #{translation.FORM.HEALTH_INSURANCE}
                      option(value='seguro_de_accidentes') #{translation.FORM.ACCIDENT_INSURANCE}
                      option(value='seguro_de_responsabilidad_civil') #{translation.FORM.CIVIL_RESPONSIBILITY_INSURANCE}
                      option(value='seguro_de_decesos') #{translation.FORM.DEATH_INSURANCE}
                      option(value='seguro_medico') #{translation.FORM.MEDICAL_INSURANCE}
                      option(value='no_life_insurance') #{translation.FORM.NO_LIFE_INSURANCE}
                .col-12.col-md-8
                  .form-group 
                    label(for="correo_mostrar") #{translation.FORM.EMAIL}
                    input#correo_mostrar.form-control(type="text" placeholder=translation.FORM.EMAIL)
                .col-12.col-md-4 
                  .form-group 
                    label(for="celular_mostrar") #{translation.FORM.CELULAR}
                    input#celular_mostrar.form-control(type="number" placeholder=translation.FORM.CELULAR)
                .col-12
                  .form-group
                    label(for="cobertura_mostrar") #{translation.FORM.COVERAGE}
                    textarea#cobertura_mostrar.form-control(type="text" placeholder=translation.FORM.COVERAGE)
              
              
            .modal-footer(style="padding:8px;")
                .row(style="margin:0;")
                    .col-md-12.text-right
                        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE} 
  
  script
    include ../../../js/modulo-tv/save.js
    include ../../../js/modulo-tv/update.js
    include ../../../js/modulo-tv/delete.js
  script.
    const nombre = document.getElementById('nombre');
    const numero_identificacion = document.getElementById('numero_identificacion');
    const direccion = document.getElementById('direccion');
    const tipo_seguro = document.getElementById('tipo_seguro');
    const cobertura = document.getElementById('cobertura');
    const correo = document.getElementById('correo');
    const celular = document.getElementById('celular');

    const nombre_editar = document.getElementById('nombre_editar');
    const numero_identificacion_editar = document.getElementById('numero_identificacion_editar');
    const direccion_editar = document.getElementById('direccion_editar');
    const tipo_seguro_editar = document.getElementById('tipo_seguro_editar');
    const cobertura_editar = document.getElementById('cobertura_editar');
    const correo_editar = document.getElementById('correo_editar');
    const celular_editar = document.getElementById('celular_editar');

    const nombre_mostrar = document.getElementById('nombre_mostrar');
    const numero_identificacion_mostrar = document.getElementById('numero_identificacion_mostrar');
    const direccion_mostrar = document.getElementById('direccion_mostrar');
    const tipo_seguro_mostrar = document.getElementById('tipo_seguro_mostrar');
    const cobertura_mostrar = document.getElementById('cobertura_mostrar');
    const correo_mostrar = document.getElementById('correo_mostrar');
    const celular_mostrar = document.getElementById('celular_mostrar');

    const empresa_id = document.getElementById('empresa_id');
    const itemId = document.getElementById('itemId');

    const nuevoItem = document.getElementById('nuevoItem');
    const editarItem = document.getElementById('editarItem');

    let tabla;
    addEventListener('DOMContentLoaded', () => {
      let urlAjax = '/admin-clinica/aseguradoras/datatable'
      if (empresa_id)
      tabla = $('#tablaSeguros').DataTable({
        fnCreatedRow: function (nRow, aData, iDataIndex) {
          $(nRow).attr('id', aData.id);
        },
        searchDelay: 500,
        serverSide: true,
        processing: true,
        ajax: urlAjax,
        columns: [
          //- nombre	numero_identificacion	direccion	tipo_seguro	cobertura	correo	celular	
          { 
            data: 'id',
            name: 'id',
            title: 'ID',
            orderable: false,
            searchable: false,
            visible: false
          },
          { data: 'nombre', name: 'nombre' ,title: '#{translation.FORM.NAME}' },
          {
            data: 'numero_identificacion',
            name: 'numero_identificacion',
            title: '#{translation.FORM.IDENTIFICATION_NUMBER}'
          },
          {
            data: 'tipo_seguro',
            name: 'tipo_seguro',
            title: '#{translation.FORM.INSURANCE_TYPE}',
            render: function (data, type, row) {
              switch(data) {
                case 'seguro_de_vida':
                  data = '#{translation.FORM.LIFE_INSURANCE}'
                  break;
                case 'seguro_de_accidentes_personales':
                  data = '#{translation.FORM.PERSONAL_ACCIDENT_INSURANCE}'
                  break;
                case 'seguro_de_responsabilidad_civil':
                  data = '#{translation.FORM.CIVIL_RESPONSIBILITY_INSURANCE}'
                  break;
                case 'seguro_de_decesos':
                  data = '#{translation.FORM.DEATH_INSURANCE}'
                  break;
                case 'seguro_medico':
                  data = '#{translation.FORM.MEDICAL_INSURANCE}'
                  break;
                case 'no_life_insurance':
                  data = '#{translation.FORM.NO_LIFE_INSURANCE}'
                  break;
                case 'seguro_de_salud':
                  data = '#{translation.FORM.HEALTH_INSURANCE}'
                  break;
                case 'seguro_de_accidentes':
                  data = '#{translation.FORM.ACCIDENT_INSURANCE}'
                  break;
              }
              return `<span class="badge badge-primary">${data}</span>` //- raw 
            },
            orderable: false,
            searchable: false
          },
          { 
            data: 'direccion',
            name: 'direccion',
            title: '#{translation.FORM.ADDRESS}'
          },
          { 
            data: 'celular',
            name: 'celular',
            title: '#{translation.FORM.PHONE}'
          },
          { 
            data: 'correo',
            name: 'correo',
            title: '#{translation.FORM.EMAIL}'
          },
          {
            data: 'actions',
            name: 'actions',
            title: '#{translation.FORM.ACTIONS}',
            render: function (data, type, row) {
              let rowStr = JSON.stringify(row);
              return `
                <div class="btn-group">
                  <button class="btn btn-primary btn-sm" data-toggle="modal" data-target="#editarModal" onclick='editarData(${rowStr})'>
                    <i class="fas fa-edit"></i>
                  </button>
                  <button class="btn btn-info btn-sm" data-toggle="modal" data-target="#mostrarModal" onclick='mostrarData(${rowStr})'>
                    <i class="fas fa-eye"></i>
                  </button>
                  <button class="btn btn-danger btn-sm" onclick="beforeDeleteItem('/admin-clinica/aseguradoras/items/${row.id}', deleteSuccessData)">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              `
            },
            orderable: false,
            searchable: false
          }
          
        ]
      })
    })

    nuevoItem.addEventListener('click', (event) => {
      if(nombre.value != '' && numero_identificacion.value != '' && direccion.value != '') {
        let auxData = {
          nombre: nombre.value,
          numero_identificacion: numero_identificacion.value,
          direccion: direccion.value,
          tipo_seguro: tipo_seguro.value,
          cobertura: cobertura.value,
          correo: correo.value,
          celular: celular.value,
        }
        if (empresa_id.value != '') {
          auxData.empresa_id = empresa_id.value
        }

        save('/admin-clinica/aseguradoras/items', auxData, itemSuccessData);
      } else {
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'error',
          title: 'Oops...',
          text: '#{translation.FORM.REQUIRED_FIELDS}',
        })
      }
    })

    editarItem.addEventListener('click', (event) => {
      if(nombre_editar.value != '' && numero_identificacion_editar.value != '' && direccion_editar.value != '') {
        let auxData = {
          nombre: nombre_editar.value,
          numero_identificacion: numero_identificacion_editar.value,
          direccion: direccion_editar.value,
          tipo_seguro: tipo_seguro_editar.value,
          cobertura: cobertura_editar.value,
          correo: correo_editar.value,
          celular: celular_editar.value,
        }



        updateItem(`/admin-clinica/aseguradoras/items/${itemId.value}`, auxData, editarSuccessData);
      } else {
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'error',
          title: 'Oops...',
          text: '#{translation.FORM.REQUIRED_FIELDS}',
        })
      }
    });

    function clearForm () {}

    function itemSuccessData (data) {
      nombre.value = '';
      numero_identificacion.value = '';
      direccion.value = '';
      tipo_seguro.value = '';
      cobertura.value = '';
      correo.value = '';
      celular.value = '';

      tabla.ajax.reload();
      $('#nuevoModal').modal('hide')
    }

    function editarSuccessData (data) {
      tabla.ajax.reload();
      $('#editarModal').modal('hide')
    }

    function deleteSuccessData(data) {
      tabla.row($(`#${data.target}`)).remove().draw();
    }

    function editarData(data) {
      nombre_editar.value = data.nombre;
      numero_identificacion_editar.value = data.numero_identificacion;
      direccion_editar.value = data.direccion;
      tipo_seguro_editar.value = data.tipo_seguro;
      cobertura_editar.value = data.cobertura;
      correo_editar.value = data.correo;
      celular_editar.value = data.celular;
      editarItem.dataset.id = data.id;
      itemId.value = data.id;
      $('#editarModal').modal('show');
    }

    function mostrarData (data) {
      nombre_mostrar.value = data.nombre;
      numero_identificacion_mostrar.value = data.numero_identificacion;
      direccion_mostrar.value = data.direccion;
      tipo_seguro_mostrar.value = data.tipo_seguro;
      cobertura_mostrar.value = data.cobertura;
      correo_mostrar.value = data.correo;
      celular_mostrar.value = data.celular;
      nombre_mostrar.setAttribute('disabled', 'disabled');
      numero_identificacion_mostrar.setAttribute('disabled', 'disabled');
      direccion_mostrar.setAttribute('disabled', 'disabled');
      tipo_seguro_mostrar.setAttribute('disabled', 'disabled');
      cobertura_mostrar.setAttribute('disabled', 'disabled');
      correo_mostrar.setAttribute('disabled', 'disabled');
      celular_mostrar.setAttribute('disabled', 'disabled');
    }
    