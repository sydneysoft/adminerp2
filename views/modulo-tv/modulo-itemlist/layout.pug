extends ../../extends/menu-superior-admin

block contenido
  ul.nav.nav-tabs
    li.nav-item
      a.nav-link.active(href='/admin-itemlist' ) #{translation.LISTS}
  script.
    const currentPath = window.location.pathname
    const navLinks = $(".nav .nav-link");
    $.each(navLinks, function (index, value) {
      if(currentPath == value.getAttribute('href')) {
        $.each(navLinks,  (i, v) => v.classList.remove('active'))
        value.classList.toggle('active')
      }
    });
   
