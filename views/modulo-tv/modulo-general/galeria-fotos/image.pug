script.
  let targetImage;
  let preTargetImage;
  let showTargetImage;
  let fromTargetImage;

  function createImageGroup (target, preTarget, showTarget, fromTarget) {
    targetImage = document.getElementById(target);
    preTargetImage = document.getElementById(preTarget);
    showTargetImage = document.getElementById(showTarget);
    fromTargetImage = document.getElementById(fromTarget);

    preTargetImage.addEventListener('change', async (event) => {
      const file = event.target.files[0];
      const reader = new FileReader();
      // Extension images match and test
      const extension = file.name.split('.').pop();
      if (extension !== 'jpg' && extension !== 'jpeg' && extension !== 'png') {
        Swal.fire({
          toast: false,
          position: 'top-end',
          icon: 'error',
          title: 'Oops...',
          text: 'Solo se permiten archivos .jpg, .jpeg y .png',
          showConfirmButton: false,
          timer: 2000
        });
        preTargetImage.value = '';
        return;
      }
      reader.onload = (event) => {
        showTargetImage.innerHTML = `<img src="${event.target.result}" class="img-fluid" alt="Responsive image">`;
      };
      reader.readAsDataURL(file);
      let dataForms = new FormData();
      dataForms.append('multimedia', file);
      Swal.showLoading();
      $.ajax({
        url: '/admin-galeria',
        type: 'POST',
        data: dataForms,
        contentType: false,
        processData: false,
        success: function (response) {
          Swal.close();
          if (response.status === 200) {
            Swal.fire({
              toast: false,
              position: 'top-end',
              icon: 'success',
              title: 'Imagen subida',
              text: 'La imagen se subio correctamente',
              showConfirmButton: false,
              timer: 2000
            });
            targetImage.value = response.data;
            fromTargetImage.value = 'upload';
          } else {
            Swal.fire({
              toast: false,
              position: 'top-end',
              icon: 'error',
              title: 'Oops...',
              text: 'La imagen no se subio correctamente',
              showConfirmButton: false,
              timer: 2000
            });
          }
        },
        error: function (error) {
          Swal.close();
          Swal.fire({
            toast: false,
            position: 'top-end',
            icon: 'error',
            title: 'Oops...',
            text: 'La imagen no se subio correctamente',
            showConfirmButton: false,
            timer: 2000
          });
        }
      });
    })

  }

  const getImagePagedGaleria = async (dataPage,  modalTarget, showModalTarget) => {
    $(`#${showModalTarget}`).empty();
    $(`#${showModalTarget}`).hide();
    $("#loadingDataAjax").show();
    try {
      let url = "/admin-galeria/selectImages/" + dataPage;
      let data = null;
      let head = { "Content-Type": "application/json" };
      const dataFilesUpload = await axios.get(url, data, head);
      if (dataFilesUpload.data) {
        for (let i = 0; dataFilesUpload.data.length > i; i++) {
          $(`#${showModalTarget}`).append(
            '<div id="mediaPhoto' +
            dataFilesUpload.data[i].id +
            '" class="col-6 col-md-3 mb-4 text-center">' +
            '<div onclick="' +
            'insertarImage(\'' + dataFilesUpload.data[i].url + '\', \''+ modalTarget +'\')' +
            '" class="selectImg position-relative"><img class="image-item-galeria-photo" src="' +
            dataFilesUpload.data[i].url +
            '"/></div>' +
            "</div>"
          );
        }
        $("#loadingDataAjax").hide();
        $(`#${showModalTarget}`).show();
        $(`#${modalTarget}`).modal('show');
      }
    } catch (e) {
      console.log(e);
    }
  };


  function insertarImage (url, modalTarget) {
    targetImage.value = url;
    showTargetImage.innerHTML = `<img src="${url}" class="img-fluid" alt="Responsive image">`;
    $(`#${modalTarget}`).modal('hide');
  }