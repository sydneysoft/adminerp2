//- Modal para crear una nuevo faq
.modal.fade(role="dialog" id="saveModal")
  .modal-dialog
    .modal-content.modalContent(style="height: 100%;")
      .modal-header 
        .row(style="margin:0;")
          .col-md-12
            h3(style="margin:0px 0;") #{translation.ADD}

      .modal-body.borderBottom
        .row 
          .col-12.col-md-9
            .form-group
              label(for='pregunta') #{translation.QUESTION}
              input#pregunta.form-control(type='text' placeholder="Pregunta")
          .col-12.col-md-3
            .form-group
              label(for='icono') #{translation.FORM.ICON}
              .controls
                button.btn.btn-info#icono(data-iconset="fontawesome5" data-icon="fas fa-wifi" role="iconpicker")
          .col-12.my-3
          .col-12
            .form-group 
              label(for="respuesta") #{translation.ANSWER} 
              textarea#respuesta(name="respuesta" placeholder="Respuesta")

      .modal-footer(style="padding:8px;")
        .row(style="margin:0;")
          .col-md-12.text-right
            button#saveItem.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.ADD}
              i.fas.fa-plus.ml-3
            button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
