    ]
    // Crea las opciones de los iconos en los select del modal
    iconosPricingFeatures.forEach((icon) => {
      let option = document.createElement('option');
      option.value = icon[0];
      option.innerHTML = icon[1];
      icono.appendChild(option);
      icono_editar.appendChild(option.cloneNode(true));
    })

    // Muestra el icono seleccionado en el select

    icono.addEventListener('change', (event) => {
      showIcono.innerHTML = `<i class="${event.target.value}"></i>`;
    });

    icono_editar.addEventListener('change', (event) => {
      showIcono_editar.innerHTML = `<i class="${event.target.value}"></i>`;
    });

    // Inserta las caracteristicas a los inputs del modal y abre el modal
    function editarCaracteristicas(data) {
      icono_editar.value = data.icono;
      showIcono_editar.innerHTML = `<i class="${data.icono}"></i>`;
      descripcion_editar.value = data.nombre;
      id_editar.value = data.id;
      $('#editarCaracteristicaModal').modal('show');
    }
    // Inserta las caracteristicas a los inputs del modal y abre el modal
    function mostrarCaracteristicas(data) {
      icono_mostrar.value = data.icono;
      showIcono_mostrar.innerHTML = `<i class="${data.icono}"></i>`;
      descripcion_mostrar.value = data.nombre;
      $('#mostrarCaracteristicaModal').modal('show');
    }