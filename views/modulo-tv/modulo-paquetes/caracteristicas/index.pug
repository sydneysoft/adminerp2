extends ../layout.pug


append contenido 
  .border-left.border-right.border-bottom.p-3 
    .container-fluid 
      .row
        .col-12.text-right 
          button#nuevaCaracteristica.btn.btn-primary(type="button") #{translation.ADD}
            i.fas.fa-plus
      .row.mt-5
        .col-12 
          .table-responsive 
            table#caracteristicasTable.table
              thead.thead-dark
                tr
                  th(scope='col') ID
                  th(scope='col') #{translation.NAME}
                  th(scope='col') #{translation.ICON}
                  th(scope='col') #{translation.ACTIONS}
              tbody
  
    if empresa_id 
      input#empresa_id(type="text" value=empresa_id hidden)
    else 
      input#empresa_id(type="text" value="" hidden)

  //- Modal para agregar caracteristica
  .modal.fade.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="nuevaCaracteristicaModal")
    .modal-dialog.modal-md
        .modal-content.modalContent(style="height: 100%;")
            .modal-header 
                .row(style="margin:0;")
                    .col-md-12
                        h3(style="margin:0px 0;") #{translation.ADD}

            .modal-body.borderBottom
              .row 
                .col-12
                  .form-group 
                    label(for="descripcion") #{translation.DESCRIPTION}
                    textarea#descripcion.form-control(name="descripcion")
                    span#textAreaCounter.text-sm
                .col-12 
                  .form-group 
                    label(for="icono") #{translation.ICON}
                      span#showIcono.ml-3
                    select#icono.form-control
                      option(value="") #{translation.ICON}
            .modal-footer(style="padding:8px;")
                .row(style="margin:0;")
                    .col-md-12.text-right
                        button#addCaracteristica.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.ADD}
                          i.fas.fa-plus.ml-3
                        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
  
  //- Modal para editar
  .modal.fade.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="editarCaracteristicaModal")
    .modal-dialog.modal-md
        .modal-content.modalContent(style="height: 100%;")
            .modal-header 
                .row(style="margin:0;")
                    .col-md-12
                        h3(style="margin:0px 0;") #{translation.EDIT}

            .modal-body.borderBottom
              .row 
                .col-12
                  .form-group 
                    label(for="descripcion_editar") #{translation.DESCRIPTION}
                    textarea#descripcion_editar.form-control(name="descripcion")
                    span#textAreaCounter.text-sm
                .col-12 
                  .form-group 
                    label(for="icono_editar") #{translation.ICON}
                      span#showIcono_editar.ml-3
                    select#icono_editar.form-control
                      option(value="") #{translation.ICON}
                .col-12 
                  #id_editar(type="text" value="" hidden)
            .modal-footer(style="padding:8px;")
                .row(style="margin:0;")
                    .col-md-12.text-right
                        button#saveCaracteristica.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.SAVE}
                          i.fas.fa-save.ml-3
                        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
  //- Modal para mostrar
  .modal.fade.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="mostrarCaracteristicaModal")
    .modal-dialog.modal-md
        .modal-content.modalContent(style="height: 100%;")
            .modal-header 
                .row(style="margin:0;")
                    .col-md-12
                        h3(style="margin:0px 0;") #{translation.EDIT}

            .modal-body.borderBottom
              .row 
                .col-12
                  .form-group 
                    label(for="descripcion_mostrar") #{translation.DESCRIPTION}
                    textarea#descripcion_mostrar.form-control(name="descripcion" readonly)
                    span#textAreaCounter.text-sm
                .col-12 
                  .form-group 
                    label(for="icono_mostrar") #{translation.ICON}
                      span#showIcono_mostrar.ml-3
                    select#icono_mostrar.form-control(disabled)
                      option(value="") #{translation.ICON}
                .col-12 
                  #id_editar(type="text" value="" hidden)
            .modal-footer(style="padding:8px;")
                .row(style="margin:0;")
                    .col-md-12.text-right
                        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}

  script
    include ../../../js/modulo-tv/save.js
    include ../../../js/modulo-tv/update.js
    include ../../../js/modulo-tv/delete.js
  script.
    let tabla = null;
    let urlAjaxTable = '/admin-paquetes/caracteristicas/datatable';
    const caracteristicasTable = document.getElementById('caracteristicasTable');
    const empresa_id = document.getElementById('empresa_id');
    const nuevaCaracteristica = document.getElementById('nuevaCaracteristica');

    const descripcion = document.getElementById('descripcion');
    const description_editar = document.getElementById('descripcion_editar');
    const icono = document.getElementById('icono');
    const icono_editar = document.getElementById('icono_editar');
    const showIcono = document.getElementById('showIcono');
    const showIcono_editar = document.getElementById('showIcono_editar');
    const id_editar = document.getElementById('id_editar');

    const description_mostrar = document.getElementById('descripcion_mostrar');
    const icono_mostrar = document.getElementById('icono_mostrar');
    const showIcono_mostrar = document.getElementById('showIcono_mostrar');

    const addCaracteristica = document.getElementById('addCaracteristica');
    const saveCaracteristica = document.getElementById('saveCaracteristica');

    const editarCaracteristicaModal = document.getElementById('editarCaracteristicaModal');

    const textAreaCounter = document.getElementById('textAreaCounter');
    let maxCounter = 255;
    textAreaCounter.innerHTML = maxCounter;

    descripcion.addEventListener('keyup', (event) => {
      let counter = maxCounter - descripcion.value.length;
      textAreaCounter.innerHTML = counter;
    });

    addCaracteristica.addEventListener('click', (event) => {
      if(icono.value != '' && descripcion.value != '') {
        const payloadData = {
          nombre: descripcion.value,
          icono: icono.value,
        }
        if(empresa_id.value != '') {
          payloadData.empresa_id = empresa_id.value;
        }
        save('/admin-paquetes/caracteristicas/items', payloadData, clearForm);

      } else {
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'error',
          title: 'Oops...',
          text: 'Todos los campos son obligatorios',
          showConfirmButton: false,
          timer: 2000
        })
      }
    });

    saveCaracteristica.addEventListener('click', (event) => {
      if(icono_editar.value != '' && description_editar.value != '') {
        const payloadData = {
          nombre: description_editar.value,
          icono: icono_editar.value,
        }
        updateItem(`/admin-paquetes/caracteristicas/items/${id_editar.value}`, payloadData, clearEditForm);

      } else {
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'error',
          title: 'Oops...',
          text: 'Todos los campos son obligatorios',
          showConfirmButton: false,
          timer: 2000
        })
      }
    });

    function deleteItemSuccess (data) {
      tabla.row($(`#data.target`)).remove().draw();
    }

    function clearForm (data) {
      icono.value = '';
      descripcion.value = '';
      showIcono.innerHTML = '';
      tabla.ajax.reload();
      $('#nuevaCaracteristicaModal').modal('hide');
    }

    function clearEditForm (data) {
      icono_editar.value = '';
      description_editar.value = '';
      showIcono_editar.innerHTML = '';
      tabla.ajax.reload();
      $('#editarCaracteristicaModal').modal('hide');
    }

    addEventListener("DOMContentLoaded", () => {
      if (empresa_id.value != '') {
        urlAjaxTable = `/admin-paquetes/caracteristicas/datatable/${empresa_id.value}`;
      }
      tabla = $('#caracteristicasTable').DataTable({
        fnCreatedRow: function (nRow, aData, iDataIndex) {
          $(nRow).attr('id', `delete${aData.id}`);
        },
        dom: 'lBfrtip',
        buttons: [
          'copy', 'excel', 'pdf', 'print'
        ],
        processing: true,
        serverSide: true,
        ajax: urlAjaxTable,
        searchDelay: 500,

        columns: [
          // nombre icono
          { 
            data: 'id', 
            name: 'id', 
            value: "ID", 
            orderable: false,
            searchable: false},
          { data: 'nombre', name: 'nombre', value: "Nombre"},
          { 
            data: 'icono', 
            name: 'icono', 
            value: "Icono", 
            render: function (data, type, row) {
              return `<i class="${row.icono}"></i>`
            },
            orderable: false,
            searchable: false
          },
          { 
            data: 'acciones', 
            value: "Acciones",
            render: function (data, type, row) {
              return `
                <button class="btn btn-primary btn-sm" onclick='editarCaracteristicas(${JSON.stringify(row)})'>Editar</button>
                <button class="btn btn-info btn-sm" onclick='mostrarCaracteristicas(${JSON.stringify(row)})'>Mostrar</button>
                <button class="btn btn-danger btn-sm" onclick="beforeDeleteItem('/admin-paquetes/caracteristicas/items/${row.id}', deleteItemSuccess)">Eliminar</button>
              `
            },
            orderable: false,
            searchable: false
          }
        ]

      });
    });

    nuevaCaracteristica.addEventListener('click', (event) =>{ 
      $('#nuevaCaracteristicaModal').modal('show');
    });

