extends ../../extends/menu-superior-admin

block contenido
  .my-3
    div
      a.btn.btn-primary(href="/admin-video-prime/productores") 
        i.fas.fa-arrow-left
        span.px-3 #{translation.BACK}

    h1.text-center.mb-5 
      | #{data.nombre}

    .my-3.text-right 
      a.btn.btn-primary(href=`/admin-video-prime/productores/editar/${data.id}`) #{translation.EDIT}
    .card   
      .card-body 
        table.table 
          thead
            tr
              th(scope='col') #{translation.NAME} 
              th(scope='col') #{translation.DESCRIPTION} 
          tbody
            tr
              th(scope='row') ID
              td #{data.id}
            tr
              th(scope='row') #{translation.NAME} 
              td #{data.nombre}
            tr
              th(scope='row') #{translation.NATIONALITY} 
              td #{data.nacionalidad}
            tr
              th(scope='row') #{translation.BIOGRAPHY} 
              td #{data.biografia}
            tr
              th(scope='row') #{translation.GENRE} 
              td #{data.genero}