extends ../layout.pug


append contenido 
  .my-3
    .d-grid
      a#aCrear.btn.btn-primary.btn-block(type='button' href="/admin-video-prime/documentales/crear") Crear nueva 
        span#spanCrear Documental
  if data && data.length > 0
    .table-responsive
      table.table
        thead#headTable 
          tr 
            th ID 
            th Nombre 
            th Estracto 
            th Actions 
        tbody#programasTable 
          each item, key in data 
            tr(id=`delete${item.id}`)
              td #{item.id}
              td #{item.estracto}
              td #{item.tipo}
              td 
                .btn-group
                  a.btn.btn-primary(href=`/admin-video-prime/documentales/editar/${item.id}`)
                    i.fas.fa-pen
                  a.btn.btn-info(href=`/admin-video-prime/documentales/mostrar/${item.id}`)
                    i.fas.fa-eye
                  button.btn.btn-danger(onclick=`beforeDeleteItem('/admin-video-prime/documentales/documental/${item.id}', ${item.id})`)
                    i.fas.fa-trash
 
  else 
    .alert.alert-primary(role='alert')
      | #{translation.ALERTS.NO_DOCUMENTALS_YET}

  nav(aria-label='...')
    ul.pagination
      li.page-item
        a#prevPage.page-link Previous
      li.page-item
        a#nextPage.page-link(href='#') Next

  script 
    include ../../../js/modulo-tv/delete.js
