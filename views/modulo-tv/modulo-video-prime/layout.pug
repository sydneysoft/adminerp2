extends ../../extends/menu-superior-admin

block contenido
  h1 #{translation.MODULE_MOVIE}
  ul.nav.nav-tabs
    li.nav-item
      a.nav-link(href='/admin-video-prime/peliculas') #{translation.MOVIES}
    li.nav-item
      a.nav-link(href='/admin-video-prime/series') #{translation.SERIES}
    li.nav-item
      a.nav-link(href='/admin-video-prime/documentales') #{translation.DOCUMENTALS}
    li.nav-item
      a.nav-link(href='/admin-video-prime/actores') #{translation.ACTORS}
    li.nav-item
      a.nav-link(href='/admin-video-prime/directores') #{translation.DIRECTORS}
    li.nav-item
      a.nav-link(href='/admin-video-prime/productores') #{translation.PRODUCERS}
    li.nav-item 
      a.nav-link(href='/admin-video-prime/videoupload') #{translation.UPLOAD}

  script.
    const currentPath = window.location.pathname
    const navLinks = $(".nav .nav-link");
    $.each(navLinks, function (index, value) {
      if(currentPath.startsWith(value.getAttribute('href'))) {
        value.classList.toggle('active')
      }
    });
   
