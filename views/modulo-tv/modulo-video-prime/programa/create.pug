extends ../../extends/menu-superior-admin

block contenido
  .my-3
    div
      a.btn.btn-primary(href="/admin-video-prime/programas") 
        i.fas.fa-arrow-left
        span.px-3 #{translation.BACK} 
    h1.text-center.mb-5 
      | #{translation.CREATE_NEW_TV_SHOW}
   
    .card
      .card.card-body 
          form#programas-forms
            .row.g-3 
              .col-12.mb-3.text-right 
                button.btn.btn-primary(type="submit") #{translation.SAVE} 
              .col-12.col-md-8
                label.form-label(for='nombre') #{translation.TV_SHOW_NAME}
                input#nombre.form-control(type='text' value='' required='' placeholder=translation.TV_SHOW_NAME name="")
                .valid-feedback
                  |  #{translation.NAME}

              .col-12.col-md-4
                label.form-label(for='numero_temporadas') #{translation.SEASONS_NUMBER}
                input#numero_temporadas.form-control(type='number' value='' required='' placeholder=translation.SEASONS_NUMBER name="num_temporadas")
                .valid-feedback
                  | #{translation.SEASONS_NUMBER}
                
              .col-12.my-3
              .col-12.col-md-6 
                label.form-label(for='slogan') #{translation.SLOGAN}
                input#slogan.form-control(type='text' value='' required='' placeholder=translation.SLOGAN name="slogan")
                .valid-feedback
                  | #{translation.SLOGAN}
              .col-12.col-md-6 
                label.form-label(for='slogan') #{translation.SHORT_DESCRIPTION}
                textarea#estracto.form-control(required='' placeholder=translation.SHORT_DESCRIPTION name="estracto")
                  |
                .valid-feedback
                  | #{translation.SLOGAN}
              .col-12.my-3 

              .col-12.col-md-8
                label.form-label(for='portada') #{translation.BAKGROUND_PHOTO}
                input#portada.form-control(type='text' value='' required='' placeholder=translation.BAKGROUND_PHOTO name="foto_portada")
                .valid-feedback
                  | #{translation.BAKGROUND_PHOTO}

              .col-12.col-md-4
                label.form-label(for='lanzamiento') #{translation.LAUNCHING_DATE}
                input#lanzamiento.form-control(type='text' value='' required='' placeholder=translation.LAUNCHING_DATE)
                .valid-feedback
                  | #{translation.LAUNCHING_DATE}
            
              .col-12.my-3

              .col-12.col-md-4
                label.form-label() #{translation.GENRE} 
                select#idGenero.custom-select(name="id_genero")
                  option(selected='0') #{translation.SELECT_GENRE}
              .col-12.col-md-4
                label.form-label() #{translation.DIRECTOR} 
                select#idDirector.custom-select(name="id_director")
                  option(selected='0') #{translation.SELECT_GENRE}
              .col-12.col-md-4
                label.form-label() #{translation.PRODUCER} 
                select#idProductor.custom-select(name="id_productor")
                  option(selected='0') #{translation.SELECT_GENRE}

  script 
    include ./programa.js
    include ../../../js/modulo-tv/save.js
  
  script.
    document.getElementById('programas-forms').addEventListener('submit', (event) => {
      event.preventDefault()
      save('/admin-video-prime/programas', {
        nombre: nombrePrograma.value,
        slogan: sloganPrograma.value,
        estracto: estractoPrograma.value,
        foto_portada: portadaPrograma.value,
        num_temporadas: num_temporadas.value,
        id_productora: idProductorPrograma.value,
        id_genero: idGeneroPrograma.value,
        id_director: idDirectorPrograma.value,
        fecha_lanzamiento: lanzamiento.value
      })
    });

    
