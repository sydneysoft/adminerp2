extends ../layout.pug

append contenido 
  .my-3
    div
      a.btn.btn-info(href="/admin-video-prime/directores") 
        i.fas.fa-arrow-left
        span.px-3 Atras
    h1.text-center.mb-5 
      | Crear nueva director
  .my-3 
    form#nuevaDirector(action=`/admin-video-prime/directores/index` method="post")
      .row.g-3 
        .col-12.mb-3.text-right 
          button.btn.btn-primary(type="submit") #{translation.SAVE}
        .col-12.col-md-8
          label.form-label(for='nombre') #{translation.FORM.PRODUCER_NAME}
          input#nombre.form-control(type='text' value='' required='' placeholder="Nombre del productor" name="nombre")
          .valid-feedback
            | #{translation.FORM.NAME}
        .col-12.col-md-4 
          label.form-label(for="nacionalidad") #{translation.FORM.NATIONALITY} 
          input#nacionalidad.form-control(type="text" value="" placeholder="Nacionalidad" name="nacionalidad" required)
        .col-12.my-3 
        .col-12.col-md-6 
          label.form-label(form="biografia") #{translation.FORM.BIOGRAPHY} 
          textarea#biografia.form-control(type="text" placeholder="Biografia")
            | 
        .col-12.col-md-3 
          label.form-label(for="fecha_nacimiento") #{translation.FORM.BIRTH_DATE}
          input#fecha_nacimiento.form-control(type="date" placeholder="Fecha de nacimiento" value="")
        .col-12.col-md-3 
          label.form-label(for="genero") #{translation.FORM.GENRE}
          select#genero.custom-select
            option(value='Masculino') #{translation.FORM.MALE}
            option(value='Femenino') #{translation.FORM.FEMALE}


  script.
    const editor = CKEDITOR.replace('biografia')

  script 
    include ./director.js
    include ../../../js/modulo-tv/save.js

  script.
    document.getElementById('nuevaDirector').addEventListener('submit', (event) => {
      event.preventDefault();
      save('/admin-video-prime/directores', {
        nombre: nombre.value,
        nacionalidad: nacionalidad.value,
        fecha_nacimiento: fecha_nacimiento.value,
        genero: genero.value,
        biografia: editor.getData()
      })
    })

