extends ../layout.pug


append contenido 
  .my-3
    .d-grid
      a#aCrear.btn.btn-primary.btn-block(type='button' href="/admin-video-prime/directores/crear") #{translation.CREATE_NEW}  
        span#spanCrear #{translation.DIRECTOR}
  if data && data.length > 0
    .table-responsive
      table.table
        thead#headTable 
          tr 
            th ID 
            th #{translation.NAME} 
            th #{translation.NATIONALITY} 
            th #{translation.GENRE}  
        tbody#programasTable 
          each item, key in data 
            tr 
              td #{item.id}
              td #{item.nombre}
              td #{item.nacionalidad}
              td #{item.genero}
              td 
                .btn-group
                  a.btn.btn-primary(href=`/admin-video-prime/directores/editar/${item.id}`)
                    i.fas.fa-pen
                  a.btn.btn-info(href=`/admin-video-prime/directores/mostrar/${item.id}`)
                    i.fas.fa-eye
                  button.btn.btn-danger(onclick=`beforeDeleteItem('/admin-video-prime/directores/director/${item.id}', ${item.id})`)
                    i.fas.fa-trash
 
  else 
    .alert.alert-primary(role='alert')
      | #{translation.NO_DIRECTORS_YET}

  nav(aria-label='...')
    ul.pagination
      li.page-item
        a#prevPage.page-link #{translation.PREVIOUS} 
      li.page-item
        a#nextPage.page-link(href='#') #{translation.NEXT} 

  script 
    include ../../../js/modulo-tv/delete.js
