extends ../layout.pug


append contenido 
  .my-3
    .d-grid
      a#aCrear.btn.btn-primary.btn-block(type='button' href="/admin-video-prime/actores/crear") Crear nueva 
        span#spanCrear Actor
  if data && data.length > 0
    .table-responsive
      table.table
        thead#headTable 
          tr 
            th ID 
            th #{translation.FORM.NAME}   
            th #{translation.FORM.NATIONALITY}   
            th #{translation.FORM.GENRE}   
        tbody#programasTable 
          each item, key in data 
            tr 
              td #{item.id}
              td #{item.nombre}
              td #{item.nacionalidad}
              td #{item.genero}
              td 
                .btn-group
                  a.btn.btn-primary(href=`/admin-video-prime/actores/editar/${item.id}`)
                    i.fas.fa-pen
                  a.btn.btn-info(href=`/admin-video-prime/actores/mostrar/${item.id}`)
                    i.fas.fa-eye
                  button.btn.btn-danger(onclick=`beforeDeleteItem('/admin-video-prime/actores/actor/${item.id}', ${item.id})`)
                    i.fas.fa-trash
 
  else 
    .alert.alert-primary(role='alert')
      | #{translation.ALERT.NO_DATA} 

  nav(aria-label='...')
    ul.pagination
      li.page-item
        a#prevPage.page-link #{translation.FORM.PREVIOUS} 
      li.page-item
        a#nextPage.page-link(href='#') #{translation.FORM.NEXT}

  script 
    include ../../../js/modulo-tv/delete.js
