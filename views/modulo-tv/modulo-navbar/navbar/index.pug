      } else {
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'error',
          title: 'Oops...',
          text: 'Something went wrong!',
          showConfirmButton: false,
          timer: 1500
        })
      }
    }

    function deleteChild (data) {
      if (Array.isArray(menuPayload)) {
        menuPayload = menuPayload.map(item => {
          if (item.children) {
            item.children =  deleteChildren(item.children, data);
          }
          return item;
        });
        edit_payload_child.innerHTML = '';
        renderMenuPayload();
      } else {
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'error',
          title: 'Oops...',
          text: 'Something went wrong!',
          showConfirmButton: false,
          timer: 1500
        })
      }
    }

    function deleteChildren(children, data) {
      return children.filter(child => {
        if (child.children) {
          child.children = deleteChildren(child.children, data);
        } else {
          if (child['data-identifier'] === data['data-identifier']) {
            return false;
          }
        }
        return true;
      });
    }
    
    function alterChildren(children, data, name, link) {
      return children.map(child => {
        if (child.children) {
          alterChildren(child.children, data, name, link);
        } else {
          if (child['data-identifier'] === data['data-identifier']) {
            child.text = name;
            child.href = link;
          }
        }
        return child;
      });
    }

