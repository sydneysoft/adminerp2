.modal.fade#nuevoBannerAdministrador(tabindex="-1" role="dialog")
  .modal-dialog.modal-lg(role="document")
    .modal-content
      .modal-body
        .row(style="padding:10px;margin-bottom:8px;")
          .col-md-12
            .form-group
              img(id="imagen-data-banner" src="https://www.cuba.travel/images/noimage.png" class="content-img-banner" onClick="handleModal()")
          .col-md-6
            .form-group
              h5 #{translation.NAME}:
              .controls
                input#nombreNuevo-banners-admin.form-control(type="text")
          .col-md-6
            .form-group
              h5 Url:
              .controls
                input#urlNuevo-banners-admin.form-control(type="text")
          .col-md-6
            .form-group
              h5 #{translation.STATUS}:
              .controls
                select#activadoNuevo-banners-admin.form-control
                  option(value="1") #{translation.ACTIVE}
                  option(value="0") #{translation.DEACTIVE}
          .col-md-6
            .form-group
              h5 #{translation.DESCRIPTION}:
              .controls
                textarea#descripcionNuevo-banners-admin.form-control(name="" cols="30" rows="5")
          .col-md-12.text-center
            button.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;",onClick=`AgregarBannerAdmin(${token})`) #{translation.ADD}
            button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}