script.
  //Funciones del Admin Banner
  const AgregarBannerAdmin = (token) => {

    let nombreBanner = $("#nombreNuevo-banners-admin").val();
    let imagenBanner = $("#imagen-data-banner").attr("src");
    let urlBanner = $("#urlNuevo-banners-admin").val();
    let estatusBanner = $("#activadoNuevo-banners-admin").val();
    let descripcionBanner = $("#descripcionNuevo-banners-admin").val();

    if (

      nombreBanner &&
      imagenBanner &&
      urlBanner &&
      estatusBanner &&
      descripcionBanner
    ) {
      Swal.showLoading();
      $.ajax({
        method: "POST",
        url: "/admin-banners",
        dataType: "json",
        data: {
          empresa_id: token,
          nombre: nombreBanner,
          imagen: imagenBanner,
          url: urlBanner,
          activado: estatusBanner,
          descripcion: descripcionBanner,
        },
        success: function (data) {
          if (data.status === "success") {
            $("#nuevoBannerAdministrador").modal("hide");
            Swal.close();
            clearBannerAdmin();
            window.location.reload(true);
          } else {
            Swal.close();
            Swal.fire({
              position: "center",
              icon: "error",
              title:
                "#{translation.BANNER_CANT_BE_ADDED}",
              showConfirmButton: false,
              timer: 2500,
            });
          }
        },
        error: function () {
          Swal.close();
          Swal.fire({
            position: "center",
            icon: "error",
            title: "#{translation.WRONG}",
            showConfirmButton: false,
            timer: 2500,
          });
        },
      });
    } else {
      Swal.fire({
        position: "center",
        icon: "error",
        title: "#{translation.COMPLETE_FORM}",
        showConfirmButton: false,
        timer: 2500,
      });
    }
  };

  const clearBannerAdmin = () => {
    $("#nombreNuevo-banners-admin").val("");

    $("#imgNuevo-banners-admin").val("");
    $("#urlNuevo-banners-admin").val("");
    $("#activadoNuevo-banners-admin").val("1");
    $("#descripcionNuevo-banners-admin").val("");
  };