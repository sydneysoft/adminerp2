script.
  let tablaBanners;
  addEventListener("DOMContentLoaded", () => {
    let urlAjaxBanners = "/admin-banners/datatable";
    if (typeof empresa_id != 'undefined' && empresa_id && empresa_id.value != "" && !isNaN(empresa_id.value)) {
      urlAjaxBanners += `/${empresa_id.value}`;
    }
    tablaBanners = $("#tabla-banners").DataTable({
      "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"},
      "responsive": true,
      searchDelay: 500,
      processing: true,
      serverSide: true,
      ajax: urlAjaxBanners,
      columns: [
        { data: 'id', name: 'id', title: 'ID', orderable: false, searchable: false, visible: false},
        { 
          data: 'imagen', name: 'imagen', title: #{translation.FORM.IMAGE},
          render: function (data, type, row) {
            try {
              new URL(row.imagen)
              return `<img src="${data}" style="width:50px;height:50px;object-fit:cover">`;
            } catch (e) {
              return `<img src="/images/image-default.jpg" style="width:50px;height:50px;object-fit:cover">`;
            }
          },
          orderable: false, searchable: false,
        },
        {
          data: 'nombre', name: 'nombre', title: #{translation.FORM.NAME}, orderable: true, searchable: true
        },
        {
          data: 'activado', name: 'activado', title: #{translation.FORM.STATUS},
          render: function (data, type, row) {
            if (data == "0") {
              return '<span class="badge badge-danger">#{translation.FORM.DISABLED}</span>';
            } else {
              return '<span class="badge badge-success">#{translation.FORM.ENABLED}</span>';
            }
          },
          orderable: false, searchable: false,
        },
        {
          data: 'acciones', name: 'acciones', title: #{translation.FORM.ACTIONS}, orderable: false, searchable: false,
          render: function (data, type, row) {
            let strRow = JSON.stringify(row);
            return `
              <button class="btn btn-warning" style="margin-right:7px;" type="button" onclick="handlingEditBannersAdmin(${row.id},'${row.nombre}','${row.url}','${row.descripcion}','${row.imagen}','${row.activado}')">
                <i class="fas fa-edit"></i>
              </button>
              <button class="delete btn btn-danger" onclick="deleteBannersAdminPanel('${row.id}')">
                <i class="fas fa-trash"></i>
              </button>
            `;
          }
        }
      ]
    });
  })
