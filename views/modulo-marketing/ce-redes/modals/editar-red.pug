//- Modal para editar una nuevo link a red social
.modal.fade.justify-content-center.align-items-center(role="dialog" id="editRedModal")
  .modal-dialog.modal-md
    .modal-content.modalContent(style="height: 100%;")
      .modal-header 
        .row(style="margin:0;")
          .col-md-12
            h3(style="margin:0px 0;") #{translation.ADD}

      .modal-body.borderBottom
        .row 
          .col-12
            .form-group
              label(for='nombre_edit') #{translation.FORM.NAME}
              input#nombre_edit.form-control(type='text' placeholder=translation.FROM.NAME name="nombre" required)
        .row 
          .col-12
            .form-group
              label(for='url_edit') #{translation.FORM.URL}
              input#url_edit.form-control(type='text' placeholder=translation.FORM.URL name="url" required)
          .col-12
            .form-group
              //- label(for='identificador_edit') #{translation.FORM.IDENTIFIER} (#{translation.OPTIONAL})
              select#identificador_edit.form-control(name="identificador" hidden)
                option(value="footer" selected) #{translation.FOOTER}
          input#itemId(type="text" value="" hidden)
        .row
          .col-12
            .form-group
              label(for='icono_edit') #{translation.FORM.ICON} 
              br
              button.btn.btn-info#icono_edit(data-iconset="fontawesome5" data-icon="fas fa-wifi" role="iconpicker")
                //- span#showIcon.ml-3
              //- input#icono.form-control(type='text' placeholder="Icono (Fontawesome)" name="icono" required)
              //- select#icono_edit.form-control

      .modal-footer(style="padding:8px;")
        .row(style="margin:0;")
          .col-md-12.text-right
            button#editRed.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.ADD}
              i.fas.fa-save.ml-3
            button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}