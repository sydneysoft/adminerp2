script.
  let tablaTestimonios;
  $(document).ready(function () {
    let urlAjaxTablaTestimonios = "/admin-testimonios/datatable"
    if (typeof empresa_id != 'undefined' && !isNaN(empresa_id.value)) {
      urlAjaxTablaTestimonios += `/${empresa_id.value}`;
    }
    tablaTestimonios = $("#tabla-testimonios").DataTable({
      columnDefs: [
        {
          orderable: false,
          className: "select-checkbox",
          targets: 0,
        },
      ],
      select: {
        style: "multi",
        selector: "td:first-child",
      },
      dom: "Bfrtip",
      buttons: ["selectAll", "selectNone"],
      order: [[1, "asc"]],
      language: {
        buttons: {
          selectAll: '#{translation.SELECT_EVERYTHING}',
          selectNone: '#{translation.ERASE_SELECTION}',
        },
        url: "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json",
        select: {
          rows: "%d filas seleccionadas",
        },
      },
      responsive: true,
      searchDelay: 500,
      processing: true,
      serverSide: true,
      ajax: urlAjaxTablaTestimonios,
      rowId: 'id',
      columns: [
        { 
          data: 'id', name: 'id', title: 'ID', orderable: false, searchable: false,
          render: function (data, type, row) {
            return ``;
          }
        },       
        // id	titulo	nombre	apellido	imagen	fecha	texto	calificacion
        {
          data: 'titulo', name: 'titulo', title: '#{translation.TITLE}',
        },
        {
          data: 'nombre', name: 'nombre', title: '#{translation.NAME}',
        },
        {
          data: 'apellido', name: 'apellido', title: '#{translation.LASTNAME}',
        },
        {
          data: 'imagen', name: 'imagen', title: '#{translation.IMAGE}',
          render: function (data, type, row) {
            try {
              new URL(row.imagen)
              return `<img src="${data}" style="width:50px;height:50px;object-fit:cover">`;
            } catch (e) {
              return `<img src="/images/image-default.jpg" style="width:50px;height:50px;object-fit:cover">`;
            }
          }
        },
        {
          data: 'fecha', name: 'fecha', title: '#{translation.DATE}',
        },
        {
          data: 'texto', name: 'texto', title: '#{translation.TEXT}',
          render: function (data, type, row) {
            return data.substring(0, 50) + '...';
          }
        },
        {
          data: 'calificacion', name: 'calificacion', title: '#{translation.RATING}',
        },
        {
          data: 'acciones',
          name: 'acciones',
          title: '#{translation.ACTIONS}',
          render: function (data, type, row) {
            let strRow = JSON.stringify(row);
            return `
              <button class="btn btn-primary btn-sm" onclick='setTestimonioData(${strRow})'>
                <i class="fas fa-edit"></i>
              </button>
              <button class="btn btn-danger btn-sm" onclick="beforeDeleteItem('/admin-testimonios/${row.id}', ${row.id})">
                <i class="fas fa-trash"></i>
              </button>
              `
          },
          orderable: false,
          searchable: false
        },
      ],
      initComplete: function (settings) {
        //- clone thead to tfoot
        $("#tabla-testimonios thead tr").clone().appendTo($("#tabla-testimonios tfoot"));
      }
    });


    $("#accionesBoton").click(function () {
      const valorSeleccionado = $("#acciones").val();
      const selected_rows = tablaTestimonios
        .rows({
          selected: true,
        })
        .ids();

      const arraySeleccion = $.makeArray(selected_rows);
      switch (valorSeleccionado) {
        case "0":
          eliminarProductos(arraySeleccion, "testimonios");
          break;
      }
    });
  });