.modal.fade.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="nuevoTestimonioModal")
  .modal-dialog.modal-lg
    .modal-content.modalContent(style="height: 100%;")
      .modal-header 
        .row(style="margin:0;")
          .col-md-12
            h3(style="margin:0px 0;") #{translation.CREATE}

      .modal-body.borderBottom
        //- id	titulo	nombre	apellido	imagen	fecha	texto	calificacion
        .row
          .col-12
            .form-group
              label(for="titulo") #{translation.TITLE}
              input#titulo.form-control(type="text" placeholder=translation.TITLE)

          .col-6
            .form-group
              label(for="nombre") Nombre
              input#nombre.form-control(type="text" placeholder="Nombre")
          .col-6
            .form-group
              label(for="apellido") Apellido
              input#apellido.form-control(type="text" placeholder="Apellido")
          
          .col-4
            .form-group
              label(for="fecha") Fecha
              input#fecha.form-control(type="date" placeholder="Fecha")
          .col-4
            .form-group
              label(for="calificacion") Calificación
              input#calificacion.form-control(type="number" placeholder="Calificación")
          .col-12
            .form-group
              label(for="texto") Texto
              textarea#texto.form-control(type="text" placeholder="Texto")

      .modal-footer(style="padding:8px;")
        .row(style="margin:0;")
          .col-md-12.text-right
            button#addTestimonio.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.SAVE}
              i.fas.fa-save.ml-2
            button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
