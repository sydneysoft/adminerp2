extends ../../extends/menu-superior-admin
block contenido
    .row
        .col-12.text-grey(style="margin-bottom:50px;")
            h1.display-1
                strong #{translation.POPUP_WINDOW_LIST}
        .col-md-12.mb-5
                button.btn.btn-success(style="margin-bottom:10px", type="button", onClick="openModalNew()")
                    i.fas-fa-plus
                    span #{translation.ADD_POPUP}
        .col-md-12
            .row
                each book in items.ventanas
                    .col-12.col-md-6
                        .container-banner
                            .row
                                .col-12.text-center
                                    img(src=book.imagen, alt=book.name, style="width: 100%; height: 250px;object-fit:cover;border-radius:4px")
                                .col-12.text-center.mt-3
                                    button.btn.btn-warning(onClick="handlingEditVentanaAdmin('"+book.id+"','"+book.url+"','"+book.imagen+"','"+book.estado+"')")
                                        i.fas.fa-edit
                                    button.btn.btn-danger(style="margin-left:10px",onClick="deleteVentanasAdminPanel('"+book.id+"')")
                                        i.fas.fa-trash
        .modal#editarBannerAdministrador(tabindex="-1" role="dialog")
            .modal-dialog(role="document")
                .modal-content
                    .modal-body
                        .row(style="padding:10px;margin-bottom:8px;")
                            .col-md-12
                                .form-group
                                    img(id="imagen-data-banner-editar" src="https://www.cuba.travel/images/noimage.png" class="content-img-banner" onClick="handleModal()")
                            .col-6
                                .form-group
                                    label Url:
                                    .controls
                                        input#data-id-ventanas(type="hidden")
                                        input#urlEditar-ventantas-admin.form-control(type="text")
                            .col-md-6
                                .form-group
                                    label #{translation.FORM.STATUS}:
                                    .controls
                                        select#activadoEditar-ventanas-admin.form-control
                                            option(value="1") #{translation.FORM.ACTIVE}
                                            option(value="0") #{translation.FORM.DEACTIVATE}
                            .col-md-12.text-center
                                button.btn.btn-success.nuevo(type="button", style="margin-left:7px;margin-right:7px;",onClick=`updateVentanaAdmin(${token})`) #{translation.FORM.UPDATE_DATA}
                                button.btn.btn-danger(type="buton", data-dismiss="modal") Cerrar
        .modal#nuevoBannerAdministrador(tabindex="-1" role="dialog")
            .modal-dialog(role="document")
                .modal-content
                    .modal-body
                        .row(style="padding:10px;margin-bottom:8px;")
                            .col-md-12
                                .form-group
                                    img(id="imagen-data-banner" src="https://www.cuba.travel/images/noimage.png" class="content-img-banner" onClick="handleModal()")
                            .col-md-6
                                .form-group
                                    label Url:
                                    .controls
                                        input#urlNuevo-ventanas-admin.form-control(type="text")
                            .col-md-6
                                .form-group
                                    label #{translation.FORM.STATUS}:
                                    .controls
                                        select#activadoNuevo-ventanas-admin.form-control
                                            option(value="1") #{translation.FORM.ACTIVE}
                                            option(value="0") #{translation.FORM.DEACTIVATE}
                            .col-md-12.text-center
                                button.btn.btn-success.nuevo(type="button", style="margin-left:7px;margin-right:7px;",onClick=`AgregarVentanaEmergenteAdmin(${token})`) #{translation.ADD}
                                button.btn.btn-danger(type="buton", data-dismiss="modal") #{translation.CLOSE}
        include ./../../modulo-generales/galeria-fotos/seleccion-unica-galeria/admin-galeria-modal-simple
    
    script 
        include ./additionalVentanaEmer.js
  
    script.
        var typeOperation="1";
 