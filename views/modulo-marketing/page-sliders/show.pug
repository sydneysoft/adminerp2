extends ./layout.pug

append contenido 
  .border-bottom.border-left.border-right.rounded-bottom.p-3
    if data
      .row.justify-content-between
        .col
          button.btn.btn-info(role="button" onclick="window.history.back()") #{translation.BACK}
        .col.text-right 
          a.btn.btn-primary(role="button" href=`/admin-sliders/slider/editar/${data.id}`) #{translation.EDIT}
        .col-12
          .input-group.mb-3
            .input-group-prepend
              span.input-group-text #{translation.NAME}
            input.form-control(type='text' aria-describedby='basic-addon1' placeholder=translation.NAME value=data.nombre readonly)
        .col-12
          .input-group.mb-3
            .input-group-prepend
              span.input-group-text #{translation.THUMBNAIL}
            input.form-control(type='text' aria-describedby='basic-addon1' placeholder=translation.THUMBNAIL value=data.url readonly)
        .col-12
          .input-group.mb-3
            .input-group-prepend
              span.input-group-text #{translation.ALTERNATIVE_TEXT}
            input.form-control(type='text' aria-describedby='basic-addon1' placeholder=translation.ALTERNATIVE_TEXT value=data.alt readonly)
        .col-12 
          .form-group   
            label() #{translation.DESCRIPTION}
            .card 
              .card-body 
                  div
                    | #{data.descripcion}
    else 
      .alert.alert-info.mt-3(role="alert")
        | #{translation.NO_DATA}

