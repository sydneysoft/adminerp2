script.
  const guardar_personal = document.getElementById("guardarPersonal");
  guardar_personal.addEventListener("click", (event) => {
    const nombre = document.getElementById("nombre").value;
    const tipo_documento = document.getElementById("tipo-documento").value;
    const nro_documento = document.getElementById("nro-documento").value;
    const data = {
      nombre,
      tipo_documento,
      nro_documento
    };

    if (typeof empresa_id != 'undefined' && empresa_id && !isNaN(empresa_id.value)) {
      data.empresa_id = empresa_id.value;
    }

    if (nombre != "" && tipo_documento != "" && nro_documento != "") {
      $.ajax({
        url: "/admin-personal",
        type: "POST",
        data: data,
        success: function (data) {
          if (data.ok) {
            if (typeof tablaPersonales != 'undefined' && tablaPersonales) {
              tablaPersonales.ajax.reload();
            }
            toastSweet('Exito', '#{translation.ALERTS.CREATED}', 'success');
            $("#nuevoPersonalModal").modal("hide");
          } else {
            toastSweet('Error', '#{translation.ALERTS.WRONG}', 'error');
          }
        },
        error: function (data) {
          toastSweet('Error', '#{translation.ALERTS.WRONG}', 'error');
        }
      });
    } else {
      toastSweet('Error', '#{translation.ALERTS.REQUIRED_FIELDS}', 'error');
    }
  });