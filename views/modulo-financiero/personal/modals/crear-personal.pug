.modal.fade#nuevoPersonalModal(tabindex="-1" role="dialog")
  .modal-dialog.modal-md(role="document")
    .modal-content
      .modal-body
        .row
          .col-12
            .form-group
              label(for="nombre") #{translation.NAME} *
              input#nombre.form-control(type="text" placeholder=translation.NAME)
          .col-12.col-md-6
            .form-group
              label(for="tipo-documento") #{translation.DOCUMENT_TYPE} *
              select#tipo-documento.form-control
                option(value="L.E / DNI") #{translation.DOCUMENT_NUMBER}
                option(value="CARNET DE EXTRANJERIA") 	#{translation.FOREIGNER_CARD}
                option(value="REG. UNICO DE CONTRIBUYENTES") #{translation.UNIQUE_REGISTRATION_NUMBER}
                option(value="PASAPORTE") #{translation.PASSPORT}
                option(value="PART. DE NACIMIENTO") #{translation.BIRTH_REGISTRATION} 
                option(value="OTROS") #{translation.OTHERS}
          .col-12.col-md-6
            .form-group
              label(for="nro-documento") #{translation.DOCUMENT_NUMBER} *
              input#nro-documento.form-control(type="number" placeholder=translation.DOCUMENT_NUMBER)
      .modal-footer
        button#guardarPersonal.btn.btn-success.nuevo(type="button" onclick="") #{translation.ADD}
          i.fas.fa-save.ml-2
        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
          i.fas.fa-times-circle.ml-2
