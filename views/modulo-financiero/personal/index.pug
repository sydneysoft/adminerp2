extends ../../extends/menu-superior-admin
block contenido
  .row
    if empresa_id
      input#empresa_id(type="text" value=empresa_id hidden)
    .col-6.text-grey(style="margin-bottom:10px;")
      h1.display-1
        strong  #{translation.PERSONAL}
    .col-md-6.col-6.text-right 
      button.btn.btn-success(style="margin-bottom:25px;" type="button" data-toggle="modal" data-target="#nuevoPersonalModal")
        span #{translation.ADD_BRAND}
        i.fas.fa-plus.ml-2
    .col-12
      div.table-responsive
        table.table.table-bordered#tabla-personal
          thead.thead-dark
  script
    include /js/toast.sweet.js

  include ./modals/crear-personal.pug
  include ./modals/editar-personal.pug

  include ./save/personal.pug
  include ./update/personal.pug
  include ./delete/personal.pug


  include ./datatable/personal.pug
  include ./select2/personal.pug