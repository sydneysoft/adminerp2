.modal.fade#gestionar(tabindex="-1" role="dialog" )
  .modal-dialog.modal-lg(role="document")
    .modal-content
      .modal-header 
        .row 
          .col-12
            h5.strong(style="font-size:1rem;") #{translation.WORKERS}
      .modal-body.almacen
        .row
          .col-md-12.col-12
            p #{translation.PERSONAL_DETAILS_MESSAGE_DELETED}
            div.table-responsive
              table#tabla-gestionar-personal.table.table-bordered

                thead.thead-dark
                  //- tr.table-head
                    //- if activo_marketplace===1
                      th.text-left Empresa
                    th.text-left Nombre
                    th.text-left Tipo 
                    th.text-left Documento
                    th.text-center Acción
                //- tbody
                  //- each item in personalInfo
                    tr
                      //- if activo_marketplace===1
                        td.text-center= item.empresa_id?((empresas.filter((i) => i.empresa_id == item.empresa_id)).length?(empresas.filter((i) => i.empresa_id == item.empresa_id))[0].nombre:item.empresa_id==0?"-" : item.empresa_id):"-" 

                      td.text-left= item.nombre
                      td.text-left= item.tipo_documento
                      td.text-left= item.nro_documento
                      td.text-center

                        button.btn.btn-danger( onclick="deleteAdminPanel('"+item.nro_documento+"',`/admin-pago-personal/data/`)" style="margin-left:8px")
                          i.fa.fa-trash  

        .modal-footer      
          button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
