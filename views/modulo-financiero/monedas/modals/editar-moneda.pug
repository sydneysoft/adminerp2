.modal.fade#editarMonedaModal(tabindex="-1" role="dialog" )
  .modal-dialog.modal-lg(role="document")
    .modal-content
      .modal-header 
        .row 
          .col-12
            h5.strong(style="font-size:1rem;") #{translation.EDIT_BANK}

      .modal-body-almacen
        .row(style="padding:15px;")
          .col-md-6.col-12
            .form-group
              label(for="nombreMonedaEditar") Nombre de la moneda *
              input#nombreMonedaEditar.form-control(type="text" placeholder="Nombre de la moneda")
          .col-md-6.col-12
            .form-group
              label(for="lista-paises-editar") #{translation.COUNTRY}:
              select#lista-paises-editar
          .col-md-6.col-12
            .form-group
              label(for="codigoMonedaEditar") Codigo de la moneda: 
              input#codigoMonedaEditar.form-control(type="text" name="codigoMoneda" placeholder="Codigo de la moneda")
          .col-md-6.col-12
            .form-group
              label(for="simboloMonedaEditar") Simbolo de la moneda: 
              input#simboloMonedaEditar.form-control(type="text" name="simboloMoneda" placeholder="Simbolo de la moneda")

      .modal-footer      
        button#editarMoneda.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.UPDATE}
          i.fas.fa-save.ml-2
        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
          i.fas.fa-times.ml-2
