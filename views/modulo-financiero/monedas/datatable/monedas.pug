script.
  let tablaMonedas;
  $(document).ready(function () {
    let urlAjaxTablaMonedas = "/admin-monedas/datatable"
    if (typeof empresa_id != 'undefined' && !isNaN(empresa_id.value)) {
      urlAjaxTablaMonedas += `/${empresa_id.value}`;
    }
    tablaMonedas = $("#tabla-monedas").DataTable({
      columnDefs: [
        {
          orderable: false,
          className: "select-checkbox",
          targets: 0,
        },
      ],
      select: {
        style: "multi",
        selector: "td:first-child",
      },
      dom: "Bfrtip",
      buttons: ["selectAll", "selectNone"],
      order: [[1, "asc"]],
      language: {
        buttons: {
          selectAll: '#{translation.SELECT_EVERYTHING}',
          selectNone: '#{translation.ERASE_SELECTION}',
        },
        url: "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json",
        select: {
          rows: "%d filas seleccionadas",
        },
      },
      responsive: true,
      searchDelay: 500,
      processing: true,
      serverSide: true,
      ajax: urlAjaxTablaMonedas,
      rowId: 'id',
      columns: [
        { 
          data: 'id', name: 'id', title: 'ID', orderable: false, searchable: false,
          render: function (data, type, row) {
            return ``;
          }
        },
        { data: 'nombre', name: 'nombre', title: '#{translation.NAME}', orderable: true, searchable: true},
        {
          data: 'codigo', name: 'codigo', title: 'Codigo', orderable: true, searchable: true
        },
        {
          data: 'simbolo', name: 'simbolo', title: 'Simbolo', orderable: false, searchable: false
        },
        {
          data: 'pais', name: 'pais', title: '#{translation.COUNTRY}'
        },
        { 
          data: 'acciones', name: 'acciones', title: '#{translation.ACTIONS}', orderable: false, searchable: false,
          render: function (data, type, row) {
            let strRow = JSON.stringify(row);
            return `
              <button class="btn btn-warning" onclick='setDataEditarMoneda(${strRow})'><i class="fa fa-edit"></i></button>
              <button class="btn btn-danger" onclick="deleteMoneda(${row.id})"><i class="fa fa-trash"></i></button>
            `;
          }
        }
      ],
      initComplete: function (settings) {
        //- clone thead to tfoot
        $("#tabla-monedas thead tr").clone().appendTo($("#tabla-monedas tfoot"));
      }
    });


    $("#accionesBoton").click(function () {
      const valorSeleccionado = $("#acciones").val();
      const selected_rows = tablaMonedas
        .rows({
          selected: true,
        })
        .ids();

      const arraySeleccion = $.makeArray(selected_rows);
      switch (valorSeleccionado) {
        case "0":
          eliminarProductos(arraySeleccion, "monedas");
          break;
      }
    });
  });