script.
  //Anular Factura o Boleta
  const handleAnularInvoice = (number, type, id) => {
      Swal.fire({
          title: "Estás Seguro?",
          text: "No podras revertir esta acción",
          icon: "warning",
          showCancelButton: true,
          confirmButtonColor: "#3085d6",
          cancelButtonColor: "#d33",
          confirmButtonText: #{translation.ALERTS.YES_DELETE},
      }).then((result) => {
          if (result.isConfirmed) {
              anularInvoiceFunction(number, type, id);
          }
      });
  };

  //Petición para ejecutar Eliminación
  const anularInvoiceFunction = (number, type, id) => {
      if (number && type && id) {
          Swal.showLoading();
          $.ajax({
              method: "POST",
              url: "/data-invoice-cancel",
              dataType: "json",
              data: { number: number, type: type, id: id },
              success: function (data) {
                  if (data.status == "error") {
                      Swal.close();
                      Swal.fire({
                          position: "center",
                          icon: "error",
                          html: "<b>" + data.msg + "</b>",
                          showConfirmButton: false,
                          timer: 2500,
                      });
                  } else {
                      Swal.close();
                      window.location.reload(true);
                  }
              },
              error: function (e) {
                  Swal.close();
                  Swal.fire({
                      position: "center",
                      icon: "error",
                      title: #{translation.ALERTS.WRONG},
                      showConfirmButton: false,
                      timer: 2500,
                  });
              },
          });
      }
  };