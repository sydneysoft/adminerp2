script.
  let tablaImpuestos;
  $(document).ready(function () {
    let urlAjaxTablaImpuestos = "/admin-impuestos/datatable"
    if (typeof empresa_id != 'undefined' && !isNaN(empresa_id.value)) {
      urlAjaxTablaImpuestos += `/${empresa_id.value}`;
    }
    tablaImpuestos = $("#tabla-impuestos").DataTable({
      columnDefs: [
        {
          orderable: false,
          className: "select-checkbox",
          targets: 0,
        },
      ],
      select: {
        style: "multi",
        selector: "td:first-child",
      },
      dom: "Bfrtip",
      buttons: ["selectAll", "selectNone"],
      order: [[1, "asc"]],
      language: {
        buttons: {
          selectAll: '#{translation.FORM.SELECT_EVERYTHING}',
          selectNone: '#{translation.FORM.ERASE_SELECTION}',
        },
        url: "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json",
        select: {
          rows: "%d filas seleccionadas",
        },
      },
      responsive: true,
      searchDelay: 500,
      processing: true,
      serverSide: true,
      ajax: urlAjaxTablaImpuestos,
      rowId: 'id',
      columns: [
        { 
          data: 'id', name: 'id', title: 'ID', orderable: false, searchable: false,
          render: function (data, type, row) {
            return ``;
          }
        },
        { data: 'nombre', name: 'nombre', title: '#{translation.FORM.NAME}', orderable: true, searchable: true},
        {
          data: 'codigo', name: 'codigo', title: 'Codigo', orderable: true, searchable: true
        },
        {
          data: 'tasa', name: 'tasa', title: 'Tasa', orderable: false, searchable: false,
          render: function (data, type, row) {
            return `${data}%`;
          }
        },
        {
          data: 'pais', name: 'pais', title: '#{translation.FORM.COUNTRY}'
        },
        { 
          data: 'acciones', name: 'acciones', title: '#{translation.FORM.ACTIONS}', orderable: false, searchable: false,
          render: function (data, type, row) {
            let strRow = JSON.stringify(row);
            return `
              <button class="btn btn-warning" onclick='setDataEditarImpuesto(${strRow})'><i class="fa fa-edit"></i></button>
              <button class="btn btn-danger" onclick="deleteImpuesto(${row.id})"><i class="fa fa-trash"></i></button>
            `;
          }
        }
      ],
      initComplete: function (settings) {
        //- clone thead to tfoot
        $("#tabla-impuestos thead tr").clone().appendTo($("#tabla-impuestos tfoot"));
      }
    });


    $("#accionesBoton").click(function () {
      const valorSeleccionado = $("#acciones").val();
      const selected_rows = tablaImpuestos
        .rows({
          selected: true,
        })
        .ids();

      const arraySeleccion = $.makeArray(selected_rows);
      switch (valorSeleccionado) {
        case "0":
          eliminarProductos(arraySeleccion, "impuestos");
          break;
      }
    });
  });