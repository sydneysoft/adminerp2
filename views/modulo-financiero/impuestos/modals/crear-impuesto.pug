.modal.fade#nuevoImpuestoModal(tabindex="-1" role="dialog" )
  .modal-dialog.modal-lg(role="document")
    .modal-content
      .modal-header 
        .row 
          .col-12
            h5.strong(style="font-size:1rem;") #{translation.NEW_TAX}

      .modal-body-almacen
        .row(style="padding:15px;")
          .col-md-6.col-12
            .form-group
              label(for="nombreImpuesto") #{translation.TAX_NAME}*
              input#nombreImpuesto.form-control(type="text" placeholder="Nombre de la moneda")
          .col-md-6.col-12
            .form-group
              label(for="lista-paises") #{translation.COUNTRY}:
              select#lista-paises
          .col-md-4.col-12
            .form-group
              label(for="tasaImpuesto") #{translation.TAX_FEE} % *
              input#tasaImpuesto.form-control(type="number" name="tasaImpuesto" placeholder="Tasa de impuesto")
          .col-md-4.col-12
            .form-group
              label(for="codigoImpuesto") #{translation.TAX_CODE}:
              input#codigoImpuesto.form-control(type="text" name="codigoImpuesto" placeholder="Codigo de impuesto")
          .col-12
            .form-group
              label(for="descripcionImpuesto") #{translation.DESCRIPTION}:
              textarea#descripcionImpuesto.form-control(type="text" name="descripcionImpuesto" placeholder="Descripcion")
      .modal-footer      
        button#guardarImpuesto.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.SAVE}
          i.fas.fa-save.ml-2
        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
          i.fas.fa-times.ml-2
