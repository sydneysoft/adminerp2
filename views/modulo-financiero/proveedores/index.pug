extends ../../extends/menu-superior-admin
block contenido
  .row
    if empresa_id
      input#empresa_id(type="text" value=empresa_id hidden)
    .col-md-6.col-6.text-grey(style="margin-bottom:10px;")
      h1.display-1
        strong #{translation.PROVIDERS} 
          //- span.light= `${proveedores.length} `
      p.light #{translation.CREATE_MANAGE_PROVIDERS} 

    .col-md-6.col-6.text-right 

      button.btn.btn-success(type="button" onClick="nueva()")
        i.fas.fa-plus
          span   #{translation.NEW_PROVIDER}

    .col-12 
      div.table-responsive
      table#tabla-proveedores.table.table-bordered
        thead.thead-dark
        tbody 
        tfoot 
  script(src="//cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.15/js/intlTelInput.js")
  script
    include /js/toast.sweet.js
    
  include ./modals/crear-proveedor.pug
  include ./modals/editar-proveedor.pug
  include ./styles/proveedores.pug

  include ./save/proveedor.pug
  include ./update/proveedor.pug
  include ./delete/proveedor.pug

  script
    include ./script.js

  include ./datatable/proveedor.pug




