script.
  function guardarProveedor () {
    let nombre = $("#nombreProveedorNuevo").val();
    let ruc = $("#rucNuevo").val();
    let razon_social = $("#razonSocialNuevo").val();
    let telefono_corporativo = telefono_corporativo_obt.getNumber();
    let email_corporativo = $("#correoCorporativoNuevo").val();
    let direccion = $("#direccionNuevo").val();
    let nombre_contacto = $("#nombreContactoNuevo").val();
    let telefono_contacto = telefono_contacto_obt.getNumber();
    let email_contacto = $("#correoContactoNuevo").val();

    const auxData = {
      nombre: nombre,
      ruc: ruc,
      razon_social: razon_social,
      telefono_corporativo: telefono_corporativo,
      email_corporativo: email_corporativo,
      direccion: direccion,
      nombre_contacto: nombre_contacto,
      telefono_contacto: telefono_contacto,
      email_contacto: email_contacto,
    }
    if (typeof empresa_id != 'undefined' && empresa_id && !isNaN(empresa_id.value)) {
      auxData.empresa_id = empresa_id.value;
    }
    $.ajax({
      url: "/admin-proveedores",
      type: "POST",
      dataType: "json",
      data: auxData,
      success: function (data) {
        Swal.close();
        if (typeof tablaProveedores != 'undefined' && tablaProveedores) {
          tablaProveedores.ajax.reload();
        }
        toastSweet('Success', '#{translation.ALERTS.CREATED}', 'success');
        
        $("#guardarProveedoreModal").modal("hide");
        //- window.location.reload(true);
      },
      error: function (err) {
        if ((err.responseJSON.msg == "Usuario existente") == true) {
          toastSweet('Error', 'Email coorporativo ya fue registrado', 'error');
        } else {

          Swal.close();
          toastSweet('Error', '#{translation.ALERTS.WRONG}', 'error');
        }
      }
    });
  }