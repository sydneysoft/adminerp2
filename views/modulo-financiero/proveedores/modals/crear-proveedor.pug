.modal.fade#guardarProveedoreModal(tabindex="-1" role="dialog" )
  .modal-dialog.modal-lg(role="document")
    .modal-content
      .modal-header 
        .row 
          .col-12
            h5.strong(style="font-size:1rem;") #{translation.PROVIDER_DATA} 

      .modal-body 
        form
          .step-one.step.step-active
            .row(style="padding:15px;")
              .col-12
                h4.title #{translation.FORM.GENERAL_INFO} 
                hr
              .col-md-6.col-12
                .form-group
                  label #{translation.FORM.COMMERCIAL_NAME_PROVIDER}*
                  .controls
                    input#nombreProveedorNuevo.form-control(type="text")
              .col-md-6.col-12
                .form-group
                  label #{translation.FORM.RUC}*
                  .controls
                    input#rucNuevo.form-control(type="text")
              .col-md-6.col-12
                .form-group
                  label #{translation.FORM.RAZON_SOCIAL}
                  .controls
                    input#razonSocialNuevo.form-control(type="text")
              .col-md-6.col-12
                .form-group
                  label #{translation.FORM.CORPORATE_EMAIL}*
                  .controls
                    input#correoCorporativoNuevo.form-control(type="text")
              .col-md-6.col-12
                .form-group
                  label #{translation.FORM.CORPORATE_PHONE}*
                  .controls
                    input#celularCorporativoNuevo.form-control(type="text")
              .col-md-6.col-12
                .form-group
                  label #{translation.FORM.ADDRESS}
                  .controls
                    input#direccionNuevo.form-control(type="text")

            .row.justify-content-end.mt-4
              .col-md-4
                button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CANCEL}
                span  
                button.btn.btn-primary(onclick="changeStep()" type="button") #{translation.NEXT}
          .step-two.step.hidden
            .row(style="padding:15px;")
              .col-12
                h4.title #{translation.CONTACT_DATA}
                hr
              .col-md-6.col-12
                .form-group
                  label #{translation.FORM.NAME}
                  .controls
                    input#nombreContactoNuevo.form-control(type="text")
              .col-md-6.col-12
                .form-group
                  label #{translation.FORM.MOBILE}

                  .controls
                    input#celularContactoNuevo.form-control(type="text")              
              .col-md-6.col-12
                .form-group
                  label #{translation.FORM.EMAIL}
                  .controls
                    input#correoContactoNuevo.form-control(type="text" )            


            .row.justify-content-end.mt-4
              .col-md-4
                button.btn.btn-primary(onclick="changeStep()" type="button") Atr&aacute;s
                span 
                button.btn.btn-success(type='button' onclick="guardarProveedor()" data-target="#guardarProveedoreModal") #{translation.SAVE}
