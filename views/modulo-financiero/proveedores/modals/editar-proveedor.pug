.modal.fade#editarProveedoreModal(tabindex="-1" role="dialog" )
  .modal-dialog.modal-lg(role="document")
    .modal-content
      .modal-header 
        .row 
          .col-12
            h5.strong(style="font-size:1rem;") #{translation.RUC}

      .modal-body 
        form
          .step-one.step.step-active
            .row(style="padding:15px;")
              .col-12
                h4.title #{translation.GENERAL_INFO}
                hr
              .col-md-6.col-12
                .form-group
                  label #{translation.FORM.COMMERCIAL_NAME_PROVIDER}*
                  .controls
                    input#nombreProveedorNuevo-editar.form-control(type="text")
              .col-md-6.col-12
                .form-group
                  label #{translation.FORM.RUC}*
                  .controls
                    input#rucNuevo-editar.form-control(type="text")
              .col-md-6.col-12
                .form-group
                  label #{translation.FORM.RAZON_SOCIAL}*
                  .controls
                    input#razonSocialNuevo-editar.form-control(type="text")
              .col-md-6.col-12
                .form-group
                  label #{translation.FORM.COPORATE_EMAIL}*
                  .controls
                    input#correoCorporativoNuevo-editar.form-control(type="text")
              .col-md-6.col-12
                .form-group
                  label #{translation.FORM.COPORATE_PHONE}*
                  .controls
                    input#celularCorporativoNuevo-editar.form-control(type="text")
              .col-md-6.col-12
                .form-group
                  label #{translation.FORM.ADDRESS}
                  .controls
                    input#direccionNuevo-editar.form-control(type="text")

            .row.justify-content-end.mt-4
              .col-md-4
                button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CANCEL}
                span  
                button.btn.btn-primary(onclick="changeStepEditar()" type="button") #{translation.NEXT}
          .step-two.step.hidden
            .row(style="padding:15px;")
              .col-12
                h4.title #{translation.CONTACT_DATA}
                hr
              .col-md-6.col-12
                .form-group
                  label #{translation.FORM.NAME}
                  .controls
                    input#nombreContactoNuevo-editar.form-control(type="text")
              .col-md-6.col-12
                .form-group
                  label #{translation.FORM.PHONE}

                  .controls
                    input#celularContactoNuevo-editar.form-control(type="text")              
              .col-md-6.col-12
                .form-group
                  label #{translation.FORM.EMAIL}
                  .controls
                    input#correoContactoNuevo-editar.form-control(type="text" )            

              input#itemId(type="text" value="" hidden)
            .row.justify-content-end.mt-4
              .col-md-4
                button.btn.btn-primary(onclick="changeStepEditar()" type="button") #{translation.BACK}
                span 
                button.btn.btn-success(type='button' onclick="actualizarProveedor()" data-target="#editarProveedoreModal") #{translation.SAVE}
