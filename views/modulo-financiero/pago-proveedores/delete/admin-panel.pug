script.

  const eliminarPagoProveedoresAdmin = (id) => {
    Swal.fire({
      title: "Estás Seguro?",
      text: "No podras revertir esta acción",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: #{translation.ALERTS.YES_DELETE},
    }).then((result) => {
      if (result.isConfirmed) {
        Swal.showLoading();
        fetch('/admin-pago-proveedores/'+ id, {
          method: "delete",
        })
          .then((data) => {
            Swal.close();
            if (data.ok) {
              if (typeof tablaPagoProveedores != 'undefined' && tablaPagoProveedores) {
                tablaPagoProveedores.ajax.reload();
              }
              toastSweet('Success', '#{translation.ALERTS.DELETED}', 'success');
            } else {
              toastSweet('Error', '#{translation.ALERTS.WRONG}', 'error');
            }
          })
          .catch(() => {
            Swal.close();
            toastSweet('Error', '#{translation.ALERTS.WRONG}', 'error');
          });
      }
    });
  };