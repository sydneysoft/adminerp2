script.
  let tablaPagoProveedores;
  $(document).ready( function () {
    let urlAjaxTablaPagoProveedores = "/admin-pago-proveedores/datatable";
    if (typeof empresa_id != 'undefined' && empresa_id.value != "" && !isNaN(empresa_id.value)) {
      urlAjaxTablaPagoProveedores = "/admin-pago-proveedores/datatable/" + empresa_id.value;
    }

    tablaPagoProveedores = $('#tabla-pago-proveedores').DataTable({
      "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"},
      fnCreatedRow: function (nRow, aData, iDataIndex) {
        $(nRow).attr('id', aData.id);
      },
      columnDefs: [
        {
          orderable: false,
          className: "select-checkbox",
          targets: 0,
        },
      ],

      select: {
        style: "multi",
        selector: "td:first-child",
      },
      rowId: 'id',
      dom: "Bfrtip",
      buttons: ["selectAll", "selectNone"],
      searchDelay: 500,
      processing: true,
      serverSide: true,
      ajax: urlAjaxTablaPagoProveedores,
      columns: [
        { data: 'id', name: 'id', title: "ID", searchable: false,checkboxes: {'selectRow':true }, render: function () { return ""} },
        {
          data: 'insumo', name: 'insumo', title: '#{translation.INSUMO}', orderable: true, searchable: true
        },
        {
          data: 'cuit', name: 'cuit', title: '#{translation.CUIT}', orderable: true, searchable: true
        },
        {
          data: 'nombre_proveedor', name: 'nombre_proveedor', title: '#{translation.FORM.PROVIDERS_NAME}', orderable: true, searchable: true
        },
        {
          data: 'monto', name: 'monto', title: "Monto", orderable: true, searchable: true,
          render: function (data, type, row) {
            return "$/ "+ data;
          }
        },
        {
          data: 'created_at', name: 'created_at', title: '#{translation.FORM.PAYMENT_DATE}', orderable: true, searchable: true,
          render: function (data, type, row) {
            return moment(data).format('DD/MM/YYYY');
          }
        },
        { 
          data: 'actions', name: 'actions', title: '#{translation.FORM.ACTIONS}', orderable: false, searchable: false,
          render: function (data, type, row) {
            let strRow = JSON.stringify(row);
            return `
              <button class="btn btn-warning" style="margin-right:7px;" type="button" data-toggle="modal" data-target="#editarPagoProveedoresModal" onclick='handleEditarPagoProveedores(${strRow})'><i class="fas fa-edit"></i></button>
              <button class="delete btn btn-danger" onClick="eliminarPagoProveedoresAdmin('${row.id}')"><i class="fas fa-trash"></i></button>
            `;
          }  
        }
      ]
    });
  });
