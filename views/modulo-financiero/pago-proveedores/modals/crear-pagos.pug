.modal.fade#nuevo(tabindex="-1" role="dialog" )
  .modal-dialog.modal-lg(role="document")
    .modal-content
      .modal-header 
        .row 
          .col-12
            h5.strong(style="font-size:1rem;") #{translation.NEW_PAYMENT}
      .modal-body-almacen
        .row(style="padding:15px;")
          if activo_marketplace===1
            .col-md-12.col-12
              .form-group
                label #{translation.BUSINESS}:
                  select#nuevaEmpresa.seleccionar(onChange="seleccionaInsumos()")
                    option(disabled value=null) #{translation.SELECT}
                    option(value=0) #{translation.UNASSIGNED}  
                      //- each item in empresas
                        option(value=item.empresa_id)= item.nombre

          .col-md-6.col-12
            .form-group
              label #{translation.CUIT}
              .controls
                input#cuitNuevo.form-control(type="text")
          .col-md-6.col-12
            .form-group
              label #{translation.PROVIDER_NAME}
              .controls
                input#nombreProveedor.form-control(type="text")
          .col-md-12.col-12
            .form-group
              label #{translation.INGREDIENTS_SERVICE}:
              .controls
                select#lista-insumos
                //- if activo_marketplace===1
                  select#nuevoInsumo.agregarInsumo.seleccionar(disabled)
                    option(selected value=null) --SELECCIONE--   
                    option(value = "otros") + AGREGAR
                //- else        
                  select#nuevoInsumo.agregarInsumo.seleccionar
                    option(selected value=null) --SELECCIONE--   
                    option(value = "otros") + AGREGAR
                    each item in materials
                      option(value= item.insumo)= item.insumo.toUpperCase()



          .col-md-6.col-12
            .form-group
              label #{translation.AMOUNT}
              .controls
                input#montoNuevo.form-control(type="number")

          .col-md-12.col-12
            .form-group#nuevoMaterial
              label #{translation.ADD_PRODUCT_SERVICE}
              .controls
                input#agregar.form-control(type="text")

        .modal-footer      
          button.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;" onClick=`agregarPago(${token})`) #{translation.SAVE}
          button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
