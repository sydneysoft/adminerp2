.modal.fade#editar(tabindex="-1" role="dialog" )
  .modal-dialog.modal-lg(role="document")
    .modal-content
      .modal-body-almacen
        .row(style="padding:15px;")
          if activo_marketplace===1
            .col-md-12.col-12
              .form-group
                label #{translation.BUSINESS}:
                  select#empresaEditar.seleccionar
                    option(value=null)  #{translation.SELECT} 
                      //- each item in empresas
                        option(value=item.empresa_id)= item.nombre


          .col-md-12.col-12

            .form-group
              label #{translation.INGREDIENTS_SERVICE}:
              select#lista-insumos-editar
                //- select#insumoEditar.form-control  
                  option(selected value=null) --SELECCIONE--   
                  option(value = "otros") + AGREGAR
                    //- each item in materials
                      option(value= item.insumo)= item.insumo    

          .col-md-7.col-12
            .form-group
              label #{translation.CUIT}
              .controls
                input#cuitEditar.form-control(type="text")
          .col-md-5.col-12
            .form-group
              label #{translation.AMOUNT}
              .controls
                input#montoEditar.form-control(type="text")


      .modal-footer      
        button.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;" onClick="actualizar()") #{translation.UPDATE}
        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE} 
