.modal.fade#gestionarAgregar(tabindex="-1" role="dialog" )
  .modal-dialog.modal-lg(role="document")
    .modal-content
      .modal-header 
        .row 
          .col-12
            h5.strong(style="font-size:1rem;") #{translation.ADD_INGREDIENTS}
      .modal-body-almacen
        .row(style="padding:20px;")
          //- if activo_marketplace===1
            .col-md-12.col-12
              .form-group
                label Empresa:
                  select#empresaInsumoAgregar.seleccionar
                    option(disabled value=null) --SELECCIONE-- 
                    option( value=0) Sin asignar
                      //- each item in empresas
                        option(value=item.id)= item.razon_social

          .col-md-12.col-12
            .form-group#add
              label #{translation.NEW_INGREDIENTS_SERVICE}
              .controls
                input#insumoAgregar.form-control(type="text")
            .modal-footer      
              button.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;" onClick=`guardarInsumo(${token})`) #{translation.SAVE}

              button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
