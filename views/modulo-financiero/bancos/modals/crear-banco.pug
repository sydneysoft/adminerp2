.modal.fade#nuevo(tabindex="-1" role="dialog" )
  .modal-dialog.modal-lg(role="document")
    .modal-content
      .modal-header 
        .row 
          .col-12
            h5.strong(style="font-size:1rem;") #{translation.NEW_BANK}

      .modal-body-almacen
        .row(style="padding:15px;")
          .col-md-6.col-12
            .form-group
              label #{translation.BANK_NAME} *
              .controls
                input#nombreNuevo.form-control(type="text" placeholder=translation.BANK_NAME)
          .col-md-6.col-12
            .form-group
              label #{translation.PHONE} *
              .controls
                input#telefonoNuevo.form-control(type="text" placeholder=translation.PHONE)
          .col-md-6.col-12
            .form-group
              label #{translation.WEBSITE} *
              .controls
                input#websiteNuevo.form-control(type="text" placeholder=translation.WEBSITE)
          .col-md-6.col-12
            .form-group
              label(for="Pais") #{translation.COUNTRY}:
              select#lista-paises
          .col-md-6.col-12
            .form-group
              label #{translation.ADDRESS} *
              .controls
                input#direccionNuevo.form-control(type="text" placeholder=translation.ADDRESS)

      .modal-footer      
        button.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;" onClick=`agregarAlmacen(${token})`) #{translation.SAVE}
          i.fas.fa-save.ml-2
        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
          i.fas.fa-times.ml-2
