.modal.fade#editar(tabindex="-1" role="dialog" )
  .modal-dialog.modal-lg(role="document")
    .modal-content
      .modal-header 
        .row 
          .col-12
            h5.strong(style="font-size:1rem;") #{translation.EDIT_BANK}

      .modal-body-almacen
        .row(style="padding:15px;")
          .col-md-6.col-12
            .form-group
              label #{translation.FORM.BANK_NAME} *
              .controls
                input#nombreEditar.form-control(type="text" placeholder #{translation.FORM.BANK_NAME})
          .col-md-6.col-12
            .form-group
              label #{translation.FORM.PHONE} *
              .controls
                input#telefonoEditar.form-control(type="text" placeholder #{translation.FORM.PHONE})
          .col-md-6.col-12
            .form-group
              label #{translation.FORM.WEBSITE} *
              .controls
                input#websiteEditar.form-control(type="text" placeholder #{translation.FORM.WEBSITE})
          .col-md-6.col-12
            .form-group
              label(for="Pais") #{translation.FORM.COUNTRY}:
              select#lista-paises-editar
          .col-md-6.col-12
            .form-group
              label #{translation.FORM.ADDRESS} *
              .controls
                input#direccionEditar.form-control(type="text" placeholder #{translation.FORM.ADDRESSS})


      .modal-footer      
        button.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;" onClick=`actualizar(${token})`) #{translation.UPDATE}
          i.fas.fa-save.ml-2
        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
          i.fas.fa-times.ml-2
