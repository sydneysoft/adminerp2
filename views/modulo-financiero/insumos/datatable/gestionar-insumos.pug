script.
  let tablaGestionarInsumos;
  $(document).ready( function () {
    let urlAjaxTablaGestionarInsumos = "/admin-insumos/datatable";
    if (typeof empresa_id != 'undefined' && empresa_id.value != "" && !isNaN(empresa_id.value)) {
      urlAjaxTablaGestionarInsumos = "/admin-insumos/datatable/" + empresa_id.value;
    }

    tablaGestionarInsumos = $('#tabla-gestionar-insumos').DataTable({
      "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"},
      order: [[ 0, "desc" ]],
      searchDelay: 500,
      processing: true,
      serverSide: true,
      ajax: urlAjaxTablaGestionarInsumos,
      columns: [
        { data: 'id', name: 'id', title: "ID", orderable: true, searchable: false, visible: false},
        { 
          data: 'insumo', name: 'insumo', title: "#{translation.NAME}", orderable: true, searchable: true
        },
        { 
          data: 'actions', name: 'actions', title: "#{translation.ACTIONS}", orderable: false, searchable: false,
          render: function (data, type, row) {
            let strRow = JSON.stringify(row);
            return `
              <button class="delete btn btn-danger" onClick="eliminarInsumoAdmin('${row.id}')"><i class="fas fa-trash"></i></button>
            `;
          }  
        }
      ]
    });
  });

