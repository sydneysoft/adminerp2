script.
  const actualizar_insumo = document.getElementById("actualizarInsumo");
  actualizar_insumo.addEventListener("click", (event) => {
    const nombre = document.getElementById("nombre-editar").value;
    const itemId = document.getElementById("itemId").value;
    const data = {
      insumo: nombre
    };

    if (typeof empresa_id != 'undefined' && empresa_id && !isNaN(empresa_id.value)) {
      data.empresa_id = empresa_id.value;
    }

    if (itemId != "" && nombre != "") {
      $.ajax({
        url: "/admin-insumos/" + itemId,
        type: "PUT",
        data: data,
        success: function (data) {
          if (data.ok) {
            if (typeof tablaInsumos != 'undefined' && tablaInsumos) {
              tablaInsumos.ajax.reload();
            }
            toastSweet('Exito', "#{translation.UPDATED}", 'success');
            $("#editarInsumoModal").modal("hide");
          } else {
            toastSweet('Error', "#{translation.WRONG}", 'error');
          }
        },
        error: function (data) {
          toastSweet('Error', "#{translation.WRONG}", 'error');
        }
      });
    } else {
      toastSweet('Error', "#{translation.REQUIRED_FIELDS}", 'error');
    }
  });

  function handleEditarInsumo (data) {
    const { id, insumo } = data;
    document.getElementById("itemId").value = id;
    document.getElementById("nombre-editar").value = insumo;
  }