script.
  function eliminarInsumoAdmin (id) {
    Swal.fire({
      title: "Estás Seguro?",
      text: "No podras revertir esta acción",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "#{translation.ALERTS.YES_DELETE}",
    })
    .then((willDelete) => {
      if (willDelete.isConfirmed) {
        $.ajax({
          url: "/admin-insumos/" + id,
          type: "DELETE",
          success: function (data) {
            if (data.ok) {
              if (typeof tablaInsumos != 'undefined' && tablaInsumos) {
                tablaInsumos.ajax.reload();
              }
              if (typeof tablGestionarInsumo != 'undefined' && tablGestionarInsumo) {
                tablGestionarInsumo.ajax.reload();
              }
              if (typeof tablaGestionarInsumos != 'undefined' && tablaGestionarInsumos) {
                tablaGestionarInsumos.ajax.reload();
              }
              toastSweet('Exito', "#{translation.ALERTS.DELETED}", 'success');
            } else {
              toastSweet('Error', "#{translation.ALERTS.WRONG}", 'error');
            }
          },
          error: function (data) {
            toastSweet('Error', "#{translation.ALERTS.WRONG}", 'error');
          }
        });
      }
    });
  }