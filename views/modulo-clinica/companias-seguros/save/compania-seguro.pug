script.
  const openNewStore = () => {
    typeOperation = "1";
    $("#nuevo").modal("show");
  };

  // la variable guardarImpuesto viene del id del boton guardar moneda */modals/crear-moneda.pug
  guardarCompaniaSeguro.addEventListener("click", (event) => {
    const nombre = $("#nombreCompaniaSeguro").val(),
      direccion = $("#direccionCompaniaSeguro").val(),
      pais = $("#lista-paises").val(),
      //- provincia = $("#lista-provincias").val(),
      correo = $("#correoCompaniaSeguro").val(),
      telefono = $("#telefonoCompaniaSeguro").val(),
      sitio_web = $("#sitioWebCompaniaSeguro").val();
    const auxData = {
      nombre,
      direccion,
      pais,
      //- provincia,
      correo,
      telefono,
      sitio_web,
    };

    if (typeof empresa_id != 'undefined' && empresa_id && !isNaN(empresa_id.value)) {
      auxData.empresa_id = empresa_id.value;
    }

    if ((nombre)) {
      Swal.showLoading();
      $.ajax({
        url: "/admin-companias-seguros",
        type: "POST",
        data: auxData,
        success: function (data) {
          Swal.close();
          if (data.ok) {
            if (typeof tablaCompaniasSeguros !== 'undefined') {
              tablaCompaniasSeguros.ajax.reload();
            }
            $("#nuevo").modal("hide");
            toastSweet('Success', '#{translation.ALERTS.CREATED}', 'success');
          } else {
            toastSweet('Error', '#{translation.ALERTS.WRONG}', 'error');
          }
        },
        error: function (err) {
          Swal.close();
          toastSweet('Error', '#{translation.ALERTS.WRONG}', 'error');
        }
      })
    }

  });
