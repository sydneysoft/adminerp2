script.
  // la variable editarCompaniaSeguro viene del id del boton editar moneda */modals/editar-moneda.pug
  editarCompaniaSeguro.addEventListener("click", function (event) {
    const id = $("#editarCompaniaSeguroModal").attr("data-id");
    const nombre = $("#nombreCompaniaSeguroEditar").val(),
      direccion = $("#direccionCompaniaSeguroEditar").val(),
      pais = $("#lista-paises-editar").val(),
      //- provincia = $("#lista-provincias-editar").val(),
      correo = $("#correoCompaniaSeguroEditar").val(),
      telefono = $("#telefonoCompaniaSeguroEditar").val(),
      sitio_web = $("#sitioWebCompaniaSeguroEditar").val();

    if (id > 0) {
      const auxData = {
        nombre,
        direccion,
        pais,
        //- provincia,
        correo,
        telefono,
        sitio_web,
      };
      if (typeof empresa_id != 'undefined' && empresa_id && !isNaN(empresa_id.value)) {
        auxData.empresa_id = empresa_id.value;
      }

      Swal.showLoading();
      $.ajax({
        url: "/admin-companias-seguros/" + id,
        type: "PUT",
        data: auxData,
        success: function (data) {
          Swal.close();
          if (data.ok) {
            if (typeof tablaCompaniasSeguros !== 'undefined') {
              tablaCompaniasSeguros.ajax.reload();
            }
            $("#editarCompaniaSeguroModal").modal("hide");
            toastSweet('Success', '#{translation.ALERTS.UPDATED}', 'success');
          } else {
            toastSweet('Error', '#{translation.ALERTS.WRONG}', 'error');
          }
        },
        error: function (err) {
          Swal.close();
          toastSweet('Error', '#{translation.ALERTS.WRONG}', 'error');
        }
      })
    } else {
      toastSweet('Error', '#{translation.ALERTS.REQUIRED_FIELDS}', 'error');
    }
  });

  /**
   * @description Funcion que carga los datos de la moneda a editar
   * @param {Object} data
   */
  const setDataEditarCompaniaSeguro = (data) => {
    typeOperation = "2";
    $("#nombreCompaniaSeguroEditar").val(data.nombre);
    $("#direccionCompaniaSeguroEditar").val(data.direccion);
    $("#lista-paises-editar").val(data.pais).trigger("change");
    //- $("#lista-provincias-editar").val(data.provincia).trigger("change");
    $("#correoCompaniaSeguroEditar").val(data.correo);
    $("#telefonoCompaniaSeguroEditar").val(data.telefono);
    $("#sitioWebCompaniaSeguroEditar").val(data.sitio_web);
    $("#editarCompaniaSeguroModal").modal('show').attr("data-id", data.id);
  };