.modal.fade#nuevoCompaniaSeguroModal(tabindex="-1" role="dialog" )
  .modal-dialog.modal-lg(role="document")
    .modal-content
      .modal-header 
        .row 
          .col-12
            h5.strong(style="font-size:1rem;") Nuevo Compania Seguro

      .modal-body-almacen
        .row(style="padding:15px;")
          .col-md-6.col-12
            .form-group
              label(for="nombreCompaniaSeguro") Nombre de la compania de seguro *
              input#nombreCompaniaSeguro.form-control(type="text" placeholder="Nombre de la compania de seguro")
          .col-md-6.col-12
            .form-group
              label(for="direccionCompaniaSeguro") Direccion:
              input#direccionCompaniaSeguro.form-control(type="text" placeholder="Direccion")
          .col-md-6.col-12
            .form-group
              label(for="lista-paises") #{translation.COUNTRY}:
              select#lista-paises
          //- .col-md-6.col-12
          //-   .form-group
          //-     label(for="lista-provincias") #{translation.PROVINCE}:
          //-     select#lista-provincias
          .col-md-6.col-12
            .form-group
              label(for="correoCompaniaSeguro") Correo:
              input#correoCompaniaSeguro.form-control(type="text" placeholder="Correo")
          .col-md-6.col-12
            .form-group
              label(for="telefonoCompaniaSeguro") Telefono:
              input#telefonoCompaniaSeguro.form-control(type="text" placeholder="Telefono")
          .col-md-6.col-12
            .form-group
              label(for="sitioWebCompaniaSeguro") Sitio Web:
              input#sitioWebCompaniaSeguro.form-control(type="text" placeholder="Sitio Web")
          
      .modal-footer      
        button#guardarCompaniaSeguro.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.SAVE}
          i.fas.fa-save.ml-2
        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
          i.fas.fa-times.ml-2