//- Modal para agregar sede
.modal.fade.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="nuevoSedeModal")
  .modal-dialog.modal-lg
    .modal-content.modalContent(style="height: 100%;")
      .modal-header 
        .row(style="margin:0;")
          .col-md-12
            h3(style="margin:0px 0;") #{translation.ADD}

      .modal-body.borderBottom
        //- nombre	direccion	googlemap	imagen	telefono	atencion 	estado	activado
        .row
          .col-md-6
            .form-group
              label(for="nombre") #{translation.NAME}
              input#nombre.form-control(type="text" placeholder=translation.NAME)
          .col-md-6
            .form-group
              label(for="direccion") #{translation.ADDRESS}
              input#direccion.form-control(type="text" placeholder=translation.ADDRESS)
        .row.mt-3 
          .col-md-6
            .form-group
              label(for="googlemap") #{translation.GOOGLEMAP}
              textarea#googlemap.form-control(placeholder=translation.GOOGLEMAP)
          .col-md-6
            //- .form-group
            //- label(for="imagen") #{translation.IMAGE}
            //- input#imagen.form-control(type="text" placeholder="#{translation.IMAGE}")
            .row.mb-3.align-items-end
              .col-8
                span #{translation.IMAGE}
                br
                .btn-group
                  label.btn.btn-info.m-0(for="preFavicon") #{translation.UPLOAD}
                    i.fas.fa-upload.ml-2
                  button#galeriaImagen.btn.btn-primary(type="button" onclick="getImagePagedGaleria(0, 'imagenModal', 'showImagenModal')") De galeria
              .col-4
                input#imagenFile.form-control-file(type="file" name="" value="" hidden)
                input#imagen(type="text" hidden )
                #mostrarImagen

        .row.mt-3 
          .col-md-6
            .form-group
              label(for="telefono") #{translation.PHONE}
              input#telefono.form-control(type="text" placeholder=translation.PHONE)
          .col-md-6
            .form-group
              label(for="activado") #{translation.ACTIVATED}
              select#activado.form-control
                option(value="1") #{translation.ACTIVE}
                option(value="0") #{translation.INACTIVE}

        .row.mt-3
          .col-md-4
            .form-group
              label(for="estado") #{translation.STATUS}
              select#estado.form-control
                option(value="1") #{translation.ACTIVE}
                option(value="0") #{translation.INACTIVE}

          .col-md-8
            .row.align-items-end 
              .col-8
                .form-group
                  label(for="atencion") #{translation.ATTENTION}
                  //- input#atencion.form-control(type="text" placeholder=translation.ATTENTION)
                  select#atencion.form-control
                    each item in horarios
                      option(value=item.id) #{item.text}
              .col-4
                .form-group
                  button#agregarHorarioAtencion.btn.btn-primary.btn-block(type="button") #{translation.ADD}
                    i.fas.fa-plus.ml-2
            .row 
              .col-12 
                #showHorarioAtencion.mt-3

      .modal-footer(style="padding:8px;")
        .row(style="margin:0;")
          .col-md-12.text-right
            button#addSede.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.ADD}
            button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
