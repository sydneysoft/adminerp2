script.
  const select2Pacientes = $("#lista-pacientes, #lista-pacientes-editar, #lista-pacientes-filtro").select2({
    placeholder: '#{translation.FORM.SEARCH}',
    templateResult: pacientesState,
    allowClear: true
  })
  //- .on("select2:open", () => {
  //-   $(".select2-results:not(:has(a))").append(
  //-     '<a href="#" style="padding: 6px;height: 20px;display: inline-table;" data-toggle="modal" data-target="#nuevoBannerAdministrador" onclick="closePacientesSelect2()">Agregar pacientes</a>'
  //-   );
  //- }); //- No se debe crear

  //- Funcion para modificar como muestra el select2 las opciones
  function pacientesState (state) {
    if (!state.id) {
      return state.text;
    }
    let $container = $(`
      <span><strong>${state.id}</strong> | ${state.text}</span>
    `);

    return $container;
  }

  function closePacientesSelect2 () {
    $("#lista-pacientes, #lista-pacientes-editar, #lista-pacientes-filtro").select2('close');
  }

  //- Funcion para poder obtener los datos de la especialidad con empresa dinamicamente
  function urlSelect2Pacientes() {
    let auxUrl = "/admin-pacientes/select2";
    if (typeof empresa_id != "undefined" && !isNaN(empresa_id.value)) {
      auxUrl += `/${empresa_id.value}`;
    }
    return auxUrl;
  }

  $.ajax({
    url: urlSelect2Pacientes(),
    dataType: 'json',
    delay: 500,
    data: {
      select: ['id', 'nombre', 'apellido_paterno', 'apellido_materno']
    },
    success: function (data, status) {
      if (data.ok) {
        if (Array.isArray(data.data) && data.data.length > 0) {
          select2Pacientes.empty();
          select2Pacientes.append(new Option('Seleccionar', '', false, false));
          data.data.forEach((item) => {
            let newOption = new Option(`${item.nombre} ${item.apellido_paterno} ${item.apellido_materno}`, item.id, false, false);
            select2Pacientes.append(newOption);
          });
        } else {
          select2Pacientes.empty();
          select2Pacientes.append(new Option('Seleccionar', '', false, false));
        }
      }
    }, 
    error: function (error, statur) {
      select2Pacientes.empty();
      select2Pacientes.append(new Option('Seleccionar', '', false, false));
    }
  })
