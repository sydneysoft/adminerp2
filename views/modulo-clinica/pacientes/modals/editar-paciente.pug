.modal.fade.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="editarPacienteModal")
  .modal-dialog.modal-lg
    .modal-content.modalContent(style="height: 100%;")
      .modal-header 
        .row(style="margin:0;")
          .col-md-12
            h3(style="margin:0px 0;") #{translation.EDIT}

      .modal-body.borderBottom
        .row
          .col-12.col-md-4 
            .form-group 
              label(for="nombreEditar") #{translation.NAME} *
              input#nombreEditar.form-control(type="text" placeholder=translation.NAME)
          .col-12.col-md-4
            .form-group 
              label(for="apellido_paternoEditar") #{translation.FATHER_LASTNAME}*
              input#apellido_paternoEditar.form-control(type="text" placeholder=translation.FATHER_LASTNAME)
          .col-12.col-md-4
            .form-group 
              label(for="apellido_maternoEditar") #{translation.MOTHER_LASTNAME}
              input#apellido_maternoEditar.form-control(type="text" placeholder=translation.MOTHER_LASTNAME)
        .row.mt-3
          .col-12.col-md-6
            .form-group
              label(for="tipo_documentoEditar") #{translation.DOCUMENT_TYPE}
              select#lista-documentos-editar
              //- select#tipo_documentoEditar.form-control
              //-   option(value="pasaporte") #{translation.PASSPORT}
              //-   option(value="cedula") #{translation.CEDULA}
              //-   option(value="carnet_extranjeria") #{translation.CARNET_EXTRANJERIA}
              //-   option(value="dni") #{translation.DNI}
              //-   option(value="otro") #{translation.OTHER}
          .col-12.col-md-6
            .form-group
              label(for="numero_documentoEditar") #{translation.DOCUMENT_NUMBER}
              input#numero_documentoEditar.form-control(type="text" placeholder=translation.DOCUMENT_NUMBER)

        .row.mt-3 
          .col-12.col-md-4 
            .form-group
              label(for="sexoEditar") #{translation.GENRE}
              select#sexoEditar.form-control
                option(value="masculino") #{translation.MALE}
                option(value="femenino") #{translation.FEMALE}

          .col-12.col-md-4 
            .form-group
              label(for="fecha_nacimientoEditar") #{translation.BIRTH_DATE}
              input#fecha_nacimientoEditar.form-control(type="date" placeholder=translation.BIRTH_DATE)    
          .col-12.col-md-4 
            .form-group
              label(for="estado_civilEditar") #{translation.CIVIL_STATUS}
              select#estado_civilEditar.form-control
                if Array.isArray(estado_civil) && estado_civil.length > 0
                  each tipo in sexo[0].valor
                    option(value=tipo)
                      span.text-capitalize #{tipo}
                else
                  option(value="0") No hay tipos de sexo   
        .row.mt-3 
          .col-12.col-md-4
            .form-group
              label(for="tipo_seguroEditar") #{translation.INSURANCE_TYPE}
              select#tipo_seguroEditar.form-control
                if Array.isArray(tipo_seguro) && tipo_seguro.length > 0
                  each tipo in tipo_seguro[0].valor
                    option(value=tipo)
                      span.text-capitalize #{tipo}
                else
                  option(value="0") No hay tipos de seguro
          .col-12.col-md-4
            .form-group
              label(for="nombre_seguroEditar") #{translation.INSURANCE_NAME}
              select#lista-companias-seguros-editar
              //- select#nombre_seguroEditar.form-control
              //-   if Array.isArray(aseguradoras) && aseguradoras.length > 0
              //-     each item in aseguradoras
              //-       option(value=item.id)
              //-         span.text-capitalize #{item.nombre}
              //-   else
              //-     option(value="0") No hay aseguradoras
          .col-12.col-md-4
            .form-group
              label(for="numero_seguroEditar") #{translation.INSURANCE_NUMBER}
              input#numero_seguroEditar.form-control(type="text" placeholder=translation.INSURANCE_NUMBER)

        .row.mt-3 
          .col-12.col-md-4 
            .form-group 
              label(for="celularEditar") #{translation.CELULAR}
              input#celularEditar.form-control(type="text" placeholder=translation.CELULAR)
          .col-12.col-md-4 
            .form-group 
              label(for="correoEditar") #{translation.EMAIL}
              input#correoEditar.form-control(type="email" placeholder=translation.EMAIL)
          .col-12.col-md-4
            +pais('paisEditar')
        .row.mt-3 
          .col-12.col-md-6 
            .form-group
              label(for="direccionEditar") #{translation.ADDRESS}
              input#direccionEditar.form-control(type="text" placeholder=translation.ADDRESS)
          .col-12.col-md-6
            .form-group
              label(for="notaEditar") #{translation.OBSERVATION}
              textarea#notaEditar.form-control.h-100(placeholder=translation.OBSERVATION)

        input#idEditar(type="text" hidden)
      .modal-footer(style="padding:8px;")
        .row(style="margin:0;")
          .col-md-12.text-right
            button#updatePaciente.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.SAVE}
              i.fas.fa-save.ml-2
            button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
              i.fas.fa-times.ml-2
