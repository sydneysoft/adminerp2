script.
  let tablaPacientes;
  $(document).ready(function () {
    let urlAjaxTablaPacientes = "/admin-pacientes/datatable"
    if (typeof empresa_id != 'undefined' && !isNaN(empresa_id.value)) {
      urlAjaxTablaPacientes += `/${empresa_id.value}`;
    }
    tablaPacientes = $("#tabla-pacientes").DataTable({
      columnDefs: [
        {
          orderable: false,
          className: "select-checkbox",
          targets: 0,
        },
      ],
      select: {
        style: "multi",
        selector: "td:first-child",
      },
      dom: "Bfrtip",
      buttons: ["selectAll", "selectNone"],
      order: [[1, "asc"]],
      language: {
        buttons: {
          selectAll: '#{translation.SELECT_EVERYTHING}',
          selectNone: '#{translation.ERASE_SELECTION}',
        },
        url: "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json",
        select: {
          rows: "%d filas seleccionadas",
        },
      },
      responsive: true,
      searchDelay: 500,
      processing: true,
      serverSide: true,
      ajax: urlAjaxTablaPacientes,
      rowId: 'id',
      columns: [
        { 
          data: 'id', name: 'id', title: 'ID', orderable: false, searchable: false,
          render: function (data, type, row) {
            return ``;
          }
        },       
        { data: 'nombre', name: 'nombre', title: '#{translation.NAME}', orderable: true, searchable: true},
        { data: 'apellido_paterno', name: 'apellido_paterno', title: 'Apellido paterno', orderable: true, searchable: true},
        { data: 'celular', name: 'celular', title: '#{translation.CELLPHONE}', orderable: true, searchable: true},
        { data: 'correo', name: 'correo', title: '#{translation.EMAIL}', orderable: true, searchable: true},
        { 
          data: 'acciones', name: 'acciones', title: '#{translation.ACTIONS}', orderable: false, searchable: false,
          render: function (data, type, row) {
            let strRow = JSON.stringify(row);
            return `
              <button class="btn btn-primary btn-sm" onclick='editarPacienteModal(${strRow})'>#{translation.EDIT}</button>
              <a class="btn btn-warning btn-sm" href="/admin-pacientes/historial/${row.id}">#{translation.HISTORY}</a>
              <button class="btn btn-danger btn-sm" onclick="beforeDeleteItem('/admin-pacientes/pacientes/${row.id}', ${row.id})">#{translation.DELETE}</button>
              `;
          }
        }
      ],
      initComplete: function (settings) {
        //- clone thead to tfoot
        $("#tabla-pacientes thead tr").clone().appendTo($("#tabla-pacientes tfoot"));
      }
    });


    $("#accionesBoton").click(function () {
      const valorSeleccionado = $("#acciones").val();
      const selected_rows = tablaPacientes
        .rows({
          selected: true,
        })
        .ids();

      const arraySeleccion = $.makeArray(selected_rows);
      switch (valorSeleccionado) {
        case "0":
          eliminarProductos(arraySeleccion, "ce_pacientes");
          break;
      }
    });
  });