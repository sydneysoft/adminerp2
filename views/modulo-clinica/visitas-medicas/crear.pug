//- id	paciente_id	medico_id	fecha	hora	motivo	anotaciones	resultado	diagnostico	recetas	estado	costo	clinica_id	referenccias	empresa_id

extends ../layout.pug

append contenido 
  .border-bottom.border-left.border-right.rounded-bottom.p-3
    .container-fluid
      .row.mt-3
        .col-12.col-md-4 
          .form-group 
            label(for='fecha')  #{translation.DATE}
            input#fecha.form-control(type='date')
        .col-12.col-md-4 
          .form-group 
            label(for='hora') #{translation.TIME}
            input#hora.form-control(type='time')
        .col-12.col-md-4
          .form-group 
            label(for='motivo') #{translation.MOTIVE}
            select#motivo.form-control
              option(value='') #{translation.SELECT}
              option(value='1') #{translation.CONSULT}
              option(value='2') #{translation.EXAM}
              option(value='3') #{translation.SURGERY}
              option(value='4') #{translation.OTHER}
      .row.mt-3
        .col-12.col-md-6 
          .form-group 
            label(for='anotaciones') #{translation.ANNOTATIONS}
            textarea#anotaciones.form-control(placeholder="Anotaciones de la visita")
        .col-12.col-md-6
          .form-group 
            label(for='resultado') #{translation.RESULT}
            textarea#resultado.form-control(placeholder="Resultado de la visita")
      .row.mt-3 
        .col-12.col-md-6 
          .form-group 
            label(for='diagnostico') #{translation.DIAGNOSE}
            textarea#diagnostico.form-control(placeholder="Diagnóstico de la visita")
        .col-12.col-md-6
          .form-group 
            label(for='recetas') #{translation.RECIPES_VISIT}
            textarea#recetas.form-control(placeholder="Recetas de la visita")
      .row.mt-3 
        .col-12.col-md-6
          .form-group 
            label(for='referencias') #{translation.REFERENCES}
            textarea#referencias.form-control(placeholder="Referencias de la visita")
        .col-12.col-md-3
          .form-group 
            label(for='estado') #{translation.STATE}
            select#estado.form-control
              option(value='') #{translation.SELECT}
              option(value='1') #{translation.PENDING}
              option(value='2') #{translation.DONE}
              option(value='3') #{translation.CANCELLED}
        .col-12.col-md-3
          .form-group 
            label(for='costo') #{translation.PRICE}
            input#costo.form-control(type='number', placeholder="Costo de la visita")
