//- id	paciente_id	medico_id	fecha	hora	motivo	anotaciones	resultado	diagnostico	recetas	estado	costo	clinica_id	referenccias	empresa_id

extends ../layout.pug

append contenido 
  .border-bottom.border-left.border-right.rounded-bottom.p-3
    .container-fluid
      .row.mt-3
        .col-12.col-md-4 
          .form-group 
            label(for='fecha')  #{translation.FORM.DATE}
            input#fecha.form-control(type='date')
        .col-12.col-md-4 
          .form-group 
            label(for='hora') #{translation.FORM.TIME}
            input#hora.form-control(type='time')
        .col-12.col-md-4
          .form-group 
            label(for='motivo') #{translation.FORM.MOTIVE}
            select#motivo.form-control
              option(value='') #{translation.FORM.SELECT}
              option(value='1') #{translation.FORM.CONSULT}
              option(value='2') #{translation.FORM.EXAM}
              option(value='3') #{translation.FORM.SURGERY}
              option(value='4') #{translation.FORM.OTHER}
      .row.mt-3
        .col-12.col-md-6 
          .form-group 
            label(for='anotaciones') #{translation.FORM.ANNOTATIONS}
            textarea#anotaciones.form-control(placeholder="Anotaciones de la visita")
        .col-12.col-md-6
          .form-group 
            label(for='resultado') #{translation.FORM.RESULT}
            textarea#resultado.form-control(placeholder="Resultado de la visita")
      .row.mt-3 
        .col-12.col-md-6 
          .form-group 
            label(for='diagnostico') #{translation.FORM.DIAGNOSE}
            textarea#diagnostico.form-control(placeholder="Diagnóstico de la visita")
        .col-12.col-md-6
          .form-group 
            label(for='recetas') #{translation.FORM.RECIPES_VISIT}
            textarea#recetas.form-control(placeholder="Recetas de la visita")
      .row.mt-3 
        .col-12.col-md-6
          .form-group 
            label(for='referencias') #{translation.FORM.REFERENCES}
            textarea#referencias.form-control(placeholder="Referencias de la visita")
        .col-12.col-md-3
          .form-group 
            label(for='estado') #{translation.FORM.STATE}
            select#estado.form-control
              option(value='') #{translation.FORM.SELECT}
              option(value='1') #{translation.FORM.PENDING}
              option(value='2') #{translation.FORM.DONE}
              option(value='3') #{translation.FORM.CANCELLED}
        .col-12.col-md-3
          .form-group 
            label(for='costo') #{translation.FORM.PRICE}
            input#costo.form-control(type='number', placeholder="Costo de la visita")
