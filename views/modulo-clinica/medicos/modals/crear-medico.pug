.modal.fade.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="nuevoMedicoModal")
  .modal-dialog.modal-lg
    .modal-content.modalContent(style="height: 100%;")
      .modal-header 
        .row(style="margin:0;")
          .col-md-12
            h3(style="margin:0px 0;") #{translation.CREATE}

      .modal-body.borderBottom

        .row 
          .col-12.col-md-3
            .form-group
              label(for="first_name") #{translation.FIRST_NAME} *
              input#first_name.form-control(type="text" placeholder=translation.FIRST_NAME)
          .col-12.col-md-3
            .form-group
              label(for="middle_name") #{translation.MIDDLE_NAME}
              input#middle_name.form-control(type="text" placeholder=translation.MIDDLE_NAME)
          .col-12.col-md-6
            .form-group
              label(for="surnames") #{translation.SURNAMES} *
              input#surnames.form-control(type="text" placeholder=translation.SURNAMES)

        .row 
          .col-12.col-md-4
            .form-group 
              label(for="especialidad") #{translation.SPECIALTY} *
              //- input#especialidad.form-control(type="text" placeholder=translation.SPECIALTY)
              select#lista-especialidades
              //- select#especialidad.form-control(name="especialidad")
              //-   if Array.isArray(especialidades) && especialidades.length > 0
              //-     each especialidad in especialidades
              //-       option(value=especialidad.id) #{especialidad.nombre}
              //-   else
              //-     option(value="0") #{translation.NO_SPECIALTY}
          .col-12.col-md-4
            .form-group 
              label(for="tipo_documento") #{translation.DOCUMENT_TYPE} *
              select#lista-documentos
              //- select#tipo_documento.form-control
              //-   if Array.isArray(tipo_documento) && tipo_documento.length === 1
              //-     each tipo in tipo_documento[0].valor
              //-       option(value=tipo)
              //-         span.text-capitalize #{tipo}
              //-   else
              //-     option(value="0") #{translation.NO_DOCUMENT_TIME}
          .col-12.col-md-4
            .form-group 
              label(for="numero_documento") #{translation.DOCUMENT_NUMBER} *
              input#numero_documento.form-control(placeholder=translation.DOCUMENT_NUMBER)

        .row
          .col-12.col-md-4
            .form-group 
              label(for="celular") #{translation.CELULAR} *
              input#celular.form-control(type="text" placeholder=translation.CELULAR)
          .col-12.col-md-4
            .form-group 
              label(for="correo") #{translation.EMAIL}
              input#correo.form-control(type="email" placeholder=translation.EMAIL)
          .col-12.col-md-4 
            .form-group
              label(for="tiempo_cita") #{translation.APPOINTMENT_MINUTES}
              input#tiempo_cita.form-control(type="number" placeholder="0 (tiempo por defecto 30 minutos)")

        .row.align-items-end
          .col-6.col-md-3
            .form-group
              label(for="dia_de") #{translation.FROM}
              select#dia_de.form-control
                option(value="lunes") #{translation.DAYS.MONDAY}
                option(value="martes") #{translation.DAYS.TUESDAY}
                option(value="miercoles") #{translation.DAYS.WEDNESDAY}
                option(value="jueves") #{translation.DAYS.THURSDAY}
                option(value="viernes") #{translation.DAYS.FRIDAY}
                option(value="sabado") #{translation.DAYS.SATURDAY}
                option(value="domingo") #{translation.DAYS.SUNDAY}

          .col-6.col-md-3
            .form-group
              label(for="dia_a") #{translation.TO}
              select#dia_a.form-control
                option(value="lunes") #{translation.DAYS.MONDAY}
                option(value="martes") #{translation.DAYS.TUESDAY}
                option(value="miercoles") #{translation.DAYS.WEDNESDAY}
                option(value="jueves") #{translation.DAYS.THURSDAY}
                option(value="viernes") #{translation.DAYS.FRIDAY}
                option(value="sabado") #{translation.DAYS.SATURDAY}
                option(value="domingo") #{translation.DAYS.SUNDAY}

          .col-6.col-md-2
            .form-group 
              label(for="hora_de") #{translation.FROM}
              input#hora_de.form-control(type="time" placeholder="Hora de inicio")

          .col-6.col-md-2
            .form-group 
              label(for="hora_a") #{translation.TO}
              input#hora_a.form-control(type="time" placeholder="Hora de fin")

          .col-6.col-md-2 
            .form-group
              button#agregar_horario(type="button" class="btn btn-success mt-4") #{translation.ADD}
                i.fas-fa-plus.ml-2
          .col-12
            .row.align-items-start
              .col-5
                .my-3
                  #show_horarios 
              .col-7
                .btn-group
                  button#upload_cv.btn.btn-info(type="button" ) #{translation.UPLOAD_CV}
                    i.fas.fa-upload.ml-2
                  button.btn.btn-primary.d-flex.align-items-center
                    label.d-block(for="subir_archivo" style="position: relative;") #{translation.SEARCH_FILES} 
                  input#subir_archivo(type="file" text="Subir archivo" value="Subir archivo" hidden)
                  input#cv.form-control(type='text' value='' disabled hidden)
                  a#linkCv.btn.btn-success.disabled(href="" target="_blank" aria-disabled=true) #{translation.SEE_CV}
                #showLink



      .modal-footer(style="padding:8px;")
        .row(style="margin:0;")
          .col-md-12.text-right
            button#addMedico.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.SAVE}
              i.fas.fa-save.ml-2
            button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
