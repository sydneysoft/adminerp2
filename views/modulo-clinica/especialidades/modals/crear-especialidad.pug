//- Modal para agregar especialidad
.modal.fade.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="nuevoEspecialidadModal")
  .modal-dialog.modal-lg
    .modal-content.modalContent(style="height: 100%;")
      .modal-header 
        .row(style="margin:0;")
          .col-md-12
            h3(style="margin:0px 0;") #{translation.ADD}

      .modal-body.borderBottom
        .row 
          .col-12.col-md-9
            .form-group 
              label(for="nombre") #{translation.NAME}
              input#nombre.form-control(type="text" placeholder=translation.NAME)
          .col-12.col-md-3
            .form-group
              label(for="codigoexterno") #{translation.EXTERNAL_CODE}
              input#codigoexterno.form-control(type="text" placeholder=translation.EXTERNAL_CODE)
        .row.mt-3
          .col-12.col-md-6
            .form-group 
              label(for="estado") #{translation.STATE}
              //- input#estado.form-control(type="text" placeholder=translation.STATE)
              select#estado.form-control(name="estado")
                option(value="1") #{translation.ACTIVE}
                option(value="2") #{translation.INACTIVE}
          .col-12.col-md-6 
            .form-group
              label(for="sede") #{translation.BRANCH}
              select#sede.form-control
                option(value="0") #{translation.NO_BRANCH}
                each sede in sedes
                  option(value=sede.id) #{sede.nombre}
        .row.mt-3
          .col-12.col-md-6
            .form-group 
              label(for="categoria") #{translation.CATEGORY}
              select#categoria.form-control(name="categoria")
                //- Categorias medicas
                option(value="1") Angiología
                option(value="2") Cardiología
                option(value="3") Cirugía General
                option(value="4") Dermatología
                option(value="5") Endocrinología
                option(value="6") Gastroenterología
                option(value="7") Geriatría
                option(value="8") Ginecología
                option(value="9") Hematología
                option(value="10") Infectología
                option(value="11") Medicina Interna
                option(value="12") Nefrología
                option(value="13") Neurología
                option(value="14") Neurocirugía
                option(value="15") Nutrición
                option(value="16") Oftalmología
                option(value="17") Oncología
                option(value="18") Otorrinolaringología
                option(value="19") Pediatría
                option(value="20") Psiquiatría
                option(value="21") Reumatología
                option(value="22") Traumatología
                option(value="23") Urología
                option(value="24") Otros
                //- Categorias odontologicas
                option(value="25") Odontología General
                option(value="26") Odontopediatría
                option(value="27") Ortodoncia
                option(value="28") Periodoncia
                option(value="29") Endodoncia
                option(value="30") Cirugía Maxilofacial
                option(value="31") Prótesis
                option(value="32") Implantes
                option(value="33") Otros
                //- Categorias de laboratorio
                option(value="34") Análisis Clínicos
                option(value="35") Análisis de Orina
                option(value="36") Análisis de Sangre
                option(value="37") Análisis de Heces
                option(value="38") Otros
                //- Categorias de fisioterapia
                option(value="39") Fisioterapia General
                option(value="40") Fisioterapia Respiratoria
                option(value="41") Fisioterapia Neurológica
                option(value="42") Fisioterapia Pediátrica
                option(value="43") Fisioterapia Deportiva
                option(value="44") Fisioterapia Geriátrica
                option(value="45") Fisioterapia Oncológica
                option(value="46") Fisioterapia Cardiovascular
                option(value="47") Fisioterapia Traumatológica
                option(value="48") Fisioterapia Uroginecológica
                option(value="49") Fisioterapia Estética
                option(value="50") Fisioterapia del Suelo Pélvico
                option(value="51") Fisioterapia del Trastorno del Espectro Autista
                option(value="52") Fisioterapia del Trastorno del Espectro Autista
                option(value="53") Fisioterapia del Trastorno del Espectro Autista

          .col-12.col-md-6
            .form-group
              label(for="icono") #{translation.ICON}
                span#showIcono.ml-1
              select#icono.form-control
                option(value="0") #{translation.NO_ICON}
        .row.mt-3
          .col-12.col-md-6
            .form-group 
              label(for="descriptionlarga") #{translation.LONG_DESCRIPTION}
              textarea#descriptionlarga.form-control(placeholder=translation.LONG_DESCRIPTION)
          .col-12.col-md-6
            .form-group
              label(for="descripcioncorta") #{translation.SHORT_DESCRIPTION}
              textarea#descripcioncorta.form-control(placeholder=translation.SHORT_DESCRIPTION)
        .row.mt-3 
          .col-12.col-md-6
            .row.mb-3.align-items-end
              .col-8
                span #{translation.IMAGE}
                br
                .btn-group
                  label.btn.btn-info.m-0(for="galeriaImagen") #{translation.UPLOAD}
                    i.fas.fa-upload.ml-2
                  button#galeriaImagen.btn.btn-primary(type="button" onclick="getImagePagedGaleria(0, 'imagenModal', 'showImagenModal')") De galeria
              .col-4
                input#imagenFile.form-control-file(type="file" name="" value="" hidden)
                input#imagen(type="text" hidden )
                #mostrarImagen
          .col-12.col-md-6
            //- Checkbox
            .form-check 
              input#activado.form-check-input(type="checkbox" value="")
              label.form-check-label(for="activado") #{translation.ENABLED}

      .modal-footer(style="padding:8px;")
        .row(style="margin:0;")
          .col-md-12.text-right
            button#addEspecialidad.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.ADD}
            button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
