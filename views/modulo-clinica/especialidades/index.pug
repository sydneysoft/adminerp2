  script.
    function itemDeleteSuccess (data) {
      tabla.row($(`#${data.target}`)).remove().draw();
    }

    function formatState (state) {
      if (!state.id) { return state.text; }
          let $state = $(
            '<span><i class="' +  state.element.value.toLowerCase() + '"> </i> ' + 
        state.text +     '</span>'
      );
      return $state;
    };

    $("#icono").select2({
      templateResult: formatState
    });
    $("#icono_editar").select2({
      templateResult: formatState
    });

