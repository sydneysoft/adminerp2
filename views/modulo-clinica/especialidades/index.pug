extends ./layout.pug

append contenido
  .border-left.border-right.border-bottom.p-3
    .container-fluid 
      .row.justify-content-end
        if empresa_id
          include /mixins/btn/back.pug
          input#empresa_id(type="text" value=empresa_id hidden)
          .col-md-6.col-6
            +btn-back()
        .col-md-6.col-6.text-right 
          button#nuevoPaciente.btn.btn-primary(role="button") #{translation.CREATE}
            i.fas.fa-plus.ml-2
      .row.mt-3
        .col-md-4.col-6(style="max-width: 400px")

          label.font-weight-bold.datev-label #{translation.MASSIVE_ACTIONS}
            .row
              .col-md-8.col-12
                select#acciones.form-control
                  option(value=null) #{translation.SELECT}
                  option(value="0") #{translation.DELETE}
              .col-md-4.col-12
                button#accionesBoton(class="btn btn-success-2") #{translation.CONFIRM}
      .row
        .col-12.text-right 
          button.btn.btn-primary(type="button" data-toggle="modal" onclick="nuevaEspecialidad()" data-target="#nuevoEspecialidadModal") #{translation.ADD}
            i.fas.fa-plus.ml-2
    .container-fluid.mt-3
      .table-responsive
        table#tabla-especialidades.table.table-striped
          thead.thead-dark
          tbody
          tfoot
