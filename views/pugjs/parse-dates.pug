script.
  function parseDay (dia) {
    switch (dia) {
      case '1':
        return '#{translation.MONDAY}';
      case '2':
        return '#{translation.TUESDAY}';
      case '3':
        return '#{translation.WEDNESDAY}';
      case '4':
        return '#{translation.THURSDAY}';
      case '5':
        return '#{translation.FRIDAY}';
      case '6':
        return '#{translation.SATURDAY}';
      case '0':
        return '#{translation.SUNDAY}';
    }
  }

  function parseMonth (month) {
    switch (month) {
      case '1':
        return '#{translation.JANUARY}';
      case '2':
        return '#{translation.FEBRUARY}';
      case '3':
        return '#{translation.MARCH}';
      case '4':
        return '#{translation.APRIL}';
      case '5':
        return '#{translation.MAY}';
      case '6':
        return '#{translation.JUNE}';
      case '7':
        return '#{translation.JULY}';
      case '8':
        return '#{translation.AUGUST}';
      case '9':
        return '#{translation.SEPTEMBER}';
      case '10':
        return '#{translation.OCTOBER}';
      case '11':
        return '#{translation.NOVEMBER}';
      case '12':
        return '#{translation.DECEMBER}';
    }
  }