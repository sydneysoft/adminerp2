extends extends/menu-superior-admin
block contenido
        .row
            .col-xs-12.text-grey(style="margin-bottom:50px;")
                h1.display-1
                    strong #{translation.LIST_ROLES}
            .col-xs-12
                .row
                    .col-md-10
                        
                    .col-md-2(style="height:60px;") 
                        div(style="height: 100%;display: flex;justify-content: center;align-items: center;")
                            button.btn.btn-success(style="margin-bottom:10px;", type="button", data-toggle="modal", data-target="#nuevoRol")
                                i.fas-fa-plus
                                span #{translation.ADD_ROLE}
            .col-xs-12
                .container-table.table-responsive
                    table.table.table-miscitas
                        thead
                            tr
                                th.text-center(scope="col") #{translation.NAME}
                                th.text-center(scope="col") #{translation.DESCRIPTION}
                                th.text-center(scope="col") #{translation.IMAGE}
                                th.text-center(scope="col") #{translation.STATUS}
                                th.text-center(scope="col") #{translation.ACTIONS}
                        tbody
                            each book in bookStore
                                -var finalStatusRoles= (book.activado=="0" ? 'Desactivado': 'Activado')
                                tr
                                    td.text-center.col-left=book.name
                                    td.text-center.col-center=book.description
                                    td.text-center.col-center
                                        img(src=book.imagen,style="width:50px;height:50px")
                                    td.text-center.col-center=finalStatusRoles
                                    td.text-center.col-right
                                        button.delete.btn.btn-warning(style="margin-right:7px;", type="button", data-toggle="modal", data-target="#editarRol",onClick="handleAdminRoles('"+book._pk_roles+"','"+book.name+"','"+book.description+"','"+book.imagen+"','"+book.activado+"')")
                                            i.fas.fa-edit
                                        button.delete.btn.btn-danger(onClick="deleteRolAdmin('"+book._pk_roles+"')")
                                            i.fas.fa-trash

        .modal#nuevoRol(tabindex="-1" role="dialog")
            .modal-dialog(role="document")
                .modal-content
                    .modal-body
                        h3 #{translation.ADD_BRAND}
                            .row
                                .col-md-6
                                    .form-group
                                        h5 #{translation.NAME}:
                                        .controls
                                            input#nombreNuevo-admin-rol.form-control(type="text")
                                .col-md-6
                                    .form-group
                                        h5 #{translation.DESCRIPTION}:
                                        .controls
                                            input#descripcionNuevo-admin-rol.form-control(type="text")
                                .col-md-6
                                    .form-group
                                        h5 #{translation.IMAGE_URL}:
                                        .controls
                                            input#imgNuevo-admin-rol.form-control(type="text")
                                .col-md-6
                                    .form-group
                                        h5 #{translation.STATE}:
                                        .controls
                                            select#estadoNuevo-admin-rol.form-control()
                                                option(value="1") #{translation.ACTIVE}
                                                option(value="0") #{translation.DEACTIVATED}
                                .col-md-12.text-center
                                    button.btn.btn-success.nuevo(type="button", style="margin-left:7px;margin-right:7px;",onClick="AgregarRolAdmin()") #{translation.ADD}
                                    button.btn.btn-danger(type="buton", data-dismiss="modal") #{translation.CLOSE}
        
        .modal#editarRol(tabindex="-1" role="dialog")
            .modal-dialog(role="document")
                .modal-content
                    .modal-body
                        h3 #{translation.EDIT_ROLE}
                            .row
                                .col-md-6
                                    .form-group
                                        h5 #{translation.NAME}:
                                        .controls
                                            input#idActualizar-admin-rol(type="hidden")
                                            input#nombreActualizar-admin-rol.form-control(type="text")
                                .col-md-6
                                    .form-group
                                        h5 #{translation.DESCRIPTION}:
                                        .controls
                                            input#descripcionActualizar-admin-rol.form-control(type="text")
                                .col-md-6
                                    .form-group
                                        h5 #{translation.IMAGE_URL}:
                                        .controls
                                            input#imgActualizar-admin-rol.form-control(type="text")
                                .col-md-6
                                    .form-group
                                        h5 #{translation.STATE}:
                                        .controls
                                            select#estadoActualizar-admin-rol.form-control()
                                                option(value="1") #{translation.ACTIVE}
                                                option(value="0") #{translation.STATE}
                                .col-md-12.text-center
                                    button.btn.btn-success.editar(type="button", style="margin-left:7px;margin-right:7px;",onClick="EditAdminRoles()") #{translation.UPDATE_DATA}
                                    button.btn.btn-danger(type="buton", data-dismiss="modal") #{translation.CLOSE}