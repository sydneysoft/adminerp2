//- Modal para editar una nuevo link a red social
.modal.fade.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="editModal")
  .modal-dialog.modal-md
    .modal-content.modalContent(style="height: 100%;")
      .modal-header 
        .row(style="margin:0;")
          .col-md-12
            h3(style="margin:0px 0;") #{translation.ADD}

      .modal-body.borderBottom
        .row 
          .col-12 
            .form-group
              label(for="nombre_editar") #{translation.NAME}
              input#nombre_editar.form-control(type="text" placeholder=translation.NAME)
        .row.mt-2 
          .col-12 
            .alert.alert-info 
              | #{translation.CORTE_MESSAGE_INFO}  
        .row.mt-2 
          .col-12
            .form-group 
              label(for="descripcion_editar") #{translation.DESCRIPTION}
              textarea#descripcion_editar.form-control(type="text" placeholder=translation.DESCRIPTION)
        .row.mt-2 
          .col-12
            .form-group
              label(for="precio_editar") #{translation.PRICE}
              input#precio_editar.form-control(type="number" placeholder=translation.PRICE) 
          input#itemId(type="text" value="" hidden)
      .modal-footer(style="padding:8px;")
        .row(style="margin:0;")
          .col-md-12.text-right
            button#editItem.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.ADD}
              i.fas.fa-plus.ml-3
            button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
