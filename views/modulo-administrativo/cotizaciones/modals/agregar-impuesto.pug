.modal.fade#agregarImpuesto(tabindex="-1" role="dialog" )
  .modal-dialog.modal-lg(role="document")

    .modal-content
      form#agregarClienteModal
        .modal-header 
          .row 
            .col-12
              h5.strong(style="font-size:1rem;") Crear nuevo impuesto

        .modal-body
          .col-12
            if activo_marketplace===1
              .form-group
              label.form-label(style="display:block") Empresa   
                select#empresaImpuesto.form-control.seleccionar(onChange="seleccionaProductoEditar()")
                  //- option(disabled selected value=null) Elige una empresa     
                  //- option(value=0) Sin Asignar
                  //- each item in empresa
                  //-     option(value=item.empresa_id)= item.nombre
            else 
              input#empresaImpuesto.text-center.form-control(type="text" style="display:none" value=`${token}`)


            .form-group
              label Nombre del impuesto
                .controls
                  input.nombreImpuesto.text-center.form-control(type="text")

            .form-group
              label Tasa (%)
                .controls
                  input.tasaImpuesto.text-center.form-control( type="number")

        .modal-footer      
          button.btn.btn-danger(type="buton" data-dismiss="modal") Cerrar
          button.btn.btn-success.nuevo(type="submit" style="margin-left:7px;margin-right:7px;" id="agrega-impuesto-modal-btn") Guardar

