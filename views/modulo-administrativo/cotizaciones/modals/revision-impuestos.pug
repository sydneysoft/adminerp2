.modal.fade#revisionImpuestos(tabindex="-1" role="dialog" )
  .modal-dialog.modal-lg(role="document")
    .modal-content
      .modal-header 
        .row 
          .col-12
            h5.strong(style="font-size:1rem;") Impuestos

      .modal-body
        .row(style="padding:20px;")
          .col-md-12.col-12 
            div.table
              table#tabla-todosImpuestos.table.table-bordered

                thead
                  tr.table-head
                    if activo_marketplace===1
                      th.text-left Empresa
                    th.text-left Nombre
                    th.text-left Tasa
                    th.text-center Acción
                tbody
                  each item in tax
                    tr
                      if activo_marketplace===1
                        td.text-center= item.empresa_id?((empresas.filter((i) => i.empresa_id == item.empresa_id)).length?(empresas.filter((i) => i.empresa_id == item.empresa_id))[0].nombre:item.empresa_id==0?"-" : item.empresa_id):"-" 

                      td.text-left= item.nombre
                      td.text-left= item.tasa
                      td.text-center

                        button#borraImpuesto.btn.btn-danger( data-id=item.id data-url="/cotizaciones/eliminar-impuesto/" style="margin-left:8px")
                          i.fa.fa-trash  

        .modal-footer      
          button.btn.btn-danger(type="buton" data-dismiss="modal" onClick="closeWindows()") Cerrar