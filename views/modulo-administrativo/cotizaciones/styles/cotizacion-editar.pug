style.
  .centerRow{
    vertical-align:-webkit-baseline-middle  

  }
  .hidden,#nuevosTerminos, #nuevoCliente{
    display:none
  }
  table thead th,table tfoot th  {
    vertical-align: inherit!important;
    border-bottom: 2px solid #dee2e6;
    font-size: 0.8em;
  }
  .display-2 {
    font-size: 1.5rem;
    font-weight:500
  }
  .fieldDescuento{
    text-align: center;
    width: 50px;
    margin-left: 10px;
    float: right;
    font-size: 12px;

  }
  #guardarCotizacion{
    margin:20px
  }

  .title{
    font-size:1.3rem;
    font-weight:600; 
    display:block; 

  }
  .table td, .table th {
    padding: 0.2rem;}
  .add{
    min-width: 150px;
    font-size: 0.7rem;
  }

  .space{
    padding-bottom:50px
  }
  th{
    font-size:1rem; 
    background-color:#f2f2f2
  }
  span{
    font-family: "Roboto Condensed", sans-serif !important;
  }
  .btn-green{
    color:#0f832a;
    border: none;
    background: none;
    padding: 10px 0px
  }
  label{
    display:block
  }
  @media (min-width: 992px){
    .modal-lg, .modal-xl {
      max-width: 550px;
    }
  }
  .select2-container{
    width: 100% !important;
  }
