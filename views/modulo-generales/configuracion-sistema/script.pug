script
  include ../../js/toast.sweet.js
script.
  $(document).ready(function () {
    const data = {};
    if (typeof empresa_id != 'undefined' && !isNaN(empresa_id.value)) {
      data.empresa_id = empresa_id.value
    }
    $.ajax({
      method: "GET",
      url: "/admin-sistema/datos",
      dataType: "json",
      data,
      success: function (datos) {
        Swal.close();
        if (datos) {
          let configuraciones = datos.items.configuraciones[0]
          $("#moneda").val(configuraciones.moneda);
          CKEDITOR.instances.privacidad.setData(configuraciones.politicasdeprivacidad);
          CKEDITOR.instances.terminos.setData(configuraciones.terminosycondiciones);
          let data = datos.items.correos[0]
          $("#host-service").val(data.smtp_service);
          $("#seguro-smtp").val(data.smtp_seguro);
          $("#host-smtp").val(data.smtp_host);
          $("#puerto-smtp").val(data.smtp_puerto);
          $("#correo-smtp").val(data.smtp_correo);
          $("#password-smtp").val(data.smpt_password);
          $("#usuario-smtp").val(data.smtp_user);
          if (data.estado == "1") {
            $("#toggle-state").bootstrapToggle("on");
          }
        }
      },
    })
  });


  const updateConfigurationNewsletter = (token) => {
    let datos
    let smtp_service = $("#host-service").val();
    let smtp_seguro = $("#seguro-smtp").val();
    let smtp_host = $("#host-smtp").val();
    let smtp_puerto = $("#puerto-smtp").val();
    let smtp_correo = $("#correo-smtp").val();
    let password_smtp = $("#password-smtp").val();
    const smtp_user = $("#usuario-smtp").val();
    let valState = document.getElementById("toggle-state").checked;
    if (valState == true) {
      valState = "1";
    } else {
      valState = "0";
    }
    if (!password_smtp) {
      datos = {
        empresa_id: token,
        smtp_service: smtp_service,
        smtp_seguro: smtp_seguro,
        smtp_host: smtp_host,
        smtp_puerto: smtp_puerto,
        smtp_correo: smtp_correo,
        smtp_user: smtp_user,
        estado: valState
      }
    } else {
      datos = {
        empresa_id: token,
        smtp_service: smtp_service,
        smtp_seguro: smtp_seguro,
        smtp_host: smtp_host,
        smtp_puerto: smtp_puerto,
        smtp_correo: smtp_correo,
        smpt_password: password_smtp,
        estado: valState,
        smtp_user: smtp_user,
      }
    }

    if (typeof empresa_id != 'undefined' && !isNaN(empresa_id.value)) {
      datos.empresa_id = empresa_id.value
    }

    Swal.showLoading();
    $.ajax({
      method: "POST",
      url: "/admin-sistema/configuracion-correo",
      dataType: "json",
      data: datos,
      success: function (data) {
        if (data.status == "success") {
          Swal.close();
          toastSweet("success", "#{translation.UPDATED}", "success");
        } else {
          Swal.close();
          toastSweet("error", "#{translation.WRONG}", "error");
        }
      },
      error: function () {
        Swal.close();
        toastSweet("error", "#{translation.WRONG}", "error");
      },
    });

  };

