//- Modal para crear una nuevo faq
.modal.fade.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="updateModal")
  .modal-dialog.modal-md
    .modal-content.modalContent(style="height: 100%;")
      .modal-header 
        .row(style="margin:0;")
          .col-md-12
            h3(style="margin:0px 0;") #{translation.ADD}

      .modal-body.borderBottom
        .row 
          .col-12.col-md-8
            .form-group
              label(for='pregunta_editar') #{translation.QUESTION}
              input#pregunta_editar.form-control(type='text' placeholder="Pregunta")
          .col-12.col-md-4
            .form-group
              label(for='icono_editar') #{translation.ICON}
              .controls
                button.btn.btn-info#icono_editar(data-iconset="fontawesome5" data-icon="fas fa-wifi" role="iconpicker")
          .col-12.my-3
          .col-12
            .form-group 
              label(for="respuesta_editar") #{translation.ANSWER} 
              textarea#respuesta_editar(name="respuesta" placeholder="Respuesta")
          input#itemId(type="text" value="" hidden)
      .modal-footer(style="padding:8px;")
        .row(style="margin:0;")
          .col-md-12.text-right
            button#updateItem.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.SAVE}
              i.fas.fa-plus.ml-3
            button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
