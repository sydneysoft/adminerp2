script.
  //Función para Agregar Estilos CSS
  const handleSaveStyles = (token) => {
    let estilos = $("#data-text-area").val();
    Swal.showLoading();
    const auxData = { style: estilos };
    if (typeof empresa_id != 'undefined' && !isNaN(empresa_id.value)) {
      auxData.empresa_id = empresa_id.value;
    }
    $.ajax({
      method: "PUT",
      url: "/admin-agregar-css/" + itemId,
      dataType: "json",
      data: auxData,
      success: function (data) {
        Swal.close();
