.modal#galeriaModalMultiple(tabindex="-1" role="dialog")
     .modal-dialog.modal-lg(role="document")
            .modal-content
                .modal-body
                    ul#myTab2.nav.nav-tabs(role='tablist')
                        li.nav-item
                            a#profile1-tab.nav-link.active(data-toggle='tab' href='#profile1' role='tab' aria-controls='profile' aria-selected='false') #{translation.PHOTO_GALLERY}
                        li.nav-item
                            a#home2-tab.nav-link(data-toggle='tab' href='#home2' role='tab' aria-controls='home' aria-selected='true') #{translation.UPLOAD_PHOTOS}
                    #myTabContent2.tab-content
                        #home2.tab-pane.fade(role='tabpanel' aria-labelledby='home-tab')
                            div(style="width:100%;padding:10px;margin-top:10px;")
                                form.dropzone(action="/file-upload" id="my-awesome-dropzone" method="post" enctype="multipart/form-data")  
                            div(style="width:100%;display:flex;justify-content:center;align-items:center;margin-top:20px;")
                                button#btn-upload-multiple.btn.btn-success(onClick=`uploadImagesMultiple()`,style="display:none;") #{translation.UPLOAD_PHOTOS}
                        #profile1.tab-pane.fade.show.active(role='tabpanel' aria-labelledby='profile-tab')
                            div(class='row',style='padding:8px;')
                                div(class='col-md-12')
                                    .modal-body
                                        div(class='row' style='padding:8px;')
                                            div(class='col-md-12')
                                                input#selected-img-data-editar(type="hidden")
                                                input#selected-img-data(type="hidden")
                                                div#dataRowListMultimedia-multiple(class='row m-0 mt-4')
                                                div#loadingDataAjax(class='row m-0 mt-4 ajaxLoading')
                                                    img(class="image-loader" src="https:ceisantagema.com/wp-content/plugins/gallery-by-supsystic/src/GridGallery/Galleries/assets/img/loading.gif")
                                                div(style="width:100%;display:flex;justify-content:center;align-items:center")
                                                    div(id="data-paginate-images-multiple"   data-total-count='100'  data-take='16')
                                    .modal-footer 
                                        button.btn.btn-success(disabled id="choice-image-banner" data-dismiss="modal")="Seleccionar Imágenes" 
                                        button.btn.btn-danger(data-dismiss="modal") #{translation.CANCEL}