.modal#galeriaModal(tabindex="-1" role="dialog")
     .modal-dialog.modal-lg(role="document")
            .modal-content
                .modal-body
                    ul#myTab.nav.nav-tabs(role='tablist')
                        li.nav-item
                            a#profile-tab.nav-link.active(data-toggle='tab' href='#profile' role='tab' aria-controls='profile' aria-selected='false') #{translation.FORM.PHOTO_GALLERY}
                        li.nav-item
                            a#home-tab.nav-link(data-toggle='tab' href='#home' role='tab' aria-controls='home' aria-selected='true') #{translation.FORM.UPLOAD_PHOTOS}
                    #myTabContent.tab-content
                        #home.tab-pane.fade(role='tabpanel' aria-labelledby='home-tab')
                            div(style="width:100%;padding:10px;margin-top:10px;")
                                form.dropzone(action="/file-upload" id="my-awesome-dropzone2" method="post" enctype="multipart/form-data")  
                            div(style="width:100%;display:flex;justify-content:center;align-items:center;margin-top:20px;")
                                button#btn-upload.btn.btn-success(onClick=`uploadImages()`,style="display:none;")="Subir Foto"
                        #profile.tab-pane.fade.show.active(role='tabpanel' aria-labelledby='profile-tab')
                            div(class='row',style='padding:8px;')
                                div(class='col-md-12')
                                        .modal-body
                                            div(class='row' style='padding:8px;')
                                                div(class='col-md-12')
                                                    input#selected-img-data-editar-single(type="hidden")
                                                    input#selected-img-data-single(type="hidden")
                                                    div#dataRowListMultimedia-single(class='row col-xs-12 col md-4')
                                                    div#loadingDataAjax-single(class='row m-0 mt-4 ajaxLoading')
                                                        img(class="image-loader" src="https:ceisantagema.com/wp-content/plugins/gallery-by-supsystic/src/GridGallery/Galleries/assets/img/loading.gif")
                                                    div(style="width:100%;display:flex;justify-content:center;align-items:center")
                                                        div(id="data-paginate-images-single"   data-total-count='100'  data-take='16')
                                        .modal-footer 
                                            button.btn.btn-success(disabled id="choice-image-banner-single" onClicK="choiceImgSingleProducto2()") #{translation.CHOOSE_IMAGE} 
                                            button.btn.btn-danger(data-dismiss="modal") #{translation.CANCEL}