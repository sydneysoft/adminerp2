extends ../../extends/menu-superior-admin
block contenido
    .modal(class="modal fade" id="myModalMultimedia" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true")
        .modal-dialog.modal-dialog-centered
            .modal-content
                .modal-body(style="padding:0px")
                    img(id="data-img-all" style="width:100%;object-fit:contain")
    .row    
        .col-12 
            ul#myTab.nav.nav-tabs(role='tablist')
                li.nav-item
                    a#profile-tab.nav-link.active(data-toggle='tab' href='#profile' role='tab' aria-controls='profile' aria-selected='false') #{translation.PHOTO_GALLERY}
                li.nav-item
                    a#home-tab.nav-link(data-toggle='tab' href='#home' role='tab' aria-controls='home' aria-selected='true') #{translation.UPLOAD_PHOTOS}
            #myTabContent.tab-content
                #home.tab-pane.fade(role='tabpanel' aria-labelledby='home-tab')
                    div(style="width:100%;padding:10px;margin-top:10px;")
                        form.dropzone(action="/file-upload" id="my-awesome-dropzone" method="post" enctype="multipart/form-data")  
                    div(style="width:100%;display:flex;justify-content:center;align-items:center;margin-top:20px;")
                        button#btn-upload.btn.btn-success(onClicK=`uploadImagesGaleria()`,style="display:none;")="#{translation.UPLOAD_PHOTO}"
                #profile.tab-pane.fade.show.active(role='tabpanel' aria-labelledby='profile-tab')
                    div(class='row',style='padding:8px;')
                        div(class='col-md-8')
                            div(class='row m-0 mt-4')
                                div#dataRowListMultimedia(class='row m-0 mt-4')
                                div#loadingDataAjax(class='row m-0 mt-4 ajaxLoading')
                                    img(class="image-loader" src="https://ceisantagema.com/wp-content/plugins/gallery-by-supsystic/src/GridGallery/Galleries/assets/img/loading.gif")
                                div(style="width:100%;display:flex;justify-content:center;align-items:center")
                                    div(id="data-paginate-images" data-total-count=bookStore data-take='16')

                        div(class='col-md-4 mt-4')
                            div(style="width:100%;height:100;background:rgba(0,0,0,0.1)")
                                div#infoImagenData(class='row m-0' style="padding:15px;display:none;")
                                    div(class='col-md-12 mt-3')
                                        input(type="hidden" id="data-id-multimedia-select")
                                        input(type="hidden" id="data-public-multimedia-select")
                                        input(type="hidden" id="data-image-multimedia-select")
                                        div(style="borderBottom:1px solid rgba(0,0,0,0.2);paddingBottom:10px" solid='')
                                            h5 #{translation.FORM.FILE_INFO}
                                            p(class='m-0')
                                              
                                                span(style="fontWeight:700",id="text-date-multimedia-select")
                                                br
                                                span(style="fontWeight:700",id="text-peso-multimedia-select")
                                                br
                                                span(style="fontWeight:700",id="text-type-multimedia-select")
                                    div(class='col-md-12 mt-3')
                               
                                        div(class='mb-1' style="width:100%;margin-top:10px")
                                            button.btn.btn-info.btn-block(onClick="visualizarFotoMultimedia()")="#{translation.FORM.PREVIEW_PHOTO}"
                                        div(class='mb-1' style="width:100%;margin-top:10px")
                                            button.btn.btn-danger.btn-block(onClick="deletePhotoMultimedia()")="#{translation.FORM.DELETE_PHOTO}"
                                div#noSelectedDivImagen(class='row m-0' style="padding:15px;")
                                    div(class='col-md-12 mt-3')
                                        div(style="borderBottom:1px solid rgba(0,0,0,0.2);paddingBottom:10px" solid='')
                                            h5 #{translation.FORM.FILE_INFO}
                                            b #{translation.NO_IMAGE_SELECTED}

                   

 
  

    script
        include ./additionalImage.js