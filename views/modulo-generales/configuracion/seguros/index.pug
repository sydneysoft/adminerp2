extends ./layout.pug

append contenido
  .row.justify-content-end
    if empresa_id
      include /mixins/btn/back.pug
      input#empresa_id(type="text" value=empresa_id hidden)
      .col-md-6.col-6
        +btn-back()
    .col-md-6.col-6.text-right 
      button.btn.btn-success(type="button" data-toggle="modal" data-target="#nuevoDocumentoModal")
        i.fas.fa-plus
          span  #{translation.ADD_INSURANCE_COMPANY}
    .col-md-3.col-sm-6
      .form-group
        label(for="") #{translation.FORM.COUNTRY}
        select#lista-paises-filtro
  .row.mt-3
    .col-md-4.col-6(style="max-width: 400px")

      label.font-weight-bold.datev-label #{translation.MASSIVE_ACTIONS}
        .row
          .col-md-8.col-12
            select#acciones.form-control
              option(value=null) #{translation.SELECT}
              option(value="0") #{translation.DELETE}
          .col-md-4.col-12
            button#accionesBoton(class="btn btn-success-2") #{translation.CONFIRM}


    .col-12(style="margin-top: 20px;")
      div.table-responsive
        table#tabla-documentos.table.table-bordered
          thead.thead-dark
          tbody
          tfoot  


  include ./modals/crear-documento.pug
  include ./modals/editar-documento.pug
  include ./styles/documentos.pug

  script
    include /js/toast.sweet.js

  include ./datatable/documentos.pug
  include ./update/documento.pug
  include ./save/documento.pug
  include ./delete/documento.pug

  script.

    $("#lista-paises-filtro").change(function () {
      let filtro_pais_id = this.value;
      if (filtro_pais_id != "") {
        tablaCompaniasSeguros.columns([1]).search(filtro_pais_id).draw();
      } else {
        tablaCompaniasSeguros.columns([1]).search("").draw();
      }
    });
    

  //- otros modulos
  include /modulo-generales/geolocalizacion/select2/paises.pug
