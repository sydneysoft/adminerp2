.modal.fade#editarDocumentoModal(tabindex="-1" role="dialog" )
  .modal-dialog.modal-lg(role="document")
    .modal-content
      .modal-header 
        .row 
          .col-12
            h5.strong(style="font-size:1rem;") Editar Compania Seguro

      .modal-body-almacen
        .row(style="padding:15px;")
          .col-md-6.col-12
            .form-group
              label(for="nombreDocumentoEditar") Nombre de la compania de seguro *
              input#nombreDocumentoEditar.form-control(type="text" placeholder="Nombre de la compania de seguro")
          .col-md-6.col-12
            .form-group
              label(for="lista-paises-editar") #{translation.FORM.COUNTRY}:
              select#lista-paises
          //- .col-md-6.col-12
          //-   .form-group
          //-     label(for="lista-provincias-editar") #{translation.FORM.PROVINCE}:
          //-     select#lista-provincias
          .col-md-6.col-12
            .form-group
              label(for="abreviaturaDocumentoEditar") Abreviatura:
              input#abreviaturaDocumentoEditar.form-control(type="text" placeholder="Abreviatura")

      .modal-footer      
        button#editarDocumento.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.UPDATE}
          i.fas.fa-save.ml-2
        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
          i.fas.fa-times.ml-2
