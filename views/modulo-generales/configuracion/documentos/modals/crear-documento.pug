.modal.fade#nuevoDocumentoModal(tabindex="-1" role="dialog" )
  .modal-dialog.modal-lg(role="document")
    .modal-content
      .modal-header 
        .row 
          .col-12
            h5.strong(style="font-size:1rem;") #{translation.NEW_DOCUMENT_TYPE} 

      .modal-body-almacen
        .row(style="padding:15px;")
          .col-md-6.col-12
            .form-group
              label(for="nombreDocumento") #{translation.NAME_DOCUMENT_TYPE} *
              input#nombreDocumento.form-control(type="text" placeholder="#{translation.NAME_DOCUMENT_TYPE}")
          .col-md-6.col-12
            .form-group
              label(for="lista-paises") #{translation.COUNTRY}:
              select#lista-paises
          //- .col-md-6.col-12
          //-   .form-group
          //-     label(for="lista-provincias") #{translation.PROVINCE}:
          //-     select#lista-provincias
          .col-md-6.col-12
            .form-group
              label(for="abreviaturaDocumento") #{translation.ABREVIATION}:
              input#abreviaturaDocumento.form-control(type="text" placeholder="Abreviatura")
          
      .modal-footer      
        button#guardarDocumento.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;") #{translation.SAVE}
          i.fas.fa-save.ml-2
        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
          i.fas.fa-times.ml-2