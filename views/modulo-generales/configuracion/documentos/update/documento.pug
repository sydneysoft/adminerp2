script.
  // la variable editarDocumento viene del id del boton editar moneda */modals/editar-moneda.pug
  editarDocumento.addEventListener("click", function (event) {
    const id = $("#editarDocumentoModal").attr("data-id");
    const nombre = $("#nombreDocumentoEditar").val(),
      pais = $("#lista-paises-editar").val(),
      //- provincia = $("#lista-provincias-editar").val(),
      abreviatura = $("#abreviaturaDocumentoEditar").val();

    if (id > 0) {
      const auxData = {
        nombre,
        pais,
        //- provincia,
        abreviatura,
      };
      if (typeof empresa_id != 'undefined' && empresa_id && !isNaN(empresa_id.value)) {
        auxData.empresa_id = empresa_id.value;
      }

      Swal.showLoading();
      $.ajax({
        url: "/admin-documentos/" + id,
        type: "PUT",
        data: auxData,
        success: function (data) {
          Swal.close();
          if (data.ok) {
            if (typeof tablaCompaniasSeguros !== 'undefined') {
              tablaCompaniasSeguros.ajax.reload();
            }
            $("#editarDocumentoModal").modal("hide");
            toastSweet('Success', '#{translation.UPDATED}', 'success');
          } else {
            toastSweet('Error', '#{translation.WRONG}', 'error');
          }
        },
        error: function (err) {
          Swal.close();
          toastSweet('Error', '#{translation.WRONG}', 'error');
        }
      })
    } else {
      toastSweet('Error', '#{translation.REQUIRED_FIELDS}', 'error');
    }
  });

  /**
   * @description Funcion que carga los datos de la moneda a editar
   * @param {Object} data
   */
  const setDataEditarDocumento = (data) => {
    typeOperation = "2";
    $("#nombreDocumentoEditar").val(data.nombre);
    $("#lista-paises-editar").val(data.pais).trigger("change");
    //- $("#lista-provincias-editar").val(data.provincia).trigger("change");
    $("#abreviaturaDocumentoEditar").val(data.abreviatura);
    $("#editarDocumentoModal").modal('show').attr("data-id", data.id);
  };