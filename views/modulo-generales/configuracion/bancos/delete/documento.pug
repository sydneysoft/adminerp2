script.
  const deleteDocumento = (id) => {
    Swal.fire({
      title: "#{translation.ARE_YOU_SURE}",
      text: "#{translation.YOU_CANT_REVERT_THIS_ACTION}", 
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "#{translation.YES_DELETE}",
    }).then((result) => {
      if (result.isConfirmed) {
        Swal.showLoading();
        fetch(`/admin-documentos/` + id, {
          method: "delete",
        })
          .then((data) => {
            Swal.close();
            if (data.status === 200) {
              if (typeof tablaCompaniasSeguros !== 'undefined') {
                tablaCompaniasSeguros.ajax.reload();
              }
              toastSweet('Success', '#{translation.DELETED}', 'success');
            } else {
              Swal.fire({
                position: "center",
                icon: "error",
                title: "#{translation.WRONG}",
                showConfirmButton: false,
                timer: 2500,
              });
            }
          })
          .catch(() => {
            Swal.close();
            Swal.fire({
              position: "center",
              icon: "error",
              title: "#{translation.WRONG}",
              showConfirmButton: false,
              timer: 2500,
            });
          });
      }
    });
  };
