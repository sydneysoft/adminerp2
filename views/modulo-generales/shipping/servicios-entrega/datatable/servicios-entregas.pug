script.
  let tablaServiciosEntrega;
  $(document).ready(function () {
    let urlAjaxTablaServiciosEntrega = "/admin-shipping/servicios-entrega/datatable"
    if (typeof empresa_id != 'undefined' && empresa_id && !isNaN(empresa_id.value)) {
      urlAjaxTablaServiciosEntrega += `/${empresa_id.value}`;
    }
    tablaServiciosEntrega = $('#tabla-servicios-entrega').DataTable({
      columnDefs: [
        {
          orderable: false,
          className: "select-checkbox",
          targets: 0,
        },
      ],
      select: {
        style: "multi",
        selector: "td:first-child",
      },
      dom: "Bfrtip",
      buttons: ["selectAll", "selectNone"],
      order: [[1, "asc"]],
      language: {
        buttons: {
          selectAll: "Seleccionar todos",
          selectNone: "Borrar Selección",
        },
        url: "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json",
        select: {
          rows: "%d filas seleccionadas",
        },
      },
      rowId: 'id',
      responsive: true,
      searchDelay: 500,
      processing: true,
      serverSide: true,
      ajax: urlAjaxTablaServiciosEntrega,
      columns: [
        { 
          data: 'id', name: 'id', title: 'ID', orderable: false, searchable: false,
          render: function (data, type, row) {
            return ''
          }
        },
        {
          data: 'nombre', name: 'nombre', title: "#{translation.NAME}", orderable: true, searchable: true,
        },
        {
          data: 'telefono', name: 'telefono', title: "#{translation.CELULAR}", orderable: true, searchable: true
        },
        { 
          data: 'acciones', name: 'acciones', title: '#{translation.ACTIONS}', orderable: false, searchable: false,
          render: function (data, type, row) {
            let strRow = JSON.stringify(row);
            return `
              <button class="btn btn-warning" style="margin-right:7px;" type="button" onclick="handleEditServicio(${row.id})">
                <i class="fas fa-edit"></i>
              </button>
              <button class="delete btn btn-danger" onclick="handleDeleteServicio(${row.id})">
                <i class="fas fa-trash"></i>
              </button>
            `;
          }
        }
      ],
      initComplete: function (settings) {
        //- clone thead to tfoot
        $("#tabla-servicios-entrega thead tr").clone().appendTo($("#tabla-servicios-entrega tfoot"));
      }
    });

    $(".seleccionar").select2({
      language: {
        noResults: function () {
          return "#{translation.NO_RESULTS}";
        },
      },
    });

    var tableFilter = $("#tabla-servicios-entrega").dataTable();
  });
