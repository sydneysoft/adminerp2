extends ../../extends/menu-superior-admin
block contenido
    .row
        .col-12.text-grey(style="margin-bottom:10px;")
            h1.display-1
                strong #{translation.SERVICES_LIST}
        .col-12
            button.btn.btn-success(style="margin-bottom:25px;", type="button", data-toggle="modal" data-target="#nuevoServicioAdministrador")
                i.fas-fa-plus
                span #{translation.ADD_DELIVERY_SERVICE}
        .col-12
            div.table-responsive
                table.table.table-bordered#tabla-servicios
                    thead.thead-dark
                        tr
                            th.text-center Id
                            th.text-center #{translation.FORM.NAME}
                            th.text-center #{translation.FORM.PHONE} 
                            th.text-center #{translation.FORM.OPERATION}
                    tbody
                        each book in items.servicios_entrega
                            tr
                                td.text-center=book.id
                                td.text-center=book.nombre
                                td.text-center=book.telefono
                                td.text-center.col-right
                                    button.btn.btn-warning(style="margin-right:7px;", type="button",onclick="handleEditServicio('"+book.id+"')")
                                        i.fas.fa-edit
                                    button.delete.btn.btn-danger(onClick="handleDeleteServicio('"+book.id+"')")
                                        i.fas.fa-trash
    .modal#nuevoServicioAdministrador(tabindex="-1" role="dialog")
        .modal-dialog(role="document")
            .modal-content
                .modal-body
                    .row(style="padding:10px;margin-bottom:8px;")
                        .col-md-6.col-12
                            .form-group
                                label #{translation.FORM.NAME}:
                                .controls
                                    input#nombreNuevo-servicio.form-control(type="text")
                        .col-md-6.col-12
                            .form-group
                                label #{translation.FORM.PHONE}:
                                .controls
                                    input#telefonoNuevo-servicio.form-control(type="text")
                        .col-md-12.col-12
                            label #{translation.FORM.SHIPPING_METHODS}
                            .controls
                                span#metodosNuevo-servicio-modulos
                .modal-footer
                    button.btn.btn-success.nuevo(type="button", style="margin-left:7px;margin-right:7px;",onClick=`AgregarServicioAdmin(${token})`) #{translation.ADD}
                    button.btn.btn-danger(type="buton", data-dismiss="modal") #{translation.CLOSE}
    .modal#editarServicioAdministrador(tabindex="-1" role="dialog")
        .modal-dialog(role="document")
            .modal-content
                .modal-body
                    .row(style="padding:10px;margin-bottom:8px;")
                        .col-md-6.col-12
                            .form-group
                                label #{translation.FORM.NAME}:
                                .controls
                                    input#nombreEditar-servicio.form-control(type="text")
                                    input#idEditar-servicio(type="hidden")
                                    input#arrDatosSelectEdit(type="hidden")
                        .col-md-6.col-12
                            .form-group
                                label #{translation.FORM.PHONE}:
                                .controls
                                    input#telefonoEditar-servicio.form-control(type="text")
                        .col-md-12.col-12
                            label #{translation.FORM.SHIPPING_METHODS}
                            .controls
                                div#dataEditSelect
                .modal-footer
                    button.btn.btn-success.nuevo(type="button", style="margin-left:7px;margin-right:7px;",onClick="ActualizarServicioAdmin()") #{translation.UPDATE}
   
                    button.btn.btn-danger(type="buton", data-dismiss="modal") #{translation.CLOSE}

    script
        include ./additionalServices.js   
   
    script.
        var dataOldArray=[];
        $(document).ready( function () {
            $('#tabla-servicios').DataTable({
                "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"}
            });
        });

        var dataFunctional=JSON.parse('!{JSON.stringify(items.metodos_envio)}');
        dataFunctional = dataFunctional.map( item => { 
                return { label: item.nombre , value: item.id.toString()}; 
        });

        var autocompleteTiposEnvioNuevo = new SelectPure("#metodosNuevo-servicio-modulos", {
            options:dataFunctional,
            multiple: true,
            value:[],
            autocomplete: true,
            icon: "fa fa-times",
            onChange: value => { console.log(value)},
            classNames: {
            select: "select-pure__select",
            dropdownShown: "select-pure__select--opened",
            multiselect: "select-pure__select--multiple",
            label: "select-pure__label",
            placeholder: "select-pure__placeholder",
            dropdown: "select-pure__options",
            option: "select-pure__option",
            autocompleteInput: "select-pure__autocomplete",
            selectedLabel: "select-pure__selected-label",
            selectedOption: "select-pure__option--selected",
            placeholderHidden: "select-pure__placeholder--hidden",
            optionHidden: "select-pure__option--hidden",
            }
        }); 