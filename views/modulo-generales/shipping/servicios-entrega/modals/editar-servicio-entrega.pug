.modal#editarServicioAdministrador(tabindex="-1" role="dialog")
  .modal-dialog(role="document")
    .modal-content
      .modal-body
        .row(style="padding:10px;margin-bottom:8px;")
          .col-md-6.col-12
            .form-group
              label #{translation.FORM.NAME}:
              .controls
                input#nombreEditar-servicio.form-control(type="text")
                input#idEditar-servicio(type="hidden")
                input#arrDatosSelectEdit(type="hidden")
          .col-md-6.col-12
            .form-group
              label #{translation.FORM.PHONE}:
              .controls
                input#telefonoEditar-servicio.form-control(type="text")
          .col-md-12.col-12
            label #{translation.FORM.SHIPPING_METHODS}
            .controls
              div#dataEditSelect
                span(id="editar-select-complement")
      .modal-footer
        button.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;" onClick="ActualizarServicioAdmin()") #{translation.UPDATE}

        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
