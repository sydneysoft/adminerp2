.modal.fade#nuevoMetodoAdministrador(tabindex="-1" role="dialog")
  .modal-dialog(role="document")
    .modal-content
      .modal-body
        .row(style="padding:10px;margin-bottom:8px;")
          .col-md-6.col-12
            .form-group
              label #{translation.FORM.NAME}:
              .controls
                input#nombreNuevoMetodo.form-control(type="text")
          .col-md-6.col-12
            form-group
              label #{translation.FORM.STATE}:
              .controls
                select.form-control#estadoNuevoMetodo
                  option(value="1") "#{translation.FORM.ACTIVE}"
                  option(value="0") "#{translation.FORM.DEACTIVATED}"



      .modal-footer
        button.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;",onClick=`AgregarMetodoEnvio()`)  #{translation.FORM.ADD}
        button.btn.btn-danger(type="buton" data-dismiss="modal")  #{translation.FORM.CLOSE}