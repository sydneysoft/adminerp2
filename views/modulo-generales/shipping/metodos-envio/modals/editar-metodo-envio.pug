.modal.fade#editarMetodoAdministrador(tabindex="-1" role="dialog")
  .modal-dialog(role="document")
    .modal-content
      .modal-body
        .row(style="padding:10px;margin-bottom:8px;")
          .col-md-6.col-12
            .form-group
              label  #{translation.NAME}:
              .controls
                input#idEditarMetodo.form-control(type="hidden")
                input#nombreEditarMetodo.form-control(type="text")
          .col-md-6.col-12
            form-group
              label  #{translation.STATE}:
              .controls
                select.form-control#estadoEditarMetodo
                  option(value="1") #{translation.ACTIVE}
                  option(value="0") #{translation.DEACTIVATED}
      .modal-footer
        button.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;" onClick="ActualizarMetodoEnvio()")  #{translation.UPDATE}
        button.btn.btn-danger(type="buton" data-dismiss="modal")  #{translation.CLOSE}