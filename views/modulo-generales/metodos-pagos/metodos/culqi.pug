html
    head
        meta(charset="utf-8")
        title Inkalandia
        script(src="https://code.jquery.com/jquery-3.6.0.js" integrity="sha256-H+K7U5CnXl1h5ywQfKtSj8PCmoN9aaq30gDh27Xc0jk=" crossorigin="anonymous")
        script(src="https://checkout.culqi.com/js/v3")
    body 
        h1=productoData+" - monto a pagar S/."+precioData
        button#buyButton(style="padding:12px;background-color:#0077CC;color:white;border-radius:4px;outline:none;")="Pagar"
    script. 
        let dataApiFinal="#{apiKey}";
        let dataPrecioFinal="#{precioData}"+"00";
        dataPrecioFinal=parseInt(dataPrecioFinal);
        let dataProductoFinal="#{productoData}";
        let dataDescripcionFinal="#{descripcionData}";
        Culqi.publicKey = dataApiFinal;
        // Configura tu Culqi Checkout
        Culqi.settings({
            title: dataProductoFinal,
            currency: 'PEN',
            description: dataDescripcionFinal,
            amount: dataPrecioFinal
        });

        Culqi.open();
        // Usa la funcion Culqi.open() en el evento que desees
        $('#buyButton').on('click', function(e){
            // Abre el formulario con las opciones de Culqi.settings
            e.preventDefault();
        });