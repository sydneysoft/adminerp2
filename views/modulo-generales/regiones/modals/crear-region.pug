.modal.fade#nuevaRegionAdmin(tabindex="-1" role="dialog")
  .modal-dialog(role="document")
    .modal-content
      .modal-body
        .row(style="padding:10px;margin-bottom:8px;")
          .col-md-6.col-12
            .form-group
              label Nombre de Región:
              .controls
                input#nuevo-nombre-regiones.form-control(type="text")
                input#nuevo-coordenandas-regiones.form-control(type="hidden")
          .col-md-6.col-12
            .form-group
              label Pais:
              .controls
                select#nuevo-pais-regiones.form-control.seleccionar(onChange="seleccionPais()")
                  option(value=0) Seleccione
                    each i in items.paises
                      option(value=i.PaisCodigo)= i.PaisNombre


          .col-md-12.col-12
            .form-group
              label Ciudad:
              .controls

                select#nuevo-ciudad-regiones.form-control.seleccionar(type="text" name="states[]" multiple="multiple" disabled) 



      .modal-footer
        button.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;",onClick=`AgregarRegionAdmin(${token})`) Añadir
        button.btn.btn-danger(type="buton" data-dismiss="modal") Cerrar
