script.
  //Eliminar Datos
  const deleteModuloAdminPanel = (val) => {
    Swal.fire({
      title: "#{translation.ARE_YOU_SURE}",
      text: "#{translation.YOU_CANT_REVERT_THIS_ACTION}",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "#{translation.YES_DELETE}",
    }).then((result) => {
      if (result.isConfirmed) {
        handleDeleteModulosAdmin(val);
      }
    });
  };

  const handleDeleteModulosAdmin = (val) => {
    Swal.showLoading();
    $.ajax({
      method: "DELETE",
      url: "/admin-modulos/" + val,
      dataType: "json",
      success: function (data) {
        if (data.ok) {
          Swal.close();
          Swal.fire({
            position: "center",
            icon: "success",
            title: "#{translation.ALERTS.DELETED_SUCCESSFULLY}",
            showConfirmButton: false,
            timer: 2500,
          });
          if (typeof tablaModulos != "undefined") {
            tablaModulos.ajax.reload();
          }
        } else {
          Swal.close();
          Swal.fire({
            position: "center",
            icon: "error",
            title: "#{translation.ALERTS.YOU_CANT_REVERT_THIS_ACTION}",
            showConfirmButton: false,
            timer: 2500,
          });
        }
      },
      error: function () {
        Swal.close();
        Swal.fire({
          position: "center",
          icon: "error",
          title: "#{translation.ALERTS.WRONG}",
          showConfirmButton: false,
          timer: 2500,
        });
      },
    });
  };