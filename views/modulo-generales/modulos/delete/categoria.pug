script.


  //Eliminar Datos
  const deleteCategoriaAdminPanel = (val) => {
    Swal.fire({
      title: "#{translation.ARE_YOU_SURE}",
      text: "#{translation.YOU_CANT_REVERT_THIS_ACTION}",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: '#{translation.YES_DELETE}',
    }).then((result) => {
      if (result.isConfirmed) {
        handleDeleteCategoriasAdmin(val);
      }
    });
  };

  const handleDeleteCategoriasAdmin = (val) => {
    Swal.showLoading();
    $.ajax({
      method: "DELETE",
      url: "/admin-modulos/categorias/" + val,
      dataType: "json",
      success: function (data) {
        if (data.ok) {
          Swal.close();
          Swal.fire({
            position: "center",
            icon: "success",
            title: "#{translation.DELETED_SUCCESSFULLY}",
            showConfirmButton: false,
            timer: 2500,
          });
          if (typeof tablaCategorias != "undefined") {
            tablaCategorias.ajax.reload();
          }
        } else {
          Swal.close();
          Swal.fire({
            position: "center",
            icon: "error",
            title: "Ocurrió un error interno inténtalo más tarde.",
            showConfirmButton: false,
            timer: 2500,
          });
        }
      },
      error: function () {
        Swal.close();
        Swal.fire({
          position: "center",
          icon: "error",
          title: "Ocurrió un error interno inténtalo más tarde.",
          showConfirmButton: false,
          timer: 2500,
        });
      },
    });
  };