    //- La siguiente funcion se ejecuta cuando se agrega un item y esta agrega la informacion de empresas y categoriable_server en el front
    function createItemSuccess (data) {
      let auxCategoria = {
        id: data.id,
        marketplace_categoria_id: data.data.marketplace_categoria_id,
        marketplace_id: data.data.marketplace_id
      };
      categoriable_server.push(auxCategoria);

      empresas.forEach(empresa => {
        if (empresa.id == auxCategoria.marketplace_id) {
          empresa.categorias = [auxCategoria];
        }
      });
      reloadTabla();
    }

    function agregarEmpresa(data) {
      save('/admin-marketplace-categorias/categorias', {
        marketplace_categoria_id: data.categoria_id,
        marketplace_id: data.empresa_id
      }, createItemSuccess); 
    }

    function removerEmpresa (data) {
      beforeDeleteItem(`/admin-marketplace-categorias/categorias/${data.id}`, deleteItemSuccess);
    }

    //- La siguiente funcion se ejecuta cuando se elimina un item y esta elimina la informacion de empresas y categoriable_server en el front
    function deleteItemSuccess(data) {
      //- data.id
      empresas.forEach(empresa => {
        if (empresa.categorias) {
          if (empresa.categorias[0].id == data.id) {
            empresa.categorias = null;
          }
        }
      });

      categoriable_server.forEach((categoria, index) => {
        if (categoria.id == data.id) {
          categoriable_server.splice(index, 1);
        }
      });

      reloadTabla();

    }

