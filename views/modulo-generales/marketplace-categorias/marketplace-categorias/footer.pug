//- Modal para editar items de seccion
.modal.fade.justify-content-center.align-items-center(tabindex="-1" role="dialog" id="editItemSectionModal")
  .modal-dialog.modal-sm
      .modal-content.modalContent(style="height: 100%;")
          .modal-header 
              .row(style="margin:0;")
                  .col-md-12
                      h3(style="margin:0px 0;") #{translation.EDIT_SECTION}
          .modal-body.borderBottom
            .row
              .col-12
                .form-group 
                  label(for="nombre_item") #{translation.FORM.NAME} *
                  input#nombre_item.form-control(type="text" placeholder=translation.FORM.NAME name="nombre_item" required)
              .col-12
                .form-group
                  label(for="icono_item") #{translation.FORM.ICON} *
                  select#icono_item.form-control
              .col-12
                .form-group
                  label(for="href_item") #{translation.FORM.URL} *
                  input#href_item.form-control(type="text" placeholder=translation.FORM.URL name="href_item" required)
              //- .col-12.col-md-8
              //-   .form-group
              //-     label(for='name_section_edit') #{translation.FORM.NAME_SECTION} *
              //-     input#name_section.form-control(type='text' placeholder=translation.FORM.NAME_SECTION name="name_section" required)
              //- .col-12.col-md-4 
              //-   .form-group
              //-     label(for="description_section_edit") #{translation.FORM.DESCRIPTION_SECTION}
              //-     input#description_section.form-control(type="text" placeholder=translation.FORM.DESCRIPTION_SECTION name="description_section")
          .modal-footer(style="padding:8px;")
              .row(style="margin:0;")
                  .col-md-12.text-right
                      button.btn.btn-danger(type="buton" onclick="$('#editItemSectionModal').modal('hide');") #{translation.CLOSE}
                      button#saveSectionFooter.btn.btn-primary(type="button" onclick="guardarItemPayload()") #{translation.SAVE}

script.
  const insertSectionFooter = document.getElementById('insertSectionFooter');
  //- const showFooterSection= document.getElementById('showFooterSection');
  const showRenderFooterSection = document.getElementById('showRenderFooterSection');
  const nameSection = document.getElementById('name_section');
  const descriptionSection = document.getElementById('description_section');

  const nombre_item = document.getElementById('nombre_item');
  const href_item = document.getElementById('href_item');
  const icono_item = document.getElementById('icono_item');

  const sectionPayload = {
    nombre: '',
    descripcion: '',
    identificador: '',
    items: []
  }

  const itemPayload = {
    identificador: '',
    nombre: '',
    icono: '',
    href: ''
  }

  const sectionPayloads = [];
  
  //- Evento que inserta una nueva seccion
  insertSectionFooter.addEventListener('click', () => {
    const identificador_section = `section_${sectionPayloads.length + 1}_${new Date().getTime()}`;
    let auxSectionPayload = {
      nombre: '',
      descripcion: '',
      identificador: identificador_section,
      items: []
    };
    sectionPayloads.push(auxSectionPayload);
    renderSectionPayloads();
  });

  //- Evento que renderiza las secciones
  function renderSectionPayloads () {
    if (Array.isArray(sectionPayloads) && sectionPayloads.length > 0) {
      showRenderFooterSection.innerHTML = '';
      sectionPayloads.forEach((section, index) => {
        let colCard =  document.createElement('div');
        colCard.classList.add('col-12', 'col-md-6', 'col-lg-4', 'col-xl-4');

        let cardSection = document.createElement('div');
        cardSection.classList.add('card', 'mb-3');
        cardSection.setAttribute('id', `card_section_${section.identificador}`);

        let cardBodySection = document.createElement('div');
        cardBodySection.classList.add('card-body');

        let cardHeaderSection = document.createElement('div');
        cardHeaderSection.classList.add('card-header');
        
        //- Button delete 
        let buttonDeleteSection = document.createElement('button');
        buttonDeleteSection.classList.add('btn', 'btn-danger', 'float-right');
        buttonDeleteSection.setAttribute('type', 'button');
        buttonDeleteSection.setAttribute('onclick', `deleteSection('${section.identificador}')`);
        buttonDeleteSection.innerHTML = '#{translation.DELETE}';

        cardHeaderSection.appendChild(buttonDeleteSection);
        cardSection.appendChild(cardHeaderSection);

        let sectionElement = document.createElement('div');
        sectionElement.setAttribute('id', section.identificador);
        //- form-group
        let formGroup = document.createElement('div');
        formGroup.classList.add('form-group');
        //- label
        let label = document.createElement('label');
        label.setAttribute('for', `name_section_${section.identificador}`);
        label.innerHTML = '#{translation.FORM.NAME}';
        //- input
        let input = document.createElement('input');
        input.classList.add('form-control');
        input.setAttribute('type', 'text');
        input.setAttribute('placeholder', '#{translation.FORM.NAME}');
        input.setAttribute('name', `name_section_${section.identificador}`);
        input.setAttribute('id', `name_section_${section.identificador}`);
        input.value = section.nombre;
        input.setAttribute('onchange', "saveSection('"+ section.identificador + "')");

        formGroup.appendChild(label);
        formGroup.appendChild(input);
        sectionElement.appendChild(formGroup);

        //- form-group
        let formGroupDescription = document.createElement('div');
        formGroupDescription.classList.add('form-group');
        //- label
        let labelDescription = document.createElement('label');
        labelDescription.setAttribute('for', `description_section_${section.identificador}`);
        labelDescription.innerHTML = '#{translation.FORM.DESCRIPTION}';
        //- input
        let inputDescription = document.createElement('textarea');
        inputDescription.classList.add('form-control');
        inputDescription.setAttribute('placeholder', '#{translation.FORM.DESCRIPTION}');
        inputDescription.setAttribute('name', `description_section_${section.identificador}`);
        inputDescription.setAttribute('id', `description_section_${section.identificador}`);
        inputDescription.innerHTML = section.descripcion;
        inputDescription.setAttribute('onchange', "saveSection('"+ section.identificador + "')");

        formGroupDescription.appendChild(labelDescription);
        formGroupDescription.appendChild(inputDescription);
        sectionElement.appendChild(formGroupDescription);

        //- row
        let row = document.createElement('div');
        row.classList.add('row');
        row.setAttribute('id', `row_${section.identificador}`);

        if (Array.isArray(section.items) && section.items.length > 0) {
          row.appendChild(renderItemsSection(section.items, section.identificador));
        }

        sectionElement.appendChild(row);

        //- row insert
        let rowInsert = document.createElement('div');
        rowInsert.classList.add('row');
        rowInsert.setAttribute('id', `row_insert_${section.identificador}`);
        let colButton = document.createElement('div');
        colButton.classList.add('col-12');
        let formGroupButton = document.createElement('div');
        formGroupButton.classList.add('form-group');

        let buttonInsert = document.createElement('button');
        buttonInsert.classList.add('btn', 'btn-primary', 'btn-block');
        buttonInsert.setAttribute('type', 'button');
        buttonInsert.setAttribute('onclick', `addItemSection('${section.identificador}')`);
        buttonInsert.innerHTML = '#{translation.CREATE}';

        formGroupButton.appendChild(buttonInsert);
        colButton.appendChild(formGroupButton);
        rowInsert.appendChild(colButton);

        sectionElement.appendChild(rowInsert);

        cardBodySection.appendChild(sectionElement);
        cardSection.appendChild(cardBodySection);
        colCard.appendChild(cardSection);
        showRenderFooterSection.appendChild(colCard);
      });
    }
  }
  //- Funcion para poder renderizar los items de una seccion
  function renderItemsSection(items, section_identificador) {
    let col12 = document.createElement('div');
    col12.classList.add('col-12');
    items.forEach((item, index) => {
      //- row
      let rowItem = document.createElement('div');
      rowItem.classList.add('row', 'mt-2');
      rowItem.setAttribute('id', `row_item_${item.identificador}`);
      
      //- col-8 link
      let col8 = document.createElement('div');
      col8.classList.add('col-8');
      let a = document.createElement('a');
      a.setAttribute('href', item.href);
      a.innerHTML = item.nombre;
      let icono = document.createElement('i');
      icono.className = item.icono;
      a.appendChild(icono);
      col8.appendChild(a);
      rowItem.appendChild(col8);

      //- col-4 botones
      let col4 = document.createElement('div');
      col4.classList.add('col-4');
      let formGroupButton = document.createElement('div');
      formGroupButton.classList.add('form-group', 'btn-group');
      //- button edit
      let buttonEdit = document.createElement('button');
      buttonEdit.classList.add('btn', 'btn-primary');
      buttonEdit.setAttribute('type', 'button');
      buttonEdit.setAttribute('onclick', `editItemSection('${item.identificador}')`);
      let iconoButtonEdit = document.createElement('i');
      iconoButtonEdit.classList.add('fas', 'fa-edit');
      buttonEdit.appendChild(iconoButtonEdit);

      //- button delete
      let buttonDelete = document.createElement('button');
      buttonDelete.classList.add('btn', 'btn-danger');
      buttonDelete.setAttribute('type', 'button');
      buttonDelete.setAttribute('onclick', `deleteItemSection('${item.identificador}')`);
      let iconoButtonDelete = document.createElement('i');
      iconoButtonDelete.classList.add('fas', 'fa-trash');
      buttonDelete.appendChild(iconoButtonDelete);

      formGroupButton.appendChild(buttonEdit);
      formGroupButton.appendChild(buttonDelete);
      col4.appendChild(formGroupButton);
      rowItem.appendChild(col4);

      col12.appendChild(rowItem);
    });
    return col12;
  }
  //- Funcion para agregar un item a una seccion especifica
  function addItemSection(section_identificador) {
    let randomMath = Math.floor(Math.random() * 1000000);
    const item_identificador = `item_${randomMath}_${new Date().getTime()}`;
    let auxItemPayload = {
      ...itemPayload
    };
    auxItemPayload.identificador = item_identificador;
    auxItemPayload.nombre = 'Nombre del item';
    auxItemPayload.href = '#';
    auxItemPayload.icono = 'fas fa-link';
    if (Array.isArray(sectionPayloads) && sectionPayloads.length > 0) {
      for(let i = 0; i < sectionPayloads.length; i++) {
        if (sectionPayloads[i].identificador === section_identificador) {
          if (Array.isArray(sectionPayloads[i].items)) {
            
            let auxItems = sectionPayloads[i].items;
            let insert = true;
            for (let j = 0; j < auxItems.length; j++) {
              if (auxItems[j].identificador == item_identificador) {
                insert = false;
              }
            }

            if (insert) {
              auxItems.push(auxItemPayload);
              sectionPayloads[i].items = auxItems;
            }
          }
        }
      }

    }
    renderSectionPayloads();
  }
  //- Funcion para editar un item de una seccion especifica
  function editItemSection(item_identificador) {
    let item = null;
    if (Array.isArray(sectionPayloads) && sectionPayloads.length > 0) {
      sectionPayloads.forEach((section, index) => {
        if (Array.isArray(section.items) && section.items.length > 0) {
          section.items.forEach((itemAux, index) => {
            if (itemAux.identificador === item_identificador) {
              item = itemAux;
            }
          });
        }
      });
    }
    if (item) {
      
      nombre_item.value = item.nombre;
      href_item.value = item.href;
      icono_item.value = item.icono;
      nombre_item.setAttribute('data-identificador', item.identificador);
      href_item.setAttribute('data-identificador', item.identificador);
      icono_item.setAttribute('data-identificador', item.identificador);
      $('#editItemSectionModal').modal('show');
    }
  }

  //- Funcion para guardar el item editando en el modal
  function guardarItemPayload() {
    let identificador = nombre_item.getAttribute('data-identificador');
    if (Array.isArray(sectionPayloads) && sectionPayloads.length > 0) {
      let auxSectionPayloads = sectionPayloads;

      auxSectionPayloads = auxSectionPayloads.map((section, index) => {
        if (Array.isArray(section.items) && section.items.length > 0) {
          section.items = section.items.map((item, index) => {
            if (item.identificador === identificador) {
              item.nombre = nombre_item.value;
              item.href = href_item.value;
              item.icono = icono_item.value;
            }
            return item;
          });
        }
        return section;
      });
      sectionPayloads.splice(0, sectionPayloads.length);
      sectionPayloads.push(...auxSectionPayloads);
      renderSectionPayloads();
      $('#editItemSectionModal').modal('hide');
    }
  }

  //- Funcion para vorrar un item de una seccion
  function deleteItemSection(item_identificador) {
    Swal.fire({
      title: '¿Estás seguro?',
      text: "¡No podrás revertir esto!",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#3085d6',
      cancelButtonColor: '#d33',
      confirmButtonText: '¡Sí, bórralo!'
    }).then((result) => {
      if (result.isConfirmed) {
        if (Array.isArray(sectionPayloads) && sectionPayloads.length > 0) {
          let auxSectionPayloads = sectionPayloads;

          auxSectionPayloads = auxSectionPayloads.map((section, index) => {
            if (Array.isArray(section.items) && section.items.length > 0) {
              section.items = section.items.filter((item, index) => {
                return item.identificador !== item_identificador;
              });
            }
            return section;
          });
          sectionPayloads.splice(0, sectionPayloads.length);
          sectionPayloads.push(...auxSectionPayloads);
          renderSectionPayloads();
        }
      }
    })
  }
  //- Funcion para borrar la seccion
  function deleteSection(section_identificador) {
    Swal.fire({
      title: '¿Estás seguro?',
      text: "¡No podrás revertir esto!",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#3085d6',
      cancelButtonColor: '#d33',
      confirmButtonText: '¡Sí, bórralo!'
    }).then((result) => {
      if (result.isConfirmed) {
        if (Array.isArray(sectionPayloads) && sectionPayloads.length > 0) {
          let auxSectionPayloads = sectionPayloads.filter((section, index) => {
            return section.identificador !== section_identificador;
          });
          sectionPayloads.splice(0, sectionPayloads.length);
          sectionPayloads.push(...auxSectionPayloads);
          renderSectionPayloads();
        }
      }
    })
  }
  //- Funcion para guardar la seccion, esta la ejecuta el evento onchagen en los inputs nombre y descripcion de la seccion
  function saveSection(section_identificador) {
    let name_section = document.getElementById(`name_section_${section_identificador}`);
    let descripcion_section = document.getElementById(`description_section_${section_identificador}`);
    if(Array.isArray(sectionPayloads) && sectionPayloads.length > 0) {
      let auxSectionPayloads = sectionPayloads;
      auxSectionPayloads = auxSectionPayloads.map((section, index) => {
        if (section.identificador === section_identificador) {
          section.nombre = name_section.value;
          section.descripcion = descripcion_section.value;
        }
        return section;
      });
      sectionPayloads.splice(0, sectionPayloads.length);
      sectionPayloads.push(...auxSectionPayloads);
      renderSectionPayloads();
    }
  }

  
