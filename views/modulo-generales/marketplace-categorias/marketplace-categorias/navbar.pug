.border-left.border-right.border-bottom.p-3 
  .container-fluid
    .row
      .col-12 
        h3 #{translation.NAVBAR}
    .row.mt-3
      .col-12.col-md-6
        .row.align-items-end
          .col-8
            .form-group
              label(for="nombre_navbar") #{translation.NAME}
              select#nombre_navbar.form-control(name="nombre")
                option(value="0" selected) #{translation.SELECT}
                option(value="link") #{translation.LINK}
          .col-4
            .form-group
              button#addPayload.btn.btn-primary.btn-block(type="button")  #{translation.ADD}
                i.fas.fa-plus.ml-2
        .row
          .col-12 
            #render_payload_here
      .col-12.col-md-6 
        #edit_payload_child

script.
  const render_payload_selected = document.getElementById('render_payload_here');
  const edit_payload_child = document.getElementById('edit_payload_child');
  const addPayload = document.getElementById('addPayload');
  const nombreInsert = document.getElementById('nombre_navbar');

  let menuPayload = [
    {
      el: 'ul',
      class: 'navbar-nav mr-auto',
      'data-name': 'Menu 1',
      'data-identifier': 'menu-1',
      children: [
        
      ]
    }
  ]


  /**
  * La siguiente funcion renderiza el menu principal
  */
  function renderMenuPayload () {
    const payload = {...menuPayload[0]};
    const { el, class: className, children, ...rest } = payload;
    const listgroup = document.createElement('div');
    listgroup.className = 'list-group';
    if (children) {
      children.forEach(child => {
        const { el, class: className, children, text, ...rest } = child;
        const linkMatch = /link/gi.test(child['data-identifier']);
        if (linkMatch) {
          const listgroupitem = document.createElement('button');
          listgroupitem.className = 'list-group-item list-group-item-action';
          listgroupitem.setAttribute('type', 'button');
          listgroupitem.setAttribute('onclick', 'handleClick(this,' + JSON.stringify(child) + ')');
          if (text) {
            listgroupitem.innerText = text;
          }
          listgroup.appendChild(listgroupitem);
          if (children) {
            renderChildren(listgroupitem, children);
          }
        } else {
          const listgroupitem = document.createElement('div');
          listgroupitem.className = 'list-group-item';
          if (text) {
            listgroupitem.innerText = text;
          }
          listgroup.appendChild(listgroupitem);
          if (children) {
            renderChildren(listgroupitem, children);
          }
        }
        //- listgroup.appendChild(listgroupitem);
      });
      render_payload_selected.innerHTML = '';
      render_payload_selected.appendChild(listgroup);
    }
    
  }

  
  /**
  * La siguiente funcion renderiza los hijos de un elemento
  * se aplica recursion por si en futuro se desea agregar mas niveles
  */
  function renderChildren(listgroup, children) {
    children.forEach(child => {
      const { el, class: className, children, text, ...rest } = child;
      const linkMatch = /link/gi.test(child['data-identifier']);
      // Si es un link se crea un boton
      if (linkMatch) {
        const listgroupitem = document.createElement('button');
        listgroupitem.className = 'list-group-item list-group-item-action';
        listgroupitem.setAttribute('type', 'button');
        listgroupitem.setAttribute('onclick', 'handleClick(this,' + JSON.stringify(child) + ')');
        if (text) {
          listgroupitem.innerText = text;
        }
        listgroup.appendChild(listgroupitem);
        if (children) {
          renderChildren(listgroupitem, children);
        }
      } else {
        const listgroupitem = document.createElement('div');
        listgroupitem.className = 'list-group-item';
        if (text) {
          listgroupitem.innerText = text;
        }
        listgroup.appendChild(listgroupitem);
        if (children) {
          renderChildren(listgroupitem, children);
        }
      }
    });
  }

  function handleClick(event, el) {
    const listgroupitem = document.querySelectorAll('.list-group-item');
    listgroupitem.forEach(item => {
      item.classList.remove('active');
    });
    event.classList.add('active');
    editeFormChild(el);
  }

  /** 
  * La siguiente funcion recibe un objeto con los datos del elemento seleccionado y estrutura de Node elment
  * para crear el formulario de edicion
  */
  function editeFormChild (data) {
    const card = document.createElement('div');
    card.className = 'card';
    const cardBody = document.createElement('div');
    cardBody.className = 'card-body';
    const cardTitle = document.createElement('h5');
    cardTitle.className = 'card-title';
    cardTitle.innerText = 'Edit';
    const cardText = document.createElement('p');
    cardText.className = 'card-text';
    cardText.innerText = data['data-name'];
    // crear el formgroup para name
    const formGroup = document.createElement('div');
    formGroup.className = 'form-group';
    const label = document.createElement('label');
    label.innerText = 'Name';
    const input = document.createElement('input');
    input.className = 'form-control';
    input.setAttribute('type', 'text');
    input.setAttribute('value', data.text);
    input.setAttribute('placeholder', 'Name')
    input.setAttribute('id', 'name')
    formGroup.appendChild(label);
    formGroup.appendChild(input);

    // crear el formgroup para link
    const formGroup2 = document.createElement('div');
    formGroup2.className = 'form-group';
    const label2 = document.createElement('label');
    label2.innerText = 'Link';
    const input2 = document.createElement('input');
    input2.className = 'form-control';
    input2.setAttribute('type', 'text');
    input2.setAttribute('value', data.href);
    input2.setAttribute('placeholder', 'Link');
    input2.setAttribute('id', 'link');
    formGroup2.appendChild(label2);
    formGroup2.appendChild(input2);

    // Filas y columna
    const row = document.createElement('div');
    row.className = 'row';
    const col = document.createElement('div');
    col.className = 'col-12';
    col.appendChild(formGroup);

    const col2 = document.createElement('div');
    col2.className = 'col-12';
    col2.appendChild(formGroup2);

    card.appendChild(cardBody);
    cardBody.appendChild(cardTitle);
    cardBody.appendChild(cardText);
    cardBody.appendChild(row);
    row.appendChild(col);
    row.appendChild(col2);
    const button = document.createElement('button');
    button.className = 'btn btn-primary';
    button.innerText = 'Save';

    const buttonDelete = document.createElement('button');
    buttonDelete.className = 'btn btn-danger ml-1';
    buttonDelete.innerText = 'Delete';
    buttonDelete.setAttribute('onclick', 'deleteChild(' + JSON.stringify(data) + ')');

    button.setAttribute('onclick', 'saveChanges(' + JSON.stringify(data) + ')');
    cardBody.appendChild(button);
    cardBody.appendChild(buttonDelete);

    edit_payload_child.innerHTML = ''
    edit_payload_child.appendChild(card);
  }

  function saveChanges(data) {
    // Edit menuPayload
    const name = document.getElementById('name').value;
    const link = document.getElementById('link').value;
    if (Array.isArray(menuPayload)) {
      menuPayload = menuPayload.map(item => {
        if (item.children) {
          item.children =  alterChildren(item.children, data, name, link);
        }
        return item;
      });
      renderMenuPayload();
    } else {
      Swal.fire({
        toast: true,
        position: 'top-end',
        icon: 'error',
        title: 'Oops...',
        text: 'Something went wrong!',
        showConfirmButton: false,
        timer: 1500
      })
    }
  }

  function deleteChild (data) {
    if (Array.isArray(menuPayload)) {
      menuPayload = menuPayload.map(item => {
        if (item.children) {
          item.children =  deleteChildren(item.children, data);
        }
        return item;
      });
      edit_payload_child.innerHTML = '';
      renderMenuPayload();
    } else {
      Swal.fire({
        toast: true,
        position: 'top-end',
        icon: 'error',
        title: 'Oops...',
        text: 'Something went wrong!',
        showConfirmButton: false,
        timer: 1500
      })
    }
  }

  function deleteChildren(children, data) {
    return children.filter(child => {
      if (child.children) {
        child.children = deleteChildren(child.children, data);
      } else {
        if (child['data-identifier'] === data['data-identifier']) {
          return false;
        }
      }
      return true;
    });
  }
  
  function alterChildren(children, data, name, link) {
    return children.map(child => {
      if (child.children) {
        alterChildren(child.children, data, name, link);
      } else {
        if (child['data-identifier'] === data['data-identifier']) {
          child.text = name;
          child.href = link;
        }
      }
      return child;
    });
  }

  function insertChildren () {
    //- const name = document.getElementById('name').value;
    //- const link = document.getElementById('link').value;
    const name = 'example';
    const link = '/example';
    const mathRandom = Math.floor(Math.random() * 100000) + 10;
    const data = {
      el: 'li',
      class: 'nav-item',
      'data-name': 'Link',
      'data-identifier': 'item-' + mathRandom,
      children: [
        {
          el: 'a',
          class: 'nav-link',
          href: '/example',
          text: 'Example',
          'data-name': 'Link',
          'data-identifier': 'item-' + mathRandom +'.link-' + (mathRandom - 1)
        }
      ]
    }
    if (Array.isArray(menuPayload) && menuPayload.length > 0) {
      menuPayload = menuPayload.map(item => {
        if (item.children) {
          //- item.children =  insertChildrenInArray(item.children, data);
          item.children.push(data);
        }
        return item;
      });
      renderMenuPayload();
    } else {
      Swal.fire({
        toast: true,
        position: 'top-end',
        icon: 'error',
        title: 'Oops...',
        text: 'Something went wrong!',
        showConfirmButton: false,
        timer: 1500
      })
    }
  }

  function insertChildrenDropdown () {
    const name = document.getElementById('name').value;
    const link = document.getElementById('link').value;
    const data = {
      "el": "a",
      "class": "dropdown-item",
      "href": link,
      "text": name,
      "data-identifier": "link-" + Math.floor(Math.random() * 1000000),
      "data-name": name
    }
    if (Array.isArray(menuPayload)) {
      menuPayload = menuPayload.map(item => {
        if (item.children) {
          item.children =  insertChildrenInArray(item.children, data);
        }
        return item;
      });
      renderMenuPayload();
    } else {
      Swal.fire({
        toast: true,
        position: 'top-end',
        icon: 'error',
        title: 'Oops...',
        text: 'Something went wrong!',
        showConfirmButton: false,
        timer: 1500
      })
    }
  }

  function insertChildrenInArray (children, data) {
    return children.map(child => {
      if (child.children) {
        insertChildrenInArray(child.children, data);
      } else {
        if (child['data-identifier'] === data['data-identifier']) {
          child.children = [data];
        }
      }
      return child;
    });
  }
  addPayload.addEventListener('click', (event) => {
    switch (nombreInsert.value) {
      case 'link':
        insertChildren();
        renderMenuPayload(); 
        break;
      case 'dropdown':
        insertChildrenDropdown();
        break;
      default:
        break;
    }
  });

