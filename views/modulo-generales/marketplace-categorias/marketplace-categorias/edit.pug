extends ../layout.pug

append contenido
  include /mixins/btn/back.pug
  .border.rounded.p-3
    .row
      .col-12 
        h3 #{translation.WEBSITE}
    //- | #{JSON.stringify(marketplace)}
    input#marketplaceId(type="hidden" value=marketplace[0].id)
    input#marketplaceImagen(type="text" value=marketplace[0].logo hidden)
    input#marketplaceFavicon(type="text" value=marketplace[0].favicon hidden)
    .container-fluid
      .row
        .col-6
          +btn-back()
        .col-6.text-right
          button#guardarMarketplace.btn.btn-primary(type="button") #{translation.SAVE}
            i.fas.fa-save.ml-2
      .row
        .col-12.col-md-8
          .form-group
            label(for="nombre") #{translation.NAME} *
            input#nombre.form-control(type="text" placeholder=translation.NAME name="nombre" required value=marketplace[0].nombre)
        .col-12.col-md-8
          .row.align-items-end
            .col-9
              .form-group
                label(for="token") TOKEN
                input#token.form-control(type="text" placeholder="TOKEN" name="token" value=marketplace[0].token readonly)
                input#old_token(type="hidden" value=marketplace[0].token readonly)
            .col-3
              .form-group
                button.btn.btn-primary.btn-block(type="button" id="generateToken" onclick="generarNewToken()") REGENERAR
                  i.fas.fa-sync-alt.ml-3
        .col-12.col-md-8
          .form-group
            label(for="repository") REPOSITORY
            input#repository.form-control(type="text" placeholder="REPOSITORY" name="repository" value=marketplace[0].repository)
        .col-12.col-md-4
          include /modulo-tv/modulo-general/galeria-fotos/favicon.pug
        .col-12.col-md-4 
          .form-group
            label(for="tipo_telefono") #{translation.PHONE_TYPE}
            select#tipo_telefono.form-control(name="tipo_telefono")
              option(value="") #{translation.PHONE_TYPE}
              option(value="whatsapp" selected=marketplace[0].tipo_telefono == 'whatsapp' ? 'selected': null) Whatsapp
              option(value="telefono" selected=marketplace[0].tipo_telefono == 'telefono' ? 'selected': null) Telefono
              option(value="celular" selected=marketplace[0].tipo_telefono == 'celular' ? 'selected': null) Celular
              option(value="otro" selected=marketplace[0].tipo_telefono == 'otro' ? 'selected': null) Otro
        .col-12.col-md-4
          .form-group
            label(for="telefono") #{translation.PHONE}
            input#telefono.form-control(type="number" placeholder=translation.PHONE name="telefono" value=marketplace[0].telefono)
        .col-12.col-md-4 
          .form-group
            label(for="url_telefono") #{translation.PHONE_URL}
            input#url_telefono.form-control(type="text" placeholder=translation.PHONE_URL name="url_telefono" value=marketplace[0].url_telefono)
        .col-12.col-md-8
          .form-group
            label(for="eslogan") #{translation.SLOGAN}
            textarea#eslogan.form-control(placeholder=translation.SLOGAN name="eslogan") #{marketplace[0].eslogan}
        .col-12.col-md-4
          .form-group(style="overflow: hidden;")
            label(for="logo") #{translation.LOGO}
            include /modulo-tv/modulo-general/galeria-fotos/modal-galeria.pug

  include ./navbar.pug
  include ./brand.pug
  include ./footer.pug

  include /modulo-tv/modulo-general/galeria-fotos/partial-modal-galeria.pug

  script
    include /modulo-tv/modulo-general/galeria-fotos/modal-galeria.js
    include /js/modulo-tv/update.js

  script.
    const guardarMarketplace = document.getElementById('guardarMarketplace');

    const nombre = document.getElementById('nombre');
    const old_token = document.getElementById('old_token');
    const repository = document.getElementById('repository');
    const tipo_telefono = document.getElementById('tipo_telefono');
    const telefono = document.getElementById('telefono');
    const url_telefono = document.getElementById('url_telefono');
    const eslogan = document.getElementById('eslogan');
    const logo = document.getElementById('imagen');
    const navbar = document.getElementById('navbar');
    const footer = document.getElementById('footer');
    const brands = document.getElementById('brands');
    const empresa_id = document.getElementById('empresa_id');

    const marketplaceFavicon = document.getElementById('marketplaceFavicon');
    const marketplaceImagen = document.getElementById('marketplaceImagen');

    function generarNewToken () {
      $.ajax({
        url: '/generate-token',
        type: 'GET',
        success: function (data) {
          if (data.token) {
            document.getElementById('token').value = data.token;
          }
        }
      })
    }


    guardarMarketplace.addEventListener('click', async () => {
      const marketplaceId = document.getElementById('marketplaceId');
      const data = {
        nombre: nombre.value,
        tipo_telefono: tipo_telefono.value,
        telefono: telefono.value,
        url_telefono: url_telefono.value,
        eslogan: eslogan.value,
        logo: logo.value,
        favicon: favicon.value,
        repository: repository.value,
        navbar: JSON.stringify(menuPayload),
        footer: JSON.stringify(sectionPayloads),
        brands: JSON.stringify(brandsPayload)
      }

      if (token.value != old_token.value) {
        data.token = token.value;
      }

      updateItem('/admin-marketplace-categorias/items/' + marketplaceId.value, data, guardarItemSuccess)

    });

    function guardarItemSuccess(data) {}

    addEventListener('DOMContentLoaded', () => {
      const navbar_item = !{marketplace[0].navbar};
      const footer_item = !{marketplace[0].footer};
      const brands_item = !{marketplace[0].brands};

      if (marketplaceFavicon.value != '') {
        try {
          new URL(marketplaceFavicon.value);
          $('#showFavicon').html('<img src="' + marketplaceFavicon.value + '" class="img-fluid" alt="Responsive image">');
          favicon.value = marketplaceFavicon.value;
        } catch (e) {}
      }

      if (marketplaceImagen.value != '') {
        try {
          new URL(marketplaceImagen.value);
          $('.imagen_').html(`
            <figure style="position: relative;">
              <img src="${marketplaceImagen.value}" class="image-item-galeria-photo" alt="Responsive image">
              <button type="button" class="btn btn-danger btn-sm" onclick="deletePhotoMultimediaFromTemplate()" style="position: absolute; top: 0; right: 0; z-index: 1;">
                <i class="fas fa-trash"></i>
              </button>
            </figure>
          `);

          imagen.value = marketplaceImagen.value;
        } catch (e) {}
      }
  
      if (footer_item) {
        sectionPayloads.push(...footer_item);
      }
      if (navbar_item) {
        if(Array.isArray(navbar_item) && navbar_item.length > 0) {
          menuPayload = []
          menuPayload.push(...navbar_item);
        }
      }
      if (brands_item) {
        brandsPayload.push(...brands_item);
      }

      renderSectionPayloads();
      renderMenuPayload();
      renderBrands();

    });
  