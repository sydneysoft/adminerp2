mixin select2-estados(target = "lista-estados-filtro")
  .form-group
    label(for=target) Estado
    select.form-control(id="lista-estados-filtro")
      option(value="") Todos
      option(value="1") Activado
      option(value="0") Desactivado

  script.
    const select2Estados = $(`#!{target}`).select2()
