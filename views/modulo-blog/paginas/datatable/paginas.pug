script.
  let tablaPaginas;
  $(document).ready(function () {
    let urlAjax = '/admin-blog/paginas/datatable'
    if (typeof empresa_id != 'undefined' && !isNaN(empresa_id.value)) {
      urlAjax = `/admin-blog/paginas/datatable/${empresa_id.value}`
    }
    tablaPaginas = $('#tabla-blog-paginas').DataTable({
      fnCreatedRow: function (nRow, aData, iDataIndex) {
        $(nRow).attr('id', `delete${aData.id}`);
      },
      columnDefs: [
        {
          orderable: false,
          className: "select-checkbox",
          targets: 0,
        },
      ],
      select: {
        style: "multi",
        selector: "td:first-child",
      },
      dom: "Bfrtip",
      buttons: ["selectAll", "selectNone"],
      order: [[1, "asc"]],
      language: {
        buttons: {
          selectAll: "Seleccionar todos",
          selectNone: "Borrar Selección",
        },
        url: "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json",
        select: {
          rows: "%d filas seleccionadas",
        },
      },
      rowId: 'id',
      pageLength: 20,
      responsive: true,
      processing: true,
      serverSide: true,
      ajax: urlAjax,
      dataType: 'json',
      type: 'POST',
      order: [[0, 'desc']],
      searchDelay: 500,
      columns: [
        {
          data: 'id',
          name: 'id',
          title: 'ID',
          searchable: false,
          orderable: true,
          render: function (data, type, row) {
            return "";
          }
        },
        {
          data: 'titulo',
          name: 'titulo',
          title: '#{translation.NAME}'
        },
        {
          data: 'subtitulo',
          name: 'subtitulo',
          title: '#{translation.SUBTITLE}'
        },
        {
          data: 'estracto',
          name: 'estracto',
          title: '#{translation.EXTRACT}',
          visible: false,
          orderable: false,
          searchable: false
        },
        {
          data: 'estado',
          name: 'estado',
          title: '#{translation.STATUS}',
          visible: false,
          searchable: true,
          orderable: true,
        },
        { 
          data: 'imagen', name: 'imagen', title: '#{translation.IMAGE}',
          searchable: false,
          orderable: false,
          render: function (data, type, row) {
            try {
              new URL(row.imagen);
              return `<img src="${row.imagen}" alt="imagen" style="width: 50px; height: 50px;">`
            } catch(e) {
              return `<img src="/images/image-default.jpg" alt="imagen" style="width: 50px; height: 50px;">`
            }
          }
        },
        {
          data: 'acciones',
          name: 'acciones',
          title: '#{translation.ACTIONS}',
          render: function (data, type, row) {
            let strRow = JSON.stringify(row);
            return `
              <div class="btn-group" role="group" aria-label="acciones">
                <button class="btn btn-primary btn-sm" onclick='editarRed(${strRow})' data-toggle="modal" data-target="#editRedModal"><i class="fas fa-pen" aria-hidden="true"></i></button>
                <button class="btn btn-info btn-sm" onclick='mostrarRed(${strRow})' data-toggle="modal" data-target="#showRedModal"><i class="fas fa-eye" aria-hidden="true"></i></button>
                <button class="btn btn-danger btn-sm" onclick="beforeDeleteItem('/admin-blog/paginas/${row.id}', deleteItemSuccess)"><i class="fas fa-trash" aria-hidden="true"></i></button>
              </div>
              `
          },
          searchable: false,
          orderable: false
        }
      ],
      initComplete: function (settings) {
        //- clone thead to tfoot
        $("#tabla-blog-paginas thead tr").clone().appendTo($("#tabla-blog-paginas tfoot"));
      }
    });
  });

  function deleteItemSuccess (data) {
    if (data.ok) {
      tablaPaginas.row($(`#${data.target}`)).remove().draw();
    }
  }