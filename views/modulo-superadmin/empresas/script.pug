script.
  const changeStep = () => {
    const steps = Array.from(document.querySelectorAll(".step"));
    const [stepActive] = steps.filter((step) =>
      step.classList.contains("step-active")
    );
    const [stepHidden] = steps.filter((step) =>
      step.classList.contains("hidden")
    );


    let nombre = $("#nombreEmpresaNuevo").val();
    let correo = $("#correoCorporativoNuevo").val();

    let razon_social = $("#razonSocialNuevo").val();

    if (nombre != "" & razon_social != "" & correo != "") {

      stepActive.classList.remove("step-active");
      stepActive.classList.add("hidden");

      stepHidden.classList.remove("hidden");
      stepHidden.classList.add("step-active");
    } else {
      Swal.fire({
        position: "center",
        icon: "error",
        title: "#{translation.MUST_COMPLETE_DATA_CREATE_BUSINESS}",
        showConfirmButton: false,
        timer: 2500,
      });
    }
  }

  var numero = document.querySelector("#whatsCorporativoNuevo");

  var whatsapp_corporativo_obt = window.intlTelInput(numero, {
    hiddenInput: "full_number",
    nationalMode: false,
    formatOnDisplay: true,
    separateDialCode: true,
    autoHideDialCode: true,
    autoPlaceholder: "aggressive",
    placeholderNumberType: "MOBILE",
    initialCountry: "pe",

    utilsScript:
