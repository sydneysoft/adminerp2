.modal.fade#guardarEmpresa(tabindex="-1" role="dialog" )
  .modal-dialog.modal-lg(role="document")
    .modal-content
      .modal-header 
        .row 
          .col-12
            h5.strong(style="font-size:1rem;") #{translation.BUSINESS_DATA}

      .modal-body 
        form
          .step-one.step.step-active
            .row(style="padding:15px;")
              .col-12
                h4.title #{translation.GENERAL_INFO}
                hr
              .col-md-6.col-12
                .form-group
                  label #{translation.BUSINESS_NAME}*
                  .controls
                    input#nombreEmpresaNuevo.form-control(type="text")
              .col-md-6.col-12
                .form-group
                  label #{translation.RAZON_SOCIAL}*
                  .controls
                    input#razonSocialNuevo.form-control(type="text")
              .col-md-6.col-12
                .form-group
                  label #{translation.CORPORATE_EMAIL}*
                  .controls
                    input#correoCorporativoNuevo.form-control(type="email")


              .col-md-6.col-12
                .form-group
                  label #{translation.CORPORATE_WHATSAPP}
                  .controls
                    input#whatsCorporativoNuevo.form-control(type="text")
              .col-md-6.col-12
                .form-group
                  label #{translation.ADDRESS}
                  .controls
                    input#direccionNueva.form-control(type="text")


              .col-12
                h4.title #{translation.CONTACT_DATA}
                  hr
              .col-md-6.col-12
                .form-group
                  label #{translation.NAME}
                  .controls
                    input#nombreContactoNuevo.form-control(type="text")
              .col-md-6.col-12
                .form-group
                  label #{translation.MOBILE}

                  .controls
                    input#celularContactoNuevo.form-control(type="text")              
              .col-md-6.col-12
                .form-group
                  label #{translation.EMAIL}
                  .controls
                    input#emailContactoNuevo.form-control(type="text" ) 
              .col-md-6.col-12
                .form-group
                  label(for="contrasena") #{translation.PASSWORD}
                  input#contrasenaNueva.form-control(type="password" placeholder="Contraseña")    
            .row.justify-content-end.mt-4
              .col-md-4
                button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CANCEL}
                span  
                button.btn.btn-primary(onclick="changeStep()" type="button") #{translation.NEXT}

          .step-two.step.hidden
            .row(style="padding:15px;")
              .col-12
                h4.title #{translation.SOCIAL_NETWORKS}
                hr
              .col-md-6.col-12
                .form-group
                  label Facebook
                  .controls
                    input#facebookNuevo.form-control(type="text")
              .col-md-6.col-12
                .form-group
                  label Youtube
                  .controls
                    input#youtubeNuevo.form-control(type="text")
              .col-md-6.col-12
                .form-group
                  label Twitter
                  .controls
                    input#twitterNuevo.form-control(type="text")
              .col-md-6.col-12
                .form-group
                  label Instagram
                  .controls
                    input#instagramNuevo.form-control(type="text")  

            .row.justify-content-end.mt-4
              .col-md-4
                button.btn.btn-primary(onclick="changeStep()" type="button") #{translation.BACK}
                span 
                button.btn.btn-success(type='button' onclick="guardarEmpresa()" data-target="#guardarEmpresa") #{translation.SAVE}

