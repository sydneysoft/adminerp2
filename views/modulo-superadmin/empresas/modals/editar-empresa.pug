.modal.fade#permisosEmpresas(tabindex="-1" role="dialog" )
  .modal-dialog.modal-lg(role="document")
    .modal-content
      .modal-header(style="place-items: center;") 

        .col-md-6
          h5.strong(style="font-size:1rem;") #{translation.ACCESS_MODULES}
      .modal-body
        .row(style="padding:20px;")
          .col-md-12.col-12 

            label #{translation.ENABLED_MODULES}
            select.selectpicker(id="modulosSel" multiple  name="modulosSel" title="Selecciona" required='' ) 
              option(value=0 disabled) #{translation.SELECT_MODULES}
                each item in modulos_categorias
                  option(value= item.id)= item.nombre

        .modal-footer      
          button.btn.btn-danger(type="buton" data-dismiss="modal" onClick="closeWindows()") #{translation.CLOSE}
          span 
          button.btn.btn-success(type='button' onclick="guardarCategoria()" data-target="#guardarCategoria") #{translation.SAVE}    
