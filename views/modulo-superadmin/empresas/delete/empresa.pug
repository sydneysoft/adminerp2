script.
  const borrarEmpresa = (id) => {
    Swal.fire({
      title: "Estás Seguro?",
      text: "No podras revertir esta acción",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "#{translation.ALERTS.YES_DELETE}",
    }).then((result) => {
      if (result.isConfirmed) {
        Swal.showLoading();
        fetch(`/admin-empresas/` + id, {
          method: "delete",
        })
          .then((data) => {
            if (data.status === 200) {
              Swal.close();
              window.location.reload(true);
            } else {
              Swal.close();
              Swal.fire({
                position: "center",
                icon: "error",
                title: "#{translation.ALERTS.WRONG}",
                showConfirmButton: false,
                timer: 2500,
              });
            }
          })
          .catch(() => {
            Swal.close();
            Swal.fire({
              position: "center",
              icon: "error",
              title: "#{translation.ALERTS.WRONG}",
              showConfirmButton: false,
              timer: 2500,
            });
          });
      }
    });
  };
