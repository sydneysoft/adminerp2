    function initGrupoChangeEventListener () {
      let gruposNode = document.querySelectorAll('#permisos input[type="checkbox"]');
      gruposNode.forEach(g => {
        g.addEventListener('change', function (e) {
          let id = e.target.id;
          let tipo = id.split('_')[0];
          let identificador = id.split('_')[1];
          let permisosNode = document.querySelectorAll(`#permisos input[type="checkbox"][data-target*="${identificador}"]`);
          if (tipo == 'modulo') {
            // disable grupo checkbox
            let gruposNode = document.querySelectorAll(`#permisos input[type="checkbox"][id*="grupo_${identificador}"]`);
            gruposNode.forEach(g => {
              console.log(g)
              g.checked = e.target.checked;
            });
            
            permisosNode.forEach(p => {
              p.checked = e.target.checked;
            });
          } else if (tipo == 'grupo') {
            permisosNode.forEach(p => {
              p.checked = e.target.checked;
            });
          } else if (tipo == 'permiso') {
            let grupoNode = document.querySelector(`#permisos input[type="checkbox"][id="grupo_${identificador.split('.')[1]}"]`);
            let moduloNode = document.querySelector(`#permisos input[type="checkbox"][id="modulo_${identificador.split('.')[0]}"]`);
            grupoNode.checked = e.target.checked;
            moduloNode.checked = e.target.checked;
          }
        });
      });
    }