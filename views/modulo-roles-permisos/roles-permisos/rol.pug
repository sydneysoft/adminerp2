    function getAllPermisos () {
      const ajaxUrl = '/admin-roles-permisos/allpermisos';
      $.ajax({
        url: ajaxUrl,
        type: 'GET',
        dataType: 'json',
        success: function (data) {
          console.log(data)
          // data.permisos = [{ id: 1, nombre: "Nombre", identificador: "modulo_tv.categoria.create"}]
          // filtar por identificador, el identificador antes del punto es el modulo general, intermedio es sub grupo y el ultimo es el permiso
          // generar una estructura asi: permisos = [{modulo: "modulo_tv", grupos: [{grupo: "categoria", permisos: [{id: 1, nombre: "Nombre", identificador: "modulo_tv.categoria.create"}]}]}]
          
          if (data.ok) {
            let permisos = []
            data.permisos.forEach(p => {
              let modulo = p.identificador.split('.')[0];
              let grupo = p.identificador.split('.')[1];
              let permiso = p.identificador.split('.')[2];
              let permisoObj = {id: p.id, nombre: p.nombre, identificador: p.identificador};
              let grupoObj = {grupo: grupo, permisos: [permisoObj]};
              let moduloObj = {modulo: modulo, grupos: [grupoObj]};
              let moduloIndex = permisos.findIndex(m => m.modulo == modulo);
              if(moduloIndex == -1) {
                permisos.push(moduloObj);
              } else {
                let grupoIndex = permisos[moduloIndex].grupos.findIndex(g => g.grupo == grupo);
                if(grupoIndex == -1) {
                  permisos[moduloIndex].grupos.push(grupoObj);
                } else {
                  permisos[moduloIndex].grupos[grupoIndex].permisos.push(permisoObj);
                }
              }
            });
            renderPermisos(permisos);
          }          
        },
        error: function (error) {
          console.log(error)
        }
      })
    }

