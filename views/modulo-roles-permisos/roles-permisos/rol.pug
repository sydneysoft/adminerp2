    function getPermisos () {
      let permisos = [];
      let permisosNode = document.querySelectorAll('#permisos input[type="checkbox"]:checked');
      permisosNode.forEach(p => {
        let identificador_permiso = p.getAttribute('data-target');
        let id_permiso = p.id.split('_')[1]
        permisos.push({
          id: id_permiso,
          identificador: identificador_permiso
        });
      });
      return permisos;
    }

