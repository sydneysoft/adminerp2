.modal.fade#nuevoBannerAdministrador(tabindex="-1" role="dialog")
  .modal-dialog(role="document")
    .modal-content
      .modal-body
        .row(style="padding:10px;margin-bottom:8px;")
          .row 
            .col-md-12(style="margin-bottom:20px;")
                label(for="lista-categorias")="Seleccionar Categoria:"
                select#lista-categorias
            .col-md-12(style="margin-bottom:20px;")
                label(for="lista-subcategorias")="Seleccionar Subcategoria:"
                select#lista-subcategorias

            .col-md-12(style="margin-bottom:20px;")
                label(for="nombre")="Nombre del Tutorial:"
                input.form-control(type="text",id="nombre", name="nombre")

            .col-md-12(style="margin-bottom:20px;")
                label(for="urlVideo")="URL del Tutorial (Opcional):"
                input.form-control(type="text",id="urlVideo", name="urlVideo")
            .col-md-12(style="margin-bottom:20px;")
                label(for="videoUpload")="Subir Video:"
                input.form-control(type="file",id="videoUpload", name="videoUpload")
      .modal-footer
        button.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;",onClick=`AgregarMarcasAdmin(${token})`) #{translation.ADD}
          i.fas.fa-save.ml-2
        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
          i.fas.fa-times-circle.ml-2
