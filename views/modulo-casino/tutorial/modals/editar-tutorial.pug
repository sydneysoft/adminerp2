.modal.fade#editarBannerAdministrador(tabindex="-1" role="dialog")
  .modal-dialog(role="document")
    .modal-content
      .modal-body
        .row(style="padding:10px;margin-bottom:8px;")
          .row

            input.form-control(type="hidden",id="id-editar", name="id") 
            .col-md-12(style="margin-bottom:20px;")
                .row
                    .col-md-1(style="height:35px;")
                        div(style="height: 100%;display: flex;align-items: center;")
                            label(style="color:#202020")="Seleccionar Categoria:"
                    .col-md-11
                        select#lista-categorias-editar
            .col-md-12(style="margin-bottom:20px;")
                .row
                    .col-md-1(style="height:35px;")
                        div(style="height: 100%;display: flex;align-items: center;")
                            label(style="color:#202020")="Seleccionar Subcategoria:"
                    .col-md-11
                        select#lista-subcategorias-editar

            .col-md-12(style="margin-bottom:20px;")
                .row
                    .col-md-1(style="height:35px;")
                        div(style="height: 100%;display: flex;align-items: center;")
                            label(style="color:#202020")="Nombre del Tutorial:"
                    .col-md-11
                        input.form-control(type="text",id="nombre-editar", name="nombre")

            .col-md-12(style="margin-bottom:20px;")
                .row
                    .col-md-1(style="height:35px;")
                        div(style="height: 100%;display: flex;align-items: center;")
                            label(style="color:#202020")="URL del Tutorial (Opcional):"
                    .col-md-11
                        input.form-control(type="text",id="urlVideo-editar", name="urlVideo")
            .col-md-12(style="margin-bottom:20px;")
                .row
                    .col-md-1(style="height:35px;")
                        div(style="height: 100%;display: flex;align-items: center;")
                            label(style="color:#202020")="Subir Video:"
                    .col-md-11
                        input.form-control(type="file",id="videoUpload", name="videoUpload")
      .modal-footer
        button.btn.btn-success.editar(type="button" style="margin-left:7px;margin-right:7px;", onClick=`updateTutorialAdmin()`) #{translation.UPDATE}
          i.fas.fa-save.ml-2
        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
          i.fas.fa-times-circle.ml-2
