script.
  //Eliminar Marcas
  const eliminarMarcasAdmin = (val) => {
    Swal.fire({
      title: "Estás Seguro?",
      text: "No podras revertir esta acción",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Si, Eliminar!",
    }).then((result) => {
      if (result.isConfirmed) {
        handleDeleteMarcasAdmin(val);
      }
    });
  };

  const handleDeleteMarcasAdmin = (val) => {
    Swal.showLoading();
    $.ajax({
      method: "DELETE",
      url: "/admin-marcas/" + val,
      dataType: "json",
      success: function (data) {
        if (data.ok) {
          Swal.close();
          toastSweet('Success', '#{translation.ALERTS.DELETED}', 'success');
          if(typeof tablaMarcas != 'undefined') {
            tablaMarcas.ajax.reload();
          }
        } else {
          Swal.close();
          toastSweet('Error', '#{translation.ALERTS.WRONG}', 'error');
        }
      },
      error: function () {
        Swal.close();
        toastSweet('Error', '#{translation.ALERTS.WRONG}', 'error');
      },
    });
  };