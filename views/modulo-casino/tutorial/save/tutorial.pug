script.
  const AgregarMarcasAdmin = () => {

    let formData= new FormData();
    let nombre = $("#nombre").val();
    let categoria = $("#lista-categorias").val();
    let subcategoria = $("#lista-subcategorias").val();
    let files= document.getElementById("videoUpload")
    let urlVideo = $("#urlVideo").val();
    formData.append("titulo", nombre)
    formData.append("id_categoria", categoria)
    formData.append("id_subcategoria", subcategoria)
    formData.append("url",  urlVideo)
    formData.append("video", files.files[0])

    if (nombre && categoria && subcategoria && (files  ||  urlVideo) {
      if (typeof empresa_id != 'undefined' && empresa_id && !isNaN(empresa_id.value)) {
        formData.append("empresa_id", empresa_id.value);
      } 
      //- else {
      //-   if (token) {
      //-     auxData.empresa_id = token;
      //-   }
      //- }
      Swal.showLoading();
      $.ajax({
        method: "POST",
        url: "/admin-casino",
        dataType: "json",
        data: auxData,
        contentType: false,
        processData: false,
        success: function (data) {
          if (data.ok) {
            Swal.close();
            $("#nuevoBannerAdministrador").modal("hide");
            toastSweet('Success', '#{translation.CREATED}', 'success');
            if(typeof tablaMarcas != 'undefined') {
              tablaMarcas.ajax.reload();
              $("#empresa_id").val("");
            }
          } else {
            Swal.close();
            toastSweet('Error', '#{translation.BRAND_ERROR}', 'error');
          }
        },
        error: function () {
          Swal.close();
          toastSweet('Error', '#{translation.WRONG}', 'error');
        },
      });
    } else {
      toastSweet('Error', '#{translation.FORM_EMPTY}', 'error');
    }
  };