extends ../../extends/menu-superior-admin
block contenido
    .row
        .col-6.text-grey(style="margin-bottom:10px;")
            h1.display-1
                strong #{translation.MANAGERS}  
                    if Array.isArray(items.usuarios)
                        span.light= items.usuarios.length
                    else
                        span.light 0
        .col-md-6.col-6.text-right 
        
            button.btn.btn-success(style="margin-bottom:25px;" type="button" data-toggle="modal" data-target="#nuevoUsuarioAdministrador")
                i.fas-fa-plus
                span #{translation.NEW_MANAGER} 
        .col-12
            div.table-responsive
                table.table.table-bordered#tabla-categorias
                    thead.thead-dark
                        tr
                            th.text-center #{translation.NAMES}
                            th.text-center #{translation.SURNAMES}
                            th.text-center #{translation.EMAIL}
                            th.text-center #{translation.DOCUMENT_TYPE}
                            th.text-center #{translation.ACTIONS}
                    tbody
                        if Array.isArray(items.usuarios)
                            each book in items.usuarios
                                tr
                                    td.text-center=book.nombre
                                    td.text-center=book.apellido
                                    td.text-center=book.correo
                                    td.text-center=book.tipo_documento
                                    td.text-center.col-right
                                        button.btn.btn-warning(style="margin-right:7px;", type="button",onclick="handleEditUsuario('"+book.id+"','"+book.tipo_documento+"','"+book.numero_documento+"','"+book.nombre+"','"+book.apellido+"','"+book.celular+"','"+book.correo+"')")
                                            i.fas.fa-edit
                                        button.delete.btn.btn-danger(onClick="eliminarAdminUsuario('"+book.id+"')")
                                            i.fas.fa-trash
    
    include ./modals/crear-usuario-administrador.pug
    include ./modals/editar-usuario-administrador.pug

    include ./save/usuario-administrador.pug
    include ./update/usuario-administrador.pug
    include ./delete/usuario-administrador.pug

    //- script(src="//cdn.jsdelivr.net/npm/bootstrap-select@1.13.17/dist/js/bootstrap-select.min.js")
    //- link(rel='stylesheet' href="//cdn.jsdelivr.net/npm/bootstrap-select@1.13.17/dist/css/bootstrap-select.min.css")
    script.
        var input = document.querySelector("#telefono_user");
        var itiRegister = window.intlTelInput(input, {
            separateDialCode:true,
            utilsScript: "https://cdn.jsdelivr.net/npm/intl-tel-input@17.0.3/build/js/utils.js",
        });

        var inputEditar = document.querySelector("#telefono_user_editar");
        var itiEditar = window.intlTelInput(inputEditar, {
            separateDialCode:true,
            utilsScript: "https://cdn.jsdelivr.net/npm/intl-tel-input@17.0.3/build/js/utils.js",
        });
        window.itiEditar = itiEditar;

    

        $('#nuevoUsuarioAdministrador').on('shown.bs.modal', function(){
            let phoneData = $('#telefono_user'), lPadd = phoneData.prev('.iti__flag-container').width() + 6;
            phoneData.css('padding-left', lPadd);
        });

        $('#editarUsuarioAdministrador').on('shown.bs.modal', function(){
            let phoneData = $('#telefono_user_editar'), lPadd = phoneData.prev('.iti__flag-container').width() + 6;
            phoneData.css('padding-left', lPadd);
        });