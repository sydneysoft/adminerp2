.modal.fade#editarUsuarioAdministrador(tabindex="-1" role="dialog")
        .modal-dialog(role="document")
            .modal-content
                .modal-body
                    .row(style="padding:10px;margin-bottom:8px;")
                        .col-md-6.mt-2
                            label="Tipo de Documento"
                            .controls
                                input#id-user-editar(type="hidden")
                                select.form-control#tipo_documento_user_editar
                                    option(value #{translation.DOCUMENT_NUMBER}) #{translation.DOCUMENT_NUMBER}
                                    option(value #{translation.FOREIGNER_CARD}) #{translation.FOREIGNER_CARD}
                                    option(value #{translation.OTHER}) #{translation.OTHER}
                        .col-md-6.mt-2
                            label #{translation.DOCUMENT_NUMBER}
                            .controls
                                input.form-control#numero_documento_user_editar(type="number" autoComplete="new-password")
                        .col-md-6.mt-2 
                            label #{translation.NAMES}
                            .controls
                                input.form-control#nombres_user_editar(type="text" autoComplete="new-password")
                        .col-md-6.mt-2 
                            label #{translation.LAST_NAMES}
                            .controls
                                input.form-control#apellidos_user_editar(type="text" autoComplete="new-password")
                        .col-md-6.mt-2 
                            label #{translation.PHONE}
                            .controls
                                input.form-control#telefono_user_editar(type="tel")
                        .col-md-6.mt-2 
                            label #{translation.EMAIL}
                            .controls
                                input.form-control#correo_user_editar(disabled type="text" autoComplete="new-password")
                       
                .modal-footer 
                    button.btn.btn-success(onClick="updateUserAdmin()") {translation.UPDATE}
                    button.btn.btn-danger(data-dismiss="modal") #{translation.CANCEL}
