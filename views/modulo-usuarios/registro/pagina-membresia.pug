extends ../../extends/viewregister
block formRegister
    section
        div.container
          div.row 
            div.plan
                    p       
                    h5 #{translation.SELECT_PRODUCT_TO_HIRE}
                    p=plan.nombre
                    p.resaltado #{translation.CURRENCY_SYMBOL}
                        span= plan.precio
            div.plan            
              form#registro-form
                div.progress-wrap
                    div.line-progress-bar
                        div.line
                        ul.checkout-bar
                            li.progressbar-dots.active
                            span  
                            li.progressbar-dots
                            span  
                            li.progressbar-dots
                div#loader(style="display:none")   	     
                div.tab-content
                    div#step1.tab-pane
                        ul
                            li 
                                label #{translation.MARKETPLACE}
                                .errorTxt(id="marketplace-error")
                                select#marketplace.selectpicker(name="markeplatce" title="Selecciona" required='' aria-describedby="marketplace-error") 
                                    option(value=0 disabled) #{translation.SELECT_MARKETPLACE}
                                    if Array.isArray(marketplaces) && marketplaces.length > 0
                                        each item in marketplaces
                                            option(value=item.id)= item.nombre
                            li
                                label #{translation.BUSINESS_NAME}
                                .errorTxt(id="nombre-error")
                                input#nombre(type='text' name='nombre' required='' aria-describedby="nombre-error")
  
                            li
                                label #{translation.RUC}
                                .errorTxt(id="documento-error")
                                input#documento(type='text' name='documento' minlength=8 aria-describedby="documento-error")
                             
                            li(style='list-style: none; display: inline')
                                 button.next-btn.next-btn1(type='button') #{translation.NEXT}
                    div#step2.tab-pane
                        ul
                           
                            li
                            label #{translation.WHAT_DO_YOU_DO}
                            .errorTxt(id="categoria-error")
                            select.selectpicker(id="categoria"  name="categoria" title="Selecciona" required='' aria-describedby="categoria-error") 
                                option(value=0 disabled) #{translation.SELECT_ECONOMY_SECTOR}
                                if Array.isArray(categorias) && categorias.length > 0
                                    each item in categorias
                                        option(value=item.categoria)= item.categoria
                                    
                            li
                            label #{translation.CORPORATE_EMAIL}
                            .errorTxt(id="email-error")
                            input#email(type='email' name='email' placeholder='Correo Electrónico' required='' aria-describedby="email-error")
                            li
                            label #{translation.PASSWORD}
                            .errorTxt(id="password-error")
                            input#password(type='Password' name='pswd' required='' aria-describedby="password-error")
                            li
                            button.next-btn.next-btn2(type='button') #{translation.NEXT}
                    #step3.tab-pane
                        ul
                            li
                            label #{translation.CONTACT_NAME}
                            .errorTxt(id="contacto-error")
                            input#contacto(type='text' name='bf_fullname' required='' aria-describedby="contacto-error")
                            li
                            label #{translation.CORPORATE_MOBILE}
                            .errorTxt(id="telefono-error")
                            input#telefono(type='phone' name='phone' required='' aria-describedby="telefono-error")
                            p.form__terms
                            #{translation.REGISTERED_YOU_ACCEPT}
                            a(href="#")  #{translation.TERMS_AND_CONDITIONS}
                            li
                            button.submit-btn(type='button' onclick=`enviarFormulario(${plan.id})`) #{translation.REGISTER_TO_PAY}
                        
                
    style.
    
        .selectpicker{
            width:100%;
            height: 60px;
            font-size: 21px;
            
        }
        .logo-registro {
            margin-bottom: 4rem;
            width: 100;
            text-align: center;
        }
        .bootstrap-select>.dropdown-toggle {
            position: relative;
            width: auto!important;
        }
        #formSent{
            display:none
        }
        .errorTxt {
            color: red;
        }
        

    link(rel='stylesheet' href="/css/stylesMembresia.css")
    script(src="//cdn.jsdelivr.net/npm/bootstrap-select@1.13.17/dist/js/bootstrap-select.min.js")
    link(rel='stylesheet' href="//cdn.jsdelivr.net/npm/bootstrap-select@1.13.17/dist/css/bootstrap-select.min.css")
    script(src='//cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.17.0/jquery.validate.js')
    
    script
        include ./scriptMembresia.js