script.
  let tablaTrabajadores;
  addEventListener("DOMContentLoaded", () => {
    let urlAjaxTrabajadores = "/admin-trabajadores/datatable";
    if (typeof empresa_id != 'undefined' && empresa_id && !isNaN(empresa_id.value)) {
      urlAjaxTrabajadores += `/${empresa_id.value}`;
    }
    tablaTrabajadores = $("#tabla-trabajadores").DataTable({
      "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"},
      "responsive": true,
      searchDelay: 500,
      processing: true,
      serverSide: true,
      ajax: urlAjaxTrabajadores,
      columns: [
        { data: 'id', name: 'id', title: 'ID', orderable: false, searchable: false, visible: false},
        {
          data: 'primer_nombre', name: 'primer_nombre', title: "#{translation.FORM.FIRST_NAME}", orderable: true, searchable: true,
        },
        {
          data: 'segundo_nombre', name: 'segundo_nombre', title: "#{translation.FORM.SECOND_NAME}", orderable: true, searchable: true,
        },
        {
          data: 'apellido_paterno', name: 'apellido_paterno', title: "#{translation.FORM.FATHER_LAST_NAME}", orderable: true, searchable: true,
        },
        {
          data: 'apellido_materno', name: 'apellido_materno', title: "#{translation.FORM.MOTHER_LAST_NAME}", orderable: true, searchable: true,
        },
        {
          data: 'celular', name: 'celular', title: "#{translation.FORM.CELLPHONE}", orderable: true, searchable: true,
        },
        {
          data: 'telefono', name: 'telefono', title: "#{translation.FORM.PHONE}", orderable: true, searchable: true,
        },
        {
          data: 'correo', name: 'correo', title: "#{translation.FORM.EMAIL}", orderable: true, searchable: true,
        },
        {
          data: 'direccion', name: 'direccion', title: "#{translation.FORM.ADDRESS}", orderable: true, searchable: true,
        },
        {
          data: 'tipo_de_documento', name: 'tipo_de_documento', title: "#{translation.FORM.DOCUMENT_TYPE}", orderable: true, searchable: true,
        },
        {
          data: 'numero_de_documento', name: 'numero_de_documento', title: "#{translation.FORM.DOCUMENT_NUMBER}", orderable: true, searchable: true,
        },
        {
          data: 'foto_de_documento_cara_frontal', name: 'foto_de_documento_cara_frontal', title: "#{translation.FORM.DOCUMENT_PHOTO_FRONT}", orderable: false, searchable: false,
          render: function (data, type, row) {
            return `
              <a href="admin-trabajadores/files/${data}" target="_blank">${data}</a>
            `;
          }
        },
        {
          data: 'foto_de_documento_cara_trasera', name: 'foto_de_documento_cara_trasera', title: "#{translation.FORM.DOCUMENT_PHOTO_BACK}", orderable: false, searchable: false,
          render: function (data, type, row) {
            return `
              <a href="admin-trabajadores/files/${data}" target="_blank">${data}</a>
            `;
          }
        },
        {
          data: 'entidad_bancaria', name: 'entidad_bancaria', title: "#{translation.FORM.BANK}", orderable: true, searchable: true,
        },
        {
          data: 'numero_de_cuenta', name: 'numero_de_cuenta', title: "#{translation.FORM.ACCOUNT_NUMBER}", orderable: true, searchable: true,
        },
        {
          data: 'AFP', name: 'AFP', title: "#{translation.FORM.AFP}", orderable: true, searchable: true,
        },
        {
          data: 'CTS', name: 'CTS', title: "#{translation.FORM.CTS}", orderable: true, searchable: true,
        },
        {
          data: 'observaciones', name: 'observaciones', title: "#{translation.FORM.OBSERVATIONS}", orderable: true, searchable: true,
        },
        {
          data: 'fecha_de_contratacion', name: 'fecha_de_contratacion', title: "#{translation.FORM.HIRED_DATE}", orderable: true, searchable: true,
        },
        {
          data: 'estado', name: 'estado', title: "#{translation.FORM.STATUS}", orderable: true, searchable: true,
        },
        {
          data: 'fecha_de_despido', name: 'fecha_de_despido', title: "#{translation.FORM.FIRED_DATE}", orderable: true, searchable: true,
        },
        {
          data: 'CV', name: 'CV', title: "#{translation.FORM.CV}", orderable: false, searchable: false,
          render: function (data, type, row) {
            return `
              <a href="admin-trabajadores/files/${data}" target="_blank">${data}</a>
            `;
          }
        },
        {
          data: 'contrato', name: 'contrato', title: "#{translation.FORM.CONTRACT}", orderable: false, searchable: false,
          render: function (data, type, row) {
            return `
              <a href="admin-trabajadores/files/${data}" target="_blank">${data}</a>
            `;
          }
        },
        {
          data: 'acciones', name: 'acciones', title: '#{translation.FORM.ACTIONS}', orderable: false, searchable: false,
          render: function (data, type, row) {
            let strRow = JSON.stringify(row);
            return `
              <button class="btn btn-info" data-action="duplicate" data-id="${row.id}"><i class="fa fa-camera"></i></button>   
              <button class="btn btn-warning" data-action="edit" data-id="${row.id}"><i class="fa fa-edit"></i></button>
              <button class="btn btn-danger" data-action="delete" data-id="${row.id}"><i class="fa fa-trash"></i></button>
            `;
          }
        }
      ],
      drawCallback: function (setting) {
        initializeListener();
      }
    }); 
  })
