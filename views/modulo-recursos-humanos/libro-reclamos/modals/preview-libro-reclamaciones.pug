.modal.fade#preview-reclamo-modal 
  .modal-dialog.modal-lg(role="document")
    .modal-content
      .modal-body
        .row(style="padding:10px;margin-bottom:8px;")
          .col-6 
            label #{translation.DOCUMENT_TYPE}
            input.form-control#tipo-documento-libro(type="text" readonly)
          .col-6 
            label #{translation.NAMES}
            input.form-control#nombres-libro(type="text" readonly)
          .col-6 
            label #{translation.LAST_NAMES} 
            input.form-control#apellidos-libro(type="text" readonly)
          .col-6 
            label #{translation.ANSWER_TYPE}
            input.form-control#tipo-respuesta-libro(type="text" readonly)
          .col-6 
            label #{translation.ADDRESS} 
            input.form-control#direccion-libro(type="text" readonly)
          .col-6 
            label #{translation.DEPARTMENT}
            input.form-control#departamento-libro(type="text" readonly)
          .col-6 
            label #{translation.PROVINCE} 
            input.form-control#provincia-libro(type="text" readonly)
          .col-6 
            label #{translation.DISTRICT} 
            input.form-control#distrito-libro(type="text" readonly)
          .col-6 
            label #{translation.PHONE}
            input.form-control#telefono-libro(type="text" readonly)
          .col-6 
            label #{translation.EMAIL}
            input.form-control#email-libro(type="text" readonly)
          .col-6 
            label #{translation.ID_GOOD_HIRED}
            input.form-control#identificacion-libro(type="text" readonly)
          .col-6 
            label #{translation.AMOUNT_CLAIMED}
            input.form-control#monto-libro(type="text" readonly)
          .col-6 
            label #{translation.PRODUCT_SERVICE_NAME}
            input.form-control#nombre-producto-libro(type="text" readonly)
          .col-6 
            label #{translation.CLAIM_TYPE}
            input.form-control#tipo-reclamo-libro(type="text" readonly)
          .col-6 
            label #{translation.PRODUCT_DESCRIPTION}
            textarea.form-control#descripcion-producto-libro(cols="50" rows="5" readonly)
          .col-6 
            label #{translation.CLAIM_DESCRIPTION}
            textarea.form-control#detalle-reclamo-libro(cols="50" rows="5" readonly)

          .col-6 
            label #{translation.UNDERAGE}
            input.form-control#menor-edad-libro(type="text" readonly)
