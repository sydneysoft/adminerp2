.modal.fade#configuracionLibroReclamaciones(tabindex="-1" role="dialog")
  .modal-dialog.modal-lg(role="document")
    .modal-content
      .modal-body
        .row(style="padding:10px;margin-bottom:8px;")
          .col-12 
            .form-group
              label  #{translation.HEADER} 
              textarea#ckeditorareaEditar(name="ckeditorareaEditar")
          .col-12 
            .form-group
              label #{translation.FOOTER}
              textarea#ckeditorareaFooter(name="ckeditorareaFooter")
          .col-12
            .form-group
              label #{translation.FORM.STATE} 
              br
              input(id="toggle-state" type="checkbox" data-toggle="toggle" data-on="Activo" data-off="Desactivado" data-onstyle="success" data-offstyle="danger")

          input#idConfiguracionLibroReclamaciones(type="hidden")

      .modal-footer
        button.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;",onClick=`updateConfigurationBook()`) #{translation.UPDATE}
        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
