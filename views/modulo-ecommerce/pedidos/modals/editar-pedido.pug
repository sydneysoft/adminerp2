.modal.fade#editarPedido(tabindex="-1" role="dialog")
  .modal-dialog(role="document")
    .modal-content
      .modal-body
        input#idItem(type="text" hidden)
        .row(style="padding:10px;margin-bottom:8px;")

          .col-md-6.col-12
            .form-group
              div#facturacion
          .col-md-6.col-12
            .form-group
              div#pago
              div#envio
          .col-md-6.col-12
            .form-group
              div#resumen
          .col-md-6.col-6
            .form-group
              span  #{translation.STATE}:
              .controls
                select#estado.form-control
                  option(value="1")  #{translation.PAID} 
                  option(value="2")  #{translation.PROCESSED} 
                  option(value="3")  #{translation.DELIVERED} 

      .modal-footer
        button.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;",onClick=`actualizar(${token})`)  #{translation.UPDATE} 
        button.btn.btn-danger(type="buton" data-dismiss="modal")  #{translation.CLOSE} 
