script.
  let tablaCategorias;
  $(document).ready(function () {
    let urlAjaxTablaCategorias = "/admin-categorias/datatable"
    if (typeof empresa_id != 'undefined' && empresa_id && !isNaN(empresa_id.value)) {
      urlAjaxTablaCategorias += `/${empresa_id.value}`;
    }
    tablaCategorias = $('#tabla-categorias').DataTable({
      responsive: true,
      searchDelay: 500,
      processing: true,
      serverSide: true,
      ajax: urlAjaxTablaCategorias,
      columns: [
        { data: 'id', name: 'id', title: 'ID', orderable: false, searchable: false, visible: false},
        { 
          data: 'imagen', name: 'imagen', title: '#{translation.IMAGE}', orderable: false, searchable: false,
          render: function (data, type, row) {
            try {
              new URL(row.imagen)
              return `<img src="${data}" style="width:50px;height:50px;object-fit:cover">`;
            } catch (e) {
              return `<img src="/images/image-default.jpg" style="width:50px;height:50px;object-fit:cover">`;
            }
          }
        },
        { data: 'name', name: 'name', title: '#{translation.NAME}', orderable: true, searchable: true},
        { data: 'description', name: 'description', title: "#{translation.DESCRIPTION}", orderable: true, searchable: true},
        { 
          data: 'destacado', name: 'destacado', title: '#{translation.HIGHLIGHT}', orderable: false, searchable: false,
          render: function (data, type, row) {
            return data == 1 ? '<i class="fas text-success fa-check"></i>' : '<i class="fas fa-times text-danger"></i>';
          },
        },
        { 
          data: 'activado', name: 'activado', title: '#{translation.STATUS}', orderable: false, searchable: false,
          render: function (data, type, row) {
            console.log(data);
            return data == 1 ? '<i class="fas text-success fa-check"></i>' : '<i class="fas fa-times text-danger"></i>';
          }
        },
        { data: 'empresa_id', name: 'empresa_id', title: '#{translation.COMPANY}', orderable: true, searchable: true, visible: false},
        { 
          data: 'acciones', name: 'acciones', title: '#{translation.ACTIONS}', orderable: false, searchable: false,
          render: function (data, type, row) {
            let strRow = JSON.stringify(row);
            return `
              <button class="btn btn-warning" style="margin-right:7px;" type="button" onclick='handleEditCategoria(${strRow})'>
                <i class="fas fa-edit"></i>
              </button>
              <button class="delete btn btn-danger" onclick="eliminarCategoriaAdmin('${row.id}', '${row.name}')">
                <i class="fas fa-trash"></i>
              </button>
            `;
          }
        }
      ],
      initComplete: function (settings) {
        //- clone thead to tfoot
        $("#tabla-categorias thead tr").clone().appendTo($("#tabla-categorias tfoot"));
      }
    });

    $(".seleccionar").select2({
      language: {
        noResults: function () {
          return "#{translation.NO_RESULTS}";
        },
      },
    });

    var tableFilter = $("#tabla-categorias").dataTable();

    $('select#empresa').change(function () {
      if (this.value != 0) {
        tablaCategorias.search(this.value).draw();
      } else {
        tablaCategorias.search("").draw();
      }
    })

  });