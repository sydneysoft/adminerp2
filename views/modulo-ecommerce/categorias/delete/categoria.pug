script.
  //Eliminar Categoría Admin
  const eliminarCategoriaAdmin = (id, name) => {
    if (name == "Prendas") {
      Swal.close();
      Swal.fire({
        icon: "error",
        title: "#{translation.ALERTS.CANT_DELETE_CLOTHES_CATEGORY}",
        showConfirmButton: false,
        timer: 2500,
      });
    } else {
      Swal.fire({
        title: "#{translation.ALERTS.ARE_YOU_SURE}",
        text: "#{translation.ALERTS.YOU_CANT_REVERT_THIS_ACTION}",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "#{translation.ALERTS.YES_DELETE}",
      }).then((result) => {
        if (result.isConfirmed) {
          handleDeleteCategoria(id);
        }
      });
    }
  };

  const handleDeleteCategoria = (id) => {
    Swal.showLoading();

    $.ajax({
      method: "DELETE",
      url: `/admin-categorias/${id}`,

      success: function (data) {
        if (data.ok) {
          Swal.close();
          if (typeof tablaCategorias != 'undefined') {
            tablaCategorias.ajax.reload();
          }
          toastSweet('Success', '#{translation.ALERTS.DELETED}', 'success');
        } else {
          Swal.close();
          toastSweet('Error', '#{translation.ALERTS.WRONG}', 'error');
        }
      },
      error: function () {
        Swal.close();
        toastSweet('Error', '#{translation.ALERTS.WRONG}', 'error');
      },
    });
  };