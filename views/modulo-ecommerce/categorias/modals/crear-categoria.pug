.modal.fade#crearCategoriaModal(role="dialog")
  .modal-dialog(role="document")
    .modal-content
      .modal-body
        .row(style="padding:10px;margin-bottom:8px;")
          .col-md-12.col-12
            .form-group
              img(id="imagen-data-banner" src="https://www.cuba.travel/images/noimage.png" class="content-img-banner" onClick="handleModal()")
          if marketplace==true  
            .col-md-12.col-12
              .form-group          
              label.form-label(style="display:block") #{translation.FORM.COMPANY}:  
                select#lista-empresas.form-control
                  option(disabled selected value=null) #{translation.FORM.SELECT_BUSINESS}     
                  option(value=0) #{translation.FORM.UNASSIGNED}
                  //- each item in empresas
                    option(value=item.id)= item.nombre

          .col-md-6.col-12
            .form-group
              label #{translation.FORM.NAME} *:
              .controls
                input#nombreNuevo-categoria.form-control(type="text" placeholder=translation.FORM.NAME)
          .col-md-6.col-12
            .form-group
              label #{translation.FORM.DESCRIPTION}
              .controls
                input#descripcionNuevo-categoria.form-control(type="text" placeholder=translation.FORM.DESCRIPTION)
          .col-md-4.col-12
            .form-group
              label #{translation.FORM.STATUS} *:
              .controls
                select#activadoNuevo-categoria.form-control
                  option(value="1") #{translation.FORM.ACTIVATED}
                  option(value="0") #{translation.FORM.DEACTIVATED}
          .col-md-4.col-12
            .form-group
              label #{translation.FORM.HIGHLIGHT} *:
              .controls
                select#destacadoNuevo-categoria.form-control
                  option(value="1") #{translation.FORM.YES}
                  option(value="0") #{translation.FORM.NO}
          .col-md-3
            label #{translation.FORM.ICON}
            .controls
              button.btn.btn-info#btn-icon-data-new(data-iconset="fontawesome5" data-icon="fas fa-wifi" role="iconpicker")
          .col-md-5 
            label #{translation.FORM.ACTIVE_NAVBAR} *:	
            .controls 
              select#headerNuevo-categoria.form-control
                option(value="1") #{translation.FORM.YES}
                option(value="0") #{translation.FORM.NO}
      .modal-footer
        button.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;",onClick=`AgregarCategoriaAdmin(${token})`) #{translation.FORM.ADD}
          i.fas.fa-save.ml-2
        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.FORM.CLOSE}
          i.fas.fa-times.ml-2
