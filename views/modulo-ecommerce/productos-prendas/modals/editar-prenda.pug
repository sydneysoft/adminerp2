.modal.fade#editarProductoAdmin(tabindex="-1" role="dialog")
  .modal-dialog.modal-lg(role="document")
    .modal-content
      .modal-body
        .row(style="padding:15px;")
          .col-md-12
            .form-group(style="display:flex;justify-content:center;align-items:center;")
              img(id="imagen-data-banner-editar" src="https://www.cuba.travel/images/noimage.png" class="imagen-data-producto" onClick="handleModal()")
          if items.marketplace==true
            .col-md-6.col-12 
              h5  #{translation.BUSINESS}  
              span  #{translation.ASSOCIATE_BUSINESS_PRODUCT}
            .col-md-6.col-12        
              select#idEmpresaEditar.idClass.form-control.seleccionar(onChange="handleCompanyEdit(1)")
                option(disabled value="") #{translation.SELECT}
                option(value=0) #{translation.UNASIGNED}
                each data in items.empresas
                  option(value=data.id)= data.nombre

          .col-md-4.col-12
            input#dataIdProducto(type="hidden")
            .form-group
              label #{translation.NAME}
              .controls
                input#nombreEditar-producto-admin.form-control(type="text")
          .col-md-4.col-12
            .form-group
              label #{translation.PRICE}
              .controls
                input#precioEditar-producto-admin.form-control(type="number")
          .col-md-4.col-12
            .form-group
              label #{translation.STATUS}
              .controls
                select#estatusEditar-producto-admin.form-control
                  option(value="1") #{translation.ACTIVE}
                  option(value="0") #{translation.DEACTIVATED}
          .col-md-4.col-12
            .form-group
              label #{translation.HIGHLIGHT}
              .controls
                select#destacadoEditar-producto-admin.form-control
                  option(value="1") #{translation.YES}
                  option(value="0") #{translation.NO}
          .col-md-4.col-12
            .form-group
              label #{translation.OFFER}
              .controls
                select#ofertaEditar-producto-admin.form-control(onChange="handleChangeOfertaEdit()")
                  option(value="1") #{translation.YES}
                  option(value="0") #{translation.NO}
          .col-md-4.col-12
            .form-group
              label #{translation.CATEGORY}
              .controls

                if items.marketplace==true    
                  select#categoriaEditar-producto-admin.form-control(disabled onChange="handleChangeCategoriaEdit()")
                else 

                  select#categoriaEditar-producto-admin.form-control(onChange="handleChangeCategoriaEdit()")
                    option(value="")="Selecciona la categoría!"
                      each categoria in items.categorias
                        option(value=categoria.id)= categoria.name




          .col-md-4.col-12
            .form-group
              label #{translation.SUBCATEGORY}
              .controls
                select#subcategoriasEditar-producto-admin.form-control(onChange="handleChangeEditSubcategoria()")
          .col-md-4.col-12
            .form-group
              label #{translation.SUBFILTER}
              .controls
                select#subfiltrosEditar-producto-admin.form-control()
          .col-md-4.col-12
            .form-group
              label #{translation.BRAND}
              .controls
                select#marcaEditar-producto-admin.form-control()
          .col-md-4.col-12
            .form-group
              label #{translation.OFFER_PERCENTAGE}
              .controls
                input#porcentajeEditar-producto-admin.form-control(type="text")
          .col-md-4.col-12
            .form-group
              label #{translation.STOCK}
              .controls
                input#stockEditar-producto-admin.form-control(type="number")
          .col-md-5.col-12
            .form-group
              label #{translation.TALLAS}
              .controls
                fieldset
                  input#tallasEditar-producto-admin.form-control(name='tags-regular-tallas-editar' originalvalue="" placeholder='selecciona o escribe las tallas disponibles' value='' type="hidden")
          .col-md-5.col-12
            .form-group
              label #{translation.COLORS}
              .controls
                fieldset
                  input#coloresEditar-producto-admin.form-control(name='tags-regular-colores-editar' originalvalue="" placeholder='selecciona o escribe los colores disponibles' value='' type="hidden")
          .col-md-4.col-12 
            .form-group 
              label #{translation.PRODUCT_REVIEW}
              .controls
                select#calificacionEditar-producto-admin.form-control(onChange="handleChangeCalificacionEditar()")
                  option(value="1") #{translation.YES}
                  option(value="0") #{translation.NO}
          .col-md-4.col-12(id="comentarios-container-edit")
            .form-group 
              label #{translation.COMMENTS}
              .controls
                select#califacion-revision-Editar-producto-admin.form-control
                  option(value="1") #{translation.AUTOMATIC_PUBLISH}
                  option(value="0") #{translation.PREVIEW_REVIEW}
          .col-md-4.col-12
            .form-group
              label #{translation.SHORT_DESCRIPTION}
              .controls
                textarea#descripcionCortaEditar-producto-admin.form-control(name="" rows="2")
          .col-12#filtrosAdvancedEdit(style="display:none;")
            input#valueFiltersEdit(type="hidden")
            .form-group 
              label #{translation.FILTERS} 
              div#controlerFiltrosEditar.controls
                span#filtroEditar-producto-admin
          .col-12 
            .form-group
              label #{translation.DESCRIPTION}
              textarea#ckeditorareaEditar(name="ckeditorareaEditar")

          .col-12 
            hr

          .col-md-4.col-12 

            h5 #{translation.WAREHOUSES}  
            span #{translation.SELECT_WAREHOUSE_STOCK}
            label.radio-inline
              input.stock_question(type='checkbox' name='stock_question', value=0)
              |  #{translation.ENABLE_WAREHOUSE_MODEL}

            div.habilitarAlmacen   
              .col-md-12.col-12 
                button.btn.btn-success(type="button" onClick="cargarAlmacen('tdbodyAlmacenEditar')")
                  i.fas-fa-plus
                  span #{translation.ADD_ADDITIONAL_WAREHOUSE} 


                div.table-responsive(style="margin-top:15px;")
                  table.table.stockEditar
                    thead
                      tr.bg-dark
                        th.text-center(style="color:#fff; width:60%") #{translation.WAREHOUSE}
                        th.text-center(style="color:#fff") #{translation.QUANTITY}
                        th
                    tbody#tdbodyAlmacenEditar 
                      tr.rowEditarAlmacen
                        if items.marketplace==true   
                          td  
                            select#almacenEditar.idAlmacen.form-control(disabled)
                              option(value=0) #{translation.SELECT_WAREHOUSE}
                        else 
                          td     
                            select#almacenEditar.idAlmacen.form-control
                              option(value=0) #{translation.SELECT_WAREHOUSE}
                              each almacen in items.almacenes
                                option(value= almacen.id)= almacen.nombre    
                        td
                          input#stockEditar.stock.stockClass.form-control(type="number" style="text-align:center")

                        td  
                          button#remove.rowDelete.btn.btn-danger(type="button" style="margin-left:8px")
                            i.fa.fa-trash  

      .modal-footer      
        button.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;" onClick=`updateDataProducto(${token})`) #{translation.UPDATE_PRODUCT}
        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
