script.
  //Agregar GrupoFiltros
  function AddGroupFilter() {
    let nombre = $("#nombreNuevo-filtros").val();
    let categoria = $("#lista-categorias").val();

    const auxData = { nombre: nombre, categoria: categoria }
    if (typeof empresa_id != 'undefined' && !isNaN(empresa_id.value))  {
      auxData.empresa_id = empresa_id.value
    }
    if (nombre && categoria) {
      Swal.showLoading();
      $.ajax({
        method: "POST",
        url: "/admin-filtros/grupo",
        dataType: "json",
        data: auxData,
        success: function (data) {
          if (data.ok) {
            Swal.close();
            window.location.reload(true);
          } else {
            Swal.close();
            toastSweet('Error', '#{translation.ALERTS.WRONG}', 'error');
          }
        },
        error: function () {
          Swal.close();
          toastSweet('Error', '#{translation.ALERTS.WRONG}', 'error');
        },
      });
    } else {
      toastSweet('Error', '#{translation.ALERTS.FORM_EMPTY}', 'error');
    }
  }