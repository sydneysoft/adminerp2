          valuesEdit.push([parseInt($(this).attr("edit")), $(this).val()]);
        }
      } else {
        if ($(this).val() != "") {
          dataCategoria = $("#category-data-filtros").val();
          values.push([idGrupoFiltros, $(this).val(), dataCategory]);
        }
      }
    });

    if (typeActionData == "1") {
      if (values.length > 0 || valuesEdit.length > 0) {
