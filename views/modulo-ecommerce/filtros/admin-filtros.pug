extends ../../extends/menu-superior-admin
block contenido
    .row
        .col-6.text-grey(style="margin-bottom:10px;")
            h1.display-1
                strong #{translation.FILTERS} 
                   span.light= items.filtros.length
        .col-md-6.col-6.text-right 
            button.btn.btn-success(style="margin-bottom:25px;", type="button", data-toggle="modal" data-target="#nuevoModalFiltros")
                i.fas-fa-plus
                span #{translation.ADD_FILTER}
        if items.marketplace==1       
            .col-md-4.col-6
                div(style="display: inline-flex")
                    .form-group
                        label.font-weight-bold.datev-label #{translation.BUSINESS} 
                            select#filtroEmpresa.form-control.seleccionar
                                option(value=0) #{translation.ADD_BUSINESS} 
                                option(value="-") #{translation.UNASIGNED} 
                                    each empresa in items.empresas
                                        option(value= empresa.nombre)= empresa.nombre
        .col-12
            div.table-responsive
                table.table.table-bordered#tabla-categorias
                    thead.thead-dark
                        tr
                            th.text-center #{translation.NAME} 
                            th.text-center #{translation.CATEGORY} 
                            if items.marketplace==1
                                  th.text-center #{translation.BUSINESS} 
                            th.text-center #{translation.ACTIONS} 
                    tbody
                        each book in items.filtros
                            tr
                            
                                td.text-center=book.nombre
                                td.text-center=items.categorias.filter(i=>i.id==book.categoria)[0]?items.categorias.filter(i=>i.id==book.categoria)[0].name:book.categoria
                                if items.marketplace==1
                                    td.text-center= book.empresa_id
                                         
                                td.text-center.col-right
                                    button.btn.btn-info(style="margin-right:7px;",type="button",onClick="handleAddValuesFilter('"+book.id+"','"+book.categoria+"')")
                                        i.fas.fa-plus
                                    button.btn.btn-warning(style="margin-right:7px;",type="button",onclick="handleEdiFiltros('"+book.id+"')")
                                        i.fas.fa-edit
                                    button.delete.btn.btn-danger(onClick="eliminarFiltrosAdmin('"+book.id+"')")
                                        i.fas.fa-trash
    script
        include /js/toast.sweet.js

    include ./modals/crear-filtros.pug
    include ./modals/actualizar-filtros.pug
    include ./modals/manejar-filtro.pug  

    script.
        var deleteArray=[];
        $(document).on('click', '#removeRowDynamic', function () {
            if($(this).closest('#inputFormRow').attr("edit")){
                deleteArray.push(parseInt($(this).closest('#inputFormRow').attr("edit"))); 
            }
            $(this).closest('#inputFormRow').remove();
        });

        $(document).ready( function () {
             
            $('#tabla-categorias').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json" }
            });
 
            $(".seleccionar").select2({
                language: {
                    noResults: function () {
                        return "No se han encontrado resultados";
                    },
                },
            });
            var tableFilter = $("#tabla-categorias").dataTable();

            $('select#filtroEmpresa').change(function () {
                if (this.value != 0) {
                    tableFilter.fnFilter(this.value, 2);
                } else {
                    tableFilter.fnFilter('', 2);
                    tableFilter.fnFilter('')
                }
            })
        
        });  

        if( $("#empresaEditarFiltros").length || $("empresaNuevaFiltros").length){
             marketplace=true
       
        } else {
 
            //- $.ajax({
            //-     method: "GET",
            //-     url: "/data-table",
            //-     dataType:"json",
            //-     data:{tableName:"categorias"},
            //-     success: function(data){
            
            //-         for(i=0;i<data.length;i++){
            //-             $('#categoriaNuevo-filtros').append('<option value="'+data[i].id+'">'+data[i].name+'</option>');   
            //-             $('#categoriaEditar-filtros').append('<option value="'+data[i].id+'">'+data[i].name+'</option>');                                   
            //-         }  
            //-     },error: function(e){
            //-         console.log(e);
            //-     },
            //- });
        }
    
    include ./script.pug
    include ./save/filtros.pug
    include ./save/grupo-filtros.pug
    include ./update/grupo-filtro.pug
    include ./delete/filtros-admin.pug
    include ./handle/agregar-filtros.pug
    include ./handle/editar-filtros.pug
