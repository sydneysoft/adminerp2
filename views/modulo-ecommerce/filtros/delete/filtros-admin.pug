script.
  //Handle Data DELETE
  function eliminarFiltrosAdmin (val) {
    Swal.fire({
      title: "#{translation.ARE_YOU_SURE}",
      text: "#{translation.YOU_COULD_NOT_REVERT}", 
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "#{translation.YES_DELETE}",
    }).then((result) => {
      if (result.isConfirmed) {
        handleDeleteFiltroAdmin(val);
      }
    });
  }
  function handleDeleteFiltroAdmin (val) {
    Swal.showLoading();
    $.ajax({
      method: "GET",
      url: "/grupo-filtro-delete/" + val,
      dataType: "json",
      data: null,
      success: function (data) {
        if (data.status === "success") {
          Swal.close();
          window.location.reload(true);
        } else {
          Swal.close();
          toastSweet('Error', '#{translation.WRONG}', 'error');
        }
      },
      error: function () {
        Swal.close();
        toastSweet('Error', '#{translation.WRONG}', 'error');
      },
    });
  }