//- Y el anterior depende de /
script.
  const select2Tratamiento = $("#lista-tratamientos, #lista-tratamientos-editar, #lista-tratamientos-filtro").select2({
    ajax: {
      url: function () {
        return urlSelect2Tratamientos()
      },
      dataType: 'json',
      delay: 500,
      data: function (params) {
        return {
          term: params.term,
          select: ['id', 'nombre'],
          page: params.page
        }
      },
      processResults: function (data, params) {
        return {
          results: $.map(data.data, (item) => {
            return {
              id: item.id,
              text: item.nombre,
            }
          })
        }
      },
      cache: true
    },
    placeholder: 'Search',
    templateResult: tratamientosState,
    allowClear: true
  })
  .on("select2:open", () => {
    $(".select2-results:not(:has(a))").append(
      '<a href="#" style="padding: 6px;height: 20px;display: inline-table;" data-toggle="modal" data-target="#nuevoBannerAdministrador" onclick="closeTratamientosSelect2()">#{translation.ADD_TREATMENT}</a>'
    );
  }); //- No se debe crear

  function tratamientosState (state) {
    if (!state.id) {
      return state.text;
    }
    let $container = $(`
      <span><strong>${state.id}</strong> | ${state.text}</span>
    `);

    return $container;
  }

  function closeTratamientosSelect2 () {
    $("#lista-tratamientos, #lista-tratamientos-editar").select2('close');
  }

  function urlSelect2Tratamientos() {
    if (typeof empresa_id != 'undefined' && empresa_id && !isNaN(empresa_id.value)) {
      return `/admin-tratamientos/select2/${empresa_id.value}`;
    } else {
      return "/admin-tratamientos/select2"
    }
  }