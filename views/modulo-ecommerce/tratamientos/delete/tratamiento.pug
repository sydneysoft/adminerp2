script.
  function eliminarTratamientoAdmin (val) {
    Swal.fire({
      title: "#{translation.ALERTS.CONFIRM_DELETE}",
      text: "#{translation.ALERTS.CANNOT_REVERT}",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "#{translation.ALERTS.YES_DELETE} ",
    }).then((result) => {
      if (result.isConfirmed) {
        handleDeleteTratamiento(val);
      }
    });
  }
  function handleDeleteTratamiento(val) {
    Swal.showLoading();
    $.ajax({
      method: "DELETE",
      url: `/admin-tratamientos/${val}`,
      dataType: "json",
      success: function (data) {
        console.log(data);
        Swal.close();
        if (data.ok) {
          toastSweet('Success', '#{translation.ALERTS.TREATMENT_DELETED}', 'success');
          tablaTratamientos.ajax.reload();
        } else {
          toastSweet('Error', '#{translation.ALERTS.WRONG}', 'error');
        }
      },
      error: function () {
        Swal.close();
        toastSweet('Error', '#{translation.ALERTS.WRONG}', 'error');
      },
    });
  }
