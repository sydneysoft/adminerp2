script.
  const deleteProductosAdminPanel = (val) => {
    Swal.fire({
      title: "Estás Seguro?",
      text: "No podras revertir esta acción",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Si, Eliminar!",
    }).then((result) => {
      if (result.isConfirmed) {
        handleDeleteProductosAdmin(val);
      }
    });
  };

  const handleDeleteProductosAdmin = (val) => {
    Swal.showLoading();
    $.ajax({
      method: "GET",
      url: "/eliminar-producto-admin/" + val,
      dataType: "json",
      data: null,
      success: function (data) {
        if (data.ok) {
          Swal.close();
          if (typeof tablaProductos != 'undefined') {
            tablaProductos.ajax.reload();
          }
        } else {
          Swal.close();
          Swal.fire({
            position: "center",
            icon: "error",
            title: "Ocurrió un error interno inténtalo más tarde.",
            showConfirmButton: false,
            timer: 2500,
          });
        }
      },
      error: function () {
        Swal.close();
        Swal.fire({
          position: "center",
          icon: "error",
          title: "Ocurrió un error interno inténtalo más tarde.",
          showConfirmButton: false,
          timer: 2500,
        });
      },
    });
  };