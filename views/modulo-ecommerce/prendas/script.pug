  const accionBorrador = (val, db) => {
    Swal.showLoading();
    $.ajax({
      method: "PUT",
      url: "/acciones-masivas/borrador",
      dataType: "json",
      data: { val, db },
      success: function (data) {
        if (data.msg > 0) {
          Swal.close();
          window.location.reload(true);
        } else {
          Swal.close();
          Swal.fire({
            position: "center",
            icon: "error",
            title: "Ocurrió un error interno inténtalo más tarde.",
            showConfirmButton: false,
            timer: 2500,
          });
        }
      },
      error: function () {
        Swal.close();
        Swal.fire({
          position: "center",
          icon: "error",
          title: "Ocurrió un error interno inténtalo más tarde.",
          showConfirmButton: false,
          timer: 2500,
        });
      },
    });
  };

  const publicarProductos = (val, db) => {
    if (val.length === 0) {
      Swal.fire({
        position: "center",
        icon: "error",
        title: "Seleccione productos a publicar.",
        showConfirmButton: false,
        timer: 2500,
      });
    } else {
      Swal.fire({
        title: "Estás Seguro?",
        text: `Se publicaran ${val.length} productos`,
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Confirmar",
      }).then((result) => {
        if (result.isConfirmed) {
          accionPublicar(val, db);
        }
      });
    }
  };

  const accionPublicar = (val, db) => {
    Swal.showLoading();
    $.ajax({
      method: "PUT",
      url: "/acciones-masivas/publicar",
      dataType: "json",
