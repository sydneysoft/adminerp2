script.
  let tablaPrendas;
  $(document).ready(function () {
    let urlAjaxTablaPrendas = "/admin-prendas/datatable"
    if (typeof empresa_id != 'undefined' && empresa_id && !isNaN(empresa_id.value)) {
      urlAjaxTablaPrendas += `/${empresa_id.value}`;
    }
    tablaPrendas = $('#tabla-prendas').DataTable({
      columnDefs: [
        {
          orderable: false,
          className: "select-checkbox",
          targets: 0,
        },
      ],
      select: {
        style: "multi",
        selector: "td:first-child",
      },
      dom: "Bfrtip",
      buttons: ["selectAll", "selectNone"],
      order: [[1, "asc"]],
      language: {
        buttons: {
          selectAll: "Seleccionar todos",
          selectNone: "Borrar Selección",
        },
        url: "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json",
        select: {
          rows: "%d filas seleccionadas",
        },
      },
      rowId: 'id',
      responsive: true,
      searchCols: [
        null,
        null,
        null,
        null,
        null,
        { "search": "9999", "escapeRegex": false }
      ],
      searchDelay: 500,
      processing: true,
      serverSide: true,
      ajax: urlAjaxTablaPrendas,
      columns: [
        { 
          data: 'id', name: 'id', title: 'ID', orderable: false, searchable: false,
          render: function (data, type, row) {
            return ''
          }
        },
        { 
          data: 'imagen', name: 'imagen', title: "#{translation.FORM.IMAGE}", orderable: false, searchable: false,
          render: function (data, type, row) {
            try {
              new URL(row.imagen)
              return `<img src="${data}" style="width:50px;height:50px;object-fit:cover">`;
            } catch (e) {
              return `<img src="/images/image-default.jpg" style="width:50px;height:50px;object-fit:cover">`;
            }
          }
        },
        {
          data: 'name', name: 'name', title: '#{translation.FORM.NAME}', orderable: true, searchable: true,
        },
        {
          data: 'stock', name: 'stock', title: '#{translation.STOCK}', orderable: true, searchable: false,
        },
        {
          data: 'subcategoria', name: 'subcategoria', title: '#{translation.FORM.SUBCATEGORY}', orderable: true, searchable: true, visible: false
        },
        {
          data: 'categoria', name: 'categoria', title: '#{translation.FORM.CATEGORY}', orderable: true, searchable: true, visible: false,
          search: { value: '9999' }
        },
        {
          data: 'precio', name: 'precio', title: '#{translation.FORM.PRICE}', orderable: true, searchable: false,
          render: function (data, type, row) {
            return `$ ${data}`;
          }
        },
        {
          data: 'oferta_porcentaje', name: 'oferta_porcentaje', title: '#{translation.OFFER}', orderable: true, searchable: false,
          render: function (data, type, row) {
            return (data > 1 && data <= 100) ? `$ ${Math.round(row.precio * (((100 - data) / 100)), 2)}` : '-';
          }
        },
        {
          data: 'z_timestamp_create', name: 'z_timestamp_create', title: '#{translation.FORM.CREATED_AT}', orderable: true, searchable: true,
          render: function (data, type, row) {
            return moment(data).format('DD/MM/YYYY');
          }
        },
        {
          data: 'activado', name: 'activado', title: '#{translation.FORM.STATUS}', orderable: true, searchable: true,
          render: function (data, type, row) {
            return data == 1 ? "#{translation.FORM.ACTIVE}" : "#{translation.FORM.INACTIVE}";
          }
        },
        {
          data: 'almacen', name: 'almacen', title: '#{translation.FORM.STORE}', orderable: false, searchable: false,
          render: function (data, type, row) {
            //- return items.stock.filter((item) => item.producto_id == row.id).map(i => i.almacen_id);
            let almacenes = [];
            let banges = "";
            $.ajax({
              url: `/admin-almacenes/producto/${row.id}`,
              type: 'GET',
              async: false,
              success: function (data) {
                if(data.ok) {
                  almacenes = data.almacenes;
                }
              }
            });
            if (Array.isArray(almacenes) && almacenes.length > 0) {
              almacenes.forEach((almacen) => {
                row.almacen = almacen.id;
                banges += `<span class="badge badge-success">${almacen.nombre} | <stron>${almacen.stock}</strong></span>`;
              });
            } else {
              banges = '<span class="badge badge-danger">No hay productos en almacenes</span>';
            }
            return banges;
          }
        },
        { 
          data: 'acciones', name: 'acciones', title: '#{translation.FORM.ACTIONS}', orderable: false, searchable: false,
          render: function (data, type, row) {
            let strRow = JSON.stringify(row);
            return `
              <button class="btn btn-info" onclick="clonarProducto(${row.id})"><i class="fa fa-camera"></i></button>
              <button class="btn btn-warning" onclick="handleProductoAdmin(${row.id})"><i class="fa fa-edit"></i></button>
              <button class="btn btn-danger" onclick="deleteProductosAdminPanel(${row.id})"><i class="fa fa-trash"></i></button>
            `;
          }
        }
      ],
      initComplete: function (settings) {
        //- clone thead to tfoot
        $("#tabla-prendas thead tr").clone().appendTo($("#tabla-prendas tfoot"));
      }
    });

    $(".seleccionar").select2({
      language: {
        noResults: function () {
          return "#{translation.NO_RESULTS}";
        },
      },
    });

    var tableFilter = $("#tabla-prendas").dataTable();

    $('select#empresa').change(function () {
      if (this.value != 0) {
        tablaPrendas.search(this.value).draw();
      } else {
        tablaPrendas.search("").draw();
      }
    })

  });
