//- Este archivo depende de /modulo-ecommerce/sedes/modals/crear-tienda-admin.pug
//- Y el anterior depende de /
script.
  $("#lista-sedes, #lista-sedes-editar").select2({
    ajax: {
      url: function () {
        return urlSelect2Sedes();
      },
      dataType: 'json',
      delay: 500,
      data: function (params) {
        return {
          term: params.term,
          select: ['id', 'nombre'],
          page: params.page
        }
      },
      processResults: function (data, params) {
        return {
          results: $.map(data.data, (item) => {
            return {
              id: item.id,
              text: item.nombre
            }
          })
        }
      },
      cache: true
    },
    placeholder: 'Search',
    templateResult: sedesState
  }).on("select2:open", () => {
    $(".select2-results:not(:has(a))").append(
      '<a href="#" style="padding: 6px;height: 20px;display: inline-table;" data-toggle="modal" data-target="#nuevoTiendaAdmin" onclick="closeSedesSelect2()">#{translation.ADD_BRANCH}</a>'
    );
  });

  function sedesState (state) {
    if (!state.id) {
      return state.text;
    }
    let $container = $(`
      <span><strong>${state.id}</strong> | ${state.text}</span>
    `);

    return $container;
  }

  function closeSedesSelect2 () {
    $("#lista-sedes, #lista-sedes-editar").select2('close');
  }

  function urlSelect2Sedes() {
    if (typeof empresa_id != 'undefined' && empresa_id && !isNaN(empresa_id.value)) {
      return `/admin-sedes/select2/${empresa_id.value}`;
    } else {
      return "/admin-sedes/select2/select2"
    }
  }