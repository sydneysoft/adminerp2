script.
  function addTiendaAdmin (token) {
    let nombreTienda = $("#nombreNuevo-tienda-admin").val();
    let correoTienda = $("#correoNuevo-tienda-admin").val();
    let telefonoTienda = $("#telefonoNuevo-tienda-admin").val();
    let celularTienda = $("#celularNuevo-tienda-admin").val();
    let statusTienda = $("#statusNuevo-tienda-admin").val();
    //- let horarioTienda = $("#horarioNuevo-tienda-admin").val();
    let horarioTienda = $("#lista-horarios option:selected").text();
    let direccionTienda = $("#direccionNuevo-tienda-admin").val();
    let urlFotoPrincipal = $("#imagen-data-banner").attr("src");

    if (urlFotoPrincipal == "/images/image-default.jog") {
      toastSweet('Error', '#{translation.ALERTS.NO_IMAGE_STORE}', 'error');
      return;
    }
    if (!nombreTienda) {
      toastSweet('Error', '#{translation.ALERTS.NO_STORE_NAME}', 'error');
      return;
    }
    if (!correoTienda) {
      toastSweet('Error', '#{translation.ALERTS.NO_STORE_EMAIL}', 'error');
      return;
    }
    const auxData = {
      nombre: nombreTienda,
      correo: correoTienda,
      telefono: telefonoTienda,
      celular: celularTienda,
      estado: statusTienda,
      horario: horarioTienda,
      direccion: direccionTienda,
      imagen: urlFotoPrincipal,
    }
    if (typeof empresa_id != 'undefined' && empresa_id && !isNaN(empresa_id.value)) {
      auxData.empresa_id = empresa_id.value
    }
    if (
      nombreTienda &&
      correoTienda
    ) {
      Swal.showLoading();
      $.ajax({
        method: "POST",
        url: "/admin-sedes",
        dataType: "json",
        data: auxData,
        success: function (data) {
          if (data.ok) {
            Swal.close();
            toastSweet('Success', '#{translation.ALERTS.CAMPUS_CREATED}', 'success');
            if (typeof tablaSedes !== 'undefined') {
              tablaSedes.ajax.reload();
            }
            $("#nuevoTiendaAdmin").modal('hide');
          } else {
            Swal.close();
            toastSweet('Error', '#{translation.ALERTS.WRONG}', 'error');
          }
        },
        error: function () {
          Swal.close();
          toastSweet('Error', '#{translation.ALERTS.WRONG}', 'error');
        },
      });
    } else {
      toastSweet('Error', '#{translation.ALERTS.REQUIRED_FIELDS_PRODUCT}', 'error');
    }
  } 

  