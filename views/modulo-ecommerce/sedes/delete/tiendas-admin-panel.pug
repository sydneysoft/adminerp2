script.
  const deleteTiendasAdminPanel = (val) => {
    Swal.fire({
      title: "#{translation.ALERTS.ARE_YOU_SURE}",
      text: "#{translation.ALERTS.YOU_COULD_NOT_REVERT}",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "#{translation.ALERTS.YES_DELETE}",
    }).then((result) => {
      if (result.isConfirmed) {
        handleDeleteTiendasAdmin(val);
      }
    });
  };

  const handleDeleteTiendasAdmin = (val) => {
    Swal.showLoading();
    $.ajax({
      method: "DELETE",
      url: "/admin-sedes/" + val,
      dataType: "json",
      data: null,
      success: function (data) {
        if (data.ok) {
          Swal.close();
            toastSweet('Success', '#{translation.ALERTS.CAMPUS_DELETED}', 'success');
            tablaSedes.ajax.reload();
        } else {
          Swal.close();
          toastSweet('Error', '#{translation.ALERTS.WRONG}', 'error');
        }
      },
      error: function () {
        Swal.close();
        toastSweet('Error', '#{translation.ALERTS.WRONG}', 'error');
      },
    });
  };