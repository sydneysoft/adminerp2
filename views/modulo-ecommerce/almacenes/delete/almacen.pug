script.
  const deleteAdminPanel = (id) => {
    Swal.fire({
      title: "Estás Seguro?",
      text: "No podras revertir esta acción",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Si, Eliminar!",
    }).then((result) => {
      if (result.isConfirmed) {
        Swal.showLoading();
        fetch(`/admin-almacenes/` + id, {
          method: "delete",
        })
          .then((data) => {
            Swal.close();
            if (data.status === 200) {
              if (typeof tablaAlmacenes !== 'undefined') {
                tablaAlmacenes.ajax.reload();
              }
              toastSweet('Success', '#{translation.ALERTS.DELETED}', 'success');
            } else {
              Swal.fire({
                position: "center",
                icon: "error",
                title: "#{translation.ALERTS.WRONG}",
                showConfirmButton: false,
                timer: 2500,
              });
            }
          })
          .catch(() => {
            Swal.close();
            Swal.fire({
              position: "center",
              icon: "error",
              title: "#{translation.ALERTS.WRONG}",
              showConfirmButton: false,
              timer: 2500,
            });
          });
      }
    });
  };
