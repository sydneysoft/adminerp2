script.
  let tablaAlmacenes;
  $(document).ready(function () {
    let urlAjaxTablaAlmacenes = "/admin-almacenes/datatable"
    if (typeof empresa_id != 'undefined' && !isNaN(empresa_id.value)) {
      urlAjaxTablaAlmacenes += `/${empresa_id.value}`;
    }
    tablaAlmacenes = $("#tabla-almacenes").DataTable({
      columnDefs: [
        {
          orderable: false,
          className: "select-checkbox",
          targets: 0,
        },
      ],
      select: {
        style: "multi",
        selector: "td:first-child",
      },
      dom: "Bfrtip",
      buttons: ["selectAll", "selectNone"],
      order: [[1, "asc"]],
      language: {
        buttons: {
          selectAll: '#{translation.SELECT_EVERYTHING}',
          selectNone: '#{translation.ERASE_SELECTION}',
        },
        url: "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json",
        select: {
          rows: "%d filas seleccionadas",
        },
      },
      responsive: true,
      searchDelay: 500,
      processing: true,
      serverSide: true,
      ajax: urlAjaxTablaAlmacenes,
      rowId: 'id',
      columns: [
        { 
          data: 'id', name: 'id', title: 'ID', orderable: false, searchable: false,
          render: function (data, type, row) {
            return `
            `;
          }
        },
        { data: 'nombre', name: 'nombre', title: '#{translation.NAME}', orderable: true, searchable: true},
        { data: 'direccion', name: 'direccion', title: '#{translation.DIRECTION}', orderable: true, searchable: true},
        { data: 'pais', name: 'pais', title: '#{translation.COUNTRY}', orderable: true, searchable: true},
        { data: 'provincia', name: 'provincia', title: '#{translation.STATE}', orderable: true, searchable: true},
        { 
          data: 'updated_at', name: 'updated_at', title: '#{translation.UPDATED_AT}', orderable: true, searchable: true,
          render: function (data, type, row) {
            return moment(data).format('DD/MM/YYYY');
          }
        },
        { 
          data: 'acciones', name: 'acciones', title: '#{translation.ACTIONS}', orderable: false, searchable: false,
          render: function (data, type, row) {
            let strRow = JSON.stringify(row);
            return `
              <button class="btn btn-warning" onclick='openNewHandleModalStore(${strRow})'><i class="fa fa-edit"></i></button>
              <button class="btn btn-danger" onclick="deleteAdminPanel(${row.id})"><i class="fa fa-trash"></i></button>
            `;
          }
        }
      ],
      initComplete: function (settings) {
        //- clone thead to tfoot
        $("#tabla-almacenes thead tr").clone().appendTo($("#tabla-almacenes tfoot"));
      }
    });

    $(".seleccionar").select2({
      language: {
        noResults: function () {
          return "No se han encontrado resultados";
        },
      },
    });


    $("#accionesBoton").click(function () {
      const valorSeleccionado = $("#acciones").val();
      const selected_rows = tablaAlmacenes
        .rows({
          selected: true,
        })
        .ids();

      const arraySeleccion = $.makeArray(selected_rows);
      switch (valorSeleccionado) {
        case "0":
          eliminarProductos(arraySeleccion, "almacenes");
          break;
      }
    });
  });