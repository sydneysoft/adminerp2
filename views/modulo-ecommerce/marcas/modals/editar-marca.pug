.modal.fade#editarBannerAdministrador(tabindex="-1" role="dialog")
  .modal-dialog(role="document")
    .modal-content
      .modal-body
        .row(style="padding:10px;margin-bottom:8px;")
          .col-md-12
            .form-group
              img(id="imagen-data-banner-editar" src="https://www.cuba.travel/images/noimage.png" class="content-img-banner" onClick="handleModal()")
          if marketplace
            .col-12
              .form-group
                label(for="lista-empresas-editar") #{translation.COMPANY}
                select#lista-empresas-editar

          .col-md-6.col-12
            .form-group
              h5 #{translation.NAME}:
              .controls
                input#idEditarMarcasAdmin(type="hidden" placeholder=translation.NAME)
                input#nombreEditar-marcas.form-control(type="text")
          .col-md-6.col-12
            .form-group
              h5 #{translation.CATEGORY}:
              .controls
                select#lista-categorias-editar
                //- select#categoriaEditar-marcas.form-control
                  option(disabled) --Seleccione Categoria--
                  //- each categoria in items.categorias
                    option(value= categoria.id)= categoria.name

          .col-md-6.col-6
            .form-group
              h5 #{translation.STATUS}:
              .controls
                select#activadoEditar-marcas.form-control
                  option(value="1") #{translation.ACTIVATED}
                  option(value="0") #{translation.DEACTIVATED}
          .col-md-6.col-6
            .form-group
              h5 #{translation.HIGHLIGHT}}:
              .controls
                select#destacadoEditar-marcas.form-control
                  option(value="1") #{translation.YES}
                  option(value="0") #{translation.NO}
      .modal-footer
        button.btn.btn-success.editar(type="button" style="margin-left:7px;margin-right:7px;",onClick=`updateMarcasAdmin(${token})`) #{translation.UPDATE}
          i.fas.fa-save.ml-2
        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
          i.fas.fa-times-circle.ml-2
