script.
  //Manejar Datos en el Modal Para editar Marcas
  const handleEditMarca = (data) => {
    typeOperation = "2";
    $("#idEditarMarcasAdmin").val(data.id);
    $("#nombreEditar-marcas").val(data.name);
    $("#lista-empresas-editar").select2("val", data.empresa_id);
    $("#lista-empresas-editar ~ .select2 .select2-selection__placeholder").html(data.empresa_id);
    $("#lista-categorias-editar").select2("val", data.categoria);
    $("#lista-categorias-editar ~ .select2 .select2-selection__placeholder").html(data.categoria);
    $("#activadoEditar-marcas").val(data.activado);
    $("#destacadoEditar-marcas").val(data.destacado);
    $("#imagen-data-banner-editar").attr("src", data.imagen);
    $("#selected-img-data-editar").val(data.imagen);
    $("#editarBannerAdministrador").modal("show");

    //- Para el cambio de empresa_id
    $("#empresa_id").val(data.empresa_id);
  };

  //Actualizar todo los Datos
  const updateMarcasAdmin = (token) => {
    let idMarca = $("#idEditarMarcasAdmin").val();
    let nombre = $("#nombreEditar-marcas").val();
    let imagen = $("#imagen-data-banner-editar").attr('src');
    let categoria = $("#lista-categorias-editar").val();
    let status = $("#activadoEditar-marcas").val();
    let destacado = $("#destacadoEditar-marcas").val();

    const auxData = {
      empresa_id:token,
      name: nombre,
      activado: status,
      imagen: imagen,
      destacado: destacado,
    }
    //- console.log(auxData);
    if (categoria) {
      auxData.categoria = categoria;
    }

    //- if (typeof empresa_id != 'undefined' && empresa_id != null) {
    //-   auxData.empresa_id = empresa_id.value;
    //- } else {
    //-   if (token) {
    //-     auxData.empresa_id = token;
    //-   }
    //- }

    if (idMarca && nombre && status && destacado) {
      Swal.showLoading();
      $.ajax({
        method: "PUT",
        url: "/admin-marcas/" + idMarca,
        dataType: "json",
        data: auxData,
        success: function (data) {
          Swal.close();
          if (data.ok) {
            $("#editarBannerAdministrador").modal("hide");
            toastSweet('Success', '#{translation.UPDATED}', 'success');
            if(typeof tablaMarcas != 'undefined') {
              tablaMarcas.ajax.reload();
              $("#empresa_id").val("");
            }
            $("#editarBannerAdministrador").modal("hide");
          } else {
            toastSweet('Error', '#{translation.REGISTER_CANNOT_UPDATE}', 'error');
          }
        },
        error: function () {
          Swal.close();
          toastSweet('Error', '#{translation.WRONG}', 'error');
        },
      });
    } else {
      toastSweet('Error', '#{translation.FORM_EMPTY}', 'error');
    }
  };