
script.
  let tablaPedidos;
  $(document).ready( function () {
    let urlAjaxTablaPedidos = "/admin-pedidos-cancelados/datatable";
    if (typeof empresa_id != 'undefined' && empresa_id.value != "" && !isNaN(empresa_id.value)) {
      urlAjaxTablaPedidos = "/admin-pedidos-cancelados/datatable/" + empresa_id.value;
    }
    tablaPedidos = $('#tabla-pedidos').DataTable({
      "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"},
      order: [[ 0, "desc" ]],
      searchDelay: 500,
      processing: true,
      serverSide: true,
      ajax: urlAjaxTablaPedidos,
      columns: [
        { data: 'id', name: 'id', title: "ID", orderable: true, searchable: false, visible: false},
        { 
          data: 'fecha_registro', name: 'fecha_registro', title: "#{translation.DATE}", orderable: false, searchable: false,
          render: function (data, type, row) {
            return moment(data).format('DD/MM/YYYY');
          }
        },
        { data: 'usuario', name: 'usuario', title: "#{translation.USER}", orderable: true, searchable: true},
        { 
          data: 'total', name: 'total', title: "#{translation.TOTAL}", orderable: false, searchable: false,
          render: function (data, type, row) {
            return row.moneda + "" + row.suma_subtotal
          }
        },
        { data: 'tipo_pago', name: 'tipo_pago', title: "#{translation.PAYMENT}", orderable: true, searchable: true},
        { data: 'direccion_entrega', name: 'direccion_entrega', title: "#{translation.ADDRESS}", orderable: true, searchable: true},
        { data: 'provincia', name: 'provincia', title: "#{translation.PROVINCE}", orderable: true, searchable: true},
        { 
          data: 'estado', name: 'estado', title: "#{translation.STATE}", orderable: false, searchable: false,
          render: function (data, type, row) {
            switch (parseInt(data)) {
              case 1:
                return "<span class='badge badge-success'>#{translation.PAID}</span>";
              case 2:
                return "<span class='badge badge-warning'>#{translation.PROCESSED}</span>";
              case 3:
                return "<span class='badge badge-info'>#{translation.DELIVERED}</span>";
              default:
                return "<span class='badge badge-danger'>#{translation.ERROR}</span>";
            }
          }  
        }
      ],
      initComplete: function (settings) {
        //- clone thead to tfoot
        $("#tabla-pedidos thead tr").clone().appendTo($("#tabla-pedidos tfoot"));
      }
    });
  });
