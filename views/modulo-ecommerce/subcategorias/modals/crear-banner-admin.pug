.modal.fade#crearSubcategoriaModal(tabindex="-1" role="dialog")
  .modal-dialog(role="document")
    .modal-content
      .modal-body
        .row(style="padding:10px;margin-bottom:8px;")
          .col-md-12.col-12
            .form-group
              img(id="imagen-data-banner" src="https://www.cuba.travel/images/noimage.png" class="content-img-banner" onClick="handleModal()")
          .col-md-6.col-12
            .form-group
              h5 #{translation.FORM.NAME}:
              .controls
                input#nombreNuevo-subcategoria.form-control(type="text")
          .col-md-6.col-12
            .form-group
              h5 #{translation.FORM.CATEGORY}:
              .controls
                select#lista-categorias
          .col-md-12.col-12
            .form-group
              h5 #{translation.FORM.STATUS}:
              .controls
                select#activadoNuevo-subcategoria.form-control
                  option(value="1") #{translation.FORM.ACTIVE}
                  option(value="0") #{translation.FORM.DEACTIVATED}
      .modal-footer
        button.btn.btn-success.nuevo(type="button" style="margin-left:7px;margin-right:7px;",onClick=`AgregarSubcategoriaAdmin(${token})`) #{translation.ADD}
        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
