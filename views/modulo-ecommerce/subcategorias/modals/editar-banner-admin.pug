.modal.fade#editarSubcategoriaModal(tabindex="-1" role="dialog")
  .modal-dialog(role="document")
    .modal-content
      .modal-body
        .row(style="padding:10px;margin-bottom:8px;")
          .col-md-12
            .form-group
              img(id="imagen-data-banner-editar" src="https://www.cuba.travel/images/noimage.png" class="content-img-banner" onClick="handleModal()")
          .col-md-6.col-12
            .form-group
              h5 #{translation.NAME}:
              .controls
                input#idEditarSubcategoriaAdmin(type="hidden")
                input#nombreEditar-subcategoria.form-control(type="text")
          .col-md-6.col-12
            .form-group
              h5 #{translation.CATEGORY}:
              .controls       
                select#lista-categorias-editar 

          .col-md-12.col-12
            .form-group
              h5 #{translation.STATUS}:
              .controls
                select#activadoEditar-categoria.form-control
                  option(value="1") #{translation.ACTIVE}
                  option(value="0") #{translation.DEACTIVATED}
      .modal-footer
        button.btn.btn-success.editar(type="button" style="margin-left:7px;margin-right:7px;",onClick=`editarSubcategoriaAdmin(${token})`) #{translation.UPDATE_DATA}
        button.btn.btn-danger(type="buton" data-dismiss="modal") #{translation.CLOSE}
