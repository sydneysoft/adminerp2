script.
  const cambiarCategoriaPorEmpresaNuevo = () => {
      let valorEmpresa = $("#empresaNuevaSubcateg").val();
      $("#categoriaNuevo-subcategoria").empty();
      if (valorEmpresa == null || valorEmpresa == "") {
          valorEmpresa = 0
      }
      if (valorEmpresa != "") {
          $.ajax({
              method: "GET",
              url: "/admin-categorias/empresa/" + valorEmpresa,
              dataType: "json",
              success: function (data) {
                  let subcategorias = data.categorias;
                  if (subcategorias.length > 0) {
                      $("#categoriaNuevo-subcategoria").append(
                          '<option value="">#{translation.CHOOSE_CATEGORY}</option>'
                      );
                      for (let i = 0; subcategorias.length > i; i++) {
                          $("#categoriaNuevo-subcategoria").append(
                              '<option value="' +
                              subcategorias[i].id +
                              '">' +
                              subcategorias[i].name +
                              "</option>"
                          );
                      }
                      $("#categoriaNuevo-subcategoria").attr("disabled", false);
                  } else {
                      $("#categoriaNuevo-subcategoria").append(
                          '<option value="0">#{translation.CATEGORIES_NOT_FOUND}</option>'
                      );
                      $("#categoriaNuevo-subcategoria").attr("disabled", true);
                  }
              },
              error: function (e) {
                  console.log(e);
              },
          });
      } else {
          $("#categoriaNuevo-subcategoria").attr("disabled", true);
      }
  };

  const cambiarCategoriaPorEmpresaEdita = () => {
      let valorEmpresa = $("#empresaEditarSubcateg").val();
      $("#categoriaEditar-subcategoria").empty();
      typeUpdate = 2;
      if (valorEmpresa != "") {
          $.ajax({
              method: "GET",
              url: "/admin-categorias/empresa/" + valorEmpresa,
              dataType: "json",

              success: function (data) {

                  let subcategorias = data.categorias;

                  if (subcategorias.length > 0) {
                      $("#categoriaEditar-subcategoria").append(
                          '<option value="">Elige una categoría</option>'
                      );
                      for (let i = 0; subcategorias.length > i; i++) {
                          $("#categoriaEditar-subcategoria").append(
                              '<option value="' +
                              subcategorias[i].id +
                              '">' +
                              subcategorias[i].name +
                              "</option>"
                          );
                      }
                      $("#categoriaEditar-subcategoria").attr("disabled", false);
                  } else {
                      $("#categoriaEditar-subcategoria").append(
                          '<option value="0">#{translation.CATEGORIES_NOT_FOUND}</option>'
                      );
                      $("#categoriaEditar-subcategoria").attr("disabled", true);
                  }
              },
              error: function (e) {
                  console.log(e);
              },
          });
      } else {
          $("#categoriaEditar-subcategoria").append('<option value=""></option>');
      }
  };
